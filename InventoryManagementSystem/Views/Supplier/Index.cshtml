@model IEnumerable<InventoryManagementSystem.Models.Supplier>
@{
    ViewData["Title"] = "Supplier Directory & Procurement";
    var totalCount = ViewBag.TotalCount ?? 0;
    var search = ViewBag.Search as string;
    var terms = ViewBag.Terms as string;
    var payableStatus = ViewBag.PayableStatus as string;
    bool hasActiveFilter = !string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(terms) || !string.IsNullOrEmpty(payableStatus);
}

<!-- Page Header -->
<div class="ph">
    <div>
        <h1 class="ph-title"><i class="bi bi-truck me-2" style="color:var(--primary)"></i>Supplier Management</h1>
        <p class="ph-sub">Vendor directory, procurement stock-in sources, and outstanding payables</p>
    </div>
    <div class="ph-actions">
        <button type="button" class="btn-d @(hasActiveFilter ? "btn-primary" : "btn-outline")" id="supplierFilterToggleBtn" onclick="toggleFilterPanel('supplierFilterPanel', 'supplierFilterToggleBtn')">
            <i class="bi bi-funnel-fill"></i>
            <span>Filters: @(hasActiveFilter ? "ON" : "OFF")</span>
        </button>
        @if (ViewBag.LimitReached == true)
        {
            <button type="button" class="btn-d btn-secondary border-warning text-warning" onclick="openCreateSupplierModal()" title="@ViewBag.LimitMessage">
                <i class="bi bi-lock-fill me-1"></i> Add Supplier (Limit Reached)
            </button>
        }
        else
        {
            <button type="button" class="btn-d btn-primary" onclick="openCreateSupplierModal()">
                <i class="bi bi-plus-circle"></i> Add New Supplier
            </button>
        }
    </div>
</div>

@if (ViewBag.LimitReached == true)
{
    <!-- Package Limit Warning Banner -->
    <div class="alert alert-danger d-flex align-items-center justify-content-between mb-4 p-3 border-danger bg-opacity-10 bg-danger text-danger rounded-3 shadow-sm">
        <div class="d-flex align-items-center">
            <i class="bi bi-slash-circle-fill fs-3 me-3"></i>
            <div>
                <h5 class="fw-bold mb-1"><i class="bi bi-shield-lock-fill me-2"></i>Not Applicable in Current Plan</h5>
                <div>@ViewBag.LimitMessage</div>
                <small class="d-block mt-1 text-muted">Upgrade your plan to unlock more supplier accounts.</small>
            </div>
        </div>
        <a href="@Url.Action("Plans", "Subscription")" class="btn btn-warning shadow-sm fw-bold">
            <i class="bi bi-rocket-takeoff-fill me-1"></i> View Other Plans
        </a>
    </div>

    <!-- Package Limit Modal Popup for Suppliers -->
    <div class="modal fade" id="supplierPackageLimitModal" tabindex="-1" style="background: rgba(0,0,0,0.85); isolation: isolate; z-index: 1055;" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-light border-warning shadow-lg">
                <div class="modal-header border-secondary bg-warning bg-opacity-10 text-warning">
                    <h5 class="modal-title font-display fw-bold mb-0">
                        <i class="bi bi-shield-slash-fill me-2"></i>Not Applicable in Current Plan
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    <div class="mb-3">
                        <span class="badge-d badge-yellow p-3 rounded-circle d-inline-flex align-items-center justify-content-center" style="width:70px;height:70px;font-size:32px">
                            <i class="bi bi-lock-fill text-warning"></i>
                        </span>
                    </div>
                    <h5 class="fw-bold text-light mb-2">Package Limit Reached</h5>
                    <p class="text-light fs-6 mb-4 fw-semibold">
                        @ViewBag.LimitMessage
                    </p>
                    <div class="alert alert-warning text-dark border-warning fs-7 mb-0 fw-bold shadow-sm">
                        <i class="bi bi-info-circle-fill me-1"></i> Upgrade to a higher plan to add more suppliers and vendors to your procurement network.
                    </div>
                </div>
                <div class="modal-footer border-secondary justify-content-center gap-2">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-arrow-left me-1"></i> Go Back
                    </button>
                    <a href="@Url.Action("Plans", "Subscription")" class="btn btn-warning shadow-sm fw-bold">
                        <i class="bi bi-rocket-takeoff-fill me-1"></i> View Other Plans & Upgrade
                    </a>
                </div>
            </div>
        </div>
    </div>
}

<!-- Detailed Filter Panel -->
<div class="card-d card-p mb-4" id="supplierFilterPanel" style="display:@(hasActiveFilter ? "block" : "none")">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-lg-5 col-md-6">
            <label class="fg-label"><i class="bi bi-search me-1 text-primary"></i>Search Keywords</label>
            <div class="search-pill">
                <i class="bi bi-search search-pill-icon"></i>
                <input type="text" name="search" value="@search" class="search-pill-input" placeholder="Vendor / Brand, Company, Phone, Email, GSTIN, Address..." />
            </div>
        </div>
        <div class="col-lg-3 col-md-3">
            <label class="fg-label"><i class="bi bi-credit-card me-1 text-info"></i>Payment Terms</label>
            <select name="terms" class="fg-control">
                <option value="">All Payment Terms</option>
                <option value="Net 15" selected="@(terms == "Net 15")">Net 15 Days</option>
                <option value="Net 30" selected="@(terms == "Net 30")">Net 30 Days</option>
                <option value="Net 60" selected="@(terms == "Net 60")">Net 60 Days</option>
                <option value="Advance" selected="@(terms == "Advance")">Advance Payment Only</option>
                <option value="COD" selected="@(terms == "COD")">Cash On Delivery (COD)</option>
            </select>
        </div>
        <div class="col-lg-2 col-md-3">
            <label class="fg-label"><i class="bi bi-wallet2 me-1 text-warning"></i>Payable Status</label>
            <select name="payableStatus" class="fg-control">
                <option value="">All Payable Statuses</option>
                <option value="HasBalance" selected="@(payableStatus == "HasBalance")">Outstanding Balance (> ₹0)</option>
                <option value="Clear" selected="@(payableStatus == "Clear")">Balance Clear (₹0)</option>
            </select>
        </div>
        <div class="col-lg-2 col-md-12 d-flex align-items-center gap-2">
            <button type="submit" class="btn-d btn-primary w-100" title="Apply Filter">
                <i class="bi bi-funnel"></i> Apply
            </button>
            <a href="@Url.Action("Index")" class="btn-d btn-outline" title="Reset All Filters">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<!-- Table Card Container -->
<div class="card-d card-p p-0 overflow-hidden">
    <div class="d-flex align-items-center justify-content-between p-3 border-bottom" style="border-color:var(--border)!important">
        <div class="d-flex align-items-center gap-2">
            <span style="font-weight:700;font-size:14px;color:var(--text-primary)">Supplier Directory</span>
            <span class="badge-d badge-gray">@totalCount Vendors</span>
        </div>
        @if (hasActiveFilter)
        {
            <span style="font-size:12px;color:var(--primary)"><i class="bi bi-filter me-1"></i>Filtered Results</span>
        }
    </div>

    <div class="tbl-scroll">
        <table class="tbl mb-0" id="suppliers-table">
            <thead>
                <tr>
                    <th class="ps-4">Vendor / Brand & Legal Company</th>
                    <th>Phone & Email</th>
                    <th>GSTIN</th>
                    <th>Payment Terms</th>
                    <th>Payable Balance</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-truck text-muted d-block mb-2" style="font-size:32px"></i>
                            No suppliers found matching your filter criteria.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var s in Model)
                    {
                        var modalJson = System.Text.Json.JsonSerializer.Serialize(s);
                        <tr>
                            <td class="ps-4">
                                <div style="font-weight:700;color:var(--text-primary);font-size:14px" class="d-flex align-items-center gap-2">
                                    <i class="bi bi-shop text-primary" style="font-size:15px"></i>
                                    @s.DisplayVendorName
                                </div>
                                <div style="font-size:12px;color:var(--text-muted);font-weight:500" class="d-flex align-items-center gap-1 mt-1">
                                    <i class="bi bi-building" style="font-size:12px"></i>
                                    @s.DisplayCompanyName
                                </div>
                                <div style="font-size:11px;color:var(--text-muted);opacity:0.8" class="mt-1">
                                    Added: @s.CreatedDate.ToString("yyyy-MM-dd")
                                </div>
                            </td>
                            <td>
                                <div style="font-size:13px;color:var(--text-primary)"><i class="bi bi-telephone me-1 text-muted"></i>@s.Phone</div>
                                <div style="font-size:11px;color:var(--text-muted)"><i class="bi bi-envelope me-1"></i>@(string.IsNullOrEmpty(s.Email) ? "-" : s.Email)</div>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(s.Gstin))
                                {
                                    <span class="code-pill">@s.Gstin</span>
                                }
                                else
                                {
                                    <span style="color:var(--text-muted);font-size:12px">-</span>
                                }
                            </td>
                            <td>
                                <span class="badge-d badge-gray">
                                    <i class="bi bi-credit-card me-1"></i>@(string.IsNullOrEmpty(s.PaymentTerms) ? "Net 30" : s.PaymentTerms)
                                </span>
                            </td>
                            <td>
                                @if (s.OutstandingPayable > 0)
                                {
                                    <span class="badge-d badge-warning" style="font-weight:700">
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i>₹@s.OutstandingPayable.ToString("N2")
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-d badge-success">
                                        <i class="bi bi-check-circle-fill me-1"></i>Clear (₹0)
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-flex align-items-center justify-content-end gap-1">
                                    <!-- View Details Button -->
                                    <button type="button" class="btn-d btn-ghost btn-icon-d text-info"
                                            onclick='openViewSupplierModal(@Html.Raw(modalJson))'
                                            title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </button>

                                    <!-- Edit Supplier Button -->
                                    <button type="button" class="btn-d btn-ghost btn-icon-d text-primary"
                                            onclick='openEditSupplierModal(@Html.Raw(modalJson))'
                                            title="Edit Supplier">
                                        <i class="bi bi-pencil"></i>
                                    </button>

                                    <!-- Reset Password Button -->
                                    <button type="button" class="btn-d btn-ghost btn-icon-d text-warning"
                                            onclick='openDirectSupplierPasswordModal(@Html.Raw(modalJson))'
                                            title="Change / Reset Password">
                                        <i class="bi bi-key"></i>
                                    </button>

                                    <!-- Send Reset Email Button -->
                                    <button type="button" class="btn-d btn-ghost btn-icon-d text-success"
                                            onclick='sendSupplierResetEmail("@s.Id", "@s.Email")'
                                            title="Send Password Reset Email">
                                        <i class="bi bi-envelope-at"></i>
                                    </button>

                                    <!-- Delete Supplier Button -->
                                    <form method="post" asp-action="Delete" asp-route-id="@s.Id" class="d-inline" onsubmit="return confirm('Are you sure you want to delete supplier \'@s.DisplayVendorName\'?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-d btn-ghost btn-icon-d text-danger" title="Delete Supplier">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination Footer -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="d-flex align-items-center justify-content-between p-3 border-top" style="border-color:var(--border)!important">
            <div style="font-size:12px;color:var(--text-muted)">
                Page @ViewBag.CurrentPage of @ViewBag.TotalPages (@totalCount total suppliers)
            </div>
            <div class="d-flex gap-1">
                @if (ViewBag.CurrentPage > 1)
                {
                    <a href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1, search, terms, payableStatus })" class="btn-d btn-outline btn-sm-d">
                        <i class="bi bi-chevron-left"></i> Previous
                    </a>
                }
                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <a href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1, search, terms, payableStatus })" class="btn-d btn-outline btn-sm-d">
                        Next <i class="bi bi-chevron-right"></i>
                    </a>
                }
            </div>
        </div>
    }
</div>

<!-- Modal: View Supplier Details -->
<div class="modal fade" id="viewSupplierDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="background:var(--bg-card);border:1px solid var(--border);border-radius:16px;color:var(--text-primary)">
            <div class="modal-header border-bottom" style="border-color:var(--border)!important">
                <div class="d-flex align-items-center gap-2">
                    <div style="width:36px;height:36px;border-radius:10px;background:var(--primary-dim);display:flex;align-items:center;justify-content:center;color:var(--primary)">
                        <i class="bi bi-truck" style="font-size:18px"></i>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0" id="v_VendorName" style="font-weight:700">Vendor / Brand Name</h5>
                        <div style="font-size:13px;color:var(--text-secondary);font-weight:600" id="v_CompanyName">Company / Legal Name</div>
                        <div style="font-size:11px;color:var(--text-muted)" id="v_CreatedDate">Added to Directory</div>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Business Identity Details Card -->
                <div class="card-d card-p p-3 mb-4" style="background:var(--bg);border:1px solid var(--border)">
                    <div style="font-size:11px;color:var(--text-muted);text-transform:uppercase;font-weight:700" class="mb-2">
                        <i class="bi bi-patch-check-fill text-primary me-1"></i>Business Identity Verification
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <span class="text-muted small">Vendor / Brand / Trading Name:</span>
                            <div class="fw-bold" style="font-size:15px;color:var(--text-primary)" id="v_IdVendorName">-</div>
                        </div>
                        <div class="col-md-6">
                            <span class="text-muted small">Company / Legal Registered Name:</span>
                            <div class="fw-bold" style="font-size:15px;color:var(--text-primary)" id="v_IdCompanyName">-</div>
                        </div>
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <!-- Key Metric Card -->
                    <div class="col-12">
                        <div class="card-d card-p p-3" style="background:var(--bg);border:1px solid var(--border)">
                            <div style="font-size:11px;color:var(--text-muted);text-transform:uppercase;font-weight:700">Outstanding Payable</div>
                            <div style="font-size:20px;font-weight:800;color:var(--warning)" class="mt-1" id="v_OutstandingPayable">₹0.00</div>
                        </div>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="fg mb-2">
                            <label class="fg-label text-muted">Contact Person</label>
                            <div style="font-size:14px;font-weight:600;color:var(--text-primary)" id="v_ContactPerson">-</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="fg mb-2">
                            <label class="fg-label text-muted">Phone Contact</label>
                            <div style="font-size:14px;font-weight:600;color:var(--text-primary)" id="v_Phone">-</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="fg mb-2">
                            <label class="fg-label text-muted">Email Address</label>
                            <div style="font-size:14px;font-weight:600;color:var(--text-primary)" id="v_Email">-</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="fg mb-2">
                            <label class="fg-label text-muted">Vendor GSTIN</label>
                            <div id="v_Gstin"><span class="code-pill">-</span></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="fg mb-2">
                            <label class="fg-label text-muted">Payment Terms</label>
                            <div style="font-size:14px;font-weight:600;color:var(--text-primary)" id="v_PaymentTerms">Net 30</div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="fg mb-0">
                            <label class="fg-label text-muted">Warehouse / Office Address</label>
                            <div class="p-3 rounded" style="background:var(--bg);border:1px solid var(--border);font-size:13px;color:var(--text-primary)" id="v_Address">-</div>
                        </div>
                    </div>
                </div>

                <!-- Security & Password Management Section -->
                <hr class="s-divider my-3" />
                <div style="font-size:11px;color:var(--text-muted);text-transform:uppercase;font-weight:700" class="mb-2">
                    <i class="bi bi-shield-lock-fill text-warning me-1"></i>Security & Credentials
                </div>
                <div class="card-d card-p p-3 mb-2" style="background:var(--bg);border:1px solid var(--border)">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <div>
                            <div style="font-size:12px;color:var(--text-muted)">Portal Login Password</div>
                            <div style="font-family:monospace;letter-spacing:3px;font-size:16px;color:var(--text-muted)">••••••••••••</div>
                            <div style="font-size:11px;color:var(--text-muted);margin-top:2px">Password is securely hashed. Original password cannot be retrieved.</div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn-d btn-outline btn-sm-d" onclick="openDirectChangePasswordFromDetails()">
                                <i class="bi bi-key me-1"></i> Reset Password
                            </button>
                            <button type="button" class="btn-d btn-outline btn-sm-d text-primary" onclick="sendSupplierResetEmailFromDetails()">
                                <i class="bi bi-send-fill me-1"></i> Send Password Reset Email
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top" style="border-color:var(--border)!important">
                <button type="button" class="btn-d btn-outline" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn-d btn-primary" id="v_EditBtn">
                    <i class="bi bi-pencil me-1"></i> Edit Supplier Profile
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Save/Edit Supplier -->
<div class="modal fade" id="saveSupplierModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background:var(--bg-card);border:1px solid var(--border);border-radius:16px;color:var(--text-primary)">
            <div class="modal-header border-bottom" style="border-color:var(--border)!important">
                <h5 class="modal-title" id="saveSupplierModalTitle" style="font-weight:700">
                    <i class="bi bi-truck me-2" style="color:var(--primary)"></i>Add Supplier Vendor Account
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Save" method="post" id="saveSupplierForm" onsubmit="return validateSaveSupplierForm()">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="supplier_Id" />

                <div class="modal-body p-4">
                    <div class="fg mb-3">
                        <label class="fg-label">Vendor / Brand Name <span class="req">*</span></label>
                        <input type="text" name="VendorName" id="supplier_VendorName" required class="fg-control" placeholder="e.g. ABC Mobiles" />
                        <div style="font-size:11px;color:var(--text-muted);margin-top:2px">Commonly known trading, brand, distributor, or store display name.</div>
                    </div>
                    <div class="fg mb-3">
                        <label class="fg-label">Company / Legal Name <span class="req">*</span></label>
                        <input type="text" name="CompanyName" id="supplier_CompanyName" required class="fg-control" placeholder="e.g. ABC Mobile Distribution Pvt. Ltd." />
                        <div style="font-size:11px;color:var(--text-muted);margin-top:2px">Officially registered corporate / business legal identity.</div>
                    </div>
                    <div class="fg mb-3">
                        <label class="fg-label">Contact Person Name</label>
                        <input type="text" name="ContactPerson" id="supplier_ContactPerson" class="fg-control" placeholder="e.g. John Doe / Account Manager" />
                        <div style="font-size:11px;color:var(--text-muted);margin-top:2px">Primary person handling orders or inquiries.</div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="fg-label">Phone Number</label>
                            <input type="tel" name="Phone" id="supplier_Phone" class="fg-control" placeholder="9876543210" />
                        </div>
                        <div class="col-6">
                            <label class="fg-label">Email Address</label>
                            <input type="email" name="Email" id="supplier_Email" class="fg-control" placeholder="vendor@supplier.com" />
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="fg-label">Vendor GSTIN <span style="font-size:11px;color:var(--text-muted);font-weight:normal">(Optional)</span></label>
                            <input type="text" name="Gstin" id="supplier_Gstin" class="fg-control text-uppercase" maxlength="15" placeholder="27AAAAA0000A1Z5 (Optional)" oninput="this.value = this.value.toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 15);" />
                            <div style="font-size:10px;color:var(--text-muted);margin-top:2px">Optional 15-digit alphanumeric GSTIN.</div>
                        </div>
                        <div class="col-6">
                            <label class="fg-label">Payment Terms</label>
                            <select name="PaymentTerms" id="supplier_PaymentTerms" class="fg-control">
                                <option value="Net 15">Net 15 Days</option>
                                <option value="Net 30" selected>Net 30 Days</option>
                                <option value="Net 60">Net 60 Days</option>
                                <option value="Advance">Advance Payment Only</option>
                                <option value="COD">Cash On Delivery (COD)</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="fg-label">Portal Account Password <span id="sup_pwd_req_star" class="req">*</span></label>
                            <div class="position-relative">
                                <input type="password" name="PasswordHash" id="supplier_Password" class="fg-control" style="padding-right:40px" placeholder="Set portal password" oninput="evaluateSupplierModalPolicy(this.value)" />
                                <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y text-muted p-2" onclick="toggleModalPassword('supplier_Password', this)" style="border:none;background:none;text-decoration:none;">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <div style="font-size:10px;color:var(--text-muted);margin-top:2px" id="sup_pwd_hint">Required for new supplier account.</div>
                        </div>
                        <div class="col-6">
                            <label class="fg-label">Confirm Password <span id="sup_conf_req_star" class="req">*</span></label>
                            <div class="position-relative">
                                <input type="password" name="confirmPassword" id="supplier_ConfirmPassword" class="fg-control" style="padding-right:40px" placeholder="Repeat portal password" oninput="evaluateSupplierModalMatch()" />
                                <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y text-muted p-2" onclick="toggleModalPassword('supplier_ConfirmPassword', this)" style="border:none;background:none;text-decoration:none;">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <div class="text-danger small mt-1" id="sup_pwd_match_err"></div>
                        </div>
                    </div>

                    <!-- Password Policy Checklist inside Add Supplier modal -->
                    <div id="sup_pwd_policy_box" class="p-3 mb-3 rounded" style="background:var(--bg);border:1px solid var(--border);font-size:12px">
                        <div style="font-weight:700;color:var(--text-muted);margin-bottom:6px;text-transform:uppercase;font-size:11px">
                            <i class="bi bi-shield-lock text-primary me-1"></i>Password must contain:
                        </div>
                        <div id="sup-req-len" style="color:var(--text-muted);margin-bottom:2px">
                            <i class="bi bi-circle me-1" id="sup-icon-len"></i> Minimum 8 characters
                        </div>
                        <div id="sup-req-upper" style="color:var(--text-muted);margin-bottom:2px">
                            <i class="bi bi-circle me-1" id="sup-icon-upper"></i> One uppercase letter (A-Z)
                        </div>
                        <div id="sup-req-lower" style="color:var(--text-muted);margin-bottom:2px">
                            <i class="bi bi-circle me-1" id="sup-icon-lower"></i> One lowercase letter (a-z)
                        </div>
                        <div id="sup-req-num" style="color:var(--text-muted);margin-bottom:2px">
                            <i class="bi bi-circle me-1" id="sup-icon-num"></i> One number (0-9)
                        </div>
                        <div id="sup-req-spec" style="color:var(--text-muted);margin-bottom:2px">
                            <i class="bi bi-circle me-1" id="sup-icon-spec"></i> One special character (!@@#$%^&*...)
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-12">
                            <label class="fg-label">Account Status</label>
                            <select name="Status" id="supplier_Status" class="fg-control">
                                <option value="Active" selected>Active</option>
                                <option value="Inactive">Inactive / Suspended</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-4">
                            <label class="fg-label">City</label>
                            <input type="text" name="City" id="supplier_City" class="fg-control" placeholder="Mumbai" />
                        </div>
                        <div class="col-4">
                            <label class="fg-label">State</label>
                            <input type="text" name="State" id="supplier_State" class="fg-control" placeholder="Maharashtra" />
                        </div>
                        <div class="col-4">
                            <label class="fg-label">Country</label>
                            <input type="text" name="Country" id="supplier_Country" class="fg-control" value="India" />
                        </div>
                    </div>
                    <div class="fg mb-3">
                        <label class="fg-label">Outstanding Payable (₹)</label>
                        <input type="number" step="0.01" min="0" name="OutstandingPayable" id="supplier_OutstandingPayable" class="fg-control" placeholder="0.00" />
                    </div>
                    <div class="fg mb-0">
                        <label class="fg-label">Office / Warehouse Address</label>
                        <textarea name="Address" id="supplier_Address" rows="2" class="fg-control" placeholder="Office / Warehouse street address"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top" style="border-color:var(--border)!important">
                    <button type="button" class="btn-d btn-outline" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-d btn-primary">
                        <i class="bi bi-check2-circle me-1"></i> Save Supplier Account
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Admin Direct Supplier Password Change -->
<div class="modal fade" id="supplierChangePasswordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background:var(--bg-card);border:1px solid var(--border);border-radius:16px;color:var(--text-primary)">
            <div class="modal-header border-bottom" style="border-color:var(--border)!important">
                <h5 class="modal-title" style="font-weight:700">
                    <i class="bi bi-key me-2" style="color:var(--warning)"></i>Change Supplier Password
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="ChangePassword" method="post" id="supplierChangePasswordForm" onsubmit="return validateDirectSupForm()">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="pwd_SupplierId" />
                <div class="modal-body p-4">
                    <p style="font-size:13px;color:var(--text-muted)" class="mb-3">
                        Setting new login password for supplier: <strong id="pwd_SupplierName" style="color:var(--text-primary)"></strong>
                    </p>

                    <div class="fg mb-3">
                        <label class="fg-label">New Password <span class="req">*</span></label>
                        <div class="position-relative">
                            <input type="password" name="newPassword" id="directSupNewPwd" required class="fg-control" style="padding-right:40px" placeholder="Enter new password" oninput="evaluateDirectSupPolicy(this.value)" />
                            <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y text-muted p-2" onclick="toggleModalPassword('directSupNewPwd', this)" style="border:none;background:none;text-decoration:none;">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Checklist -->
                    <div class="p-3 mb-3 rounded" style="background:var(--bg);border:1px solid var(--border);font-size:12px">
                        <div style="font-weight:700;color:var(--text-muted);margin-bottom:6px;text-transform:uppercase;font-size:11px">
                            <i class="bi bi-shield-lock text-primary me-1"></i>Password must satisfy:
                        </div>
                        <div id="dsup-req-len" style="color:var(--text-muted);margin-bottom:2px">
                            <i class="bi bi-circle me-1" id="dsup-icon-len"></i> Minimum 8 characters
                        </div>
                        <div id="dsup-req-upper" style="color:var(--text-muted);margin-bottom:2px">
                            <i class="bi bi-circle me-1" id="dsup-icon-upper"></i> One uppercase letter (A-Z)
                        </div>
                        <div id="dsup-req-lower" style="color:var(--text-muted);margin-bottom:2px">
                            <i class="bi bi-circle me-1" id="dsup-icon-lower"></i> One lowercase letter (a-z)
                        </div>
                        <div id="dsup-req-num" style="color:var(--text-muted);margin-bottom:2px">
                            <i class="bi bi-circle me-1" id="dsup-icon-num"></i> One number (0-9)
                        </div>
                        <div id="dsup-req-spec" style="color:var(--text-muted);margin-bottom:2px">
                            <i class="bi bi-circle me-1" id="dsup-icon-spec"></i> One special character (!@@#$%^&*...)
                        </div>
                    </div>

                    <div class="fg mb-0">
                        <label class="fg-label">Confirm New Password <span class="req">*</span></label>
                        <div class="position-relative">
                            <input type="password" name="confirmPassword" id="directSupConfPwd" required class="fg-control" style="padding-right:40px" placeholder="Repeat new password" oninput="evaluateDirectSupMatch()" />
                            <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y text-muted p-2" onclick="toggleModalPassword('directSupConfPwd', this)" style="border:none;background:none;text-decoration:none;">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <div class="text-danger small mt-1" id="directSupMatchErr"></div>
                    </div>
                </div>
                <div class="modal-footer border-top" style="border-color:var(--border)!important">
                    <button type="button" class="btn-d btn-outline" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-d btn-primary">
                        <i class="bi bi-check2-circle me-1"></i> Update Password
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Hidden Form: Send Supplier Password Reset Email -->
<form id="sendSupplierResetEmailForm" asp-action="SendResetEmail" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="emailResetSupplierId" />
</form>

@section Scripts {
    <script>
        let currentViewSupplier = null;

        function toggleModalPassword(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = btn.querySelector('i');
            if (!input || !icon) return;
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'bi bi-eye';
            }
        }

        function setPolicyRule(rowId, iconId, isMet) {
            const row = document.getElementById(rowId);
            const icon = document.getElementById(iconId);
            if (!row || !icon) return;
            if (isMet) {
                row.style.color = '#34d399';
                row.style.fontWeight = '600';
                icon.className = 'bi bi-check-circle-fill text-success me-1';
            } else {
                row.style.color = 'var(--text-muted)';
                row.style.fontWeight = 'normal';
                icon.className = 'bi bi-circle me-1';
            }
        }

        function evaluateSupplierModalPolicy(val) {
            val = val || '';
            setPolicyRule('sup-req-len', 'sup-icon-len', val.length >= 8);
            setPolicyRule('sup-req-upper', 'sup-icon-upper', /[A-Z]/.test(val));
            setPolicyRule('sup-req-lower', 'sup-icon-lower', /[a-z]/.test(val));
            setPolicyRule('sup-req-num', 'sup-icon-num', /[0-9]/.test(val));
            setPolicyRule('sup-req-spec', 'sup-icon-spec', /[^A-Za-z0-9]/.test(val));
            evaluateSupplierModalMatch();
        }

        function evaluateSupplierModalMatch() {
            const pwd = document.getElementById('supplier_Password')?.value || '';
            const conf = document.getElementById('supplier_ConfirmPassword')?.value || '';
            const err = document.getElementById('sup_pwd_match_err');
            if (conf.length > 0 && pwd !== conf) {
                if (err) err.innerText = 'Passwords do not match.';
            } else {
                if (err) err.innerText = '';
            }
        }

        function validateSaveSupplierForm() {
            const supId = document.getElementById('supplier_Id')?.value;
            const pwd = document.getElementById('supplier_Password')?.value || '';
            const conf = document.getElementById('supplier_ConfirmPassword')?.value || '';

            if (!supId) {
                // Create mode - password is required
                if (!pwd) {
                    alert('Portal account password is required.');
                    return false;
                }
                if (pwd !== conf) {
                    alert('Passwords do not match.');
                    return false;
                }
            } else if (pwd.length > 0) {
                // Edit mode with new password entered
                if (pwd !== conf) {
                    alert('Passwords do not match.');
                    return false;
                }
            }
            return true;
        }

        function evaluateDirectSupPolicy(val) {
            val = val || '';
            setPolicyRule('dsup-req-len', 'dsup-icon-len', val.length >= 8);
            setPolicyRule('dsup-req-upper', 'dsup-icon-upper', /[A-Z]/.test(val));
            setPolicyRule('dsup-req-lower', 'dsup-icon-lower', /[a-z]/.test(val));
            setPolicyRule('dsup-req-num', 'dsup-icon-num', /[0-9]/.test(val));
            setPolicyRule('dsup-req-spec', 'dsup-icon-spec', /[^A-Za-z0-9]/.test(val));
            evaluateDirectSupMatch();
        }

        function evaluateDirectSupMatch() {
            const pwd = document.getElementById('directSupNewPwd')?.value || '';
            const conf = document.getElementById('directSupConfPwd')?.value || '';
            const err = document.getElementById('directSupMatchErr');
            if (conf.length > 0 && pwd !== conf) {
                if (err) err.innerText = 'Passwords do not match.';
            } else {
                if (err) err.innerText = '';
            }
        }

        function validateDirectSupForm() {
            const pwd = document.getElementById('directSupNewPwd')?.value || '';
            const conf = document.getElementById('directSupConfPwd')?.value || '';
            if (pwd !== conf) {
                alert('Passwords do not match.');
                return false;
            }
            return true;
        }

        function openCreateSupplierModal() {
            @if (ViewBag.LimitReached == true)
            {
                <text>
                const limitModalEl = document.getElementById('supplierPackageLimitModal');
                if (limitModalEl) {
                    const limitModal = new bootstrap.Modal(limitModalEl);
                    limitModal.show();
                }
                return;
                </text>
            }
            document.getElementById('saveSupplierModalTitle').innerHTML = '<i class="bi bi-truck me-2" style="color:var(--primary)"></i>Add Supplier Vendor Account';
            document.getElementById('supplier_Id').value = '';
            document.getElementById('supplier_VendorName').value = '';
            document.getElementById('supplier_CompanyName').value = '';
            document.getElementById('supplier_ContactPerson').value = '';
            document.getElementById('supplier_Phone').value = '';
            document.getElementById('supplier_Email').value = '';
            document.getElementById('supplier_Gstin').value = '';
            document.getElementById('supplier_PaymentTerms').value = 'Net 30';

            document.getElementById('supplier_Password').value = '';
            document.getElementById('supplier_Password').setAttribute('required', 'required');
            document.getElementById('supplier_ConfirmPassword').value = '';
            document.getElementById('supplier_ConfirmPassword').setAttribute('required', 'required');
            document.getElementById('sup_pwd_req_star').style.display = 'inline';
            document.getElementById('sup_conf_req_star').style.display = 'inline';
            document.getElementById('sup_pwd_hint').innerText = 'Required for new supplier account.';
            document.getElementById('sup_pwd_match_err').innerText = '';
            evaluateSupplierModalPolicy('');

            document.getElementById('supplier_Status').value = 'Active';
            document.getElementById('supplier_City').value = '';
            document.getElementById('supplier_State').value = '';
            document.getElementById('supplier_Country').value = 'India';
            document.getElementById('supplier_OutstandingPayable').value = '0.00';
            document.getElementById('supplier_Address').value = '';

            const modal = new bootstrap.Modal(document.getElementById('saveSupplierModal'));
            modal.show();
        }

        function openEditSupplierModal(s) {
            document.getElementById('saveSupplierModalTitle').innerHTML = '<i class="bi bi-pencil-square me-2" style="color:var(--primary)"></i>Edit Supplier Profile';
            document.getElementById('supplier_Id').value = s.Id || '';
            document.getElementById('supplier_VendorName').value = s.VendorName || s.CompanyName || '';
            document.getElementById('supplier_CompanyName').value = s.CompanyName || '';
            document.getElementById('supplier_ContactPerson').value = s.ContactPerson || s.contactPerson || '';
            document.getElementById('supplier_Phone').value = s.Phone || '';
            document.getElementById('supplier_Email').value = s.Email || '';
            document.getElementById('supplier_Gstin').value = s.Gstin || '';
            document.getElementById('supplier_PaymentTerms').value = s.PaymentTerms || 'Net 30';

            document.getElementById('supplier_Password').value = '';
            document.getElementById('supplier_Password').removeAttribute('required');
            document.getElementById('supplier_ConfirmPassword').value = '';
            document.getElementById('supplier_ConfirmPassword').removeAttribute('required');
            document.getElementById('sup_pwd_req_star').style.display = 'none';
            document.getElementById('sup_conf_req_star').style.display = 'none';
            document.getElementById('sup_pwd_hint').innerText = 'Leave blank to keep existing password.';
            document.getElementById('sup_pwd_match_err').innerText = '';
            evaluateSupplierModalPolicy('');

            document.getElementById('supplier_Status').value = s.Status || 'Active';
            document.getElementById('supplier_City').value = s.City || '';
            document.getElementById('supplier_State').value = s.State || '';
            document.getElementById('supplier_Country').value = s.Country || 'India';
            document.getElementById('supplier_OutstandingPayable').value = s.OutstandingPayable || 0;
            document.getElementById('supplier_Address').value = s.Address || '';

            // Hide view modal if open
            const viewModalEl = document.getElementById('viewSupplierDetailsModal');
            const viewModal = bootstrap.Modal.getInstance(viewModalEl);
            if (viewModal) viewModal.hide();

            const modal = new bootstrap.Modal(document.getElementById('saveSupplierModal'));
            modal.show();
        }

        function openViewSupplierModal(s) {
            currentViewSupplier = s;
            const vendorName = s.VendorName || s.CompanyName || 'Supplier Details';
            const companyName = s.CompanyName || s.VendorName || '-';

            document.getElementById('v_VendorName').innerText = vendorName;
            document.getElementById('v_CompanyName').innerText = companyName;
            document.getElementById('v_IdVendorName').innerText = vendorName;
            document.getElementById('v_IdCompanyName').innerText = companyName;

            document.getElementById('v_Phone').innerText = s.Phone || '-';
            document.getElementById('v_ContactPerson').innerText = s.ContactPerson || s.contactPerson || s.DisplayContactPerson || '-';
            document.getElementById('v_Email').innerText = s.Email || '-';
            document.getElementById('v_Gstin').innerHTML = s.Gstin ? `<span class="code-pill">${s.Gstin}</span>` : '<span style="color:var(--text-muted)">-</span>';
            document.getElementById('v_PaymentTerms').innerText = s.PaymentTerms || 'Net 30';
            const loc = [s.City, s.State, s.Country].filter(Boolean).join(', ');
            document.getElementById('v_Address').innerText = (s.Address || 'No office address recorded.') + (loc ? ` (${loc})` : '');
            document.getElementById('v_CreatedDate').innerText = s.CreatedDate ? `Added: ${new Date(s.CreatedDate).toLocaleDateString('en-IN')}` : 'Supplier Profile';

            const payable = s.OutstandingPayable || 0;
            if (payable > 0) {
                document.getElementById('v_OutstandingPayable').innerHTML = `<span style="color:var(--warning)">₹${payable.toLocaleString('en-IN', {minimumFractionDigits: 2})}</span>`;
            } else {
                document.getElementById('v_OutstandingPayable').innerHTML = `<span style="color:var(--success)"><i class="bi bi-check-circle me-1"></i>Clear (₹0)</span>`;
            }

            document.getElementById('v_EditBtn').onclick = function() {
                openEditSupplierModal(s);
            };

            const modal = new bootstrap.Modal(document.getElementById('viewSupplierDetailsModal'));
            modal.show();
        }

        function openDirectSupplierPasswordModal(s) {
            document.getElementById('pwd_SupplierId').value = s.Id;
            document.getElementById('pwd_SupplierName').innerText = s.VendorName || s.CompanyName || s.Email;
            document.getElementById('directSupNewPwd').value = '';
            document.getElementById('directSupConfPwd').value = '';
            document.getElementById('directSupMatchErr').innerText = '';
            evaluateDirectSupPolicy('');

            const modal = new bootstrap.Modal(document.getElementById('supplierChangePasswordModal'));
            modal.show();
        }

        function openDirectChangePasswordFromDetails() {
            if (!currentViewSupplier) return;
            const viewModalEl = document.getElementById('viewSupplierDetailsModal');
            const viewModal = bootstrap.Modal.getInstance(viewModalEl);
            if (viewModal) viewModal.hide();
            openDirectSupplierPasswordModal(currentViewSupplier);
        }

        function sendSupplierResetEmail(id, email) {
            if (!email) {
                alert('This supplier does not have a registered email address.');
                return;
            }
            if (confirm(`Send a secure password reset email to ${email}?`)) {
                document.getElementById('emailResetSupplierId').value = id;
                document.getElementById('sendSupplierResetEmailForm').submit();
            }
        }

        function sendSupplierResetEmailFromDetails() {
            if (!currentViewSupplier) return;
            sendSupplierResetEmail(currentViewSupplier.Id, currentViewSupplier.Email);
        }

        document.addEventListener("DOMContentLoaded", function() {
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('openModal') === 'true') {
                openCreateSupplierModal();
            }
        });
    </script>
}
