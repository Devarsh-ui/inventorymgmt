@model IEnumerable<InventoryManagementSystem.Models.Supplier>
@{
    ViewData["Title"] = "Supplier Directory & Procurement";
    var totalCount = ViewBag.TotalCount ?? 0;
    var search = ViewBag.Search as string;
    var terms = ViewBag.Terms as string;
    var payableStatus = ViewBag.PayableStatus as string;
    bool hasActiveFilter = !string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(terms) || !string.IsNullOrEmpty(payableStatus);
}

<!-- Page Header -->
<div class="ph">
    <div>
        <h1 class="ph-title"><i class="bi bi-truck me-2" style="color:var(--primary)"></i>Supplier Management</h1>
        <p class="ph-sub">Vendor directory, procurement stock-in sources, and outstanding payables</p>
    </div>
    <div class="ph-actions">
        <button type="button" class="btn-d @(hasActiveFilter ? "btn-primary" : "btn-outline")" id="supplierFilterToggleBtn" onclick="toggleFilterPanel('supplierFilterPanel', 'supplierFilterToggleBtn')">
            <i class="bi bi-funnel-fill"></i>
            <span>Filters: @(hasActiveFilter ? "ON" : "OFF")</span>
        </button>
        <button type="button" class="btn-d btn-primary" onclick="openCreateSupplierModal()">
            <i class="bi bi-plus-circle"></i> Add New Supplier
        </button>
    </div>
</div>

<!-- Detailed Filter Panel -->
<div class="card-d card-p mb-4" id="supplierFilterPanel" style="display:@(hasActiveFilter ? "block" : "none")">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-lg-5 col-md-6">
            <label class="fg-label"><i class="bi bi-search me-1 text-primary"></i>Search Keywords</label>
            <div class="search-pill">
                <i class="bi bi-search search-pill-icon"></i>
                <input type="text" name="search" value="@search" class="search-pill-input" placeholder="Company, Contact Person, Phone, Email, GSTIN, Address..." />
            </div>
        </div>
        <div class="col-lg-3 col-md-3">
            <label class="fg-label"><i class="bi bi-credit-card me-1 text-info"></i>Payment Terms</label>
            <select name="terms" class="fg-control">
                <option value="">All Payment Terms</option>
                <option value="Net 15" selected="@(terms == "Net 15")">Net 15 Days</option>
                <option value="Net 30" selected="@(terms == "Net 30")">Net 30 Days</option>
                <option value="Net 60" selected="@(terms == "Net 60")">Net 60 Days</option>
                <option value="Advance" selected="@(terms == "Advance")">Advance Payment Only</option>
                <option value="COD" selected="@(terms == "COD")">Cash On Delivery (COD)</option>
            </select>
        </div>
        <div class="col-lg-2 col-md-3">
            <label class="fg-label"><i class="bi bi-wallet2 me-1 text-warning"></i>Payable Status</label>
            <select name="payableStatus" class="fg-control">
                <option value="">All Payable Statuses</option>
                <option value="HasBalance" selected="@(payableStatus == "HasBalance")">Outstanding Balance (> ₹0)</option>
                <option value="Clear" selected="@(payableStatus == "Clear")">Balance Clear (₹0)</option>
            </select>
        </div>
        <div class="col-lg-2 col-md-12 d-flex align-items-center gap-2">
            <button type="submit" class="btn-d btn-primary w-100" title="Apply Filter">
                <i class="bi bi-funnel"></i> Apply
            </button>
            <a href="@Url.Action("Index")" class="btn-d btn-outline" title="Reset All Filters">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<!-- Table Card Container -->
<div class="card-d card-p p-0 overflow-hidden">
    <div class="d-flex align-items-center justify-content-between p-3 border-bottom" style="border-color:var(--border)!important">
        <div class="d-flex align-items-center gap-2">
            <span style="font-weight:700;font-size:14px;color:var(--text-primary)">Supplier Directory</span>
            <span class="badge-d badge-gray">@totalCount Vendors</span>
        </div>
        @if (hasActiveFilter)
        {
            <span style="font-size:12px;color:var(--primary)"><i class="bi bi-filter me-1"></i>Filtered Results</span>
        }
    </div>

    <div class="tbl-scroll">
        <table class="tbl mb-0" id="suppliers-table">
            <thead>
                <tr>
                    <th class="ps-4">Company Name</th>
                    <th>Phone & Email</th>
                    <th>GSTIN</th>
                    <th>Payment Terms</th>
                    <th>Payable Balance</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-truck text-muted d-block mb-2" style="font-size:32px"></i>
                            No suppliers found matching your filter criteria.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var s in Model)
                    {
                        var modalJson = System.Text.Json.JsonSerializer.Serialize(s);
                        <tr>
                            <td class="ps-4">
                                <div style="font-weight:700;color:var(--text-primary)" class="d-flex align-items-center gap-2">
                                    <i class="bi bi-building text-primary" style="font-size:14px"></i>
                                    @s.CompanyName
                                </div>
                                <div style="font-size:11px;color:var(--text-muted)">
                                    Added: @s.CreatedDate.ToString("yyyy-MM-dd")
                                </div>
                            </td>
                            <td>
                                <div style="font-size:13px;color:var(--text-primary)"><i class="bi bi-telephone me-1 text-muted"></i>@s.Phone</div>
                                <div style="font-size:11px;color:var(--text-muted)"><i class="bi bi-envelope me-1"></i>@(string.IsNullOrEmpty(s.Email) ? "-" : s.Email)</div>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(s.Gstin))
                                {
                                    <span class="code-pill">@s.Gstin</span>
                                }
                                else
                                {
                                    <span style="color:var(--text-muted);font-size:12px">-</span>
                                }
                            </td>
                            <td>
                                <span class="badge-d badge-gray">
                                    <i class="bi bi-credit-card me-1"></i>@(string.IsNullOrEmpty(s.PaymentTerms) ? "Net 30" : s.PaymentTerms)
                                </span>
                            </td>
                            <td>
                                @if (s.OutstandingPayable > 0)
                                {
                                    <span class="badge-d badge-warning" style="font-weight:700">
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i>₹@s.OutstandingPayable.ToString("N2")
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-d badge-success">
                                        <i class="bi bi-check-circle-fill me-1"></i>Clear (₹0)
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-flex align-items-center justify-content-end gap-1">
                                    <!-- View Details Button -->
                                    <button type="button" class="btn-d btn-ghost btn-icon-d text-info"
                                            onclick='openViewSupplierModal(@Html.Raw(modalJson))'
                                            title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </button>

                                    <!-- Edit Supplier Button -->
                                    <button type="button" class="btn-d btn-ghost btn-icon-d text-primary"
                                            onclick='openEditSupplierModal(@Html.Raw(modalJson))'
                                            title="Edit Supplier">
                                        <i class="bi bi-pencil"></i>
                                    </button>

                                    <!-- Delete Supplier Button -->
                                    <form method="post" asp-action="Delete" asp-route-id="@s.Id" class="d-inline" onsubmit="return confirm('Are you sure you want to delete supplier \'@s.CompanyName\'?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-d btn-ghost btn-icon-d text-danger" title="Delete Supplier">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination Footer -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="d-flex align-items-center justify-content-between p-3 border-top" style="border-color:var(--border)!important">
            <div style="font-size:12px;color:var(--text-muted)">
                Page @ViewBag.CurrentPage of @ViewBag.TotalPages (@totalCount total suppliers)
            </div>
            <div class="d-flex gap-1">
                @if (ViewBag.CurrentPage > 1)
                {
                    <a href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1, search, terms, payableStatus })" class="btn-d btn-outline btn-sm-d">
                        <i class="bi bi-chevron-left"></i> Previous
                    </a>
                }
                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <a href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1, search, terms, payableStatus })" class="btn-d btn-outline btn-sm-d">
                        Next <i class="bi bi-chevron-right"></i>
                    </a>
                }
            </div>
        </div>
    }
</div>

<!-- Modal: View Supplier Details -->
<div class="modal fade" id="viewSupplierDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="background:var(--bg-card);border:1px solid var(--border);border-radius:16px;color:var(--text-primary)">
            <div class="modal-header border-bottom" style="border-color:var(--border)!important">
                <div class="d-flex align-items-center gap-2">
                    <div style="width:36px;height:36px;border-radius:10px;background:var(--primary-dim);display:flex;align-items:center;justify-content:center;color:var(--primary)">
                        <i class="bi bi-truck" style="font-size:18px"></i>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0" id="v_CompanyName" style="font-weight:700">Supplier Details</h5>
                        <div style="font-size:12px;color:var(--text-muted)" id="v_CreatedDate">Added to Directory</div>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-4 mb-4">
                    <!-- Key Metric Card -->
                    <div class="col-12">
                        <div class="card-d card-p p-3" style="background:var(--bg);border:1px solid var(--border)">
                            <div style="font-size:11px;color:var(--text-muted);text-transform:uppercase;font-weight:700">Outstanding Payable</div>
                            <div style="font-size:20px;font-weight:800;color:var(--warning)" class="mt-1" id="v_OutstandingPayable">₹0.00</div>
                        </div>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="fg mb-2">
                            <label class="fg-label text-muted">Phone Contact</label>
                            <div style="font-size:14px;font-weight:600;color:var(--text-primary)" id="v_Phone">-</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="fg mb-2">
                            <label class="fg-label text-muted">Email Address</label>
                            <div style="font-size:14px;font-weight:600;color:var(--text-primary)" id="v_Email">-</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="fg mb-2">
                            <label class="fg-label text-muted">Vendor GSTIN</label>
                            <div id="v_Gstin"><span class="code-pill">-</span></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="fg mb-2">
                            <label class="fg-label text-muted">Payment Terms</label>
                            <div style="font-size:14px;font-weight:600;color:var(--text-primary)" id="v_PaymentTerms">Net 30</div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="fg mb-0">
                            <label class="fg-label text-muted">Warehouse / Office Address</label>
                            <div class="p-3 rounded" style="background:var(--bg);border:1px solid var(--border);font-size:13px;color:var(--text-primary)" id="v_Address">-</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top" style="border-color:var(--border)!important">
                <button type="button" class="btn-d btn-outline" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn-d btn-primary" id="v_EditBtn">
                    <i class="bi bi-pencil me-1"></i> Edit Supplier Profile
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Save/Edit Supplier -->
<div class="modal fade" id="saveSupplierModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background:var(--bg-card);border:1px solid var(--border);border-radius:16px;color:var(--text-primary)">
            <div class="modal-header border-bottom" style="border-color:var(--border)!important">
                <h5 class="modal-title" id="saveSupplierModalTitle" style="font-weight:700">
                    <i class="bi bi-truck me-2" style="color:var(--primary)"></i>Add Supplier Vendor
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Save" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="supplier_Id" />

                <div class="modal-body p-4">
                    <div class="fg mb-3">
                        <label class="fg-label">Company / Vendor Name <span class="req">*</span></label>
                        <input type="text" name="CompanyName" id="supplier_CompanyName" required class="fg-control" placeholder="e.g. Samsung India Distributors" />
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="fg-label">Phone Number</label>
                            <input type="tel" name="Phone" id="supplier_Phone" class="fg-control" placeholder="9876543210" />
                        </div>
                        <div class="col-6">
                            <label class="fg-label">Email Address</label>
                            <input type="email" name="Email" id="supplier_Email" class="fg-control" placeholder="vendor@supplier.com" />
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="fg-label">Vendor GSTIN</label>
                            <input type="text" name="Gstin" id="supplier_Gstin" class="fg-control text-uppercase" placeholder="27AAAAA0000A1Z5" />
                        </div>
                        <div class="col-6">
                            <label class="fg-label">Payment Terms</label>
                            <select name="PaymentTerms" id="supplier_PaymentTerms" class="fg-control">
                                <option value="Net 15">Net 15 Days</option>
                                <option value="Net 30" selected>Net 30 Days</option>
                                <option value="Net 60">Net 60 Days</option>
                                <option value="Advance">Advance Payment Only</option>
                                <option value="COD">Cash On Delivery (COD)</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="fg-label">Portal Account Password</label>
                            <input type="password" name="PasswordHash" id="supplier_Password" class="fg-control" placeholder="Set supplier login password" />
                            <div style="font-size:10px;color:var(--text-muted)">Leave blank on edit to keep existing password.</div>
                        </div>
                        <div class="col-6">
                            <label class="fg-label">Account Status</label>
                            <select name="Status" id="supplier_Status" class="fg-control">
                                <option value="Active" selected>Active</option>
                                <option value="Inactive">Inactive / Suspended</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-4">
                            <label class="fg-label">City</label>
                            <input type="text" name="City" id="supplier_City" class="fg-control" placeholder="Mumbai" />
                        </div>
                        <div class="col-4">
                            <label class="fg-label">State</label>
                            <input type="text" name="State" id="supplier_State" class="fg-control" placeholder="Maharashtra" />
                        </div>
                        <div class="col-4">
                            <label class="fg-label">Country</label>
                            <input type="text" name="Country" id="supplier_Country" class="fg-control" value="India" />
                        </div>
                    </div>
                    <div class="fg mb-3">
                        <label class="fg-label">Outstanding Payable (₹)</label>
                        <input type="number" step="0.01" min="0" name="OutstandingPayable" id="supplier_OutstandingPayable" class="fg-control" placeholder="0.00" />
                    </div>
                    <div class="fg mb-0">
                        <label class="fg-label">Office / Warehouse Address</label>
                        <textarea name="Address" id="supplier_Address" rows="2" class="fg-control" placeholder="Office / Warehouse street address"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top" style="border-color:var(--border)!important">
                    <button type="button" class="btn-d btn-outline" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-d btn-primary">
                        <i class="bi bi-check2-circle me-1"></i> Save Supplier Account
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openCreateSupplierModal() {
            document.getElementById('saveSupplierModalTitle').innerHTML = '<i class="bi bi-truck me-2" style="color:var(--primary)"></i>Add Supplier Vendor Account';
            document.getElementById('supplier_Id').value = '';
            document.getElementById('supplier_CompanyName').value = '';
            document.getElementById('supplier_Phone').value = '';
            document.getElementById('supplier_Email').value = '';
            document.getElementById('supplier_Gstin').value = '';
            document.getElementById('supplier_PaymentTerms').value = 'Net 30';
            document.getElementById('supplier_Password').value = '';
            document.getElementById('supplier_Password').setAttribute('required', 'required');
            document.getElementById('supplier_Status').value = 'Active';
            document.getElementById('supplier_City').value = '';
            document.getElementById('supplier_State').value = '';
            document.getElementById('supplier_Country').value = 'India';
            document.getElementById('supplier_OutstandingPayable').value = '0.00';
            document.getElementById('supplier_Address').value = '';

            const modal = new bootstrap.Modal(document.getElementById('saveSupplierModal'));
            modal.show();
        }

        function openEditSupplierModal(s) {
            document.getElementById('saveSupplierModalTitle').innerHTML = '<i class="bi bi-pencil-square me-2" style="color:var(--primary)"></i>Edit Supplier Profile';
            document.getElementById('supplier_Id').value = s.Id || '';
            document.getElementById('supplier_CompanyName').value = s.CompanyName || '';
            document.getElementById('supplier_Phone').value = s.Phone || '';
            document.getElementById('supplier_Email').value = s.Email || '';
            document.getElementById('supplier_Gstin').value = s.Gstin || '';
            document.getElementById('supplier_PaymentTerms').value = s.PaymentTerms || 'Net 30';
            document.getElementById('supplier_Password').value = '';
            document.getElementById('supplier_Password').removeAttribute('required');
            document.getElementById('supplier_Status').value = s.Status || 'Active';
            document.getElementById('supplier_City').value = s.City || '';
            document.getElementById('supplier_State').value = s.State || '';
            document.getElementById('supplier_Country').value = s.Country || 'India';
            document.getElementById('supplier_OutstandingPayable').value = s.OutstandingPayable || 0;
            document.getElementById('supplier_Address').value = s.Address || '';

            // Hide view modal if open
            const viewModalEl = document.getElementById('viewSupplierDetailsModal');
            const viewModal = bootstrap.Modal.getInstance(viewModalEl);
            if (viewModal) viewModal.hide();

            const modal = new bootstrap.Modal(document.getElementById('saveSupplierModal'));
            modal.show();
        }

        function openViewSupplierModal(s) {
            document.getElementById('v_CompanyName').innerText = s.CompanyName || 'Supplier Details';
            document.getElementById('v_Phone').innerText = s.Phone || '-';
            document.getElementById('v_Email').innerText = s.Email || '-';
            document.getElementById('v_Gstin').innerHTML = s.Gstin ? `<span class="code-pill">${s.Gstin}</span>` : '<span style="color:var(--text-muted)">-</span>';
            document.getElementById('v_PaymentTerms').innerText = s.PaymentTerms || 'Net 30';
            const loc = [s.City, s.State, s.Country].filter(Boolean).join(', ');
            document.getElementById('v_Address').innerText = (s.Address || 'No office address recorded.') + (loc ? ` (${loc})` : '');
            document.getElementById('v_CreatedDate').innerText = s.CreatedDate ? `Added: ${new Date(s.CreatedDate).toLocaleDateString('en-IN')}` : 'Supplier Profile';

            const payable = s.OutstandingPayable || 0;
            if (payable > 0) {
                document.getElementById('v_OutstandingPayable').innerHTML = `<span style="color:var(--warning)">₹${payable.toLocaleString('en-IN', {minimumFractionDigits: 2})}</span>`;
            } else {
                document.getElementById('v_OutstandingPayable').innerHTML = `<span style="color:var(--success)"><i class="bi bi-check-circle me-1"></i>Clear (₹0)</span>`;
            }

            document.getElementById('v_EditBtn').onclick = function() {
                openEditSupplierModal(s);
            };

            const modal = new bootstrap.Modal(document.getElementById('viewSupplierDetailsModal'));
            modal.show();
        }
    </script>
}
