@model IEnumerable<InventoryManagementSystem.Models.AuditLog>
@{
    var adminUser = ViewBag.AdminUser as InventoryManagementSystem.Models.User;
    ViewData["Title"] = $"Activity Log – {adminUser?.FullName}";
}

<div class="ph">
    <div>
        <h1 class="ph-title"><i class="bi bi-clock-history text-info me-2"></i>Administrator Audit Logs</h1>
        <p class="ph-sub">Activity history for administrator <strong>@adminUser?.FullName</strong> (<code>@@@adminUser?.Username</code>).</p>
    </div>
    <div class="ph-actions">
        <a href="@Url.Action("Index","Admin")" class="btn-d btn-outline">
            <i class="bi bi-arrow-left"></i> Administrator List
        </a>
    </div>
</div>

<div class="tbl-wrap">
    <div class="tbl-toolbar">
        <div class="search-pill" style="max-width:280px">
            <i class="bi bi-search search-pill-icon"></i>
            <input type="search" data-tbl-search="admin-logs-table" class="search-pill-input" placeholder="Search activity logs…">
        </div>
        <div class="ms-auto">
            <span class="tbl-count">@(Model?.Count() ?? 0) log entries</span>
        </div>
    </div>

    <div class="tbl-scroll">
        <table class="tbl" id="admin-logs-table">
            <thead>
                <tr>
                    <th>Timestamp</th>
                    <th>Action</th>
                    <th>Module</th>
                    <th>Target</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td style="color:var(--text-muted);font-size:12px;white-space:nowrap">
                                @log.Timestamp.ToString("MMM d, yyyy HH:mm:ss")
                            </td>
                            <td>
                                <span class="badge-d badge-blue">@log.Action</span>
                            </td>
                            <td class="td-strong">@log.Module</td>
                            <td style="color:var(--text-muted)">@log.Target</td>
                            <td style="font-size:12px;color:var(--text-primary)">@log.Details</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5">
                            <div class="empty-s">
                                <i class="bi bi-journal-x empty-s-icon"></i>
                                <div class="empty-s-title">No activity logs recorded</div>
                                <div class="empty-s-desc">Actions taken by this administrator will be logged here.</div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
