@using InventoryManagementSystem.Models
@inject InventoryManagementSystem.Interfaces.IPlatformSettingsService PlatformSettingsService
@{
    ViewData["Title"] = "My Subscription Plan";
    var tenant = ViewBag.Tenant as Tenant;
    var currentPackage = ViewBag.CurrentPackage as SubscriptionPackage;
    var activeLicense = ViewBag.ActiveLicense as TenantLicense;
    var allFeatures = ViewBag.AllFeatures as List<FeatureDefinition> ?? new List<FeatureDefinition>();
    var platformSettings = ViewBag.PlatformSettings as PlatformSettings ?? await PlatformSettingsService.GetSettingsAsync();
    var supportEmail = !string.IsNullOrWhiteSpace(platformSettings?.ContactEmail) ? platformSettings.ContactEmail : "support@sims.com";
    var supportPhone = !string.IsNullOrWhiteSpace(platformSettings?.ContactPhone) ? platformSettings.ContactPhone : "+91 98765 43210";

    var adminCount = (long)(ViewBag.AdminCount ?? 0);
    var employeeCount = (long)(ViewBag.EmployeeCount ?? 0);
    var productCount = (long)(ViewBag.ProductCount ?? 0);
    var supplierCount = (long)(ViewBag.SupplierCount ?? 0);
    var customerCount = (long)(ViewBag.CustomerCount ?? 0);
    var salesCount = (long)(ViewBag.SalesCount ?? 0);

    var maxAdmins = currentPackage?.MaxAdmins ?? 2;
    var maxEmployees = currentPackage?.MaxEmployees ?? 5;
    var maxProducts = currentPackage?.MaxProducts ?? 1000;
    var maxSuppliers = currentPackage?.MaxSuppliers ?? 50;

    var adminPct = maxAdmins > 0 ? Math.Min(100, (int)Math.Round((double)adminCount / maxAdmins * 100)) : 0;
    var employeePct = maxEmployees > 0 ? Math.Min(100, (int)Math.Round((double)employeeCount / maxEmployees * 100)) : 0;
    var productPct = maxProducts > 0 ? Math.Min(100, (int)Math.Round((double)productCount / maxProducts * 100)) : 0;
    var supplierPct = maxSuppliers > 0 ? Math.Min(100, (int)Math.Round((double)supplierCount / maxSuppliers * 100)) : 0;

    var enabledKeys = currentPackage?.EnabledFeatures ?? new List<string>();

    var expiryDate = activeLicense?.ExpiryDate ?? DateTime.UtcNow;
    var startDate = activeLicense?.StartDate ?? DateTime.UtcNow;
    var isExpired = activeLicense == null || activeLicense.ExpiryDate < DateTime.UtcNow;
    var totalDuration = (expiryDate - startDate).TotalSeconds;
    var elapsedDuration = (DateTime.UtcNow - startDate).TotalSeconds;
    var elapsedPct = totalDuration > 0 ? Math.Min(100, Math.Max(0, (int)Math.Round(elapsedDuration / totalDuration * 100))) : 100;
    var remainingTimeSpan = expiryDate > DateTime.UtcNow ? (expiryDate - DateTime.UtcNow) : TimeSpan.Zero;
    var remainingDays = (int)remainingTimeSpan.TotalDays;
    var remainingHours = remainingTimeSpan.Hours;
    var remainingMinutes = remainingTimeSpan.Minutes;
    var remainingSeconds = remainingTimeSpan.Seconds;

    var licenseStatus = activeLicense?.Status ?? (isExpired ? "Expired" : "Active");
    var statusClass = licenseStatus switch
    {
        "Active" => "bg-success-subtle text-success border-success",
        "Trial" => "bg-warning-subtle text-warning border-warning",
        "Expired" => "bg-danger-subtle text-danger border-danger",
        _ => "bg-secondary-subtle text-secondary border-secondary"
    };
}

<style>
    .plan-hero-card {
        background: linear-gradient(135deg, rgba(30, 41, 59, 0.7) 0%, rgba(15, 23, 42, 0.9) 100%);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        backdrop-filter: blur(12px);
        box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
        position: relative;
        overflow: hidden;
    }
    .plan-hero-card::before {
        content: "";
        position: absolute;
        top: -50%;
        right: -20%;
        width: 350px;
        height: 350px;
        background: radial-gradient(circle, rgba(59, 130, 246, 0.15) 0%, transparent 70%);
        pointer-events: none;
    }
    .countdown-tile {
        background: rgba(15, 23, 42, 0.8);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        padding: 12px 10px;
        text-align: center;
        min-width: 72px;
        box-shadow: inset 0 2px 4px rgba(0,0,0,0.4);
    }
    .countdown-number {
        font-size: 1.85rem;
        font-weight: 800;
        font-family: var(--font-mono, monospace);
        line-height: 1;
        background: linear-gradient(180deg, #ffffff 0%, #94a3b8 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    .countdown-label {
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #94a3b8;
        font-weight: 600;
        margin-top: 4px;
    }
    .quota-card {
        background: rgba(30, 41, 59, 0.5);
        border: 1px solid rgba(255, 255, 255, 0.07);
        border-radius: 14px;
        padding: 18px;
        transition: transform 0.2s ease, border-color 0.2s ease;
    }
    .quota-card:hover {
        transform: translateY(-2px);
        border-color: rgba(59, 130, 246, 0.4);
    }
    .feature-badge-item {
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 10px;
        padding: 10px 14px;
        transition: all 0.2s ease;
    }
    .feature-badge-item:hover {
        background: rgba(30, 41, 59, 0.8);
        border-color: rgba(59, 130, 246, 0.3);
    }
    .feature-badge-item.locked {
        opacity: 0.55;
        background: rgba(15, 23, 42, 0.3);
        border-style: dashed;
    }
    .pulse-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: inline-block;
        animation: pulseAnimation 2s infinite;
    }
    @@keyframes pulseAnimation {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }
    .pulse-dot-warning {
        animation: pulseWarning 2s infinite;
    }
    @@keyframes pulseWarning {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(245, 158, 11, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(245, 158, 11, 0); }
    }
</style>

<div class="ph mb-4">
    <div>
        <h1 class="ph-title"><i class="bi bi-shield-check text-primary me-2"></i>Active Subscription Plan & License</h1>
        <p class="ph-sub">Live subscription status, expiration countdown clock, capacity quotas, and active dashboard modules for <strong>@(tenant?.ShopName ?? "Your Shop")</strong>.</p>
    </div>
    <div class="ph-actions">
        <button type="button" class="btn-d btn-outline btn-sm-d" onclick="window.location.reload()">
            <i class="bi bi-arrow-clockwise"></i> Refresh Status
        </button>
        <a href="@Url.Action("Plans", "Subscription")" class="btn-d btn-primary btn-sm-d">
            <i class="bi bi-rocket-takeoff-fill"></i> Explore All Plans
        </a>
    </div>
</div>

@if (isExpired)
{
    <div class="alert alert-danger bg-danger-subtle text-danger border-danger p-3 rounded-3 mb-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-octagon-fill fs-4"></i>
            <div>
                <strong>Subscription Plan Expired!</strong>
                <div class="fs-7">Your shop's active license expired on @expiryDate.ToIstString("dd MMM yyyy, hh:mm tt IST"). Please renew immediately to avoid service interruptions.</div>
            </div>
        </div>
        <a href="@Url.Action("Plans", "Subscription")" class="btn btn-danger btn-sm fw-bold">Renew / Upgrade Now</a>
    </div>
}
else if (remainingDays <= 5)
{
    <div class="alert alert-warning bg-warning-subtle text-warning border-warning p-3 rounded-3 mb-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-hourglass-bottom fs-4"></i>
            <div>
                <strong>Subscription Expiring Soon!</strong>
                <div class="fs-7">You have only <strong>@remainingDays day(s)</strong> remaining on your active plan. Renew or upgrade now to retain seamless access to all your shop features.</div>
            </div>
        </div>
        <a href="@Url.Action("Plans", "Subscription")" class="btn btn-warning btn-sm fw-bold text-dark">Extend License</a>
    </div>
}

<!-- Hero Plan & Real-Time Countdown Card -->
<div class="plan-hero-card p-4 p-md-5 mb-4">
    <div class="row align-items-center g-4">
        <!-- Left: Plan Overview -->
        <div class="col-lg-6">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge border @statusClass px-2 py-1 fs-7 d-inline-flex align-items-center gap-1">
                    @if (licenseStatus == "Active")
                    {
                        <span class="pulse-dot bg-success"></span>
                    }
                    else if (licenseStatus == "Trial")
                    {
                        <span class="pulse-dot pulse-dot-warning bg-warning"></span>
                    }
                    else
                    {
                        <i class="bi bi-x-circle-fill"></i>
                    }
                    @licenseStatus License
                </span>
                @if (currentPackage?.IsCustom == true)
                {
                    <span class="badge bg-info-subtle text-info border border-info px-2 py-1 fs-7">
                        <i class="bi bi-stars me-1"></i>Dedicated Shop Package
                    </span>
                }
                else
                {
                    <span class="badge bg-primary-subtle text-primary border border-primary px-2 py-1 fs-7">
                        <i class="bi bi-box me-1"></i>Standard SaaS Tier
                    </span>
                }
            </div>

            <h2 class="display-6 fw-bold text-light mb-2">@(currentPackage?.Name ?? "Basic Plan")</h2>
            <p class="text-secondary fs-6 mb-4">@(currentPackage?.Description ?? "Comprehensive retail and mobile inventory management plan.")</p>

            <div class="d-flex flex-wrap gap-4 pt-1 mb-4">
                <div>
                    <div class="text-secondary fs-7 text-uppercase fw-semibold">Monthly Rate</div>
                    <div class="fs-4 fw-bold text-success font-mono">₹@(currentPackage?.MonthlyPrice.ToString("N0") ?? "0")<span class="fs-7 text-secondary fw-normal">/mo</span></div>
                </div>
                <div class="border-start border-secondary border-opacity-25 ps-4">
                    <div class="text-secondary fs-7 text-uppercase fw-semibold">Annual Rate</div>
                    <div class="fs-4 fw-bold text-info font-mono">₹@(currentPackage?.YearlyPrice.ToString("N0") ?? "0")<span class="fs-7 text-secondary fw-normal">/yr</span></div>
                </div>
                <div class="border-start border-secondary border-opacity-25 ps-4">
                    <div class="text-secondary fs-7 text-uppercase fw-semibold">Billing Mode</div>
                    <div class="fs-5 fw-bold text-light">@(currentPackage?.BillingCycle ?? "Monthly")</div>
                </div>
            </div>

            <div class="row g-2 text-secondary fs-7 pt-2 border-top border-secondary border-opacity-25">
                <div class="col-sm-6">
                    <i class="bi bi-calendar-check text-primary me-1"></i>
                    <strong>Activation Date:</strong> @startDate.ToIstString("dd MMM yyyy, hh:mm tt IST")
                </div>
                <div class="col-sm-6">
                    <i class="bi bi-calendar-x text-warning me-1"></i>
                    <strong>Expiry Date:</strong> @expiryDate.ToIstString("dd MMM yyyy, hh:mm tt IST")
                </div>
            </div>
        </div>

        <!-- Right: Live Real-Time Countdown Clock -->
        <div class="col-lg-6">
            <div class="bg-black bg-opacity-40 p-4 rounded-4 border border-white border-opacity-10 text-center">
                <div class="d-flex align-items-center justify-content-between mb-3 text-secondary fs-7">
                    <span><i class="bi bi-clock-history text-primary me-1"></i>REAL-TIME REMAINING VALIDITY</span>
                    <span class="badge @(isExpired ? "bg-danger" : (remainingDays <= 5 ? "bg-warning text-dark" : "bg-success")) px-2 py-1">
                        @(isExpired ? "EXPIRED" : $"{remainingDays} DAYS LEFT")
                    </span>
                </div>

                <!-- Digital Countdown Tiles -->
                <div class="d-flex justify-content-center align-items-center gap-2 gap-sm-3 mb-4">
                    <div class="countdown-tile">
                        <div class="countdown-number" id="cd-days">@remainingDays.ToString("D2")</div>
                        <div class="countdown-label">Days</div>
                    </div>
                    <span class="text-secondary fs-3 fw-bold">:</span>
                    <div class="countdown-tile">
                        <div class="countdown-number" id="cd-hours">@remainingHours.ToString("D2")</div>
                        <div class="countdown-label">Hours</div>
                    </div>
                    <span class="text-secondary fs-3 fw-bold">:</span>
                    <div class="countdown-tile">
                        <div class="countdown-number" id="cd-mins">@remainingMinutes.ToString("D2")</div>
                        <div class="countdown-label">Mins</div>
                    </div>
                    <span class="text-secondary fs-3 fw-bold">:</span>
                    <div class="countdown-tile">
                        <div class="countdown-number" id="cd-secs">@remainingSeconds.ToString("D2")</div>
                        <div class="countdown-label">Secs</div>
                    </div>
                </div>

                <!-- Duration Elapsed Progress Bar -->
                <div class="mb-2">
                    <div class="d-flex justify-content-between text-secondary fs-8 mb-1">
                        <span>Cycle Start: @startDate.ToIstString("dd MMM yyyy")</span>
                        <span>@elapsedPct% Elapsed</span>
                        <span>Expires: @expiryDate.ToIstString("dd MMM yyyy")</span>
                    </div>
                    <div class="progress" style="height: 8px; background-color: rgba(255,255,255,0.1); border-radius: 4px;">
                        <div class="progress-bar @(isExpired ? "bg-danger" : (elapsedPct > 80 ? "bg-warning" : "bg-primary"))"
                             role="progressbar"
                             style="width: @elapsedPct%;"
                             aria-valuenow="@elapsedPct"
                             aria-valuemin="0"
                             aria-valuemax="100">
                        </div>
                    </div>
                </div>

                <div class="pt-3 d-flex justify-content-center gap-2">
                    <a href="@Url.Action("Plans", "Subscription")" class="btn-d btn-primary btn-sm-d">
                        <i class="bi bi-arrow-up-circle"></i> Upgrade / Renew Plan
                    </a>
                    <button type="button" class="btn-d btn-outline btn-sm-d" data-bs-toggle="modal" data-bs-target="#contactSaaSAdminModal">
                        <i class="bi bi-chat-dots"></i> Request Custom Limit
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Resource Capacity & Quota Meters -->
<div class="s-title mb-3">
    <i class="bi bi-pie-chart-fill me-2" style="color:var(--primary)"></i>Resource Capacities & Live Usage Quotas
</div>
<div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3 mb-4">
    <!-- Admins Quota -->
    <div class="col">
        <div class="quota-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-secondary fs-7 fw-semibold">Administrators</span>
                <span class="badge @(adminPct >= 100 ? "bg-danger" : "bg-primary-subtle text-primary")">@adminPct%</span>
            </div>
            <div class="d-flex align-items-baseline gap-2 mb-2">
                <span class="fs-3 fw-bold text-light font-mono">@adminCount</span>
                <span class="text-secondary fs-7">/ @maxAdmins allowed</span>
            </div>
            <div class="progress mb-2" style="height: 6px; background-color: rgba(255,255,255,0.1);">
                <div class="progress-bar @(adminPct >= 100 ? "bg-danger" : (adminPct > 70 ? "bg-warning" : "bg-primary"))"
                     style="width: @adminPct%;"></div>
            </div>
            <div class="fs-8 text-secondary">
                @(maxAdmins - adminCount > 0 ? $"{maxAdmins - adminCount} admin slot(s) remaining" : "Admin limit reached")
            </div>
        </div>
    </div>

    <!-- Staff Quota -->
    <div class="col">
        <div class="quota-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-secondary fs-7 fw-semibold">Staff & Employees</span>
                <span class="badge @(employeePct >= 100 ? "bg-danger" : "bg-success-subtle text-success")">@employeePct%</span>
            </div>
            <div class="d-flex align-items-baseline gap-2 mb-2">
                <span class="fs-3 fw-bold text-light font-mono">@employeeCount</span>
                <span class="text-secondary fs-7">/ @maxEmployees allowed</span>
            </div>
            <div class="progress mb-2" style="height: 6px; background-color: rgba(255,255,255,0.1);">
                <div class="progress-bar @(employeePct >= 100 ? "bg-danger" : (employeePct > 70 ? "bg-warning" : "bg-success"))"
                     style="width: @employeePct%;"></div>
            </div>
            <div class="fs-8 text-secondary">
                @(maxEmployees - employeeCount > 0 ? $"{maxEmployees - employeeCount} employee slot(s) remaining" : "Employee limit reached")
            </div>
        </div>
    </div>

    <!-- Products Quota -->
    <div class="col">
        <div class="quota-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-secondary fs-7 fw-semibold">Products in Inventory</span>
                <span class="badge @(productPct >= 100 ? "bg-danger" : "bg-info-subtle text-info")">@productPct%</span>
            </div>
            <div class="d-flex align-items-baseline gap-2 mb-2">
                <span class="fs-3 fw-bold text-light font-mono">@productCount.ToString("N0")</span>
                <span class="text-secondary fs-7">/ @maxProducts.ToString("N0") allowed</span>
            </div>
            <div class="progress mb-2" style="height: 6px; background-color: rgba(255,255,255,0.1);">
                <div class="progress-bar @(productPct >= 100 ? "bg-danger" : (productPct > 70 ? "bg-warning" : "bg-info"))"
                     style="width: @productPct%;"></div>
            </div>
            <div class="fs-8 text-secondary">
                @(maxProducts - productCount > 0 ? $"{(maxProducts - productCount):N0} product slots available" : "Product limit reached")
            </div>
        </div>
    </div>

    <!-- Suppliers Quota -->
    <div class="col">
        <div class="quota-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-secondary fs-7 fw-semibold">Supplier Directory</span>
                <span class="badge @(supplierPct >= 100 ? "bg-danger" : "bg-warning-subtle text-warning")">@supplierPct%</span>
            </div>
            <div class="d-flex align-items-baseline gap-2 mb-2">
                <span class="fs-3 fw-bold text-light font-mono">@supplierCount</span>
                <span class="text-secondary fs-7">/ @maxSuppliers allowed</span>
            </div>
            <div class="progress mb-2" style="height: 6px; background-color: rgba(255,255,255,0.1);">
                <div class="progress-bar @(supplierPct >= 100 ? "bg-danger" : (supplierPct > 70 ? "bg-warning" : "bg-warning"))"
                     style="width: @supplierPct%;"></div>
            </div>
            <div class="fs-8 text-secondary">
                @(maxSuppliers - supplierCount > 0 ? $"{maxSuppliers - supplierCount} supplier slot(s) available" : "Supplier limit reached")
            </div>
        </div>
    </div>
</div>

<!-- Included Dashboard Modules & Features -->
<div class="card-d card-p-lg mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <h5 class="fw-bold text-light mb-1"><i class="bi bi-grid-3x3-gap-fill text-primary me-2"></i>Enabled Dashboard Modules & Features</h5>
            <p class="text-secondary fs-7 mb-0">The following modules are unlocked according to your current <strong>@(currentPackage?.Name ?? "Plan")</strong> subscription.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-success-subtle text-success border border-success px-2 py-1 fs-7">
                <i class="bi bi-check-circle-fill me-1"></i>@enabledKeys.Count Active Features
            </span>
            <span class="badge bg-secondary-subtle text-secondary border border-secondary px-2 py-1 fs-7">
                <i class="bi bi-lock-fill me-1"></i>@(Math.Max(0, allFeatures.Count - enabledKeys.Count)) Locked
            </span>
        </div>
    </div>

    @{
        var grouped = allFeatures.GroupBy(f => f.Category ?? "GENERAL").OrderBy(g => g.Key);
    }

    <div class="row g-4">
        @foreach (var group in grouped)
        {
            <div class="col-lg-6">
                <div class="p-3 rounded-3 bg-black bg-opacity-25 border border-white border-opacity-5 h-100">
                    <div class="text-uppercase text-secondary fs-8 fw-bold tracking-wider mb-3">
                        <i class="bi bi-folder2-open text-primary me-1"></i>@group.Key
                    </div>
                    <div class="d-flex flex-column gap-2">
                        @foreach (var feat in group.OrderBy(f => f.DisplayOrder))
                        {
                            var isUnlocked = enabledKeys.Contains(feat.FeatureKey);
                            <div class="feature-badge-item @(isUnlocked ? "" : "locked") d-flex align-items-center justify-content-between gap-2">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi @(string.IsNullOrWhiteSpace(feat.Icon) ? "bi-check2-circle" : feat.Icon) @(isUnlocked ? "text-primary" : "text-secondary") fs-5"></i>
                                    <div>
                                        <div class="fw-semibold fs-7 @(isUnlocked ? "text-light" : "text-secondary")">@feat.FeatureName</div>
                                        <div class="fs-8 text-secondary text-truncate" style="max-width: 320px;">@feat.Description</div>
                                    </div>
                                </div>
                                <div>
                                    @if (isUnlocked)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success px-2 py-1 fs-8">
                                            <i class="bi bi-check2"></i> Included
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-dark text-secondary border border-secondary border-opacity-25 px-2 py-1 fs-8">
                                            <i class="bi bi-lock"></i> Locked
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal: Contact SaaS Admin -->
<div class="modal fade" id="contactSaaSAdminModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background:var(--bg-card);border:1px solid var(--border-color);border-radius:16px;">
            <div class="modal-header border-bottom" style="border-color:var(--border-color) !important;">
                <h5 class="modal-title fw-bold text-light">
                    <i class="bi bi-headset text-primary me-2"></i>Contact SaaS Platform Support
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-light">
                <p class="fs-7 text-secondary mb-3">
                    Need tailored capacity limits (extra admins, higher employee quotas, or custom module additions)? Reach out to the platform administration team.
                </p>
                <div class="p-3 rounded-3 bg-dark bg-opacity-50 border border-secondary border-opacity-25 mb-3 fs-7">
                    <div class="mb-2"><strong>Shop Name:</strong> @(tenant?.ShopName ?? "Current Shop")</div>
                    <div class="mb-2"><strong>Shop Code:</strong> <code>@(tenant?.TenantCode ?? "N/A")</code></div>
                    <div class="mb-2"><strong>Active Plan:</strong> @(currentPackage?.Name ?? "Basic Plan")</div>
                    <div><strong>License Expiry:</strong> @expiryDate.ToIstString("dd MMM yyyy")</div>
                </div>
                <div class="d-flex flex-column gap-2">
                    <a href="mailto:@(supportEmail)?subject=Custom%20Limit%20Request%20for%20@(tenant?.ShopName ?? "Shop")&body=Hello%20Platform%20Admin,%0A%0AWe%20would%20like%20to%20request%20a%20package%20upgrade%20or%20custom%20resource%20limit%20for%20our%20shop%20@(tenant?.ShopName).%0A%0AThank%20you!"
                       class="btn-d btn-primary text-center">
                        <i class="bi bi-envelope-at me-1"></i> Email Platform Support (@supportEmail)
                    </a>
                    <a href="tel:@(supportPhone)" class="btn-d btn-outline text-center">
                        <i class="bi bi-telephone me-1"></i> Call Support (@supportPhone)
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Real-Time Digital Countdown Clock
        (function() {
            var expiryTimestamp = new Date('@expiryDate.ToString("yyyy-MM-ddTHH:mm:ssZ")').getTime();

            function updateCountdown() {
                var now = new Date().getTime();
                var distance = expiryTimestamp - now;

                if (distance <= 0) {
                    document.getElementById('cd-days').textContent = '00';
                    document.getElementById('cd-hours').textContent = '00';
                    document.getElementById('cd-mins').textContent = '00';
                    document.getElementById('cd-secs').textContent = '00';
                    return;
                }

                var days = Math.floor(distance / (1000 * 60 * 60 * 24));
                var hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                var minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                var seconds = Math.floor((distance % (1000 * 60)) / 1000);

                document.getElementById('cd-days').textContent = String(days).padStart(2, '0');
                document.getElementById('cd-hours').textContent = String(hours).padStart(2, '0');
                document.getElementById('cd-mins').textContent = String(minutes).padStart(2, '0');
                document.getElementById('cd-secs').textContent = String(seconds).padStart(2, '0');
            }

            updateCountdown();
            setInterval(updateCountdown, 1000);
        })();
    </script>
}
