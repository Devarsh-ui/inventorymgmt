@model List<InventoryManagementSystem.Models.Tenant>
@{
    ViewData["Title"] = "Manage Shops / Tenants";
    var licenses = (Dictionary<string, InventoryManagementSystem.Models.TenantLicense>)ViewBag.Licenses ?? new Dictionary<string, InventoryManagementSystem.Models.TenantLicense>();
    var packages = (Dictionary<string, InventoryManagementSystem.Models.SubscriptionPackage>)ViewBag.Packages ?? new Dictionary<string, InventoryManagementSystem.Models.SubscriptionPackage>();
    var supplierCounts = (Dictionary<string, long>)ViewBag.SupplierCounts ?? new Dictionary<string, long>();
    var employeeCounts = (Dictionary<string, long>)ViewBag.EmployeeCounts ?? new Dictionary<string, long>();
    var productCounts = (Dictionary<string, long>)ViewBag.ProductCounts ?? new Dictionary<string, long>();
    var customerCounts = (Dictionary<string, long>)ViewBag.CustomerCounts ?? new Dictionary<string, long>();
    var salesCounts = (Dictionary<string, long>)ViewBag.SalesCounts ?? new Dictionary<string, long>();
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 font-display fw-bold mb-0">Platform Shops / Tenants</h1>
            <p class="text-muted fs-7 mb-0">Manage isolated mobile shop tenants, package licenses, and subscriptions.</p>
        </div>
        <a href="@Url.Action("CreateTenant", "PlatformAdmin")" class="btn btn-primary shadow-sm"><i class="bi bi-plus-lg me-1"></i> Provision New Shop</a>
    </div>

    <!-- Search & Filters -->
    <div class="glass-card p-3 mb-4">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <input type="text" name="search" class="form-control bg-dark border-secondary text-light" placeholder="Search by Shop Name, Owner, Email, or Code..." value="@Context.Request.Query["search"]">
            </div>
            <div class="col-md-3">
                <select name="statusFilter" class="form-select bg-dark border-secondary text-light">
                    <option value="">All Statuses</option>
                    <option value="Active">Active</option>
                    <option value="Trial">Trial</option>
                    <option value="Suspended">Suspended</option>
                    <option value="Expired">Expired</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search me-1"></i> Filter</button>
            </div>
            <div class="col-md-2">
                <a href="@Url.Action("Tenants", "PlatformAdmin")" class="btn btn-outline-secondary w-100">Reset</a>
            </div>
        </form>
    </div>

    <div class="glass-card p-4">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead>
                    <tr class="text-muted font-mono fs-7">
                        <th>Tenant Code</th>
                        <th>Shop Info</th>
                        <th>Owner & Contact</th>
                        <th>Subscription Package</th>
                        <th>License Status</th>
                        <th>Expiry Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var tenant in Model)
                        {
                            licenses.TryGetValue(tenant.Id, out var license);
                            packages.TryGetValue(tenant.PackageId, out var package);
                            var sCount = supplierCounts.GetValueOrDefault(tenant.Id, 0);
                            var eCount = employeeCounts.GetValueOrDefault(tenant.Id, 0);
                            var pCount = productCounts.GetValueOrDefault(tenant.Id, 0);
                            var cCount = customerCounts.GetValueOrDefault(tenant.Id, 0);
                            var slCount = salesCounts.GetValueOrDefault(tenant.Id, 0);

                            <tr>
                                <td class="font-mono text-info fw-bold">@tenant.TenantCode</td>
                                <td>
                                    <div class="fw-bold">@tenant.ShopName</div>
                                    <small class="text-muted">GST: @(string.IsNullOrEmpty(tenant.GSTIN) ? "N/A" : tenant.GSTIN)</small>
                                </td>
                                <td>
                                    <div>@tenant.OwnerName</div>
                                    <small class="text-muted"><i class="bi bi-envelope me-1"></i>@tenant.ContactEmail</small>
                                </td>
                                <td>
                                    <span class="badge bg-secondary font-mono">@(package != null ? package.Name : "Basic Plan")</span>
                                </td>
                                <td>
                                    <span class="badge @(tenant.Status == "Active" ? "bg-success" : tenant.Status == "Trial" ? "bg-warning" : "bg-danger")">@tenant.Status</span>
                                </td>
                                <td>
                                    @(license != null ? license.ExpiryDate.ToString("MMM dd, yyyy") : "N/A")
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a href="@Url.Action("TenantDetails", "PlatformAdmin", new { id = tenant.Id })" class="btn btn-outline-primary shadow-sm" title="View Shop Details">
                                            <i class="bi bi-eye me-1"></i>View Details
                                        </a>
                                        <form method="post" action="@Url.Action("ToggleTenantStatus", "PlatformAdmin")" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="tenantId" value="@tenant.Id" />
                                            <input type="hidden" name="status" value="@(tenant.Status == "Suspended" ? "Active" : "Suspended")" />
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                            <button type="submit" class="btn btn-outline-@(tenant.Status == "Suspended" ? "success" : "warning") shadow-sm ms-1" 
                                                    title="@(tenant.Status == "Suspended" ? "Activate Shop" : "Suspend Shop")">
                                                <i class="bi @(tenant.Status == "Suspended" ? "bi-play-circle" : "bi-pause-circle") me-1"></i>@(tenant.Status == "Suspended" ? "Activate" : "Suspend")
                                            </button>
                                        </form>
                                        <button type="button" class="btn btn-outline-danger shadow-sm ms-1" onclick="openDeleteShopModal('@tenant.Id', '@tenant.ShopName', '@tenant.TenantCode')" title="Delete Shop">
                                            <i class="bi bi-trash me-1"></i>Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No shops/tenants found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Security Verification Modal for Shop Deletion -->
<div class="modal fade" id="deleteTenantListModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-light border-danger shadow-lg">
            <div class="modal-header border-secondary bg-danger bg-opacity-25 text-danger">
                <h5 class="modal-title font-display fw-bold mb-0">
                    <i class="bi bi-shield-lock-fill me-2"></i>Security Check — Confirm Shop Deletion
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="@Url.Action("DeleteTenant", "PlatformAdmin")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="tenantId" id="delTenantId" value="" />
                <div class="modal-body p-4">
                    <div class="alert alert-danger border-danger text-light mb-3 fs-7">
                        <i class="bi bi-exclamation-triangle-fill text-danger me-2 fs-6"></i>
                        <strong>PERMANENT ACTION:</strong> Deleting <strong id="delTenantName">Shop</strong> (<span id="delTenantCode"></span>) will erase all inventory, sales, products, suppliers, customers, and user accounts.
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-light font-mono fw-bold fs-7">Enter SaaS Super Admin Password:</label>
                        <input type="password" name="adminPassword" class="form-control bg-dark border-danger text-light py-2" required placeholder="Super Admin Password..." autocomplete="current-password" />
                    </div>
                </div>
                <div class="modal-footer border-secondary justify-content-between">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger shadow-sm fw-bold">
                        <i class="bi bi-trash-fill me-1"></i> Confirm & Delete Shop
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openDeleteShopModal(id, name, code) {
            document.getElementById('delTenantId').value = id;
            document.getElementById('delTenantName').innerText = name;
            document.getElementById('delTenantCode').innerText = code;
            const modalEl = document.getElementById('deleteTenantListModal');
            if (modalEl) {
                const bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
                bsModal.show();
            }
        }
    </script>
}

