@{
    ViewData["Title"] = "SaaS Platform Control Center";
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="badge bg-primary px-3 py-2 text-uppercase font-mono fw-bold fs-7 rounded-pill mb-2">Super Admin Platform</span>
            <h1 class="h3 font-display fw-bold mb-0">SaaS Multi-Tenant Management</h1>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("CreateTenant", "PlatformAdmin")" class="btn btn-primary shadow-sm"><i class="bi bi-plus-lg me-1"></i> Provision New Shop</a>
            <a href="@Url.Action("Packages", "PlatformAdmin")" class="btn btn-outline-light"><i class="bi bi-box-seam me-1"></i> Subscription Packages</a>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-xl col-md-4 col-sm-6">
            <div class="glass-card p-4 h-100 border-start border-primary border-4">
                <div class="text-muted text-uppercase fs-7 font-mono fw-bold mb-1">Total Shops</div>
                <div class="fs-2 font-display fw-bold text-light">@ViewBag.TotalTenants</div>
                <div class="text-success fs-7 mt-1"><i class="bi bi-shop me-1"></i> @ViewBag.ActiveTenants Active</div>
            </div>
        </div>
        <div class="col-xl col-md-4 col-sm-6">
            <div class="glass-card p-4 h-100 border-start border-success border-4">
                <div class="text-muted text-uppercase fs-7 font-mono fw-bold mb-1">Monthly MRR</div>
                <div class="fs-2 font-display fw-bold text-success">₹@(((decimal)ViewBag.MRR).ToString("N0"))</div>
                <div class="text-muted fs-7 mt-1">Active subscriptions</div>
            </div>
        </div>
        <div class="col-xl col-md-4 col-sm-6">
            <div class="glass-card p-4 h-100 border-start border-warning border-4">
                <div class="text-muted text-uppercase fs-7 font-mono fw-bold mb-1">Trial Shops</div>
                <div class="fs-2 font-display fw-bold text-warning">@ViewBag.TrialTenants</div>
                <div class="text-muted fs-7 mt-1">Trial Subscriptions</div>
            </div>
        </div>
        <div class="col-xl col-md-4 col-sm-6">
            <div class="glass-card p-4 h-100 border-start border-danger border-4">
                <div class="text-muted text-uppercase fs-7 font-mono fw-bold mb-1">Expired Licenses</div>
                <div class="fs-2 font-display fw-bold text-danger">@ViewBag.ExpiredTenants</div>
                <div class="text-muted fs-7 mt-1">Require Extension</div>
            </div>
        </div>
        <div class="col-xl col-md-4 col-sm-6">
            <a href="@Url.Action("RenewalRequests", "PlatformAdmin")" class="text-decoration-none">
                <div class="glass-card p-4 h-100 border-start border-info border-4 transition-all hover-scale position-relative">
                    @if ((int)(ViewBag.PendingRenewalCount ?? 0) > 0)
                    {
                        <span class="position-absolute top-0 end-0 bg-warning text-dark font-mono fw-bold px-2 py-1 rounded-bottom-start fs-8">
                            ACTION REQUIRED
                        </span>
                    }
                    <div class="text-muted text-uppercase fs-7 font-mono fw-bold mb-1">Renewal Requests</div>
                    <div class="fs-2 font-display fw-bold @((int)(ViewBag.PendingRenewalCount ?? 0) > 0 ? "text-warning" : "text-light")">
                        @(ViewBag.PendingRenewalCount ?? 0)
                    </div>
                    <div class="text-info fs-7 mt-1"><i class="bi bi-clock-history me-1"></i> Pending Review &rarr;</div>
                </div>
            </a>
        </div>
    </div>

    <!-- SHOP LICENSE RENEWAL REQUESTS SECTION -->
    @{
        var renewalRequests = (List<InventoryManagementSystem.Models.LicenseRenewalRequest>)ViewBag.RenewalRequests ?? new List<InventoryManagementSystem.Models.LicenseRenewalRequest>();
        var pendingRequests = renewalRequests.Where(r => r.Status == "Pending").ToList();
    }

    <div class="glass-card p-4 mb-4 border-warning shadow-lg">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-warning text-dark" style="width:32px;height:32px;">
                    <i class="bi bi-bell-fill fs-6"></i>
                </span>
                <h2 class="h5 font-display fw-bold mb-0 text-light">Shop License Renewal Requests</h2>
                @if (pendingRequests.Any())
                {
                    <span class="badge bg-warning text-dark font-mono fw-bold px-2 py-1">
                        @pendingRequests.Count Pending Action
                    </span>
                }
            </div>
            <a href="@Url.Action("RenewalRequests", "PlatformAdmin")" class="btn btn-sm btn-outline-warning">
                View All Requests History (@renewalRequests.Count) &rarr;
            </a>
        </div>

        @if (renewalRequests.Any())
        {
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead>
                        <tr class="text-muted font-mono fs-7 border-secondary">
                            <th>Shop Details</th>
                            <th>Package & Limits Details</th>
                            <th>Duration / Billing</th>
                            <th style="min-width:240px">Shop Message / Notes</th>
                            <th>Requested At</th>
                            <th>Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var req in renewalRequests.Take(5))
                        {
                            <tr class="@(req.Status == "Pending" ? "table-active" : "")">
                                <td>
                                    <div class="fw-bold text-light font-display">@req.ShopName</div>
                                    <span class="badge bg-dark border border-secondary text-info font-mono fs-8">@req.TenantCode</span>
                                    <div class="text-secondary fs-8 mt-1">
                                        <i class="bi bi-person me-1"></i>@req.OwnerName
                                    </div>
                                    <div class="text-secondary fs-8">
                                        <i class="bi bi-telephone me-1"></i>@req.ContactPhone
                                    </div>
                                    <div class="text-secondary fs-8">
                                        <i class="bi bi-envelope me-1"></i>@req.ContactEmail
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-1">
                                        <strong class="@(req.IsCustomPackage ? "text-purple" : "text-light")">@req.PackageName</strong>
                                        @if (req.IsCustomPackage)
                                        {
                                            <span class="badge font-mono" style="background:#7c3aed;color:#fff;font-size:10px">★ Custom</span>
                                        }
                                    </div>
                                    <div class="font-mono text-success fw-bold fs-7">₹@req.PackageMonthlyPrice.ToString("N0")/mo</div>
                                    <small class="text-muted fs-8 d-block font-mono">@req.PackageLimitsSummary</small>
                                </td>
                                <td>
                                    <span class="badge bg-secondary font-mono">@req.RequestedCycle</span>
                                    <div class="font-mono text-warning fs-8 mt-1">@req.RequestedDays Days (@req.RequestedDurationMonths Mo)</div>
                                    <small class="text-info fs-8 d-block"><i class="bi bi-wallet2 me-1"></i>@req.PaymentModePreference</small>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(req.RequestMessage))
                                    {
                                        <div class="p-2 rounded font-mono fs-8 text-light shadow-sm" style="background:rgba(0,0,0,0.4);border-left:3px solid var(--warning);word-break:break-word">
                                            "@req.RequestMessage"
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted fs-8 fst-italic">No message provided.</span>
                                    }
                                </td>
                                <td>
                                    <div class="font-mono fs-8 text-light">@req.RequestedAt.AddMinutes(330).ToString("MMM dd, yyyy")</div>
                                    <small class="text-muted font-mono fs-8">@req.RequestedAt.AddMinutes(330).ToString("hh:mm tt") IST</small>
                                </td>
                                <td>
                                    @if (req.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark font-mono px-2 py-1"><i class="bi bi-clock-history me-1"></i>Pending</span>
                                    }
                                    else if (req.Status == "Approved")
                                    {
                                        <span class="badge bg-success font-mono px-2 py-1"><i class="bi bi-check2-circle me-1"></i>Approved</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger font-mono px-2 py-1"><i class="bi bi-x-circle me-1"></i>Rejected</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex align-items-center justify-content-end gap-2">
                                        <a href="@Url.Action("RenewalRequestDetails", "PlatformAdmin", new { id = req.Id })" class="btn btn-sm btn-outline-warning shadow-sm fw-semibold" title="View Request Details & Reason">
                                            <i class="bi bi-file-text me-1"></i>Details
                                        </a>
                                        <a href="@Url.Action("TenantDetails", "PlatformAdmin", new { id = req.TenantId })" class="btn btn-sm btn-outline-info shadow-sm" title="View Shop Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-4 text-muted">
                <i class="bi bi-check2-circle fs-3 text-success d-block mb-1"></i>
                No pending license renewal requests at this time. All shop licenses are up to date.
            </div>
        }
    </div>

    <!-- Content Sections -->
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="glass-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h5 font-display fw-bold mb-0">Recently Provisioned Shops</h2>
                    <a href="@Url.Action("Tenants", "PlatformAdmin")" class="btn btn-sm btn-link text-decoration-none">View All Shops &rarr;</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0">
                        <thead>
                            <tr class="text-muted font-mono fs-7">
                                <th>Code</th>
                                <th>Shop Name</th>
                                <th>Owner</th>
                                <th>Status</th>
                                <th>Provisioned</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.RecentTenants != null)
                            {
                                foreach (var tenant in (List<InventoryManagementSystem.Models.Tenant>)ViewBag.RecentTenants)
                                {
                                    <tr>
                                        <td class="font-mono text-info fw-bold">@tenant.TenantCode</td>
                                        <td class="fw-bold">@tenant.ShopName</td>
                                        <td>@tenant.OwnerName <br><small class="text-muted">@tenant.ContactEmail</small></td>
                                        <td>
                                            <span class="badge @(tenant.Status == "Active" ? "bg-success" : tenant.Status == "Trial" ? "bg-warning" : "bg-danger")">@tenant.Status</span>
                                        </td>
                                        <td class="fs-7 text-muted">@tenant.CreatedAt.ToString("MMM dd, yyyy")</td>
                                        <td class="text-end">
                                            <a href="@Url.Action("TenantDetails", "PlatformAdmin", new { id = tenant.Id })" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="glass-card p-4">
                <h2 class="h5 font-display fw-bold mb-3">Quick Platform Actions</h2>
                <div class="d-grid gap-2">
                    <a href="@Url.Action("RenewalRequests", "PlatformAdmin")" class="btn btn-outline-warning py-2 text-start px-3"><i class="bi bi-clock-history me-2"></i> All Renewal Requests (@renewalRequests.Count)</a>
                    <a href="@Url.Action("CreateTenant", "PlatformAdmin")" class="btn btn-primary py-2 text-start px-3"><i class="bi bi-building-add me-2"></i> Register New Mobile Shop</a>
                    <a href="@Url.Action("Packages", "PlatformAdmin")" class="btn btn-outline-light py-2 text-start px-3"><i class="bi bi-tags me-2"></i> Manage SaaS Packages</a>
                    <a href="@Url.Action("Payments", "PlatformAdmin")" class="btn btn-outline-light py-2 text-start px-3"><i class="bi bi-receipt-cutoff me-2"></i> SaaS Payment Transactions</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Dashboard Quick Approve Renewal Modal -->
<div class="modal fade" id="dashApproveRenewalModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-light border-success shadow-lg">
            <div class="modal-header border-secondary bg-success bg-opacity-25 text-success">
                <h5 class="modal-title font-display fw-bold mb-0">
                    <i class="bi bi-check-circle-fill me-2"></i>Approve Shop License Renewal
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="@Url.Action("ApproveRenewalRequest", "PlatformAdmin")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="requestId" id="dashAppRequestId" value="" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                <div class="modal-body p-4">
                    <div class="alert alert-success border-success text-light mb-3 fs-7" style="background:rgba(16,185,129,0.12)">
                        Approve renewal for <strong id="dashAppShopName" class="text-success">Shop</strong> with package <strong id="dashAppPackageName" class="text-warning">Package</strong>.
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-light font-mono fw-bold fs-7">Extension Duration (Days):</label>
                        <div class="input-group">
                            <input type="number" name="extensionDays" id="dashAppExtensionDays" class="form-control bg-dark border-secondary text-light font-mono" value="30" min="1" required />
                            <span class="input-group-text bg-dark border-secondary text-muted">Days</span>
                        </div>
                        <div class="d-flex gap-1 mt-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="document.getElementById('dashAppExtensionDays').value=30">30 Days</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="document.getElementById('dashAppExtensionDays').value=90">90 Days</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="document.getElementById('dashAppExtensionDays').value=180">180 Days</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="document.getElementById('dashAppExtensionDays').value=365">1 Year</button>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-light font-mono fw-bold fs-7">Admin Notes / Message (Sent in Email to Shop):</label>
                        <textarea name="adminNotes" class="form-control bg-dark border-secondary text-light" rows="2" placeholder="Payment verified via UPI / Bank, license extended..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-secondary justify-content-between">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success fw-bold shadow">
                        <i class="bi bi-check2-circle me-1"></i> Confirm & Send Approval Email
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Dashboard Quick Reject Renewal Modal -->
<div class="modal fade" id="dashRejectRenewalModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-light border-danger shadow-lg">
            <div class="modal-header border-secondary bg-danger bg-opacity-25 text-danger">
                <h5 class="modal-title font-display fw-bold mb-0">
                    <i class="bi bi-x-circle-fill me-2"></i>Reject Renewal Request
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="@Url.Action("RejectRenewalRequest", "PlatformAdmin")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="requestId" id="dashRejRequestId" value="" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                <div class="modal-body p-4">
                    <p class="text-light fs-7 mb-3">
                        Are you sure you want to reject the renewal request for <strong id="dashRejShopName" class="text-danger">Shop</strong>?
                        An explanation email with your reason will be automatically sent to the shop owner.
                    </p>
                    <div class="mb-3">
                        <label class="form-label text-light font-mono fw-bold fs-7">Rejection Reason / Notes (Sent in Email):</label>
                        <textarea name="adminNotes" class="form-control bg-dark border-secondary text-light" rows="3" placeholder="Provide reason for rejection (e.g. payment not received, duplicate request)..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer border-secondary justify-content-between">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger fw-bold shadow">
                        <i class="bi bi-x-circle me-1"></i> Confirm Rejection & Send Email
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openDashboardApproveModal(id, shopName, pkgName, days) {
            document.getElementById('dashAppRequestId').value = id;
            document.getElementById('dashAppShopName').innerText = shopName;
            document.getElementById('dashAppPackageName').innerText = pkgName;
            document.getElementById('dashAppExtensionDays').value = days > 0 ? days : 30;
            const modalEl = document.getElementById('dashApproveRenewalModal');
            if (modalEl) {
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
            }
        }

        function openDashboardRejectModal(id, shopName) {
            document.getElementById('dashRejRequestId').value = id;
            document.getElementById('dashRejShopName').innerText = shopName;
            const modalEl = document.getElementById('dashRejectRenewalModal');
            if (modalEl) {
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
            }
        }
    </script>
}
