@model IEnumerable<InventoryManagementSystem.Models.SubscriptionPackage>
@{
    ViewData["Title"] = "Super Admin — SaaS Subscription Packages";
    var subscriberCounts = ViewBag.SubscriberCounts as Dictionary<string, int> ?? new Dictionary<string, int>();
}

<div class="ph">
    <div>
        <h1 class="ph-title"><i class="bi bi-box-seam-fill text-warning me-2"></i>SaaS Subscription Packages</h1>
        <p class="ph-sub">Manage pricing tiers, capacity limits, and assign dynamic Shop Admin dashboard modules.</p>
    </div>
    <div class="ph-actions">
        <a href="@Url.Action("CreatePackage", "PlatformAdmin")" class="btn-d btn-primary fw-bold">
            <i class="bi bi-plus-lg me-1"></i> Build New Package
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    @if (Model != null && Model.Any())
    {
        foreach (var pkg in Model.OrderBy(p => p.DisplayOrder))
        {
            var subs = subscriberCounts.ContainsKey(pkg.Id) ? subscriberCounts[pkg.Id] : 0;
            var featCount = (pkg.EnabledFeatures != null && pkg.EnabledFeatures.Any()) ? pkg.EnabledFeatures.Count : (pkg.EnabledModules?.Count ?? 0);

            <div class="col-lg-4 col-md-6">
                <div class="glass-card p-4 h-100 d-flex flex-column justify-content-between position-relative border-secondary @(pkg.IsFeatured ? "border-warning shadow-lg" : "")">
                    @if (pkg.IsFeatured)
                    {
                        <span class="position-absolute top-0 end-0 bg-warning text-dark font-mono fw-bold px-3 py-1 rounded-bottom-start fs-8">
                            FEATURED / POPULAR
                        </span>
                    }

                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <a href="@Url.Action("PackageDetails", "PlatformAdmin", new { id = pkg.Id })" class="text-decoration-none">
                                <h4 class="font-display fw-bold text-light mb-0 text-hover-warning">@pkg.Name</h4>
                            </a>
                            <span class="badge @(pkg.IsActive ? "bg-success" : "bg-danger") font-mono">
                                @(pkg.IsActive ? "Active" : "Inactive")
                            </span>
                        </div>

                        <p class="text-muted fs-7 mb-3 leading-tight">@pkg.Description</p>

                        <div class="mb-3 p-3 bg-dark bg-opacity-50 rounded border border-secondary">
                            <div class="d-flex align-items-baseline gap-1">
                                <span class="fs-3 fw-bold text-success font-mono">₹@pkg.MonthlyPrice</span>
                                <span class="text-muted fs-7">/ month</span>
                                @if (pkg.YearlyPrice > 0)
                                {
                                    <span class="text-info fs-8 ms-auto font-mono">₹@pkg.YearlyPrice/yr</span>
                                }
                            </div>
                            <div class="text-muted fs-8 mt-1">
                                Trial Period: <strong class="text-light">@pkg.TrialDays Days</strong> | Billing: <strong class="text-light">@pkg.BillingCycle</strong>
                            </div>
                        </div>

                        <div class="row g-2 mb-3 fs-7">
                            <div class="col-6">
                                <div class="p-2 border border-secondary rounded bg-dark bg-opacity-25">
                                    <small class="text-muted d-block fs-8 font-mono">ENABLED FEATURES</small>
                                    <strong class="text-warning fs-6"><i class="bi bi-ui-checks me-1"></i>@featCount Features</strong>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2 border border-secondary rounded bg-dark bg-opacity-25">
                                    <small class="text-muted d-block fs-8 font-mono">SUBSCRIBERS</small>
                                    <strong class="text-info fs-6"><i class="bi bi-shop me-1"></i>@subs Shops</strong>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3 fs-7">
                            <small class="text-uppercase text-muted font-mono fw-bold d-block mb-1">Resource Limits:</small>
                            <div class="d-flex flex-wrap gap-2 text-light">
                                <span class="badge bg-dark border border-secondary text-light">
                                    <i class="bi bi-shield-lock text-warning me-1"></i>Admins: @(pkg.MaxAdmins > 0 ? pkg.MaxAdmins.ToString() : "Unlimited")
                                </span>
                                <span class="badge bg-dark border border-secondary text-light">
                                    <i class="bi bi-people text-info me-1"></i>Staff: @(pkg.MaxEmployees > 0 ? pkg.MaxEmployees.ToString() : "Unlimited")
                                </span>
                                <span class="badge bg-dark border border-secondary text-light">
                                    <i class="bi bi-box-seam text-info me-1"></i>Products: @(pkg.MaxProducts > 0 ? pkg.MaxProducts.ToString() : "Unlimited")
                                </span>
                                <span class="badge bg-dark border border-secondary text-light">
                                    <i class="bi bi-truck text-info me-1"></i>Suppliers: @(pkg.MaxSuppliers > 0 ? pkg.MaxSuppliers.ToString() : "Unlimited")
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="border-top border-secondary pt-3 mt-3 d-flex flex-wrap gap-2 justify-content-between align-items-center">
                        <div class="d-flex gap-1">
                            <a href="@Url.Action("PackageDetails", "PlatformAdmin", new { id = pkg.Id })" class="btn btn-sm btn-outline-info" title="View Details & Subscribed Shops">
                                <i class="bi bi-eye me-1"></i> Details
                            </a>
                            <a href="@Url.Action("EditPackage", "PlatformAdmin", new { id = pkg.Id })" class="btn btn-sm btn-outline-warning">
                                <i class="bi bi-pencil me-1"></i> Edit
                            </a>
                            <form asp-action="DuplicatePackage" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@pkg.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-info" title="Duplicate Package">
                                    <i class="bi bi-copy"></i>
                                </button>
                            </form>
                            <form asp-action="TogglePackageActive" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@pkg.Id" />
                                <button type="submit" class="btn btn-sm @(pkg.IsActive ? "btn-outline-secondary" : "btn-outline-success")" title="Toggle Active Status">
                                    <i class="bi @(pkg.IsActive ? "bi-eye-slash" : "bi-eye")"></i>
                                </button>
                            </form>
                        </div>
                        @if (subs == 0)
                        {
                            <form asp-action="DeletePackage" method="post" onsubmit="return confirm('Are you sure you want to delete package \'@pkg.Name\'?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@pkg.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Package">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <p class="text-muted fs-6">No SaaS subscription packages configured yet.</p>
            <a href="@Url.Action("CreatePackage", "PlatformAdmin")" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i> Build Your First Package
            </a>
        </div>
    }
</div>
