@{
    ViewData["Title"] = "Provision New Mobile Shop";
    var packages = (IEnumerable<InventoryManagementSystem.Models.SubscriptionPackage>)ViewBag.Packages;
}

<div class="container-fluid px-4 py-3" style="max-width: 800px;">
    <div class="mb-4">
        <a href="@Url.Action("Tenants", "PlatformAdmin")" class="btn btn-sm btn-outline-secondary mb-2">&larr; Back to Tenants</a>
        <h1 class="h3 font-display fw-bold mb-0">Provision New Mobile Shop Tenant</h1>
        <p class="text-muted fs-7">Creates an isolated shop environment with a default shop admin account.</p>
    </div>

    <div class="glass-card p-4">
        <form method="post" action="@Url.Action("CreateTenant", "PlatformAdmin")">
            @Html.AntiForgeryToken()

            <h5 class="text-primary font-mono fw-bold mb-3">1. Shop Information</h5>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label">Shop Name <span class="text-danger">*</span></label>
                    <input type="text" name="shopName" class="form-control bg-dark border-secondary text-light" placeholder="e.g. Apex Mobile Store" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">GSTIN (Optional)</label>
                    <input type="text" name="gstin" class="form-control bg-dark border-secondary text-light" placeholder="22AAAAA0000A1Z5" />
                </div>
                <div class="col-12">
                    <label class="form-label">Address</label>
                    <input type="text" name="address" class="form-control bg-dark border-secondary text-light" placeholder="Shop Address, City, State" />
                </div>
            </div>

            <h5 class="text-primary font-mono fw-bold mb-3">2. Owner & Admin Credentials</h5>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label">Owner Name <span class="text-danger">*</span></label>
                    <input type="text" name="ownerName" class="form-control bg-dark border-secondary text-light" placeholder="John Doe" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Contact Phone</label>
                    <input type="text" name="phone" class="form-control bg-dark border-secondary text-light" placeholder="+91 9876543210" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Admin Email <span class="text-danger">*</span></label>
                    <input type="email" name="contactEmail" class="form-control bg-dark border-secondary text-light" placeholder="owner@apexmobile.com" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Admin Login Username</label>
                    <input type="text" name="adminUsername" class="form-control bg-dark border-secondary text-light" placeholder="apex_admin" />
                </div>
                <div class="col-12">
                    <label class="form-label">Temporary Password <span class="text-danger">*</span></label>
                    <input type="password" name="temporaryPassword" class="form-control bg-dark border-secondary text-light" placeholder="ShopAdmin@123" required />
                </div>
            </div>

            <h5 class="text-primary font-mono fw-bold mb-3">3. Subscription Plan</h5>
            <div class="row g-3 mb-4">
                <div class="col-md-8">
                    <label class="form-label">Package Plan <span class="text-danger">*</span></label>
                    <select name="packageId" class="form-select bg-dark border-secondary text-light" required>
                        @{
                            var customPkgs = ViewBag.CustomPackages as IEnumerable<InventoryManagementSystem.Models.SubscriptionPackage>;
                        }
                        @if (packages != null && packages.Any())
                        {
                            <optgroup label="Standard Public Packages">
                                @foreach (var p in packages)
                                {
                                    <option value="@p.Id">@p.Name — ₹@p.MonthlyPrice/month (@p.Description)</option>
                                }
                            </optgroup>
                        }
                        @if (customPkgs != null && customPkgs.Any())
                        {
                            <optgroup label="Custom Shop Packages">
                                @foreach (var cp in customPkgs)
                                {
                                    <option value="@cp.Id">★ @cp.Name — ₹@cp.MonthlyPrice/month (@cp.Description)</option>
                                }
                            </optgroup>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">License Duration (Days)</label>
                    <input type="number" name="durationDays" class="form-control bg-dark border-secondary text-light" value="30" min="1" max="365" required />
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 border-top border-secondary pt-3">
                <a href="@Url.Action("Tenants", "PlatformAdmin")" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> Create Tenant & Admin</button>
            </div>
        </form>
    </div>
</div>
