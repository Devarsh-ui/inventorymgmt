@model List<InventoryManagementSystem.Models.LicenseRenewalRequest>
@{
    ViewData["Title"] = "Shop License Renewal Requests";
    var pendingCount = (int)(ViewBag.PendingCount ?? 0);
    var approvedCount = (int)(ViewBag.ApprovedCount ?? 0);
    var rejectedCount = (int)(ViewBag.RejectedCount ?? 0);
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    var currentStatus = ViewBag.CurrentStatus as string;
    var search = ViewBag.Search as string;
}

<div class="container-fluid px-4 py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a href="@Url.Action("Dashboard", "PlatformAdmin")" class="text-secondary text-decoration-none fs-7 font-mono">
                    <i class="bi bi-speedometer2 me-1"></i>SaaS Admin
                </a>
                <span class="text-secondary">/</span>
                <span class="text-warning fs-7 font-mono fw-bold">Renewal Requests</span>
            </div>
            <h1 class="h3 font-display fw-bold mb-0 text-light">Shop License Renewal Requests</h1>
            <p class="text-secondary fs-7 mb-0">Review renewal requests submitted by mobile shop administrators, inspect package details, and extend licenses.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Tenants", "PlatformAdmin")" class="btn btn-outline-light shadow-sm">
                <i class="bi bi-shop me-1"></i> View All Shops
            </a>
            <a href="@Url.Action("Packages", "PlatformAdmin")" class="btn btn-outline-warning shadow-sm">
                <i class="bi bi-tags me-1"></i> Subscription Packages
            </a>
        </div>
    </div>

    <!-- Filter & Stats Bar -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <a href="@Url.Action("RenewalRequests", "PlatformAdmin")" class="text-decoration-none">
                <div class="glass-card p-3 border-start border-4 @(string.IsNullOrEmpty(currentStatus) ? "border-primary" : "border-secondary")">
                    <div class="text-muted text-uppercase fs-8 font-mono fw-bold">All Requests</div>
                    <div class="fs-3 font-display fw-bold text-light">@totalCount</div>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a href="@Url.Action("RenewalRequests", "PlatformAdmin", new { status = "Pending" })" class="text-decoration-none">
                <div class="glass-card p-3 border-start border-4 border-warning @(currentStatus == "Pending" ? "shadow-lg scale-102" : "")">
                    <div class="text-muted text-uppercase fs-8 font-mono fw-bold">Pending Review</div>
                    <div class="fs-3 font-display fw-bold text-warning">@pendingCount</div>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a href="@Url.Action("RenewalRequests", "PlatformAdmin", new { status = "Approved" })" class="text-decoration-none">
                <div class="glass-card p-3 border-start border-4 border-success @(currentStatus == "Approved" ? "shadow-lg scale-102" : "")">
                    <div class="text-muted text-uppercase fs-8 font-mono fw-bold">Approved</div>
                    <div class="fs-3 font-display fw-bold text-success">@approvedCount</div>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a href="@Url.Action("RenewalRequests", "PlatformAdmin", new { status = "Rejected" })" class="text-decoration-none">
                <div class="glass-card p-3 border-start border-4 border-danger @(currentStatus == "Rejected" ? "shadow-lg scale-102" : "")">
                    <div class="text-muted text-uppercase fs-8 font-mono fw-bold">Rejected</div>
                    <div class="fs-3 font-display fw-bold text-danger">@rejectedCount</div>
                </div>
            </a>
        </div>
    </div>

    <!-- Search Form -->
    <div class="glass-card p-3 mb-4">
        <form method="get" class="row g-2 align-items-center">
            @if (!string.IsNullOrEmpty(currentStatus))
            {
                <input type="hidden" name="status" value="@currentStatus" />
            }
            <div class="col-md-8">
                <input type="text" name="search" class="form-control bg-dark border-secondary text-light py-2" placeholder="Search by Shop Name, Tenant Code, Owner, Package, or Message..." value="@search" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 py-2"><i class="bi bi-search me-1"></i> Filter</button>
            </div>
            <div class="col-md-2">
                <a href="@Url.Action("RenewalRequests", "PlatformAdmin")" class="btn btn-outline-secondary w-100 py-2">Reset</a>
            </div>
        </form>
    </div>

    <!-- Requests Table Card -->
    <div class="glass-card p-4">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead>
                    <tr class="text-muted font-mono fs-7 border-secondary">
                        <th>Shop Details</th>
                        <th>Package Requested</th>
                        <th>Duration & Cycle</th>
                        <th style="min-width:240px">Shop Message / Notes</th>
                        <th>Requested On</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var req in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-light font-display">@req.ShopName</div>
                                    <span class="badge bg-dark border border-secondary text-info font-mono fs-8">@req.TenantCode</span>
                                    <div class="text-secondary fs-8 mt-1">
                                        <i class="bi bi-person me-1"></i>@req.OwnerName
                                    </div>
                                    <div class="text-secondary fs-8">
                                        <i class="bi bi-telephone me-1"></i>@req.ContactPhone
                                    </div>
                                    <div class="text-secondary fs-8">
                                        <i class="bi bi-envelope me-1"></i>@req.ContactEmail
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-1">
                                        <span class="fw-bold @(req.IsCustomPackage ? "text-purple" : "text-light")">@req.PackageName</span>
                                        @if (req.IsCustomPackage)
                                        {
                                            <span class="badge font-mono" style="background:#7c3aed;color:#fff;font-size:10px">★ Custom</span>
                                        }
                                    </div>
                                    <div class="font-mono text-success fw-bold fs-7">₹@req.PackageMonthlyPrice.ToString("N0")/mo</div>
                                    <small class="text-muted fs-8 d-block font-mono">@req.PackageLimitsSummary</small>
                                </td>
                                <td>
                                    <span class="badge bg-secondary font-mono">@req.RequestedCycle</span>
                                    <div class="font-mono text-warning fs-8 mt-1">@req.RequestedDays Days (@req.RequestedDurationMonths Month@(req.RequestedDurationMonths > 1 ? "s" : ""))</div>
                                    <small class="text-info fs-8 d-block"><i class="bi bi-wallet2 me-1"></i>@req.PaymentModePreference</small>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(req.RequestMessage))
                                    {
                                        <div class="p-2 rounded font-mono fs-8 text-light" style="background:rgba(0,0,0,0.35);border-left:3px solid var(--warning);word-break:break-word">
                                            "@req.RequestMessage"
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted fs-8 fst-italic">No message provided.</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(req.AdminNotes))
                                    {
                                        <div class="mt-1 text-info fs-8 font-mono">
                                            <i class="bi bi-chat-square-dots me-1"></i>Admin: @req.AdminNotes
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="font-mono fs-8 text-light">@req.RequestedAt.AddMinutes(330).ToString("MMM dd, yyyy")</div>
                                    <small class="text-muted font-mono fs-8">@req.RequestedAt.AddMinutes(330).ToString("hh:mm:ss tt") IST</small>
                                </td>
                                <td>
                                    @if (req.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark font-mono px-2 py-1"><i class="bi bi-clock-history me-1"></i>Pending</span>
                                    }
                                    else if (req.Status == "Approved")
                                    {
                                        <span class="badge bg-success font-mono px-2 py-1"><i class="bi bi-check2-circle me-1"></i>Approved</span>
                                        @if (req.ProcessedAt.HasValue)
                                        {
                                            <div class="text-muted fs-8 font-mono mt-1">@req.ProcessedAt.Value.AddMinutes(330).ToString("MMM dd, hh:mm tt IST")</div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger font-mono px-2 py-1"><i class="bi bi-x-circle me-1"></i>Rejected</span>
                                        @if (req.ProcessedAt.HasValue)
                                        {
                                            <div class="text-muted fs-8 font-mono mt-1">@req.ProcessedAt.Value.AddMinutes(330).ToString("MMM dd, hh:mm tt IST")</div>
                                        }
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex align-items-center justify-content-end gap-2">
                                        <a href="@Url.Action("RenewalRequestDetails", "PlatformAdmin", new { id = req.Id })" class="btn btn-sm btn-outline-warning shadow-sm fw-semibold" title="View Request Details & Reason">
                                            <i class="bi bi-file-text me-1"></i>Details
                                        </a>
                                        <a href="@Url.Action("TenantDetails", "PlatformAdmin", new { id = req.TenantId })" class="btn btn-sm btn-outline-info shadow-sm" title="View Shop Details">
                                            <i class="bi bi-shop"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-2 text-secondary"></i>
                                No license renewal requests found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Approve Renewal Modal -->
<div class="modal fade" id="approveRenewalModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-light border-success shadow-lg">
            <div class="modal-header border-secondary bg-success bg-opacity-25 text-success">
                <h5 class="modal-title font-display fw-bold mb-0">
                    <i class="bi bi-check-circle-fill me-2"></i>Approve License Renewal
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="@Url.Action("ApproveRenewalRequest", "PlatformAdmin")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="requestId" id="appRequestId" value="" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                <div class="modal-body p-4">
                    <div class="alert alert-success border-success text-light mb-3 fs-7" style="background:rgba(16,185,129,0.12)">
                        Approve and activate license renewal for <strong id="appShopName" class="text-success">Shop</strong> with package <strong id="appPackageName" class="text-warning">Package</strong>.
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-light font-mono fw-bold fs-7">Extension Duration (Days):</label>
                        <div class="input-group">
                            <input type="number" name="extensionDays" id="appExtensionDays" class="form-control bg-dark border-secondary text-light font-mono" value="30" min="1" required />
                            <span class="input-group-text bg-dark border-secondary text-muted">Days</span>
                        </div>
                        <div class="d-flex gap-1 mt-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="document.getElementById('appExtensionDays').value=30">30 Days</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="document.getElementById('appExtensionDays').value=90">90 Days</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="document.getElementById('appExtensionDays').value=180">180 Days</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="document.getElementById('appExtensionDays').value=365">1 Year</button>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-light font-mono fw-bold fs-7">Admin Notes / Message (Sent in Email to Shop):</label>
                        <textarea name="adminNotes" class="form-control bg-dark border-secondary text-light" rows="2" placeholder="Payment verified via UPI / Bank, license extended..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-secondary justify-content-between">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success fw-bold shadow">
                        <i class="bi bi-check2-circle me-1"></i> Confirm & Send Approval Email
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Reject Renewal Modal -->
<div class="modal fade" id="rejectRenewalModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-light border-danger shadow-lg">
            <div class="modal-header border-secondary bg-danger bg-opacity-25 text-danger">
                <h5 class="modal-title font-display fw-bold mb-0">
                    <i class="bi bi-x-circle-fill me-2"></i>Reject Renewal Request
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="@Url.Action("RejectRenewalRequest", "PlatformAdmin")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="requestId" id="rejRequestId" value="" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                <div class="modal-body p-4">
                    <p class="text-light fs-7 mb-3">
                        Are you sure you want to reject the renewal request for <strong id="rejShopName" class="text-danger">Shop</strong>?
                        An explanation email with your reason will be automatically sent to the shop owner.
                    </p>
                    <div class="mb-3">
                        <label class="form-label text-light font-mono fw-bold fs-7">Rejection Reason / Notes (Sent in Email):</label>
                        <textarea name="adminNotes" class="form-control bg-dark border-secondary text-light" rows="3" placeholder="Provide reason for rejection (e.g. payment not received, duplicate request)..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer border-secondary justify-content-between">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger fw-bold shadow">
                        <i class="bi bi-x-circle me-1"></i> Confirm Rejection & Send Email
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openApproveModal(id, shopName, pkgName, days) {
            document.getElementById('appRequestId').value = id;
            document.getElementById('appShopName').innerText = shopName;
            document.getElementById('appPackageName').innerText = pkgName;
            document.getElementById('appExtensionDays').value = days > 0 ? days : 30;
            const modalEl = document.getElementById('approveRenewalModal');
            if (modalEl) {
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
            }
        }

        function openRejectModal(id, shopName) {
            document.getElementById('rejRequestId').value = id;
            document.getElementById('rejShopName').innerText = shopName;
            const modalEl = document.getElementById('rejectRenewalModal');
            if (modalEl) {
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
            }
        }
    </script>
}
