@model ProductListViewModel
@{
    ViewData["Title"] = "Products";
}

<!-- Page Header -->
<div class="ph">
    <div>
        <h1 class="ph-title">Products &amp; Specs</h1>
        <p class="ph-sub">Manage your product catalog, pricing and safety stock limits.</p>
    </div>
    <div class="ph-actions d-flex align-items-center gap-2">
        <button type="button" class="btn-d btn-outline" id="productFilterToggleBtn" onclick="toggleFilterPanel('productFilterPanel', 'productFilterToggleBtn')">
            <i class="bi bi-funnel-fill text-primary me-1"></i><span>Filters: ON</span>
        </button>
        @if (User.IsInRole("Admin") || PermissionService.HasPermission(User, "Product", "Create"))
        {
            <a href="@Url.Action("Create","Product")" class="btn-d btn-primary">
                <i class="bi bi-plus-lg"></i> Add Product
            </a>
        }
    </div>
</div>

<!-- Detailed Filter Bar (Toggleable Panel) -->
<div class="card-d card-p mb-4" id="productFilterPanel">
    <form method="get" asp-action="Index" class="row g-3">
        <!-- Row 1: Basic Identifiers -->
        <div class="col-md-3">
            <div class="fg mb-0">
                <label class="fg-label"><i class="bi bi-search me-1"></i>Search Keywords</label>
                <div class="search-pill">
                    <i class="bi bi-search search-pill-icon"></i>
                    <input type="text" name="search" value="@Model.Search" placeholder="Search name, SKU, barcode…" class="search-pill-input">
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="fg mb-0">
                <label class="fg-label"><i class="bi bi-tags me-1"></i>Category</label>
                <select name="categoryId" class="fg-control">
                    <option value="">All Categories</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.Id" selected="@(Model.SelectedCategoryId==cat.Id?"selected":null)">@cat.Name</option>
                    }
                </select>
            </div>
        </div>
        <div class="col-md-3">
            <div class="fg mb-0">
                <label class="fg-label"><i class="bi bi-phone-fill me-1"></i>Brand</label>
                <input type="text" name="brand" value="@Model.Brand" placeholder="e.g. Apple, Samsung" class="fg-control">
            </div>
        </div>
        <div class="col-md-3">
            <div class="fg mb-0">
                <label class="fg-label"><i class="bi bi-phone me-1"></i>Model Name</label>
                <input type="text" name="modelName" value="@Model.ModelName" placeholder="e.g. iPhone 13, S22" class="fg-control">
            </div>
        </div>

        <!-- Row 2: Status & Pricing Ranges -->
        <div class="col-md-3">
            <div class="fg mb-0">
                <label class="fg-label"><i class="bi bi-arrow-repeat me-1 text-primary"></i>Catalog Source / Origin</label>
                <select name="productSource" class="fg-control">
                    <option value="">All Catalog Products (New & Trade-In)</option>
                    <option value="TradeIn" selected="@(Model.ProductSource=="TradeIn"?"selected":null)">🔄 Mobile Trade-In & Exchange Only</option>
                    <option value="New" selected="@(Model.ProductSource=="New"?"selected":null)">📦 New / Standard Inventory Only</option>
                </select>
            </div>
        </div>
        <div class="col-md-3">
            <div class="fg mb-0">
                <label class="fg-label"><i class="bi bi-boxes me-1"></i>Stock Status</label>
                <select name="stockStatus" class="fg-control">
                    <option value="">All Stock Levels</option>
                    <option value="InStock" selected="@(Model.StockStatus=="InStock"?"selected":null)">In Stock (> 0)</option>
                    <option value="OutOfStock" selected="@(Model.StockStatus=="OutOfStock"?"selected":null)">Out of Stock (0)</option>
                </select>
            </div>
        </div>
        <div class="col-md-3">
            <div class="fg mb-0">
                <label class="fg-label"><i class="bi bi-toggle-on me-1"></i>Product Status</label>
                <select name="statusFilter" class="fg-control">
                    <option value="">All Statuses</option>
                    <option value="Active" selected="@(Model.StatusFilter=="Active"?"selected":null)">Active Products</option>
                    <option value="Inactive" selected="@(Model.StatusFilter=="Inactive"?"selected":null)">Inactive Products</option>
                </select>
            </div>
        </div>
        <div class="col-md-3">
            <div class="fg mb-0">
                <label class="fg-label"><i class="bi bi-currency-rupee me-1"></i>Min Sell Price (₹)</label>
                <input type="number" step="100" name="minPrice" value="@Model.MinPrice" placeholder="Min ₹" class="fg-control">
            </div>
        </div>
        <div class="col-md-3">
            <div class="fg mb-0">
                <label class="fg-label"><i class="bi bi-currency-rupee me-1"></i>Max Sell Price (₹)</label>
                <input type="number" step="100" name="maxPrice" value="@Model.MaxPrice" placeholder="Max ₹" class="fg-control">
            </div>
        </div>

        <!-- Row 3: Sorting & Action Buttons -->
        <div class="col-md-3">
            <div class="fg mb-0">
                <label class="fg-label"><i class="bi bi-sort-down me-1"></i>Sort By</label>
                <select name="sortBy" class="fg-control">
                    <option value="">Default Sort (Newest)</option>
                    <option value="Name" selected="@(Model.SortBy=="Name"?"selected":null)">Product Name</option>
                    <option value="Code" selected="@(Model.SortBy=="Code"?"selected":null)">SKU / Code</option>
                    <option value="PurchasePrice" selected="@(Model.SortBy=="PurchasePrice"?"selected":null)">Buy Price</option>
                    <option value="SellingPrice" selected="@(Model.SortBy=="SellingPrice"?"selected":null)">Sell Price</option>
                    <option value="CurrentStock" selected="@(Model.SortBy=="CurrentStock"?"selected":null)">Current Stock</option>
                </select>
            </div>
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <label style="display:flex;align-items:center;gap:6px;font-size:13px;color:var(--text-secondary);cursor:pointer;white-space:nowrap;margin-bottom:8px">
                <input type="checkbox" name="isDescending" value="true"
                       checked="@(Model.IsDescending?"checked":null)"
                       style="width:16px;height:16px;cursor:pointer;accent-color:var(--primary)">
                Descending Order
            </label>
        </div>
        <div class="col-md-6 d-flex align-items-end gap-2">
            <button type="submit" class="btn-d btn-primary flex-grow-1">
                <i class="bi bi-funnel me-1"></i> Apply Detailed Filters
            </button>
            <a href="@Url.Action("Index","Product")" class="btn-d btn-outline" title="Reset All Filters">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
            </a>
        </div>
    </form>
</div>

<!-- Products Table -->
<div class="tbl-wrap">
    <div class="tbl-toolbar">
        <div>
            <span class="tbl-title">All Products</span>
            <span class="tbl-count">@Model.TotalItems total SKUs</span>
        </div>
    </div>

    <div class="tbl-scroll">
        <table class="tbl">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>SKU</th>
                    <th class="d-none d-md-table-cell">Category</th>
                    <th>Buy Price</th>
                    <th>Sell Price</th>
                    <th>Stock</th>
                    <th>Status</th>
                    <th class="col-actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Products != null && Model.Products.Any())
                {
                    @foreach (var p in Model.Products)
                    {
                        var stockClass = p.CurrentStock == 0 ? "badge-red"
                                        : p.CurrentStock <= p.MinimumStock ? "badge-amber"
                                        : "badge-green";
                        var stockLabel = p.CurrentStock == 0 ? "Out of Stock"
                                        : p.CurrentStock <= p.MinimumStock ? "Low Stock"
                                        : "In Stock";

                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    @if (!string.IsNullOrEmpty(p.ImageUrl))
                                    {
                                        <img src="@p.ImageUrl" alt="@p.Name" class="prod-thumb">
                                    }
                                    else
                                    {
                                        <div class="prod-thumb-ph">
                                            <i class="bi bi-box-seam"></i>
                                        </div>
                                    }
                                    <div>
                                        <div class="td-strong">@p.Name</div>
                                        <div style="font-size:11px;color:var(--text-muted)">@p.Barcode</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="code-pill">@p.Code</span>
                            </td>
                            <td class="d-none d-md-table-cell" style="color:var(--text-secondary)">
                                @{
                                    var cat = Model.Categories?.FirstOrDefault(c => c.Id == p.CategoryId);
                                }
                                @(cat?.Name ?? "—")
                            </td>
                            <td style="font-weight:500">₹@p.PurchasePrice.ToString("N2")</td>
                            <td style="font-weight:600;color:var(--primary-text)">₹@p.SellingPrice.ToString("N2")</td>
                            <td>
                                <div style="font-weight:600;font-size:13px;color:var(--text-primary)">@p.CurrentStock</div>
                                <div style="font-size:11px;color:var(--text-muted)">min: @p.MinimumStock</div>
                            </td>
                            <td>
                                <span class="badge-d @stockClass">@stockLabel</span>
                                @if (p.Status == "Inactive")
                                {
                                    <span class="badge-d badge-gray" style="margin-top:2px;display:inline-flex">Inactive</span>
                                }
                            </td>
                            <td class="col-actions">
                                <div class="d-flex align-items-center justify-content-end gap-1">
                                    <a href="@Url.Action("Details","Product",new{id=p.Id})"
                                       class="btn-d btn-ghost btn-icon-d text-info"
                                       title="View Product Details & Specifications">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (User.IsInRole("Admin") || PermissionService.HasPermission(User, "Product", "Edit"))
                                    {
                                        <a href="@Url.Action("Edit","Product",new{id=p.Id})"
                                           class="btn-d btn-ghost btn-icon-d"
                                           title="Edit Product">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }
                                    @if (User.IsInRole("Admin") || PermissionService.HasPermission(User, "Product", "Delete"))
                                    {
                                        <form method="post" asp-action="Delete" asp-route-id="@p.Id" style="margin:0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn-d btn-ghost btn-icon-d"
                                                    style="color:var(--danger)"
                                                    title="Delete Product"
                                                    data-confirm="Delete '@p.Name'? This action cannot be undone.">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8">
                            <div class="empty-s">
                                <i class="bi bi-box-seam empty-s-icon"></i>
                                <div class="empty-s-title">No products found</div>
                                <div class="empty-s-desc">
                                    @if (!string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.SelectedCategoryId))
                                    {
                                        <text>Try adjusting your search or filters.</text>
                                    }
                                    else
                                    {
                                        <text>Get started by adding your first product.</text>
                                    }
                                </div>
                                <a href="@Url.Action("Create","Product")" class="btn-d btn-primary btn-sm-d">
                                    <i class="bi bi-plus-lg"></i> Add Product
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="d-flex align-items-center justify-content-between px-4 py-3 border-top" style="border-color:var(--border)!important">
            <span style="font-size:12px;color:var(--text-muted)">
                Showing @((Model.CurrentPage - 1) * Model.PageSize + 1)–@(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems)) of @Model.TotalItems
            </span>
            <div class="pagi">
                <a href="@Url.Action("Index","Product",new{search=Model.Search,categoryId=Model.SelectedCategoryId,sortBy=Model.SortBy,isDescending=Model.IsDescending,page=Model.CurrentPage-1})"
                   class="pg-btn @(Model.CurrentPage<=1?"disabled":"")">
                    <i class="bi bi-chevron-left"></i>
                </a>
                @for (int p = Math.Max(1,Model.CurrentPage-2); p <= Math.Min(Model.TotalPages,Model.CurrentPage+2); p++)
                {
                    <a href="@Url.Action("Index","Product",new{search=Model.Search,categoryId=Model.SelectedCategoryId,sortBy=Model.SortBy,isDescending=Model.IsDescending,page=p})"
                       class="pg-btn @(p==Model.CurrentPage?"active":"")">@p</a>
                }
                <a href="@Url.Action("Index","Product",new{search=Model.Search,categoryId=Model.SelectedCategoryId,sortBy=Model.SortBy,isDescending=Model.IsDescending,page=Model.CurrentPage+1})"
                   class="pg-btn @(Model.CurrentPage>=Model.TotalPages?"disabled":"")">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </div>
        </div>
    }
</div>
