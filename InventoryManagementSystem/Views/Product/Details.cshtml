@model InventoryManagementSystem.Models.Product
@{
    ViewData["Title"] = $"{Model.Name} - Hardware Specs & Commercial Profile";
    var supplier = ViewBag.Supplier as InventoryManagementSystem.Models.Supplier;
    var categoryName = ViewBag.CategoryName as string ?? "Mobile Device";
    var specs = Model.Specs ?? new InventoryManagementSystem.Models.MobileSpecifications();

    // Effective Cost & Selling prices with complete fallback chain
    var firstVariantCost = Model.Variants?.Select(v => 
        v.PurchasePrice > 0 ? v.PurchasePrice : 
        (v.SupplierPrice > 0 ? v.SupplierPrice : 
        (v.Colors?.FirstOrDefault(c => c.PurchasePrice > 0)?.PurchasePrice ?? 0m))
    ).FirstOrDefault(p => p > 0) ?? 0m;

    decimal effectiveCostPrice = Model.PurchasePrice > 0 
        ? Model.PurchasePrice 
        : (Model.SupplierPrice > 0 
            ? Model.SupplierPrice 
            : (firstVariantCost > 0 ? firstVariantCost : 0m));

    var firstVariantSelling = Model.Variants?.Select(v => 
        v.SellingPrice > 0 ? v.SellingPrice : 
        (v.Colors?.FirstOrDefault(c => c.SellingPrice > 0)?.SellingPrice ?? 0m)
    ).FirstOrDefault(p => p > 0) ?? 0m;

    decimal effectiveSellingPrice = Model.SellingPrice > 0 
        ? Model.SellingPrice 
        : (firstVariantSelling > 0 
            ? firstVariantSelling 
            : (effectiveCostPrice > 0 ? effectiveCostPrice : 0m));

    // Prepare Color Options & Strictly Color-Isolated Photos
    var colorOptions = new List<dynamic>();
    var colorNameSet = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

    if (Model.Variants != null && Model.Variants.Any())
    {
        foreach (var v in Model.Variants)
        {
            if (v.Colors != null && v.Colors.Any())
            {
                foreach (var c in v.Colors)
                {
                    var cName = (c.Name ?? "Standard Color").Trim();
                    if (!colorNameSet.Contains(cName))
                    {
                        colorNameSet.Add(cName);
                        var cImgs = new List<string>();
                        if (!string.IsNullOrEmpty(c.ImageUrl)) cImgs.Add(c.ImageUrl);
                        if (c.ImageUrls != null)
                        {
                            foreach (var u in c.ImageUrls)
                            {
                                if (!string.IsNullOrEmpty(u) && !cImgs.Contains(u)) cImgs.Add(u);
                            }
                        }
                        var stock = c.CurrentStock > 0 ? c.CurrentStock : (c.InitialStock > 0 ? c.InitialStock : 0);
                        var cCost = c.PurchasePrice > 0 
                            ? c.PurchasePrice 
                            : (v.PurchasePrice > 0 
                                ? v.PurchasePrice 
                                : (v.SupplierPrice > 0 
                                    ? v.SupplierPrice 
                                    : effectiveCostPrice));

                        var cSelling = c.SellingPrice > 0 
                            ? c.SellingPrice 
                            : (v.SellingPrice > 0 
                                ? v.SellingPrice 
                                : effectiveSellingPrice);

                        colorOptions.Add(new {
                            name = cName,
                            code = string.IsNullOrEmpty(c.Code) ? "#4f46e5" : c.Code,
                            images = cImgs,
                            stock = stock,
                            costPrice = cCost,
                            sellingPrice = cSelling,
                            price = cCost > 0 ? cCost : cSelling
                        });
                    }
                }
            }
        }
    }

    if (!colorOptions.Any())
    {
        var cName = (string.IsNullOrEmpty(Model.Color) ? "Standard Color" : Model.Color).Trim();
        var pImgs = new List<string>();
        if (!string.IsNullOrEmpty(Model.ImageUrl)) pImgs.Add(Model.ImageUrl);
        if (Model.ImageUrls != null)
        {
            foreach (var u in Model.ImageUrls)
            {
                if (!string.IsNullOrEmpty(u) && !pImgs.Contains(u)) pImgs.Add(u);
            }
        }
        colorOptions.Add(new {
            name = cName,
            code = "#4f46e5",
            images = pImgs,
            stock = Model.CurrentStock,
            price = effectiveCostPrice > 0 ? effectiveCostPrice : effectiveSellingPrice
        });
    }

    var colorOptionsJson = System.Text.Json.JsonSerializer.Serialize(colorOptions);
}

<!-- Page Header & Action Bar -->
<div class="ph">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge-d badge-gray" style="font-size:12px">@Model.Brand</span>
            <span class="badge-d @(Model.Status == "Active" ? "badge-success" : "badge-gray")" style="font-size:12px">@Model.Status</span>
            <span class="code-pill" style="font-size:12px">SKU: @(string.IsNullOrWhiteSpace(Model.Code) ? "—" : Model.Code)</span>
            <span class="badge-d badge-info" style="font-size:12px">Category: @categoryName</span>
        </div>
        <h1 class="ph-title"><i class="bi bi-phone me-2" style="color:var(--primary)"></i>@Model.Name</h1>
        <p class="ph-sub">@Model.DisplayVariant · Color: @(string.IsNullOrEmpty(Model.Color) ? "-" : Model.Color)</p>
    </div>
    <div class="ph-actions">
        <a href="javascript:history.back()" class="btn-d btn-outline">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
        <a href="@Url.Action("Edit", "Product", new { id = Model.Id })" class="btn-d btn-primary">
            <i class="bi bi-pencil me-1"></i> Edit Specifications
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Left Column: Interactive E-Commerce Gallery & Color Selector -->
    <div class="col-lg-5">
        <div class="card-d card-p-lg h-100 style-img-gallery" style="background:var(--bg-card);border:1px solid var(--border)">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="s-title mb-0"><i class="bi bi-images me-2 text-info"></i>Product Photos & Color Swatches</div>
            </div>

            <!-- Main Viewport Image Card -->
            <div class="main-img-wrap text-center p-3 rounded mb-2 position-relative shadow-sm" 
                 onclick="openFullscreenGalleryModal()"
                 title="Click to view full size"
                 style="background:#0f172a;border:1px solid var(--border);height:360px;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;cursor:pointer">
                
                <!-- Main Display Image -->
                <img id="mainDisplayImg" src="" alt="@Model.Name" class="img-fluid rounded" style="max-height:330px;max-width:100%;object-fit:contain;transition:all 0.3s ease" />
                
                <!-- Counter Pill -->
                <span id="det_ImageCounterPill" class="badge-d badge-gray" style="position:absolute;top:12px;left:12px;font-size:11px;background:rgba(0,0,0,0.75);border:1px solid rgba(255,255,255,0.2);display:none">1 / 1</span>
                
                <!-- Active Color Badge -->
                <span id="det_ActiveColorBadge" class="badge-d badge-primary" style="position:absolute;top:12px;right:12px;font-size:11px;display:none"></span>
                
                <!-- Full Size Button -->
                <button type="button" class="btn-d btn-primary position-absolute bottom-0 end-0 m-3 px-3 py-1.5 d-flex align-items-center gap-1 shadow-lg" onclick="event.stopPropagation(); openFullscreenGalleryModal()" style="font-size:12px;font-weight:700;z-index:5">
                    <i class="bi bi-arrows-fullscreen"></i> Full Size
                </button>
            </div>

            <!-- Carousel Controls Bar UNDER THE IMAGE -->
            <div id="det_CarouselBar" class="d-flex align-items-center justify-content-between gap-2 my-3 p-2 rounded" style="background:var(--bg);border:1px solid var(--border)">
                <button type="button" class="btn-d btn-ghost btn-sm d-flex align-items-center gap-1" id="det_BtnPrevImg" onclick="navigateGalleryImg(-1)" style="font-size:12px;font-weight:600;padding:5px 12px">
                    <i class="bi bi-chevron-left"></i> Prev
                </button>

                <div id="det_ThumbStrip" class="d-flex align-items-center justify-content-center gap-2 overflow-auto mx-auto" style="max-height:60px"></div>

                <button type="button" class="btn-d btn-ghost btn-sm d-flex align-items-center gap-1" id="det_BtnNextImg" onclick="navigateGalleryImg(1)" style="font-size:12px;font-weight:600;padding:5px 12px">
                    Next <i class="bi bi-chevron-right"></i>
                </button>
            </div>

            <!-- Color Option Photos Selector -->
            <div id="det_ColorSwatchesSection" class="p-3 rounded mt-3" style="background:var(--bg);border:1px solid var(--border)">
                <label class="fg-label text-muted mb-2 d-block" style="font-size:11px;text-transform:uppercase;letter-spacing:0.5px">
                    <i class="bi bi-palette me-1 text-primary"></i>Color Option Photos (Click swatch to view photos)
                </label>
                <div id="det_ColorSwatchesStrip" class="d-flex flex-wrap gap-2"></div>
            </div>
        </div>
    </div>

    <!-- Right Column: Commercial Metrics, Specifications & Supplier -->
    <div class="col-lg-7">
        <!-- Key Commercial Metrics Cards -->
        <div class="row g-3 mb-4">
            <div class="col-sm-4">
                <div class="card-d card-p text-center" style="background:var(--bg-card);border:1px solid var(--border)">
                    <div style="font-size:11px;color:var(--text-muted)">Current Available Stock</div>
                    <div style="font-size:22px;font-weight:800;color:@(Model.CurrentStock <= Model.MinimumStock ? "var(--warning)" : "var(--text-primary)")" id="det_StockQty">
                        @Model.CurrentStock Units
                    </div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="card-d card-p text-center" style="background:var(--bg-card);border:1px solid var(--border)">
                    <div style="font-size:11px;color:var(--text-muted)">Hardware Configurations</div>
                    <div style="font-size:22px;font-weight:800;color:var(--primary)">
                        @Model.GetEffectiveVariants().Count Variants
                    </div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="card-d card-p text-center" style="background:var(--bg-card);border:1px solid var(--border)">
                    <div style="font-size:11px;color:var(--text-muted)">Color Options Available</div>
                    <div style="font-size:22px;font-weight:800;color:var(--info)">
                        @colorOptions.Count Colors
                    </div>
                </div>
            </div>
        </div>

        <!-- Sellable Hardware Variants & Color Options Box -->
        <div class="card-d card-p-lg mb-4" style="background:var(--bg-card);border:1px solid var(--border)">
            <div class="s-title mb-3"><i class="bi bi-layers me-2 text-primary"></i>Hardware Variants &amp; Color Options</div>
            <div class="row g-3">
                @foreach (var variant in Model.GetEffectiveVariants())
                {
                    var vCost = variant.PurchasePrice > 0 
                        ? variant.PurchasePrice 
                        : (variant.SupplierPrice > 0 
                            ? variant.SupplierPrice 
                            : (variant.Colors != null && variant.Colors.Any(c => c.PurchasePrice > 0) 
                                ? variant.Colors.First(c => c.PurchasePrice > 0).PurchasePrice 
                                : effectiveCostPrice));

                    var vRetail = variant.SellingPrice > 0 
                        ? variant.SellingPrice 
                        : (variant.Colors != null && variant.Colors.Any(c => c.SellingPrice > 0) 
                            ? variant.Colors.First(c => c.SellingPrice > 0).SellingPrice 
                            : (effectiveSellingPrice > 0 ? effectiveSellingPrice : vCost));

                    <div class="col-md-6">
                        <div class="p-3 rounded border bg-dark-subtle h-100" style="background:var(--bg);border:1px solid var(--border)!important">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold text-primary"><i class="bi bi-cpu me-1"></i>@variant.DisplayVariantName</span>
                                <span class="badge bg-secondary" style="font-size:11px">SKU: @(!string.IsNullOrEmpty(variant.Sku) ? variant.Sku : Model.Code)</span>
                            </div>
                            <div class="d-flex flex-column gap-1.5 mt-2 pt-2 border-top" style="border-color:var(--border)!important">
                                <span class="small fw-bold text-muted mb-1">Color Options &amp; Prices:</span>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var color in (variant.Colors ?? new List<InventoryManagementSystem.Models.ProductColor>()))
                                    {
                                        var cCost = color.PurchasePrice > 0 ? color.PurchasePrice : (variant.PurchasePrice > 0 ? variant.PurchasePrice : (variant.SupplierPrice > 0 ? variant.SupplierPrice : effectiveCostPrice));
                                        var cRetail = color.SellingPrice > 0 ? color.SellingPrice : (variant.SellingPrice > 0 ? variant.SellingPrice : (effectiveSellingPrice > 0 ? effectiveSellingPrice : cCost));

                                        <div class="d-flex align-items-center gap-1.5 border px-2.5 py-1 rounded small" style="background:var(--bg-card);border-color:var(--border)!important">
                                            @if (!string.IsNullOrEmpty(color.Code))
                                            {
                                                <span class="d-inline-block rounded-circle border flex-shrink-0" style="width:12px;height:12px;background-color:@color.Code"></span>
                                            }
                                            <span class="fw-bold">@color.Name</span>
                                            <span class="text-muted" style="font-size:11px">
                                                (Cost: <strong class="text-info">₹@cCost.ToString("N2")</strong> | Retail: <strong class="text-success">₹@cRetail.ToString("N2")</strong>)
                                            </span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Supplier Vendor Profile (If Supplier Linked) -->
        @if (supplier != null || !string.IsNullOrEmpty(Model.SupplierName) || !string.IsNullOrEmpty(Model.SupplierVendorName))
        {
            <div class="card-d card-p-lg mb-4" style="background:var(--bg-card);border:1px solid var(--border)">
                <div class="d-flex align-items-center gap-2 mb-3 border-bottom pb-2" style="border-color:var(--border)!important">
                    <div style="width:36px;height:36px;border-radius:10px;background:var(--primary-dim);display:flex;align-items:center;justify-content:center;color:var(--primary);font-size:18px">
                        <i class="bi bi-truck"></i>
                    </div>
                    <div>
                        <h6 class="mb-0 fw-bold" style="color:var(--text-primary)">Supplier &amp; Vendor Profile</h6>
                        <div style="font-size:11px;color:var(--text-muted)">Distributor &amp; Warehouse Directory Info</div>
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-6 col-md-4">
                        <div style="font-size:11px;color:var(--text-muted)">Vendor Name</div>
                        <div style="font-weight:700;color:var(--primary)">@(supplier?.DisplayVendorName ?? Model.DisplaySupplierVendorName)</div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div style="font-size:11px;color:var(--text-muted)">Company Legal Name</div>
                        <div style="font-weight:700">@(supplier?.DisplayCompanyName ?? Model.DisplaySupplierCompanyName)</div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div style="font-size:11px;color:var(--text-muted)">Contact Person</div>
                        <div style="font-weight:700">@(supplier?.DisplayContactPerson ?? "-")</div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div style="font-size:11px;color:var(--text-muted)">Phone Contact</div>
                        <div style="font-weight:700">
                            @if (supplier != null && !string.IsNullOrEmpty(supplier.Phone))
                            {
                                <a href="tel:@supplier.Phone" style="color:var(--primary);text-decoration:none"><i class="bi bi-telephone me-1"></i>@supplier.Phone</a>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div style="font-size:11px;color:var(--text-muted)">Email Address</div>
                        <div style="font-weight:700;word-break:break-all;overflow-wrap:anywhere">
                            @if (supplier != null && !string.IsNullOrEmpty(supplier.Email))
                            {
                                <a href="mailto:@supplier.Email" style="color:var(--primary);text-decoration:none"><i class="bi bi-envelope me-1"></i>@supplier.Email</a>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div style="font-size:11px;color:var(--text-muted)">Vendor GSTIN</div>
                        <div style="font-weight:700;font-family:monospace">@(supplier?.Gstin ?? "Not Registered")</div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div style="font-size:11px;color:var(--text-muted)">Payment Terms</div>
                        <div style="font-weight:700">@(supplier?.PaymentTerms ?? "Net 30 Days")</div>
                    </div>
                    <div class="col-12">
                        <div style="font-size:11px;color:var(--text-muted)">Warehouse Address</div>
                        <div style="font-weight:600">
                            @if (supplier != null && (!string.IsNullOrEmpty(supplier.Address) || !string.IsNullOrEmpty(supplier.City)))
                            {
                                <span>@supplier.Address, @supplier.City, @supplier.State @supplier.Country</span>
                            }
                            else
                            {
                                <span>No warehouse address provided.</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Complete Specification Tabs -->
        <div class="card-d card-p-lg mb-4" style="background:var(--bg-card);border:1px solid var(--border)">
            <ul class="nav nav-tabs border-bottom mb-3" id="specTabs" role="tablist" style="border-color:var(--border)!important">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="tab-overview" data-bs-toggle="tab" data-bs-target="#spec-overview" type="button" role="tab"><i class="bi bi-info-circle me-1"></i> Overview</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-perf" data-bs-toggle="tab" data-bs-target="#spec-perf" type="button" role="tab"><i class="bi bi-cpu me-1"></i> Performance</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-display" data-bs-toggle="tab" data-bs-target="#spec-display" type="button" role="tab"><i class="bi bi-camera me-1"></i> Display & Camera</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-battery" data-bs-toggle="tab" data-bs-target="#spec-battery" type="button" role="tab"><i class="bi bi-battery-charging me-1"></i> Battery & Network</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-os" data-bs-toggle="tab" data-bs-target="#spec-os" type="button" role="tab"><i class="bi bi-shield-check me-1"></i> OS & Features</button>
                </li>
            </ul>

            <div class="tab-content" id="specTabsContent">
                <!-- Tab 1: Overview -->
                <div class="tab-pane fade show active" id="spec-overview" role="tabpanel">
                    <div class="row g-3">
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Brand</div><div style="font-weight:700">@Model.Brand</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Model Name</div><div style="font-weight:700">@Model.ModelName</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Category</div><div style="font-weight:700">@categoryName</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Default Variant</div><div style="font-weight:700">@Model.DisplayVariant</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Default Color</div><div style="font-weight:700">@(string.IsNullOrEmpty(Model.Color) ? "-" : Model.Color)</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Barcode</div><div style="font-weight:700">@(string.IsNullOrEmpty(Model.Barcode) ? "-" : Model.Barcode)</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Warranty Period</div><div style="font-weight:700">@Model.WarrantyDurationMonths Months</div></div>
                    </div>
                </div>

                <!-- Tab 2: Performance -->
                <div class="tab-pane fade" id="spec-perf" role="tabpanel">
                    <div class="row g-3">
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Processor / Chipset</div><div style="font-weight:700">@(string.IsNullOrEmpty(specs.ProcessorName) ? Model.Processor : specs.ProcessorName)</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">CPU Cores & Speed</div><div style="font-weight:700">@(string.IsNullOrEmpty(specs.CpuCores) ? "-" : specs.CpuCores)</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">GPU Graphics</div><div style="font-weight:700">@(string.IsNullOrEmpty(specs.Gpu) ? "-" : specs.Gpu)</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">RAM Type / GB</div><div style="font-weight:700">@(string.IsNullOrEmpty(specs.RamType) ? (!string.IsNullOrEmpty(Model.Ram) ? Model.Ram : "N/A (iOS/Standard)") : specs.RamType)</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Storage Type / GB</div><div style="font-weight:700">@(string.IsNullOrEmpty(specs.StorageType) ? Model.Storage : specs.StorageType)</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Expandable Slot</div><div style="font-weight:700">@(specs.ExpandableStorage ? "Yes Supported" : "No Expandable Slot")</div></div>
                    </div>
                </div>

                <!-- Tab 3: Display & Camera -->
                <div class="tab-pane fade" id="spec-display" role="tabpanel">
                    <div class="row g-3">
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Display Screen Size</div><div style="font-weight:700">@(string.IsNullOrEmpty(specs.DisplaySize) ? Model.DisplaySize : specs.DisplaySize)</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Screen Resolution</div><div style="font-weight:700">@(string.IsNullOrEmpty(specs.Resolution) ? "-" : specs.Resolution)</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Refresh Rate</div><div style="font-weight:700">@(string.IsNullOrEmpty(specs.RefreshRate) ? "-" : specs.RefreshRate)</div></div>
                        <div class="col-6 col-md-6"><div style="font-size:11px;color:var(--text-muted)">Rear Main Camera</div><div style="font-weight:700">@(string.IsNullOrEmpty(specs.PrimaryRearCameraMp) ? "-" : specs.PrimaryRearCameraMp)</div></div>
                        <div class="col-6 col-md-6"><div style="font-size:11px;color:var(--text-muted)">Front Selfie Camera</div><div style="font-weight:700">@(string.IsNullOrEmpty(specs.FrontCameraMp) ? "-" : specs.FrontCameraMp)</div></div>
                    </div>
                </div>

                <!-- Tab 4: Battery & Network -->
                <div class="tab-pane fade" id="spec-battery" role="tabpanel">
                    <div class="row g-3">
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Battery Capacity</div><div style="font-weight:700">@(specs.BatteryCapacityMah > 0 ? $"{specs.BatteryCapacityMah} mAh" : Model.BatteryCapacity)</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Fast Charging Speed</div><div style="font-weight:700">@(string.IsNullOrEmpty(specs.FastChargingWattage) ? "-" : specs.FastChargingWattage)</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Network 5G Support</div><div style="font-weight:700">@(specs.Network5G ? "5G Supported" : "4G / LTE")</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">SIM Card Type</div><div style="font-weight:700">@(string.IsNullOrEmpty(specs.SimType) ? Model.SimType : specs.SimType)</div></div>
                    </div>
                </div>

                <!-- Tab 5: OS & Security -->
                <div class="tab-pane fade" id="spec-os" role="tabpanel">
                    <div class="row g-3">
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Operating System</div><div style="font-weight:700">@(string.IsNullOrEmpty(specs.OperatingSystem) ? Model.OperatingSystem : specs.OperatingSystem)</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Chipset Model</div><div style="font-weight:700">@(string.IsNullOrEmpty(specs.Chipset) ? "-" : specs.Chipset)</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Biometric Security</div><div style="font-weight:700">@(string.IsNullOrEmpty(specs.FingerprintSensor) ? "-" : specs.FingerprintSensor)</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">IP Water & Dust Protection</div><div style="font-weight:700">@(string.IsNullOrEmpty(specs.WaterResistance) ? "-" : specs.WaterResistance)</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">NFC & Bluetooth</div><div style="font-weight:700">@(specs.Nfc ? "NFC Available" : "Bluetooth")</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Audio & Speakers</div><div style="font-weight:700">@(string.IsNullOrEmpty(specs.AudioFeatures) ? "-" : specs.AudioFeatures)</div></div>
                    </div>
                </div>
            </div>

            <hr class="s-divider my-4" />

            <div class="fg mb-0">
                <label class="fg-label text-muted">Complete Description & Technical Notes</label>
                <div class="p-3 rounded" style="background:var(--bg);border:1px solid var(--border);font-size:13px;line-height:1.6;color:var(--text-primary)">
                    @(string.IsNullOrWhiteSpace(Model.Description) ? "No additional product description or notes specified." : Model.Description)
                </div>
            </div>
        </div>
    </div>
</div>

<!-- FULLSCREEN LIGHTBOX MODAL -->
<div class="modal fade" id="fullscreenImageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl p-2 p-md-3">
        <div class="modal-content" style="background:#090d16;border:1px solid var(--border);border-radius:20px;color:#fff;box-shadow:0 25px 50px -12px rgba(0,0,0,0.95);overflow:hidden">
            <div class="modal-header border-bottom border-dark pb-3 px-4 d-flex align-items-center justify-content-between" style="border-color:rgba(255,255,255,0.1)!important">
                <div class="d-flex align-items-center gap-3">
                    <div style="width:38px;height:38px;border-radius:10px;background:var(--primary);display:flex;align-items:center;justify-content:center;color:#fff">
                        <i class="bi bi-arrows-angle-expand fs-5"></i>
                    </div>
                    <div>
                        <h6 class="modal-title mb-0 fw-bold text-white" id="fs_Title">@Model.Name Photo Gallery</h6>
                        <div style="font-size:12px;color:rgba(255,255,255,0.6)" id="fs_Counter">Image 1 of 1</div>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <div class="modal-body p-3 d-flex align-items-center justify-content-center position-relative" style="height:480px;max-height:65vh;background:#0f172a;border-radius:14px;margin:16px;overflow:hidden">
                <!-- Left Carousel Arrow (High Visibility Solid Indigo Circle) -->
                <button type="button" class="btn rounded-circle d-flex align-items-center justify-content-center shadow-lg" id="fs_BtnPrev" onclick="navigateFsGallery(-1)" 
                        style="position:absolute;left:16px;top:50%;transform:translateY(-50%);width:48px;height:48px;background:#4f46e5;border:2px solid #ffffff;color:#ffffff;z-index:99999;box-shadow:0 8px 20px rgba(0,0,0,0.7);cursor:pointer">
                    <i class="bi bi-chevron-left fs-5" style="color:#ffffff;font-weight:800"></i>
                </button>
                
                <!-- Main Image Viewport (Strict Object-Fit Contain) -->
                <div class="text-center w-100 h-100 d-flex align-items-center justify-content-center p-2">
                    <img id="fs_MainImg" src="" alt="Fullsize Product Image" class="img-fluid rounded" style="max-height:440px;max-width:92%;width:auto;height:auto;object-fit:contain!important;display:block;margin:0 auto;filter:drop-shadow(0 10px 20px rgba(0,0,0,0.6))" />
                </div>
                
                <!-- Right Carousel Arrow (High Visibility Solid Indigo Circle) -->
                <button type="button" class="btn rounded-circle d-flex align-items-center justify-content-center shadow-lg" id="fs_BtnNext" onclick="navigateFsGallery(1)" 
                        style="position:absolute;right:16px;top:50%;transform:translateY(-50%);width:48px;height:48px;background:#4f46e5;border:2px solid #ffffff;color:#ffffff;z-index:99999;box-shadow:0 8px 20px rgba(0,0,0,0.7);cursor:pointer">
                    <i class="bi bi-chevron-right fs-5" style="color:#ffffff;font-weight:800"></i>
                </button>
            </div>
            
            <div class="modal-footer border-top border-dark pt-3 pb-3 d-flex flex-column align-items-center justify-content-center" style="border-color:rgba(255,255,255,0.1)!important">
                <div style="font-size:11px;color:rgba(255,255,255,0.5);text-transform:uppercase;letter-spacing:1px" class="mb-2">Click thumbnails below or use Left/Right Arrow Keys</div>
                <div id="fs_ThumbStrip" class="d-flex flex-wrap gap-2 justify-content-center overflow-auto" style="max-height:70px"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const colorOptions = @Html.Raw(colorOptionsJson);
        let activeGalleryImages = [];
        let activeGalleryIndex = 0;
        let activeColorName = '';
        let fsGalleryIndex = 0;

        function initPageGallery() {
            const swatchesStrip = document.getElementById('det_ColorSwatchesStrip');
            const swatchesSection = document.getElementById('det_ColorSwatchesSection');

            if (colorOptions && colorOptions.length > 0) {
                if (swatchesStrip) {
                    swatchesStrip.innerHTML = '';
                    colorOptions.forEach((c, index) => {
                        const btn = document.createElement('button');
                        btn.type = 'button';
                        btn.className = `btn btn-sm d-flex align-items-center gap-1.5 color-swatch-btn ${index === 0 ? 'active-swatch' : ''}`;
                        btn.style.cssText = `font-size:12px;font-weight:600;padding:6px 14px;border-radius:10px;border:1px solid ${index === 0 ? 'var(--primary)' : 'var(--border)'};background:${index === 0 ? 'rgba(79,70,229,0.18)' : 'var(--bg-card)'};color:var(--text-primary);transition:all 0.2s var(--ease)`;
                        btn.innerHTML = `
                            <span style="width:12px;height:12px;border-radius:50%;background:${c.code || '#4f46e5'};display:inline-block;border:1px solid rgba(255,255,255,0.3)"></span>
                            <span>${escapeHtml(c.name)}</span>
                        `;
                        btn.onclick = function() {
                            selectColorOption(c, this);
                        };
                        swatchesStrip.appendChild(btn);
                    });
                }
                selectColorOption(colorOptions[0]);
            } else {
                if (swatchesSection) swatchesSection.style.display = 'none';
            }
        }

        function selectColorOption(c, clickedBtn) {
            activeColorName = c.name;
            activeGalleryImages = c.images || [];
            activeGalleryIndex = 0;

            updateGalleryView(0);

            const activeColorBadge = document.getElementById('det_ActiveColorBadge');
            if (activeColorBadge) {
                activeColorBadge.innerText = c.name;
                activeColorBadge.style.display = 'inline-block';
            }

            if (c.costPrice > 0 || c.price > 0) {
                const costPriceEl = document.getElementById('det_CostPrice');
                const pVal = c.costPrice > 0 ? c.costPrice : c.price;
                if (costPriceEl) costPriceEl.innerText = `₹${pVal.toLocaleString('en-IN', {minimumFractionDigits: 2})}`;
            }

            if (c.sellingPrice > 0) {
                const sellingPriceEl = document.getElementById('det_SellingPrice');
                if (sellingPriceEl) sellingPriceEl.innerText = `₹${c.sellingPrice.toLocaleString('en-IN', {minimumFractionDigits: 2})}`;
            }

            if (c.stock !== undefined && c.stock !== null) {
                const stockEl = document.getElementById('det_StockQty');
                if (stockEl) stockEl.innerText = `${c.stock} Units`;
            }

            const swatchesStrip = document.getElementById('det_ColorSwatchesStrip');
            if (swatchesStrip) {
                swatchesStrip.querySelectorAll('.color-swatch-btn').forEach(btn => {
                    btn.style.borderColor = 'var(--border)';
                    btn.style.background = 'var(--bg-card)';
                });
            }
            if (clickedBtn) {
                clickedBtn.style.borderColor = 'var(--primary)';
                clickedBtn.style.background = 'rgba(79,70,229,0.18)';
            }
        }

        function updateGalleryView(index) {
            const mainImg = document.getElementById('mainDisplayImg');
            const counterPill = document.getElementById('det_ImageCounterPill');
            const btnPrev = document.getElementById('det_BtnPrevImg');
            const btnNext = document.getElementById('det_BtnNextImg');
            const thumbStrip = document.getElementById('det_ThumbStrip');

            const imgs = activeGalleryImages || [];
            if (imgs.length === 0) {
                activeGalleryIndex = 0;
                if (mainImg) {
                    mainImg.src = 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="400" height="300" viewBox="0 0 400 300"><rect width="400" height="300" fill="%230f172a"/><text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" fill="%2364748b" font-family="sans-serif" font-size="15">No Photo Available For This Color</text></svg>';
                }
                if (counterPill) counterPill.style.display = 'none';
                if (btnPrev) btnPrev.style.display = 'none';
                if (btnNext) btnNext.style.display = 'none';
                if (thumbStrip) thumbStrip.innerHTML = '';
                return;
            }

            activeGalleryIndex = Math.max(0, Math.min(index, imgs.length - 1));
            const currentUrl = imgs[activeGalleryIndex];

            if (mainImg) mainImg.src = currentUrl;

            if (counterPill) {
                counterPill.innerText = `${activeGalleryIndex + 1} / ${imgs.length}`;
                counterPill.style.display = 'inline-block';
            }

            if (btnPrev) btnPrev.style.display = imgs.length > 1 ? 'inline-flex' : 'none';
            if (btnNext) btnNext.style.display = imgs.length > 1 ? 'inline-flex' : 'none';

            if (thumbStrip) {
                thumbStrip.innerHTML = '';
                if (imgs.length > 1) {
                    imgs.forEach((imgUrl, i) => {
                        const thumb = document.createElement('img');
                        thumb.src = imgUrl;
                        thumb.className = `rounded thumb-img ${i === activeGalleryIndex ? 'active-thumb' : ''}`;
                        thumb.style.cssText = `width:50px;height:50px;object-fit:cover;cursor:pointer;border:2px solid ${i === activeGalleryIndex ? 'var(--primary)' : 'var(--border)'};border-radius:10px;transition:all 0.2s var(--ease)`;
                        thumb.onclick = function() {
                            updateGalleryView(i);
                        };
                        thumbStrip.appendChild(thumb);
                    });
                }
            }
        }

        function navigateGalleryImg(delta) {
            const imgs = activeGalleryImages || [];
            if (imgs.length <= 1) return;
            let nextIndex = activeGalleryIndex + delta;
            if (nextIndex < 0) nextIndex = imgs.length - 1;
            if (nextIndex >= imgs.length) nextIndex = 0;
            updateGalleryView(nextIndex);
        }

        function openFullscreenGalleryModal() {
            const imgs = activeGalleryImages || [];
            if (imgs.length === 0) return;
            fsGalleryIndex = activeGalleryIndex || 0;

            const titleEl = document.getElementById('fs_Title');
            if (titleEl) {
                const colorStr = activeColorName ? ` (${activeColorName})` : '';
                titleEl.innerText = `@Model.Name${colorStr}`;
            }

            renderFsGalleryView(fsGalleryIndex);

            const modalEl = document.getElementById('fullscreenImageModal');
            if (modalEl) {
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
            }
        }

        function renderFsGalleryView(index) {
            const imgs = activeGalleryImages || [];
            if (imgs.length === 0) return;
            fsGalleryIndex = (index + imgs.length) % imgs.length;

            const fsMainImg = document.getElementById('fs_MainImg');
            if (fsMainImg) fsMainImg.src = imgs[fsGalleryIndex];

            const fsCounter = document.getElementById('fs_Counter');
            if (fsCounter) fsCounter.innerText = `Image ${fsGalleryIndex + 1} of ${imgs.length}`;

            const fsPrev = document.getElementById('fs_BtnPrev');
            const fsNext = document.getElementById('fs_BtnNext');
            if (fsPrev) fsPrev.style.display = imgs.length > 1 ? 'flex' : 'none';
            if (fsNext) fsNext.style.display = imgs.length > 1 ? 'flex' : 'none';

            const fsThumbStrip = document.getElementById('fs_ThumbStrip');
            if (fsThumbStrip) {
                fsThumbStrip.innerHTML = '';
                if (imgs.length > 1) {
                    imgs.forEach((imgUrl, i) => {
                        const thumb = document.createElement('img');
                        thumb.src = imgUrl;
                        thumb.style.cssText = `width:56px;height:56px;object-fit:cover;border-radius:10px;cursor:pointer;border:2px solid ${i === fsGalleryIndex ? 'var(--primary)' : 'rgba(255,255,255,0.2)'};transition:all 0.2s var(--ease)`;
                        thumb.onclick = () => renderFsGalleryView(i);
                        fsThumbStrip.appendChild(thumb);
                    });
                }
            }
        }

        function navigateFsGallery(delta) {
            renderFsGalleryView(fsGalleryIndex + delta);
        }

        function escapeHtml(text) {
            if (!text) return '';
            return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }

        document.addEventListener('keydown', function(e) {
            const fsModal = document.getElementById('fullscreenImageModal');
            if (fsModal && fsModal.classList.contains('show')) {
                if (e.key === 'ArrowLeft') {
                    navigateFsGallery(-1);
                } else if (e.key === 'ArrowRight') {
                    navigateFsGallery(1);
                }
            } else {
                if (e.key === 'ArrowLeft') {
                    navigateGalleryImg(-1);
                } else if (e.key === 'ArrowRight') {
                    navigateGalleryImg(1);
                }
            }
        });

        document.addEventListener('DOMContentLoaded', initPageGallery);
    </script>
}
