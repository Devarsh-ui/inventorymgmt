@model IEnumerable<InventoryManagementSystem.Models.Device>
@{
    ViewData["Title"] = "IMEI & Physical Device Registry";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-upc-scan me-2 text-primary"></i>IMEI & Device Management</h3>
        <p class="text-muted small mb-0">Search, verify and track full lifecycle history of individual IMEI-tracked mobile units</p>
    </div>
    <div>
        <a href="@Url.Action("StockIn", "Stock")" class="btn btn-primary rounded-pill px-3">
            <i class="bi bi-plus-circle me-1"></i> Stock In New Devices
        </a>
    </div>
</div>

<!-- Search & Filter Bar -->
<div class="card border shadow-sm rounded-4 mb-4" id="imeiFilterPanel">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search IMEI1, IMEI2, Serial, Brand or Customer...">
                </div>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">-- All Statuses --</option>
                    <option value="InStock" selected="@(ViewBag.Status == "InStock")">In Stock</option>
                    <option value="Sold" selected="@(ViewBag.Status == "Sold")">Sold</option>
                    <option value="Reserved" selected="@(ViewBag.Status == "Reserved")">Reserved</option>
                    <option value="Returned" selected="@(ViewBag.Status == "Returned")">Returned</option>
                    <option value="Exchanged" selected="@(ViewBag.Status == "Exchanged")">Exchanged (Pre-owned)</option>
                    <option value="UnderRepair" selected="@(ViewBag.Status == "UnderRepair")">Under Repair</option>
                    <option value="Damaged" selected="@(ViewBag.Status == "Damaged")">Damaged</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="productId" class="form-select">
                    <option value="">-- All Mobile Models --</option>
                    @if (ViewBag.Products != null)
                    {
                        foreach (var p in (IEnumerable<InventoryManagementSystem.Models.Product>)ViewBag.Products)
                        {
                            <option value="@p.Id" selected="@(ViewBag.ProductId == p.Id)">@p.Brand @p.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-dark w-100 rounded-pill"><i class="bi bi-funnel me-1"></i>Filter</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary rounded-circle" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Devices Table Card -->
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small uppercase">
                    <tr>
                        <th class="ps-4">IMEI 1 / Serial</th>
                        <th>Device Brand & Model</th>
                        <th>Variant / Color</th>
                        <th>Status</th>
                        <th>Cost / Retail</th>
                        <th>Invoice / Customer</th>
                        <th class="pe-4 text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-upc-scan fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                No devices found matching your criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var dev in Model)
                        {
                            var statusBadge = dev.Status switch
                            {
                                "InStock" => "bg-success-subtle text-success border border-success-subtle",
                                "Sold" => "bg-primary-subtle text-primary border border-primary-subtle",
                                "Returned" => "bg-danger-subtle text-danger border border-danger-subtle",
                                "Exchanged" => "bg-info-subtle text-info border border-info-subtle",
                                "UnderRepair" => "bg-warning-subtle text-warning border border-warning-subtle",
                                _ => "bg-secondary-subtle text-secondary"
                            };

                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold font-monospace text-primary">@dev.IMEI1</div>
                                    @if (!string.IsNullOrEmpty(dev.IMEI2))
                                    {
                                        <div class="small font-monospace text-muted">IMEI2: @dev.IMEI2</div>
                                    }
                                </td>
                                <td>
                                    <span class="fw-semibold">@dev.Brand @dev.ModelName</span>
                                    <div class="small text-muted">@dev.ProductName</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@dev.Variant</span>
                                    <span class="badge bg-light text-dark border">@dev.Color</span>
                                </td>
                                <td>
                                    <span class="badge rounded-pill @statusBadge px-2 py-1">@dev.Status</span>
                                </td>
                                <td>
                                    <div class="small text-muted">Cost: ₹@dev.PurchasePrice.ToString("N2")</div>
                                    <div class="fw-semibold text-dark">Price: ₹@dev.SellingPrice.ToString("N2")</div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(dev.InvoiceNumber))
                                    {
                                        <a href="@Url.Action("Invoice", "Sales", new { id = dev.InvoiceNumber })" class="badge bg-light text-primary text-decoration-none border">
                                            <i class="bi bi-receipt me-1"></i>@dev.InvoiceNumber
                                        </a>
                                    }
                                    @if (!string.IsNullOrEmpty(dev.CustomerName))
                                    {
                                        <div class="small fw-medium">@dev.CustomerName</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="d-inline-flex align-items-center gap-1">
                                        <button type="button" class="btn btn-sm btn-outline-info rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#deviceModal_@dev.Id" title="View Full Device Details">
                                            <i class="bi bi-info-circle me-1"></i> Details
                                        </button>
                                        <a href="@Url.Action("Details", new { imei = dev.IMEI1 })" class="btn btn-sm btn-outline-primary rounded-pill px-3" title="View Device Timeline">
                                            <i class="bi bi-clock-history me-1"></i> Timeline
                                        </a>
                                        <form method="post" action="@Url.Action("Delete", "Imei")" class="d-inline" onsubmit="return confirm('Are you sure you want to delete IMEI @dev.IMEI1 from inventory? This will free up the IMEI number.');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@dev.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle p-2 d-inline-flex align-items-center justify-content-center" style="width:32px;height:32px" title="Delete IMEI Device">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model != null && Model.Any())
{
    @foreach (var dev in Model)
    {
        <!-- Device Details Modal -->
        <div class="modal fade" id="deviceModal_@dev.Id" tabindex="-1" aria-labelledby="deviceModalLabel_@dev.Id" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold" id="deviceModalLabel_@dev.Id">
                            <i class="bi bi-upc-scan me-2 text-primary"></i>Device Details — @dev.Brand @dev.ModelName
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4 text-start">
                        <div class="row g-3">
                            <!-- Column 1: Core Specifications -->
                            <div class="col-md-6">
                                <div class="card-d card-p h-100">
                                    <h6 class="fw-bold text-primary mb-3"><i class="bi bi-phone me-1"></i>Specifications & Hardware</h6>
                                    <div class="d-flex justify-content-between py-1 border-bottom" style="border-color:var(--border)!important"><span style="color:var(--text-muted);font-size:12px;font-weight:600">Brand:</span><span style="color:var(--text-primary);font-weight:600;font-size:13px">@dev.Brand</span></div>
                                    <div class="d-flex justify-content-between py-1 border-bottom" style="border-color:var(--border)!important"><span style="color:var(--text-muted);font-size:12px;font-weight:600">Model:</span><span style="color:var(--text-primary);font-weight:600;font-size:13px">@dev.ModelName</span></div>
                                    <div class="d-flex justify-content-between py-1 border-bottom" style="border-color:var(--border)!important"><span style="color:var(--text-muted);font-size:12px;font-weight:600">Variant / Storage:</span><span style="color:var(--text-primary);font-weight:600;font-size:13px">@(string.IsNullOrWhiteSpace(dev.Variant) ? $"{dev.Ram} / {dev.Storage}" : dev.Variant)</span></div>
                                    <div class="d-flex justify-content-between py-1 border-bottom" style="border-color:var(--border)!important"><span style="color:var(--text-muted);font-size:12px;font-weight:600">Color:</span><span style="color:var(--text-primary);font-weight:600;font-size:13px">@dev.Color</span></div>
                                    <div class="d-flex justify-content-between py-1 border-bottom" style="border-color:var(--border)!important"><span style="color:var(--text-muted);font-size:12px;font-weight:600">IMEI 1:</span><span class="fw-bold font-monospace text-primary small">@dev.IMEI1</span></div>
                                    @if (!string.IsNullOrEmpty(dev.IMEI2))
                                    {
                                        <div class="d-flex justify-content-between py-1 border-bottom" style="border-color:var(--border)!important"><span style="color:var(--text-muted);font-size:12px;font-weight:600">IMEI 2:</span><span class="fw-bold font-monospace text-info small">@dev.IMEI2</span></div>
                                    }
                                    <div class="d-flex justify-content-between py-1 border-bottom" style="border-color:var(--border)!important"><span style="color:var(--text-muted);font-size:12px;font-weight:600">Serial Number:</span><span class="font-monospace small" style="color:var(--text-secondary)">@(string.IsNullOrEmpty(dev.SerialNumber) ? "-" : dev.SerialNumber)</span></div>
                                    <div class="d-flex justify-content-between py-1 border-bottom" style="border-color:var(--border)!important"><span style="color:var(--text-muted);font-size:12px;font-weight:600">Condition:</span><span class="badge-d badge-gray">@(string.IsNullOrEmpty(dev.Condition) ? "Standard" : dev.Condition)</span></div>
                                    @if (dev.BatteryHealthPercentage.HasValue && dev.BatteryHealthPercentage > 0)
                                    {
                                        <div class="d-flex justify-content-between py-1 border-bottom" style="border-color:var(--border)!important"><span style="color:var(--text-muted);font-size:12px;font-weight:600">Battery Health:</span><span class="fw-semibold text-success small"><i class="bi bi-battery-charging me-1"></i>@dev.BatteryHealthPercentage%</span></div>
                                    }
                                </div>
                            </div>

                            <!-- Column 2: Inventory, Sale & Customer Info -->
                            <div class="col-md-6">
                                <div class="card-d card-p h-100">
                                    <h6 class="fw-bold text-success mb-3"><i class="bi bi-receipt me-1"></i>Status, Valuation & Invoice</h6>
                                    <div class="d-flex justify-content-between py-1 border-bottom" style="border-color:var(--border)!important"><span style="color:var(--text-muted);font-size:12px;font-weight:600">Current Status:</span><span class="badge-d badge-blue">@dev.Status</span></div>
                                    <div class="d-flex justify-content-between py-1 border-bottom" style="border-color:var(--border)!important"><span style="color:var(--text-muted);font-size:12px;font-weight:600">Origin / Source:</span><span class="badge-d badge-sky">@(string.IsNullOrEmpty(dev.Source) ? "Stock In" : dev.Source)</span></div>
                                    <div class="d-flex justify-content-between py-1 border-bottom" style="border-color:var(--border)!important"><span style="color:var(--text-muted);font-size:12px;font-weight:600">Purchase / Cost Price:</span><span style="color:var(--text-primary);font-weight:700;font-size:13px">₹@dev.PurchasePrice.ToString("N2")</span></div>
                                    <div class="d-flex justify-content-between py-1 border-bottom" style="border-color:var(--border)!important"><span style="color:var(--text-muted);font-size:12px;font-weight:600">Selling / Retail Price:</span><span style="color:var(--success);font-weight:700;font-size:13px">₹@dev.SellingPrice.ToString("N2")</span></div>
                                    
                                    @if (!string.IsNullOrEmpty(dev.InvoiceNumber))
                                    {
                                        <div class="d-flex justify-content-between py-1 border-bottom align-items-center" style="border-color:var(--border)!important">
                                            <span style="color:var(--text-muted);font-size:12px;font-weight:600">Tax Invoice:</span>
                                            <a href="@Url.Action("Invoice", "Sales", new { id = dev.InvoiceNumber })" class="badge-d badge-blue text-decoration-none">
                                                <i class="bi bi-receipt me-1"></i>@dev.InvoiceNumber
                                            </a>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(dev.CustomerName))
                                    {
                                        <div class="d-flex justify-content-between py-1 border-bottom" style="border-color:var(--border)!important"><span style="color:var(--text-muted);font-size:12px;font-weight:600">Customer Name:</span><span style="color:var(--text-primary);font-weight:600;font-size:13px">@dev.CustomerName</span></div>
                                        <div class="d-flex justify-content-between py-1 border-bottom" style="border-color:var(--border)!important"><span style="color:var(--text-muted);font-size:12px;font-weight:600">Customer Phone:</span><span style="color:var(--text-primary);font-weight:600;font-size:13px">@dev.CustomerPhone</span></div>
                                    }
                                    @if (!string.IsNullOrEmpty(dev.ExchangeNumber))
                                    {
                                        <div class="d-flex justify-content-between py-1 border-bottom" style="border-color:var(--border)!important"><span style="color:var(--text-muted);font-size:12px;font-weight:600">Exchange #:</span><span class="badge-d badge-amber">@dev.ExchangeNumber</span></div>
                                    }
                                    <div class="d-flex justify-content-between py-1"><span style="color:var(--text-muted);font-size:12px;font-weight:600">Date Logged:</span><span style="color:var(--text-secondary);font-size:12px">@dev.CreatedDate.ToString("yyyy-MM-dd HH:mm")</span></div>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(dev.Notes))
                        {
                            <div class="mt-3 p-3 card-d rounded-3">
                                <small class="fw-bold d-block mb-1" style="color:var(--primary-text)"><i class="bi bi-sticky me-1"></i>Notes & Remarks:</small>
                                <small style="color:var(--text-secondary)">@dev.Notes</small>
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-d btn-ghost" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>
    }
}v>
</div>
