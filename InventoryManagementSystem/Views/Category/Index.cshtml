@model IEnumerable<Category>
@using InventoryManagementSystem.Models
@{
    ViewData["Title"] = "Categories";
}

<div class="ph">
    <div>
        <h1 class="ph-title">Categories</h1>
        <p class="ph-sub">Group and classify your products into categories.</p>
    </div>
    <div class="ph-actions d-flex align-items-center gap-2">
        <button type="button" class="btn-d btn-outline" id="categoryFilterToggleBtn" onclick="toggleFilterPanel('categoryFilterPanel', 'categoryFilterToggleBtn')">
            <i class="bi bi-funnel-fill text-primary me-1"></i><span>Filters: ON</span>
        </button>
        <a href="@Url.Action("Create","Category")" class="btn-d btn-primary">
            <i class="bi bi-plus-lg"></i> Add Category
        </a>
    </div>
</div>

<!-- Detailed Filter Bar (Toggleable Panel) -->
<div class="card-d card-p mb-4" id="categoryFilterPanel">
    <div class="row g-3 align-items-center">
        <div class="col-md-6">
            <div class="fg mb-0">
                <label class="fg-label"><i class="bi bi-search me-1"></i>Search Keywords</label>
                <div class="search-pill">
                    <i class="bi bi-search search-pill-icon"></i>
                    <input type="search" data-tbl-search="categories-table" placeholder="Search category name, description…" class="search-pill-input">
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="fg mb-0">
                <label class="fg-label"><i class="bi bi-toggle-on me-1"></i>Status Filter</label>
                <select class="fg-control" style="height:38px" onchange="const val=this.value.toLowerCase(); document.querySelectorAll('#categories-table tbody tr').forEach(r => { if(!val || r.textContent.toLowerCase().includes(val)) r.style.display=''; else r.style.display='none'; })">
                    <option value="">All Statuses</option>
                    <option value="Active">Active Categories</option>
                    <option value="Inactive">Inactive Categories</option>
                </select>
            </div>
        </div>
        <div class="col-md-3 d-flex align-items-end justify-content-end">
            <span class="tbl-count">@(Model?.Count() ?? 0) categories total</span>
        </div>
    </div>
</div>

<!-- Categories Table Card Container (Fixed Background & Border) -->
<div class="card-d card-p p-0 overflow-hidden">
    <div class="tbl-scroll">
        <table class="tbl mb-0" id="categories-table">
            <thead>
                <tr>
                    <th class="ps-4">Category Name</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Created Date (IST)</th>
                    <th class="col-actions text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var cat in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="td-strong">@cat.Name</div>
                            </td>
                            <td style="color:var(--text-secondary);max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                                @(string.IsNullOrEmpty(cat.Description) ? "—" : cat.Description)
                            </td>
                            <td>
                                @if (cat.Status == "Active")
                                {
                                    <span class="badge-d badge-green">Active</span>
                                }
                                else
                                {
                                    <span class="badge-d badge-gray">Inactive</span>
                                }
                            </td>
                            <td style="color:var(--text-muted);white-space:nowrap;font-size:12px">
                                @cat.CreatedDate.ToIstString("MMM d, yyyy IST")
                            </td>
                            <td class="col-actions pe-4 text-end">
                                <div class="d-flex align-items-center justify-content-end gap-1">
                                    <button type="button" class="btn-d btn-ghost btn-icon-d"
                                            onclick="openCategoryDetailsModal('@cat.Id', '@cat.Name', '@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(cat.Description ?? "")', '@cat.Status', '@cat.CreatedDate.ToIstString("yyyy-MM-dd HH:mm IST")')"
                                            title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <a href="@Url.Action("Edit","Category",new{id=cat.Id})"
                                       class="btn-d btn-ghost btn-icon-d"
                                       title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post" asp-action="Delete" asp-route-id="@cat.Id" style="margin:0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn-d btn-ghost btn-icon-d"
                                                style="color:var(--danger)"
                                                title="Delete"
                                                data-confirm="Delete category '@cat.Name'? Products in this category will be affected.">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5">
                            <div class="empty-s">
                                <i class="bi bi-tag empty-s-icon"></i>
                                <div class="empty-s-title">No categories yet</div>
                                <div class="empty-s-desc">Create your first category to start organizing products.</div>
                                <a href="@Url.Action("Create","Category")" class="btn-d btn-primary btn-sm-d">
                                    <i class="bi bi-plus-lg"></i> Add Category
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Category View Details -->
<div class="modal fade" id="viewCategoryModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4" style="background:var(--card-bg);color:var(--text-primary)">
            <div class="modal-header border-bottom pb-3" style="border-color:var(--border)!important">
                <h5 class="fw-bold modal-title" style="color:var(--text-primary)"><i class="bi bi-folder me-2 text-primary"></i>Category Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-4">
                <div class="card-d card-p">
                    <div class="d-flex justify-content-between py-1 border-bottom" style="border-color:var(--border)!important">
                        <span style="color:var(--text-muted);font-size:12px;font-weight:600">Category ID:</span>
                        <code style="color:var(--primary-text);font-weight:700;font-size:12px" id="catDetailId"></code>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom" style="border-color:var(--border)!important">
                        <span style="color:var(--text-muted);font-size:12px;font-weight:600">Category Name:</span>
                        <span style="color:var(--text-primary);font-weight:700;font-size:14px" id="catDetailName"></span>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom" style="border-color:var(--border)!important">
                        <span style="color:var(--text-muted);font-size:12px;font-weight:600">Status:</span>
                        <span id="catDetailStatusBadge"></span>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom" style="border-color:var(--border)!important">
                        <span style="color:var(--text-muted);font-size:12px;font-weight:600">Date Created (IST):</span>
                        <span style="color:var(--text-secondary);font-size:12px" id="catDetailCreated"></span>
                    </div>
                    <div class="mt-3">
                        <span style="color:var(--text-muted);font-size:12px;font-weight:600;display:block" class="mb-1">Category Description:</span>
                        <div class="p-3 rounded-3" style="background:var(--bg);color:var(--text-secondary);font-size:13px" id="catDetailDescription"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top py-2" style="border-color:var(--border)!important">
                <button type="button" class="btn-d btn-ghost" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openCategoryDetailsModal(id, name, desc, status, created) {
            document.getElementById('catDetailId').innerText = id || '-';
            document.getElementById('catDetailName').innerText = name || '-';
            document.getElementById('catDetailDescription').innerText = desc || 'No description entered.';
            document.getElementById('catDetailCreated').innerText = created || '-';
            
            const badgeEl = document.getElementById('catDetailStatusBadge');
            if (status === 'Active') {
                badgeEl.className = 'badge-d badge-green';
                badgeEl.innerText = 'Active Category';
            } else {
                badgeEl.className = 'badge-d badge-gray';
                badgeEl.innerText = 'Inactive Category';
            }

            const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('viewCategoryModal'));
            modal.show();
        }
    </script>
}
