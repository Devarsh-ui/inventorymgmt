@section Scripts {
@{
    var clientSuppliers = new List<object>();
    foreach (var s in suppliers)
    {
        clientSuppliers.Add(new {
            id = s.Id,
            vendorName = s.DisplayVendorName,
            companyName = s.DisplayCompanyName,
            contactPerson = s.DisplayContactPerson,
            phone = s.Phone ?? "",
            email = s.Email ?? "",
            gstin = s.Gstin ?? "",
            paymentTerms = s.PaymentTerms ?? "Net 30 Days",
            outstandingPayable = s.OutstandingPayable,
            address = s.Address ?? "",
            city = s.City ?? "",
            state = s.State ?? "",
            country = s.Country ?? "",
            status = s.Status.ToString()
        });
    }
    if (selectedSupplier != null && !suppliers.Any(s => s.Id == selectedSupplier.Id))
    {
        clientSuppliers.Add(new {
            id = selectedSupplier.Id,
            vendorName = selectedSupplier.DisplayVendorName,
            companyName = selectedSupplier.DisplayCompanyName,
            contactPerson = selectedSupplier.DisplayContactPerson,
            phone = selectedSupplier.Phone ?? "",
            email = selectedSupplier.Email ?? "",
            gstin = selectedSupplier.Gstin ?? "",
            paymentTerms = selectedSupplier.PaymentTerms ?? "Net 30 Days",
            outstandingPayable = selectedSupplier.OutstandingPayable,
            address = selectedSupplier.Address ?? "",
            city = selectedSupplier.City ?? "",
            state = selectedSupplier.State ?? "",
            country = selectedSupplier.Country ?? "",
            status = selectedSupplier.Status.ToString()
        });
    }
}
    <script>
        function escapeHtml(str) {
            if (str === null || str === undefined) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        const rawSuppliersList = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(clientSuppliers));
        window.supplierLookup = {};
        if (Array.isArray(rawSuppliersList)) {
            rawSuppliersList.forEach(s => {
                if (s && s.id) {
                    window.supplierLookup[s.id] = s;
                }
            });
        }

        const currentSupplierId = '@(selectedSupplierId ?? "")';

        function onSupplierDropdownChange(sel) {
            const supId = sel.value;
            if (supId) {
                window.location.href = `/SupplierOrder/Create?selectedSupplierId=${encodeURIComponent(supId)}`;
            } else {
                window.location.href = `/SupplierOrder/Create`;
            }
        }

        function onBrandDropdownChange(sel) {
            const brandVal = sel.value;
            if (brandVal) {
                window.location.href = `/SupplierOrder/Create?selectedSupplierId=${encodeURIComponent(currentSupplierId)}&brand=${encodeURIComponent(brandVal)}`;
            } else {
                window.location.href = `/SupplierOrder/Create?selectedSupplierId=${encodeURIComponent(currentSupplierId)}`;
            }
        }

        // Cart items stored in memory and synced with sessionStorage
        let cartItems = [];

        function getCartStorageKey() {
            return currentSupplierId ? `sims_po_cart_${currentSupplierId}` : 'sims_po_cart_default';
        }

        function loadCartFromStorage() {
            if (!currentSupplierId) return;
            const data = sessionStorage.getItem(getCartStorageKey());
            if (data) {
                try {
                    cartItems = JSON.parse(data) || [];
                } catch (e) {
                    cartItems = [];
                }
            }
            renderCart();
        }

        function saveCartToStorage() {
            if (!currentSupplierId) return;
            sessionStorage.setItem(getCartStorageKey(), JSON.stringify(cartItems));
            renderCart();
        }

        function clearCart() {
            if (!confirm('Are you sure you want to clear all items in your purchase basket?')) return;
            cartItems = [];
            saveCartToStorage();
        }

        function addToCart(productId, productName, brand, variant, color, unitPrice, quantity, variantId = '', colorId = '', availableStock = 999999) {
            quantity = parseInt(quantity) || 1;
            unitPrice = parseFloat(unitPrice) || 0;
            availableStock = parseInt(availableStock);
            if (isNaN(availableStock)) availableStock = 999999;

            const itemKey = `${productId}_${variantId || ''}_${colorId || ''}`;

            const existing = cartItems.find(i => (i.itemKey || i.productId) === itemKey);
            if (existing) {
                existing.quantity += quantity;
                if (existing.quantity > availableStock) {
                    existing.quantity = availableStock;
                }
                existing.unitPrice = unitPrice;
                existing.availableStock = availableStock;
            } else {
                cartItems.push({
                    itemKey: itemKey,
                    productId: productId,
                    variantId: variantId,
                    colorId: colorId,
                    productName: productName,
                    brand: brand,
                    variant: variant,
                    color: color,
                    unitPrice: unitPrice,
                    quantity: Math.min(quantity, availableStock),
                    availableStock: availableStock
                });
            }
            saveCartToStorage();
        }

        function updateCartItemQty(itemKey, delta) {
            const item = cartItems.find(i => (i.itemKey || i.productId) === itemKey);
            if (item) {
                if (delta > 0 && item.availableStock !== undefined && item.availableStock !== null && (item.quantity + delta) > item.availableStock) {
                    alert(`Cannot add more than available stock (${item.availableStock} units available).`);
                    return;
                }
                item.quantity += delta;
                if (item.quantity <= 0) {
                    cartItems = cartItems.filter(i => (i.itemKey || i.productId) !== itemKey);
                }
                saveCartToStorage();
            }
        }

        function removeCartItem(itemKey) {
            cartItems = cartItems.filter(i => (i.itemKey || i.productId) !== itemKey);
            saveCartToStorage();
        }

        function renderCart() {
            const listEl = document.getElementById('cartItemsList');
            const emptyEl = document.getElementById('cartEmptyState');
            const summaryBox = document.getElementById('cartSummaryBox');
            const totalQtyEl = document.getElementById('cartTotalQty');
            const subtotalEl = document.getElementById('cartSubtotal');
            const hiddenInputsEl = document.getElementById('cartHiddenInputs');
            const btnReview = document.getElementById('btnProceedReview');

            if (!listEl) return;

            listEl.innerHTML = '';
            hiddenInputsEl.innerHTML = '';

            let totalQty = 0;
            let subtotal = 0;

            if (cartItems.length === 0) {
                if (emptyEl) emptyEl.style.display = 'block';
                if (summaryBox) summaryBox.style.display = 'none';
                return;
            }

            if (emptyEl) emptyEl.style.display = 'none';
            if (summaryBox) summaryBox.style.display = 'block';

            cartItems.forEach((item, index) => {
                const lineTotal = item.quantity * item.unitPrice;
                totalQty += item.quantity;
                subtotal += lineTotal;

                const key = item.itemKey || item.productId;

                // Hidden form inputs for Review action
                hiddenInputsEl.innerHTML += `
                    <input type="hidden" name="items[${index}].ProductId" value="${item.productId}" />
                    <input type="hidden" name="items[${index}].VariantId" value="${item.variantId || ''}" />
                    <input type="hidden" name="items[${index}].ColorId" value="${item.colorId || ''}" />
                    <input type="hidden" name="items[${index}].Variant" value="${escapeHtml(item.variant || '')}" />
                    <input type="hidden" name="items[${index}].Color" value="${escapeHtml(item.color || '')}" />
                    <input type="hidden" name="items[${index}].Quantity" value="${item.quantity}" />
                    <input type="hidden" name="items[${index}].UnitPrice" value="${item.unitPrice}" />
                `;

                // Cart item row
                const row = document.createElement('div');
                row.className = 'cart-item-row';
                row.innerHTML = `
                    <div class="d-flex align-items-start justify-content-between mb-1">
                        <div class="fw-bold text-truncate" style="max-width:180px;font-size:13px;color:var(--text-primary)">${item.productName}</div>
                        <button type="button" class="btn btn-link text-danger p-0" onclick="removeCartItem('${key}')" style="font-size:12px;text-decoration:none">
                            <i class="bi bi-x-circle"></i>
                        </button>
                    </div>
                    <div class="text-muted mb-2" style="font-size:11px">
                        ${item.brand} · ${item.variant || ''} ${item.color ? '· ' + item.color : ''}
                    </div>
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-1">
                            <button type="button" class="cart-qty-btn" onclick="updateCartItemQty('${key}', -1)">-</button>
                            <span class="px-2 fw-bold" style="font-size:13px">${item.quantity}</span>
                            <button type="button" class="cart-qty-btn" onclick="updateCartItemQty('${key}', 1)">+</button>
                        </div>
                        <div class="text-end">
                            <div style="font-size:10px;color:var(--text-muted)">₹${item.unitPrice.toLocaleString('en-IN', {minimumFractionDigits: 2})} ea</div>
                            <div style="font-size:13px;font-weight:700;color:var(--success)">₹${lineTotal.toLocaleString('en-IN', {minimumFractionDigits: 2})}</div>
                        </div>
                    </div>
                `;
                listEl.appendChild(row);
            });

            if (totalQtyEl) totalQtyEl.innerText = `${totalQty} Units`;
            if (subtotalEl) subtotalEl.innerText = `₹${subtotal.toLocaleString('en-IN', {minimumFractionDigits: 2})}`;
            if (btnReview) btnReview.innerHTML = `<i class="bi bi-clipboard-check me-1"></i> Review Purchase Order (${totalQty} Items)`;
        }

        document.getElementById('poSubmitReviewForm')?.addEventListener('submit', function (e) {
            if (cartItems.length === 0) {
                e.preventDefault();
                alert('Please add at least one product to the purchase order basket before proceeding to review.');
                return false;
            }
        });

        // Quick Quantity Modal Logic (Multi-Variant & Multi-Color Batch Selection)
        let activeQuickProduct = null;
        let activeQuickProductCombinations = [];

        function openQtyStepperModal(product, defaultUnitPrice) {
            activeQuickProduct = product;
            document.getElementById('qqm_Name').innerText = product.Name || 'Product Variants & Colors';
            
            activeQuickProductCombinations = [];
            const variants = product.Variants || [];

            function getStockForOption(c, v, p) {
                if (c && c.CurrentStock !== undefined && c.CurrentStock !== null) return c.CurrentStock;
                if (c && c.InitialStock !== undefined && c.InitialStock !== null) return c.InitialStock;
                if (v && v.CurrentStock !== undefined && v.CurrentStock !== null) return v.CurrentStock;
                if (v && v.InitialStock !== undefined && v.InitialStock !== null) return v.InitialStock;
                if (p && p.CurrentStock !== undefined && p.CurrentStock !== null) return p.CurrentStock;
                if (p && p.InitialStock !== undefined && p.InitialStock !== null) return p.InitialStock;
                return 0;
            }

            if (variants.length > 0) {
                variants.forEach(v => {
                    const vName = (v.Ram && v.Storage) ? `${v.Ram} / ${v.Storage}` : (v.Storage || v.Ram || 'Standard Variant');
                    const colors = v.Colors || [];
                    if (colors.length > 0) {
                        colors.forEach(c => {
                            const price = (c.PurchasePrice && c.PurchasePrice > 0)
                                ? c.PurchasePrice
                                : ((v.PurchasePrice && v.PurchasePrice > 0) ? v.PurchasePrice : (product.PurchasePrice || defaultUnitPrice));
                            const stock = getStockForOption(c, v, product);
                            activeQuickProductCombinations.push({
                                variantId: v.VariantId || '',
                                variantName: vName,
                                colorId: c.ColorId || '',
                                colorName: c.Name || 'Standard Color',
                                unitPrice: price,
                                availableStock: stock < 0 ? 0 : stock,
                                qty: 0
                            });
                        });
                    } else {
                        const price = (v.PurchasePrice && v.PurchasePrice > 0) ? v.PurchasePrice : (product.PurchasePrice || defaultUnitPrice);
                        const stock = getStockForOption(null, v, product);
                        activeQuickProductCombinations.push({
                            variantId: v.VariantId || '',
                            variantName: vName,
                            colorId: '',
                            colorName: product.Color || 'Standard Color',
                            unitPrice: price,
                            availableStock: stock < 0 ? 0 : stock,
                            qty: 0
                        });
                    }
                });
            } else {
                const vName = (product.Variant || `${product.Ram || ''} / ${product.Storage || ''}`).trim() || 'Standard Variant';
                const price = (product.PurchasePrice && product.PurchasePrice > 0) ? product.PurchasePrice : defaultUnitPrice;
                const stock = getStockForOption(null, null, product);
                activeQuickProductCombinations.push({
                    variantId: '',
                    variantName: vName,
                    colorId: '',
                    colorName: product.Color || 'Standard Color',
                    unitPrice: price,
                    availableStock: stock < 0 ? 0 : stock,
                    qty: stock > 0 ? 1 : 0
                });
            }

            if (activeQuickProductCombinations.length > 0 && activeQuickProductCombinations.every(c => c.qty === 0)) {
                const firstAvailable = activeQuickProductCombinations.find(c => c.availableStock > 0);
                if (firstAvailable) {
                    firstAvailable.qty = 1;
                }
            }

            renderModalCombinationsTable();

            const modalEl = document.getElementById('quickQtyModal');
            let modal = bootstrap.Modal.getInstance(modalEl);
            if (!modal) {
                modal = new bootstrap.Modal(modalEl);
            }
            modal.show();
        }

        function renderModalCombinationsTable() {
            const tbody = document.getElementById('qqm_CombinationsTbody');
            if (!tbody) return;
            tbody.innerHTML = '';

            let totalSelectedItems = 0;
            let totalUnits = 0;
            let totalSubtotal = 0;

            activeQuickProductCombinations.forEach((item, index) => {
                const lineTotal = item.qty * item.unitPrice;
                if (item.qty > 0) {
                    totalSelectedItems++;
                    totalUnits += item.qty;
                    totalSubtotal += lineTotal;
                }

                const isOutOfStock = item.availableStock <= 0;
                const isMaxReached = item.qty >= item.availableStock;

                const tr = document.createElement('tr');
                tr.style.background = item.qty > 0 ? 'rgba(79, 70, 229, 0.12)' : 'transparent';
                tr.style.transition = 'background 0.2s var(--ease)';
                if (isOutOfStock) {
                    tr.style.opacity = '0.75';
                }

                tr.innerHTML = `
                    <td class="align-middle">
                        <div class="fw-bold" style="color:var(--text-primary);font-size:13px">${escapeHtml(item.variantName)}</div>
                    </td>
                    <td class="align-middle">
                        <span class="badge-d badge-gray" style="font-size:11px">${escapeHtml(item.colorName)}</span>
                    </td>
                    <td class="align-middle">
                        ${isOutOfStock 
                            ? '<span class="badge-d" style="font-size:11px;background:rgba(239,68,68,0.15);color:#ef4444;border:1px solid rgba(239,68,68,0.3)"><i class="bi bi-x-circle me-1"></i>Out of Stock</span>'
                            : `<span class="badge-d ${item.availableStock <= 5 ? 'badge-warning' : 'badge-info'}" style="font-size:11px"><i class="bi bi-box-seam me-1"></i>${item.availableStock} Units</span>`
                        }
                    </td>
                    <td class="align-middle fw-bold text-primary" style="font-size:13px">
                        ₹${item.unitPrice.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2})}
                    </td>
                    <td class="align-middle">
                        <div class="d-flex align-items-center gap-1" style="max-width:120px">
                            <button type="button" class="cart-qty-btn" onclick="adjustCombinationQty(${index}, -1)" ${item.qty <= 0 || isOutOfStock ? 'disabled' : ''}>-</button>
                            <input type="number" class="fg-control text-center py-1 px-1" value="${item.qty}" min="0" max="${item.availableStock}" 
                                   ${isOutOfStock ? 'disabled' : ''}
                                   style="font-weight:700;font-size:13px;width:50px" oninput="setCombinationQty(${index}, this.value)" />
                            <button type="button" class="cart-qty-btn" onclick="adjustCombinationQty(${index}, 1)" ${isMaxReached || isOutOfStock ? 'disabled' : ''}>+</button>
                        </div>
                    </td>
                    <td class="align-middle text-end fw-bold ${item.qty > 0 ? 'text-success' : 'text-muted'}" style="font-size:13px">
                        ₹${lineTotal.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2})}
                    </td>
                `;
                tbody.appendChild(tr);
            });

            const itemsEl = document.getElementById('qqm_TotalItemsCount');
            const unitsEl = document.getElementById('qqm_TotalUnitsCount');
            const subtotalEl = document.getElementById('qqm_ModalSubtotal');

            if (itemsEl) itemsEl.innerText = `${totalSelectedItems} Selected`;
            if (unitsEl) unitsEl.innerText = `${totalUnits} Units`;
            if (subtotalEl) subtotalEl.innerText = `₹${totalSubtotal.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
        }

        function adjustCombinationQty(index, delta) {
            const item = activeQuickProductCombinations[index];
            if (!item) return;
            const maxStock = item.availableStock || 0;
            let newQty = (item.qty || 0) + delta;
            if (newQty < 0) newQty = 0;
            if (newQty > maxStock) {
                newQty = maxStock;
                alert(`Cannot add more than available stock (${maxStock} units available).`);
            }
            item.qty = newQty;
            renderModalCombinationsTable();
        }

        function setCombinationQty(index, valStr) {
            const item = activeQuickProductCombinations[index];
            if (!item) return;
            const maxStock = item.availableStock || 0;
            let val = parseInt(valStr);
            if (isNaN(val) || val < 0) val = 0;
            if (val > maxStock) {
                val = maxStock;
                alert(`Cannot add more than available stock (${maxStock} units available).`);
            }
            item.qty = val;
            renderModalCombinationsTable();
        }

        function submitQuickModalAddBatch() {
            if (!activeQuickProduct || !activeQuickProductCombinations) return;

            let stockExceeded = false;
            activeQuickProductCombinations.forEach(item => {
                if (item.qty > 0) {
                    const itemKey = `${activeQuickProduct.Id}_${item.variantId || ''}_${item.colorId || ''}`;
                    const existingInCart = cartItems.find(i => (i.itemKey || i.productId) === itemKey)?.quantity || 0;
                    const maxStock = item.availableStock;
                    if (existingInCart + item.qty > maxStock) {
                        stockExceeded = true;
                        const remaining = Math.max(0, maxStock - existingInCart);
                        alert(`Cannot add ${item.qty} units of ${item.variantName} (${item.colorName}). Total in basket (${existingInCart + item.qty}) would exceed available stock (${maxStock} units). You can add at most ${remaining} more unit(s).`);
                    }
                }
            });

            if (stockExceeded) return;

            let addedCount = 0;
            activeQuickProductCombinations.forEach(item => {
                if (item.qty > 0) {
                    addToCart(
                        activeQuickProduct.Id,
                        activeQuickProduct.Name,
                        activeQuickProduct.Brand,
                        item.variantName,
                        item.colorName,
                        item.unitPrice,
                        item.qty,
                        item.variantId,
                        item.colorId,
                        item.availableStock
                    );
                    addedCount++;
                }
            });

            if (addedCount === 0) {
                alert('Please specify quantity > 0 for at least one available variant / color option.');
                return;
            }

            const modalEl = document.getElementById('quickQtyModal');
            bootstrap.Modal.getInstance(modalEl)?.hide();
        }

        // Details Modal Quick Add
        let activeModalProduct = null;
        let activeModalPrice = 0;

        function adjustModalQty(delta) {
            const input = document.getElementById('ps_QuickQty');
            let val = (parseInt(input.value) || 1) + delta;
            if (val < 1) val = 1;
            input.value = val;
            updateModalSubtotal();
        }

        function updateModalSubtotal() {
            const qtyEl = document.getElementById('ps_QuickQty');
            const subtotalEl = document.getElementById('ps_QuickSubtotal');
            if (!qtyEl || !subtotalEl) return;
            const qty = parseInt(qtyEl.value) || 1;
            const sub = qty * activeModalPrice;
            subtotalEl.innerText = `₹${sub.toLocaleString('en-IN', {minimumFractionDigits: 2})}`;
        }

        function addFromDetailsModal() {
            if (!activeModalProduct) return;
            const modalEl = document.getElementById('productSpecsModal');
            if (modalEl) {
                const modalInstance = bootstrap.Modal.getInstance(modalEl);
                if (modalInstance) modalInstance.hide();
            }
            openQtyStepperModal(activeModalProduct, activeModalPrice);
        }

        function setElText(id, text) {
            const el = document.getElementById(id);
            if (el) el.innerText = text;
        }

        // Specs Modal Inspection
        function openProductSpecsModal(p, sup) {
            if (!p) return;
            activeModalProduct = p;
            window.activeModalProduct = p;

            let effectivePrice = p.SupplierPrice > 0 ? p.SupplierPrice : p.PurchasePrice;
            if ((!effectivePrice || effectivePrice <= 0) && p.Variants && p.Variants.length > 0) {
                const firstV = p.Variants[0];
                if (firstV.Colors && firstV.Colors.length > 0 && firstV.Colors[0].PurchasePrice > 0) {
                    effectivePrice = firstV.Colors[0].PurchasePrice;
                } else if (firstV.PurchasePrice > 0) {
                    effectivePrice = firstV.PurchasePrice;
                } else if (firstV.SupplierPrice > 0) {
                    effectivePrice = firstV.SupplierPrice;
                }
            }
            activeModalPrice = effectivePrice || 0;

            const quickPriceEl = document.getElementById('ps_QuickPrice');
            if (quickPriceEl) quickPriceEl.innerText = `₹${activeModalPrice.toLocaleString('en-IN', {minimumFractionDigits: 2})}`;
            const quickQtyEl = document.getElementById('ps_QuickQty');
            if (quickQtyEl) quickQtyEl.value = '1';
            updateModalSubtotal();

            const s = p.Specs || {};
            setElText('ps_Name', p.Name || 'Product Specs');
            setElText('ps_Code', `SKU: ${p.Code || '-'}`);
            setElText('ps_BrandModel', `${p.Brand || ''} ${p.ModelName || ''}`.trim() || '-');
            setElText('ps_Variant', p.Variant || `${p.Ram || ''} / ${p.Storage || ''}`.trim() || '-');
            setElText('ps_Color', p.Color || '-');
            setElText('ps_SupplierPrice', `₹${activeModalPrice.toLocaleString('en-IN', {minimumFractionDigits: 2})}`);
            setElText('ps_SellingPrice', `₹${(p.SellingPrice || 0).toLocaleString('en-IN', {minimumFractionDigits: 2})}`);
            setElText('ps_Stock', `${p.CurrentStock || 0} Units`);
            setElText('ps_Barcode', p.Barcode || '-');
            setElText('ps_Warranty', `${p.WarrantyDurationMonths || 12} Months`);
            setElText('ps_Description', p.Description || 'No description provided.');

            // 1. Gather & Render All Hardware Variants
            const allVariants = [];
            const varSet = new Set();
            if (p.Variants && p.Variants.length > 0) {
                p.Variants.forEach(v => {
                    const vName = (v.Ram && v.Storage) ? `${v.Ram} / ${v.Storage}` : (v.Storage || v.Ram || 'Standard Variant');
                    if (!varSet.has(vName)) {
                        varSet.add(vName);
                        const vStock = (v.CurrentStock !== undefined && v.CurrentStock !== null) ? v.CurrentStock : (v.InitialStock || 0);
                        const vPrice = v.PurchasePrice || v.SupplierPrice || activeModalPrice;
                        allVariants.push({ name: vName, stock: vStock, price: vPrice });
                    }
                });
            } else {
                const vName = (p.Variant || `${p.Ram || ''} / ${p.Storage || ''}`).trim() || 'Standard Variant';
                allVariants.push({ name: vName, stock: p.CurrentStock || 0, price: activeModalPrice });
            }

            const varListEl = document.getElementById('ps_AllVariantsList');
            if (varListEl) {
                varListEl.innerHTML = '';
                allVariants.forEach(v => {
                    const badge = document.createElement('span');
                    badge.className = 'badge-d badge-gray py-1.5 px-2.5';
                    badge.style.cssText = 'font-size:12px;border:1px solid var(--border);display:inline-flex;align-items:center;gap:6px';
                    badge.innerHTML = `<i class="bi bi-cpu text-info"></i><strong style="color:var(--text-primary)">${escapeHtml(v.name)}</strong> <span class="text-muted" style="font-size:10px">(${v.stock} in stock)</span>`;
                    varListEl.appendChild(badge);
                });
            }

            // 2. Gather & Render All Unique Colors + Interactive Image Swatches (STRICT COLOR ISOLATION)
            const colorOptions = [];
            const colorNameSet = new Set();

            if (p.Variants && p.Variants.length > 0) {
                p.Variants.forEach(v => {
                    if (v.Colors && v.Colors.length > 0) {
                        v.Colors.forEach(c => {
                            const cName = (c.Name || 'Standard Color').trim();
                            const cKey = cName.toLowerCase();
                            if (!colorNameSet.has(cKey)) {
                                colorNameSet.add(cKey);
                                // Collect ONLY color-specific images for this color
                                const cImgs = [];
                                if (c.ImageUrl) cImgs.push(c.ImageUrl);
                                if (c.ImageUrls && Array.isArray(c.ImageUrls)) {
                                    c.ImageUrls.forEach(u => { if (u && !cImgs.includes(u)) cImgs.push(u); });
                                }
                                const stock = (c.CurrentStock !== undefined && c.CurrentStock !== null) ? c.CurrentStock : (c.InitialStock || 0);
                                colorOptions.push({
                                    name: cName,
                                    code: c.Code || '#4f46e5',
                                    images: cImgs,
                                    stock: stock,
                                    price: c.PurchasePrice || v.PurchasePrice || activeModalPrice
                                });
                            }
                        });
                    }
                });
            }

            if (colorOptions.length === 0) {
                const cName = (p.Color || 'Standard Color').trim();
                const pImgs = [];
                if (p.ImageUrl) pImgs.push(p.ImageUrl);
                if (p.ImageUrls && Array.isArray(p.ImageUrls)) {
                    p.ImageUrls.forEach(u => { if (u && !pImgs.includes(u)) pImgs.push(u); });
                }
                colorOptions.push({
                    name: cName,
                    code: '#4f46e5',
                    images: pImgs,
                    stock: p.CurrentStock || 0,
                    price: activeModalPrice
                });
            }

            // Render All Color Options list in Overview tab
            const colorsListEl = document.getElementById('ps_AllColorsList');
            if (colorsListEl) {
                colorsListEl.innerHTML = '';
                colorOptions.forEach(c => {
                    const badge = document.createElement('span');
                    badge.className = 'badge-d badge-gray py-1.5 px-2.5';
                    badge.style.cssText = 'font-size:12px;border:1px solid var(--border);display:inline-flex;align-items:center;gap:6px;cursor:pointer';
                    badge.onclick = () => selectColorOption(c);
                    badge.innerHTML = `<span style="width:10px;height:10px;border-radius:50%;background:${c.code || 'var(--primary)'};display:inline-block;border:1px solid rgba(255,255,255,0.2)"></span><strong style="color:var(--text-primary)">${escapeHtml(c.name)}</strong>`;
                    colorsListEl.appendChild(badge);
                });
            }

            // Render Interactive Color Swatches under Image Section
            const swatchesSection = document.getElementById('ps_ColorSwatchesSection');
            const swatchesStrip = document.getElementById('ps_ColorSwatchesStrip');
            const activeColorBadge = document.getElementById('ps_ActiveColorBadge');

            if (swatchesSection && swatchesStrip) {
                swatchesStrip.innerHTML = '';
                if (colorOptions.length > 0) {
                    swatchesSection.style.display = 'block';
                    colorOptions.forEach((c, index) => {
                        const btn = document.createElement('button');
                        btn.type = 'button';
                        btn.className = `btn btn-sm d-flex align-items-center gap-1.5 color-swatch-btn ${index === 0 ? 'active-swatch' : ''}`;
                        btn.style.cssText = `font-size:12px;font-weight:600;padding:4px 10px;border-radius:8px;border:1px solid ${index === 0 ? 'var(--primary)' : 'var(--border)'};background:${index === 0 ? 'rgba(79,70,229,0.15)' : 'var(--bg-card)'};color:var(--text-primary);transition:all 0.2s var(--ease)`;
                        btn.innerHTML = `
                            <span style="width:12px;height:12px;border-radius:50%;background:${c.code || '#4f46e5'};display:inline-block;border:1px solid rgba(255,255,255,0.3)"></span>
                            <span>${escapeHtml(c.name)}</span>
                        `;
                        btn.onclick = function() {
                            selectColorOption(c, this);
                        };
                        swatchesStrip.appendChild(btn);
                    });
                } else {
                    swatchesSection.style.display = 'none';
                }
            }

            window.selectColorOption = function(c, clickedBtn) {
                window.activeColorName = c.name;
                // STRICT COLOR ISOLATION: activeGalleryImages comes ONLY from c.images
                window.activeGalleryImages = c.images || [];
                window.activeGalleryIndex = 0;

                updateGalleryView(0);

                // Update Color text in Overview
                setElText('ps_Color', c.name);
                if (activeColorBadge) {
                    activeColorBadge.innerText = c.name;
                    activeColorBadge.style.display = 'inline-block';
                }
                // Update Price & Stock if color specific
                if (c.price > 0) {
                    setElText('ps_SupplierPrice', `₹${c.price.toLocaleString('en-IN', {minimumFractionDigits: 2})}`);
                }
                setElText('ps_Stock', `${c.stock || 0} Units`);

                // Update swatch active style
                if (swatchesStrip) {
                    swatchesStrip.querySelectorAll('.color-swatch-btn').forEach(btn => {
                        btn.style.borderColor = 'var(--border)';
                        btn.style.background = 'var(--bg-card)';
                    });
                }
                if (clickedBtn) {
                    clickedBtn.style.borderColor = 'var(--primary)';
                    clickedBtn.style.background = 'rgba(79,70,229,0.15)';
                }
            };

            // Set initial selected color state
            if (colorOptions.length > 0) {
                window.selectColorOption(colorOptions[0]);
            }

            // Supplier Profile
            if (sup) {
                setElText('ps_OverviewSupplier', sup.CompanyName || sup.DisplayCompanyName || sup.DisplayVendorName || '-');
                setElText('ps_SupCompany', sup.CompanyName || sup.DisplayCompanyName || 'Vendor');
                setElText('ps_SupStatus', sup.Status || 'Active');
                setElText('ps_SupContact', sup.ContactPerson || sup.DisplayContactPerson || '-');
                setElText('ps_SupPhone', sup.Phone || '-');
                setElText('ps_SupEmail', sup.Email || '-');
                setElText('ps_SupGstin', sup.Gstin || 'Not Registered');
                setElText('ps_SupTerms', sup.PaymentTerms || 'Net 30 Days');
                const fullAddr = [sup.Address, sup.City, sup.State, sup.Country].filter(Boolean).join(', ');
                setElText('ps_SupAddress', fullAddr || 'No physical address provided.');
            }

            // Specs
            setElText('ps_Proc', s.ProcessorName || s.ProcessorBrand || p.Processor || '-');
            setElText('ps_Cores', s.CpuCores || '-');
            setElText('ps_Gpu', s.Gpu || '-');
            setElText('ps_Ram', s.RamType || p.Ram || 'N/A (iOS/Standard)');
            setElText('ps_Storage', s.StorageType || p.Storage || '-');
            setElText('ps_Expandable', s.ExpandableStorage ? 'Supported' : 'No');

            setElText('ps_DispSize', s.DisplaySize || p.DisplaySize || '-');
            setElText('ps_DispRes', s.Resolution || '-');
            setElText('ps_Refresh', s.RefreshRate || '-');
            setElText('ps_RearCam', s.PrimaryRearCameraMp || '-');
            setElText('ps_FrontCam', s.FrontCameraMp || '-');

            setElText('ps_Battery', (s.BatteryCapacityMah && s.BatteryCapacityMah > 0) ? `${s.BatteryCapacityMah} mAh` : (p.BatteryCapacity || '-'));
            setElText('ps_Charging', s.FastChargingWattage || '-');
            setElText('ps_5G', s.Network5G ? '5G Supported' : '4G LTE');
            setElText('ps_Sim', s.SimType || p.SimType || '-');

            setElText('ps_OS', s.OperatingSystem || s.OsVersion || p.OperatingSystem || '-');
            setElText('ps_Biometrics', s.FingerprintSensor || '-');
            setElText('ps_IP', s.WaterResistance || '-');
            setElText('ps_NFC', s.Nfc ? 'Available' : 'No');

            const overviewTabBtn = document.querySelector('[data-bs-target="#mps-overview"]');
            if (overviewTabBtn) {
                const tab = bootstrap.Tab.getOrCreateInstance(overviewTabBtn);
                tab.show();
            }

            const modalEl = document.getElementById('productSpecsModal');
            if (modalEl) {
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
            }
        }

        // Gallery Carousel & Fullscreen Lightbox logic
        window.activeGalleryImages = [];
        window.activeGalleryIndex = 0;
        window.activeColorName = '';
        window.activeProductName = '';
        window.fsGalleryIndex = 0;

        window.updateGalleryView = function(index) {
            const mainImg = document.getElementById('ps_MainImg');
            const counterPill = document.getElementById('ps_ImageCounterPill');
            const btnPrev = document.getElementById('ps_BtnPrevImg');
            const btnNext = document.getElementById('ps_BtnNextImg');
            const thumbStrip = document.getElementById('ps_ThumbStrip');

            const imgs = window.activeGalleryImages || [];
            if (imgs.length === 0) {
                window.activeGalleryIndex = 0;
                if (mainImg) {
                    mainImg.src = 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="300" height="200" viewBox="0 0 300 200"><rect width="300" height="200" fill="%231e293b"/><text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" fill="%2364748b" font-family="sans-serif" font-size="14">No Photo Available For This Color</text></svg>';
                }
                if (counterPill) counterPill.style.display = 'none';
                if (btnPrev) btnPrev.style.display = 'none';
                if (btnNext) btnNext.style.display = 'none';
                if (thumbStrip) thumbStrip.innerHTML = '';
                return;
            }

            window.activeGalleryIndex = Math.max(0, Math.min(index, imgs.length - 1));
            const currentUrl = imgs[window.activeGalleryIndex];

            if (mainImg) mainImg.src = currentUrl;

            if (counterPill) {
                counterPill.innerText = `${window.activeGalleryIndex + 1} / ${imgs.length}`;
                counterPill.style.display = 'inline-block';
            }

            if (btnPrev) btnPrev.style.display = imgs.length > 1 ? 'flex' : 'none';
            if (btnNext) btnNext.style.display = imgs.length > 1 ? 'flex' : 'none';

            if (thumbStrip) {
                thumbStrip.innerHTML = '';
                if (imgs.length > 1) {
                    imgs.forEach((imgUrl, i) => {
                        const thumb = document.createElement('img');
                        thumb.src = imgUrl;
                        thumb.className = `rounded thumb-img ${i === window.activeGalleryIndex ? 'active-thumb' : ''}`;
                        thumb.style.cssText = `width:44px;height:44px;object-fit:cover;cursor:pointer;border:2px solid ${i === window.activeGalleryIndex ? 'var(--primary)' : 'var(--border)'};border-radius:8px;transition:all 0.2s var(--ease)`;
                        thumb.onclick = function() {
                            updateGalleryView(i);
                        };
                        thumbStrip.appendChild(thumb);
                    });
                }
            }
        };

        window.navigateGalleryImg = function(delta) {
            const imgs = window.activeGalleryImages || [];
            if (imgs.length <= 1) return;
            let nextIndex = window.activeGalleryIndex + delta;
            if (nextIndex < 0) nextIndex = imgs.length - 1;
            if (nextIndex >= imgs.length) nextIndex = 0;
            updateGalleryView(nextIndex);
        };

        window.openFullscreenGalleryModal = function() {
            const imgs = window.activeGalleryImages || [];
            if (imgs.length === 0) return;
            window.fsGalleryIndex = window.activeGalleryIndex || 0;

            const p = window.activeModalProduct || {};
            const titleEl = document.getElementById('fs_Title');
            if (titleEl) {
                const colorStr = window.activeColorName ? ` (${window.activeColorName})` : '';
                titleEl.innerText = `${p.Name || 'Product Image'}${colorStr}`;
            }

            renderFsGalleryView(window.fsGalleryIndex);

            const modalEl = document.getElementById('fullscreenImageModal');
            if (modalEl) {
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
            }
        };

        window.renderFsGalleryView = function(index) {
            const imgs = window.activeGalleryImages || [];
            if (imgs.length === 0) return;
            window.fsGalleryIndex = (index + imgs.length) % imgs.length;

            const fsMainImg = document.getElementById('fs_MainImg');
            if (fsMainImg) fsMainImg.src = imgs[window.fsGalleryIndex];

            const fsCounter = document.getElementById('fs_Counter');
            if (fsCounter) fsCounter.innerText = `Image ${window.fsGalleryIndex + 1} of ${imgs.length}`;

            const fsPrev = document.getElementById('fs_BtnPrev');
            const fsNext = document.getElementById('fs_BtnNext');
            if (fsPrev) fsPrev.style.display = imgs.length > 1 ? 'flex' : 'none';
            if (fsNext) fsNext.style.display = imgs.length > 1 ? 'flex' : 'none';

            const fsThumbStrip = document.getElementById('fs_ThumbStrip');
            if (fsThumbStrip) {
                fsThumbStrip.innerHTML = '';
                if (imgs.length > 1) {
                    imgs.forEach((imgUrl, i) => {
                        const thumb = document.createElement('img');
                        thumb.src = imgUrl;
                        thumb.style.cssText = `width:56px;height:56px;object-fit:cover;border-radius:10px;cursor:pointer;border:2px solid ${i === window.fsGalleryIndex ? 'var(--primary)' : 'rgba(255,255,255,0.2)'};transition:all 0.2s var(--ease)`;
                        thumb.onclick = () => renderFsGalleryView(i);
                        fsThumbStrip.appendChild(thumb);
                    });
                }
            }
        };

        window.navigateFsGallery = function(delta) {
            renderFsGalleryView(window.fsGalleryIndex + delta);
        };

        // Keyboard arrow key listener for smooth carousel swiping
        document.addEventListener('keydown', function(e) {
            const fsModal = document.getElementById('fullscreenImageModal');
            if (fsModal && fsModal.classList.contains('show')) {
                if (e.key === 'ArrowLeft') {
                    navigateFsGallery(-1);
                } else if (e.key === 'ArrowRight') {
                    navigateFsGallery(1);
                }
            } else {
                const psModal = document.getElementById('productSpecsModal');
                if (psModal && psModal.classList.contains('show')) {
                    if (e.key === 'ArrowLeft') {
                        navigateGalleryImg(-1);
                    } else if (e.key === 'ArrowRight') {
                        navigateGalleryImg(1);
                    }
                }
            }
        });

        // Supplier Modal Inspection
        function openDirectSupplierModal(supOrId) {
            if (!supOrId) return;
            let sup = null;
            if (typeof supOrId === 'string') {
                sup = window.supplierLookup ? window.supplierLookup[supOrId] : null;
            } else if (typeof supOrId === 'object') {
                sup = supOrId;
            }

            if (!sup) {
                console.warn('Supplier not found for identifier:', supOrId);
                return;
            }

            const vName = sup.vendorName || sup.VendorName || sup.companyName || sup.CompanyName || 'Supplier Vendor';
            const cName = sup.companyName || sup.CompanyName || sup.vendorName || sup.VendorName || '-';

            const dsVendorHeader = document.getElementById('ds_VendorHeaderTitle');
            if (dsVendorHeader) dsVendorHeader.innerText = vName;

            const dsCompanyHeader = document.getElementById('ds_CompanyHeaderSub');
            if (dsCompanyHeader) {
                dsCompanyHeader.innerText = (cName && cName !== vName && cName !== '-') 
                    ? `${cName} · Vendor Profile & Contact Directory` 
                    : 'Vendor Profile & Contact Directory';
            }

            const dsTitle = document.getElementById('ds_CompanyName');
            if (dsTitle) dsTitle.innerText = vName;

            const dsVendorName = document.getElementById('ds_VendorName');
            if (dsVendorName) dsVendorName.innerText = vName;

            const dsLegalName = document.getElementById('ds_LegalName');
            if (dsLegalName) dsLegalName.innerText = cName;

            const dsStatus = document.getElementById('ds_Status');
            if (dsStatus) {
                const statusStr = sup.status || sup.Status || 'Active';
                dsStatus.innerText = statusStr;
                dsStatus.className = (statusStr.toLowerCase() === 'active') 
                    ? 'badge bg-success-subtle text-success fs-6' 
                    : 'badge bg-danger-subtle text-danger fs-6';
            }

            const contactVal = (sup.contactPerson && sup.contactPerson.trim() && sup.contactPerson.trim() !== '-') 
                ? sup.contactPerson.trim() 
                : ((sup.companyName && sup.companyName.trim()) ? sup.companyName.trim() : (sup.vendorName || '-'));

            const dsContactPerson = document.getElementById('ds_ContactPerson');
            if (dsContactPerson) dsContactPerson.innerText = contactVal;

            const phone = sup.phone || sup.Phone || '';
            const dsPhone = document.getElementById('ds_Phone');
            const dsPhoneLink = document.getElementById('ds_PhoneLink');
            if (dsPhone) dsPhone.innerText = phone || '-';
            if (dsPhoneLink) dsPhoneLink.href = phone ? `tel:${phone}` : '#';

            const email = sup.email || sup.Email || '';
            const dsEmail = document.getElementById('ds_Email');
            const dsEmailLink = document.getElementById('ds_EmailLink');
            if (dsEmail) dsEmail.innerText = email || '-';
            if (dsEmailLink) dsEmailLink.href = email ? `mailto:${email}` : '#';

            const dsGstin = document.getElementById('ds_Gstin');
            if (dsGstin) dsGstin.innerText = sup.gstin || sup.Gstin || 'Not Registered';

            const dsPaymentTerms = sup.paymentTerms || sup.PaymentTerms || 'Net 30 Days';
            const dsPaymentTermsEl = document.getElementById('ds_PaymentTerms');
            if (dsPaymentTermsEl) dsPaymentTermsEl.innerText = dsPaymentTerms;

            const payable = Number(sup.outstandingPayable ?? sup.OutstandingPayable ?? 0);
            const dsOutstandingPayable = document.getElementById('ds_OutstandingPayable');
            if (dsOutstandingPayable) {
                dsOutstandingPayable.innerText = `₹${payable.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
            }

            const city = sup.city || sup.City;
            const state = sup.state || sup.State;
            const country = sup.country || sup.Country;
            const cityState = [city, state, country].filter(Boolean).join(', ');
            const dsCityState = document.getElementById('ds_CityState');
            if (dsCityState) dsCityState.innerText = cityState || '-';

            const address = sup.address || sup.Address;
            const fullAddr = [address, city, state, country].filter(Boolean).join(', ');
            const dsAddress = document.getElementById('ds_Address');
            if (dsAddress) dsAddress.innerText = fullAddr || 'No physical address provided.';

            const modalEl = document.getElementById('directSupplierDetailsModal');
            if (modalEl) {
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
            }
        }

        // Live Filter suppliers search on Step 1
        function filterSupplierCards() {
            const query = (document.getElementById('supplierSearchInput')?.value || '').toLowerCase().trim();
            const cards = document.querySelectorAll('.supplier-item-card');
            cards.forEach(card => {
                const kw = card.getAttribute('data-keywords') || '';
                card.style.display = kw.includes(query) ? '' : 'none';
            });
        }

        // Init
        document.addEventListener('DOMContentLoaded', function () {
            loadCartFromStorage();
        });
    </script>
}
