@model InventoryManagementSystem.Models.SupplierOrder
@{
    ViewData["Title"] = $"PO Details #{Model.OrderNumber}";
    var supplier = ViewBag.Supplier as InventoryManagementSystem.Models.Supplier;
    var statusBadge = Model.Status switch
    {
        "Pending" => "badge-warning",
        "Accepted" => "badge-info",
        "Processing" => "badge-primary",
        "Shipped" => "badge-primary",
        "Delivered" => "badge-success",
        "Completed" => "badge-success",
        "Rejected" => "badge-danger",
        "Cancelled" => "badge-gray",
        _ => "badge-gray"
    };
}

<!-- Page Header -->
<div class="ph">
    <div>
        <h1 class="ph-title"><i class="bi bi-file-earmark-text me-2" style="color:var(--primary)"></i>Purchase Order #@Model.OrderNumber</h1>
        <p class="ph-sub">Issued by: <strong>@Model.CreatedBy</strong> · Created: <strong>@Model.CreatedAt.ToString("dd-MMM-yyyy HH:mm") IST</strong></p>
    </div>
    <div class="ph-actions d-flex gap-2">
        @if (Model.Status == "Delivered" || Model.Status == "Completed" || Model.Status == "Accepted" || Model.Status == "Processing" || Model.Status == "Shipped")
        {
            <a href="@Url.Action("Create", "PurchaseReturn", new { orderId = Model.Id })" class="btn-d btn-warning" title="Initiate Purchase Return claim for this order">
                <i class="bi bi-arrow-return-left me-1"></i> Return Purchase
            </a>
        }
        @if (Model.Status == "Delivered" || Model.Status == "Completed" || Model.Status == "Rejected" || Model.Status == "Cancelled")
        {
            <form method="post" action="@Url.Action("Delete")" class="d-inline" onsubmit="return confirm('Are you sure you want to delete purchase order history entry #@Model.OrderNumber?\n\nNote: Product stock will NOT be changed.');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn-d btn-danger">
                    <i class="bi bi-trash me-1"></i> Delete Order History
                </button>
            </form>
        }
        <a href="@Url.Action("Index")" class="btn-d btn-outline">
            <i class="bi bi-arrow-left me-1"></i> Order Management
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Items Table & Snapshots -->
    <div class="col-lg-8">
        <div class="card-d card-p-lg mb-4">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="s-title mb-0"><i class="bi bi-box-seam me-2" style="color:var(--primary)"></i>Ordered Items & Snapshots</div>
                <span class="badge-d @statusBadge" style="font-size:13px;padding:6px 12px">@Model.Status</span>
            </div>

            <div class="tbl-scroll rounded border overflow-hidden mb-3" style="border-color:var(--border)!important">
                <table class="tbl mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Product Details</th>
                            <th>Brand / Model</th>
                            <th>Unit Price (₹)</th>
                            <th>Quantity</th>
                            <th class="text-end pe-4">Subtotal (₹)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div style="font-weight:700;color:var(--text-primary)">@item.ProductName</div>
                                    <div style="font-size:11px;color:var(--text-muted)">Variant: @(string.IsNullOrEmpty(item.Variant) ? $"{item.Ram} / {item.Storage}" : item.Variant) · Color: @item.Color</div>
                                </td>
                                <td>
                                    <div style="font-weight:600;color:var(--text-primary)">@item.Brand</div>
                                    <div style="font-size:11px;color:var(--text-muted)">@item.Model</div>
                                </td>
                                <td style="font-weight:600">₹@item.UnitPrice.ToString("N2")</td>
                                <td style="font-weight:700">@item.Quantity Units</td>
                                <td class="text-end pe-4" style="font-weight:800;color:var(--success)">₹@item.Subtotal.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="p-3 rounded" style="background:var(--bg);border:1px solid var(--border)">
                <div class="d-flex align-items-center justify-content-between">
                    <span style="font-size:16px;font-weight:800;color:var(--text-primary)">Grand Total Amount:</span>
                    <span style="font-size:22px;font-weight:800;color:var(--success)">₹@Model.GrandTotal.ToString("N2")</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Status & Vendor Summary -->
    <div class="col-lg-4">
        <div class="card-d card-p-lg mb-4">
            <div class="s-title"><i class="bi bi-truck me-2" style="color:var(--primary)"></i>Vendor Information</div>
            <div class="mb-2"><strong>Company:</strong> @Model.SupplierName</div>
            <div class="mb-2"><strong>Email:</strong> @Model.SupplierEmail</div>
            <div class="mb-2"><strong>Phone:</strong> @(string.IsNullOrEmpty(Model.SupplierPhone) ? "-" : Model.SupplierPhone)</div>
            <div>
                <strong>Email Alert:</strong>
                @if (Model.EmailSent)
                {
                    <span class="badge-d badge-success ms-1">Sent to Supplier</span>
                }
                else
                {
                    <span class="badge-d badge-warning ms-1">Pending / Not Sent</span>
                }
            </div>
        </div>

        <div class="card-d card-p-lg">
            <div class="s-title"><i class="bi bi-clock-history me-2" style="color:var(--primary)"></i>Supplier Fulfillment Status</div>
            
            <div class="mb-3">
                <div style="font-size:12px;color:var(--text-muted)">Current Order Status:</div>
                <div class="mt-1"><span class="badge-d @statusBadge" style="font-size:13px;padding:5px 12px">@Model.Status</span></div>
            </div>

            <div class="mb-3">
                <div style="font-size:12px;color:var(--text-muted)">Expected Delivery Date (Set by Supplier):</div>
                <div style="font-size:14px;font-weight:700;color:var(--text-primary)" class="mt-1">
                    <i class="bi bi-calendar-event me-1 text-primary"></i>
                    @(Model.ExpectedDeliveryDate.HasValue ? Model.ExpectedDeliveryDate.Value.ToString("dd-MMM-yyyy") : "Awaiting Supplier Confirmation")
                </div>
            </div>

            <div class="mb-3">
                <div style="font-size:12px;color:var(--text-muted)">Supplier Notes / Tracking Info:</div>
                <div class="p-2 rounded mt-1" style="background:var(--bg);border:1px solid var(--border);font-size:13px;color:var(--text-primary)">
                    @(string.IsNullOrWhiteSpace(Model.SupplierNotes) ? "No notes added by supplier yet." : Model.SupplierNotes)
                </div>
            </div>

            <div class="mb-3">
                <div style="font-size:12px;color:var(--text-muted)">Order Instructions / Notes:</div>
                <div class="p-2 rounded mt-1" style="background:var(--bg);border:1px solid var(--border);font-size:13px;color:var(--text-primary)">
                    @(string.IsNullOrWhiteSpace(Model.Notes) ? "None specified." : Model.Notes)
                </div>
            </div>

            @if (Model.Status == "Pending" || Model.Status == "Accepted" || Model.Status == "Processing")
            {
                <form asp-action="UpdateStatus" method="post" class="mt-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="orderId" value="@Model.Id" />
                    <input type="hidden" name="newStatus" value="Cancelled" />
                    <button type="submit" class="btn-d btn-outline text-danger w-100" onclick="return confirm('Are you sure you want to cancel this purchase order?')">
                        <i class="bi bi-x-circle me-1"></i> Cancel Purchase Order
                    </button>
                </form>
            }
        </div>
    </div>
</div>
