@model InventoryManagementSystem.Models.SupplierOrder
@{
    ViewData["Title"] = "Review Purchase Order";
    var supplier = ViewBag.Supplier as InventoryManagementSystem.Models.Supplier;
}

<!-- Page Header -->
<div class="ph">
    <div>
        <h1 class="ph-title"><i class="bi bi-clipboard-check me-2" style="color:var(--primary)"></i>Review Purchase Order</h1>
        <p class="ph-sub">Verify order items, subtotals, vendor information, and expected delivery before confirming</p>
    </div>
    <div class="ph-actions">
        <a href="@Url.Action("Create", new { selectedSupplierId = Model.SupplierId })" class="btn-d btn-outline">
            <i class="bi bi-arrow-left me-1"></i> Modify Items Basket
        </a>
    </div>
</div>

<form asp-action="SubmitOrder" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="SupplierId" />
    <input type="hidden" asp-for="SupplierName" />
    <input type="hidden" asp-for="SupplierVendorName" />
    <input type="hidden" asp-for="SupplierCompanyName" />
    <input type="hidden" asp-for="SupplierEmail" />
    <input type="hidden" asp-for="SupplierPhone" />

    <div class="row g-4 mb-4">
        <!-- Left Column: Order Items Basket -->
        <div class="col-lg-8">
            <div class="card-d card-p-lg">
                <div class="s-title mb-3"><i class="bi bi-cart-check me-2" style="color:var(--primary)"></i>Order Items Basket (@Model.TotalQuantity Units)</div>

                <div class="tbl-scroll rounded border overflow-hidden mb-3" style="border-color:var(--border)!important">
                    <table class="tbl mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">Product</th>
                                <th>Brand / Variant</th>
                                <th>Supplier Stock</th>
                                <th>Unit Price (₹)</th>
                                <th>Requested Qty</th>
                                <th class="text-end pe-4">Subtotal (₹)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Items.Count; i++)
                            {
                                var item = Model.Items[i];
                                <tr>
                                    <td class="ps-4">
                                        <input type="hidden" name="Items[@i].ProductId" value="@item.ProductId" />
                                        <input type="hidden" name="Items[@i].ProductName" value="@item.ProductName" />
                                        <input type="hidden" name="Items[@i].Brand" value="@item.Brand" />
                                        <input type="hidden" name="Items[@i].Model" value="@item.Model" />
                                        <input type="hidden" name="Items[@i].VariantId" value="@item.VariantId" />
                                        <input type="hidden" name="Items[@i].ColorId" value="@item.ColorId" />
                                        <input type="hidden" name="Items[@i].Variant" value="@item.Variant" />
                                        <input type="hidden" name="Items[@i].Color" value="@item.Color" />
                                        <input type="hidden" name="Items[@i].Ram" value="@item.Ram" />
                                        <input type="hidden" name="Items[@i].Storage" value="@item.Storage" />
                                        <input type="hidden" name="Items[@i].ImageUrl" value="@item.ImageUrl" />
                                        <input type="hidden" name="Items[@i].UnitPrice" value="@item.UnitPrice" />
                                        <input type="hidden" name="Items[@i].Quantity" value="@item.Quantity" />
                                        <input type="hidden" name="Items[@i].AvailableStock" value="@item.AvailableStock" />

                                        <div style="font-weight:700;color:var(--text-primary)">@item.ProductName</div>
                                        <div style="font-size:11px;color:var(--text-muted)">Color: @item.Color</div>
                                    </td>
                                    <td>
                                        <div style="font-weight:600;color:var(--text-primary)">@item.Brand</div>
                                        <div style="font-size:11px;color:var(--text-muted)">@item.DisplayVariant</div>
                                    </td>
                                    <td>
                                        <span class="badge-d @(item.AvailableStock <= 0 ? "badge-danger" : (item.Quantity > item.AvailableStock ? "badge-warning" : "badge-gray"))" style="font-size:11px">
                                            @item.AvailableStock Units
                                        </span>
                                    </td>
                                    <td style="font-weight:600">₹@item.UnitPrice.ToString("N2")</td>
                                    <td style="font-weight:700">
                                        @item.Quantity Units
                                        @if (item.Quantity > item.AvailableStock)
                                        {
                                            <div class="text-warning mt-1" style="font-size:11px;font-weight:700">
                                                <i class="bi bi-exclamation-triangle-fill me-1"></i> Exceeds stock (@item.AvailableStock available)
                                            </div>
                                        }
                                    </td>
                                    <td class="text-end pe-4" style="font-weight:800;color:var(--success)">₹@item.Subtotal.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="p-3 rounded mb-3" style="background:var(--bg);border:1px solid var(--border)">
                    <div class="d-flex align-items-center justify-content-between">
                        <span style="font-size:16px;font-weight:800;color:var(--text-primary)">Order Subtotal Amount:</span>
                        <span style="font-size:22px;font-weight:800;color:var(--success)">₹@Model.Subtotal.ToString("N2")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Vendor Summary & Submission -->
        <div class="col-lg-4">
            <div class="card-d card-p-lg">
                <div class="s-title"><i class="bi bi-truck me-2" style="color:var(--primary)"></i>Vendor Information</div>

                <div class="mb-3">
                    <div style="font-size:12px;color:var(--text-muted)">Vendor / Brand:</div>
                    <div style="font-size:15px;font-weight:700;color:var(--text-primary)">@Model.DisplaySupplierVendorName</div>
                </div>
                <div class="mb-3">
                    <div style="font-size:12px;color:var(--text-muted)">Company / Legal Name:</div>
                    <div style="font-size:14px;color:var(--text-secondary);font-weight:600">@Model.DisplaySupplierCompanyName</div>
                </div>
                <div class="mb-3">
                    <div style="font-size:12px;color:var(--text-muted)">Supplier Email:</div>
                    <div style="font-size:13px;color:var(--text-primary)">@Model.SupplierEmail</div>
                </div>
                <div class="mb-3">
                    <div style="font-size:12px;color:var(--text-muted)">Contact Phone:</div>
                    <div style="font-size:13px;color:var(--text-primary)">@(string.IsNullOrEmpty(Model.SupplierPhone) ? "-" : Model.SupplierPhone)</div>
                </div>

                <hr class="s-divider" />

                <div class="fg mb-3">
                    <label class="fg-label">Purchase Order Instructions / Notes</label>
                    <textarea asp-for="Notes" rows="3" class="fg-control" placeholder="Add procurement notes or delivery instructions for supplier..."></textarea>
                    <div class="form-text mt-1 text-muted" style="font-size:11px">
                        <i class="bi bi-info-circle me-1"></i> Expected delivery date will be confirmed by the supplier on their portal upon accepting this PO.
                    </div>
                </div>

                <button type="submit" class="btn-d btn-primary w-100 btn-lg-d">
                    <i class="bi bi-check2-circle me-1"></i> Confirm & Issue Purchase Order
                </button>
            </div>
        </div>
    </div>
</form>
