@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const wizardTabIds = ['cust-tab', 'device-tab', 'condition-tab', 'security-tab', 'accessories-tab', 'photos-tab', 'valuation-tab'];
        const wizardTabLabels = [
            'Next: 2. Old Device Specs',
            'Next: 3. Condition Inspection',
            'Next: 4. Security Locks',
            'Next: 5. Accessories',
            'Next: 6. Device Photos',
            'Next: 7. Valuation & Destination',
            'Accept Trade-In'
        ];

        let currentTabIdx = 0;

        function updateWizardButtons() {
            const prevBtn = document.getElementById('prevTabBtn');
            const nextBtn = document.getElementById('nextTabBtn');
            const submitBtn = document.getElementById('submitTradeInBtn');

            prevBtn.disabled = (currentTabIdx === 0);

            if (currentTabIdx === wizardTabIds.length - 1) {
                nextBtn.style.display = 'none';
                submitBtn.style.display = 'inline-flex';
            } else {
                nextBtn.style.display = 'inline-flex';
                submitBtn.style.display = 'none';
                nextBtn.innerHTML = `${wizardTabLabels[currentTabIdx]} <i class="bi bi-chevron-right ms-1"></i>`;
            }
        }

        function navigateWizard(direction) {
            if (direction > 0) {
                // Validate inputs in current active tab before moving forward
                const currentPaneId = wizardTabIds[currentTabIdx].replace('-tab', '-tab-pane');
                const currentPane = document.getElementById(currentPaneId);
                if (currentPane) {
                    const inputs = currentPane.querySelectorAll('input, select, textarea');
                    for (let input of inputs) {
                        if (!input.checkValidity()) {
                            input.reportValidity();
                            return false;
                        }
                    }
                }
            }

            const newIdx = currentTabIdx + direction;
            if (newIdx >= 0 && newIdx < wizardTabIds.length) {
                const tabBtn = document.getElementById(wizardTabIds[newIdx]);
                if (tabBtn) {
                    const bsTab = bootstrap.Tab.getOrCreateInstance(tabBtn);
                    bsTab.show();
                }
            }
        }

        // Sync button states when user manually clicks tab headers
        document.querySelectorAll('#tradeInTabs button[data-bs-toggle="tab"]').forEach((btn, idx) => {
            btn.addEventListener('shown.bs.tab', (e) => {
                const targetId = e.target.id;
                const foundIdx = wizardTabIds.indexOf(targetId);
                if (foundIdx !== -1) {
                    currentTabIdx = foundIdx;
                    updateWizardButtons();
                }
            });
        });

        function onBrandSelectChange(select) {
            const val = select.value;
            const customBox = document.getElementById('customBrandBox');
            const customInput = document.getElementById('customBrandInput');
            const finalInput = document.getElementById('finalBrandInput');

            if (val === 'Other') {
                customBox.style.display = 'block';
                customInput.required = true;
                finalInput.value = customInput.value.trim();
            } else {
                customBox.style.display = 'none';
                customInput.required = false;
                finalInput.value = val;
            }
        }

        function updateBrandValue() {
            const select = document.getElementById('brandSelect');
            if (select.value === 'Other') {
                document.getElementById('finalBrandInput').value = document.getElementById('customBrandInput').value.trim();
            }
        }

        function onColorSelectChange(select) {
            const val = select.value;
            const customBox = document.getElementById('customColorBox');
            const customInput = document.getElementById('customColorInput');
            const finalInput = document.getElementById('finalColorInput');

            if (val === 'Other') {
                customBox.style.display = 'block';
                customInput.required = true;
                finalInput.value = customInput.value.trim();
            } else {
                customBox.style.display = 'none';
                customInput.required = false;
                finalInput.value = val;
            }
        }

        function updateColorValue() {
            const select = document.getElementById('colorSelect');
            if (select.value === 'Other') {
                document.getElementById('finalColorInput').value = document.getElementById('customColorInput').value.trim();
            }
        }

        // ==========================================
        // --- LIVE CAMERA & PHOTO ATTACHMENTS LOGIC ---
        // ==========================================
        let newPhotosList = []; // { id, name, type: 'file'|'camera', dataUrl, file?: File }
        let editPhotosList = []; // Newly added photos in edit modal
        let editExistingPhotos = []; // Existing photo URLs in edit modal

        let cameraStream = null;
        let currentFacingMode = 'environment'; // 'environment' (rear) or 'user' (front)
        let cameraActiveTarget = 'new'; // 'new' or 'edit'
        let sessionCapturedPhotos = [];

        function openLiveCamera(target) {
            cameraActiveTarget = target || 'new';
            sessionCapturedPhotos = [];
            const countEl = document.getElementById('sessionCapturedCount');
            if (countEl) countEl.textContent = '0';
            const strip = document.getElementById('cameraFilmstrip');
            if (strip) strip.innerHTML = '';
            const stripWrap = document.getElementById('cameraFilmstripWrap');
            if (stripWrap) stripWrap.style.display = 'none';

            const camModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('liveCameraModal'));
            camModal.show();

            startCameraStream();
        }

        async function startCameraStream() {
            const errorBanner = document.getElementById('cameraErrorBanner');
            const liveStatus = document.getElementById('cameraLiveStatus');
            if (errorBanner) errorBanner.style.display = 'none';

            if (cameraStream) {
                cameraStream.getTracks().forEach(track => track.stop());
                cameraStream = null;
            }

            const videoEl = document.getElementById('liveCameraVideo');
            if (!videoEl) return;

            try {
                const constraints = {
                    video: {
                        facingMode: { ideal: currentFacingMode },
                        width: { ideal: 1920 },
                        height: { ideal: 1080 }
                    },
                    audio: false
                };

                cameraStream = await navigator.mediaDevices.getUserMedia(constraints);
                videoEl.srcObject = cameraStream;
                await videoEl.play();
                if (liveStatus) {
                    liveStatus.className = 'badge-d badge-red d-flex align-items-center gap-1';
                    liveStatus.innerHTML = '<span class="spinner-grow spinner-grow-sm text-danger" style="width:8px;height:8px" role="status"></span> LIVE';
                }
            } catch (err) {
                console.warn('Initial camera constraint error, falling back to basic camera:', err);
                try {
                    cameraStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });
                    videoEl.srcObject = cameraStream;
                    await videoEl.play();
                    if (liveStatus) {
                        liveStatus.className = 'badge-d badge-red d-flex align-items-center gap-1';
                        liveStatus.innerHTML = '<span class="spinner-grow spinner-grow-sm text-danger" style="width:8px;height:8px" role="status"></span> LIVE';
                    }
                } catch (fallbackErr) {
                    console.error('All camera attempts failed:', fallbackErr);
                    if (errorBanner) errorBanner.style.display = 'flex';
                    const msgEl = document.getElementById('cameraErrorMessage');
                    if (msgEl) {
                        msgEl.textContent = 'Camera access blocked or unavailable: ' + (fallbackErr.message || 'Please enable camera permissions in your browser.');
                    }
                    if (liveStatus) {
                        liveStatus.className = 'badge-d badge-gray';
                        liveStatus.textContent = 'OFFLINE';
                    }
                }
            }
        }

        function closeLiveCamera() {
            if (cameraStream) {
                cameraStream.getTracks().forEach(track => track.stop());
                cameraStream = null;
            }
            const videoEl = document.getElementById('liveCameraVideo');
            if (videoEl) videoEl.srcObject = null;

            const modalEl = document.getElementById('liveCameraModal');
            const bsModal = bootstrap.Modal.getInstance(modalEl);
            if (bsModal) bsModal.hide();
        }

        function toggleCameraFacingMode() {
            currentFacingMode = (currentFacingMode === 'environment') ? 'user' : 'environment';
            startCameraStream();
        }

        function takeLiveSnapshot() {
            const videoEl = document.getElementById('liveCameraVideo');
            const canvasEl = document.getElementById('liveCameraCanvas');
            const flashEl = document.getElementById('cameraFlashOverlay');

            if (!videoEl || !videoEl.videoWidth || !videoEl.videoHeight) {
                alert('Camera video stream is not ready. Please ensure camera is allowed and running.');
                return;
            }

            // Visual shutter flash effect
            if (flashEl) {
                flashEl.style.opacity = '0.9';
                setTimeout(() => { flashEl.style.opacity = '0'; }, 130);
            }

            // Set canvas size matching the active video stream frame
            canvasEl.width = videoEl.videoWidth;
            canvasEl.height = videoEl.videoHeight;
            const ctx = canvasEl.getContext('2d');
            ctx.drawImage(videoEl, 0, 0, canvasEl.width, canvasEl.height);

            const dataUrl = canvasEl.toDataURL('image/jpeg', 0.92);
            const photoId = 'cam_' + Date.now() + '_' + Math.random().toString(36).substr(2, 5);

            const newPhotoItem = {
                id: photoId,
                type: 'camera',
                dataUrl: dataUrl,
                name: `Camera Capture #${sessionCapturedPhotos.length + 1}`
            };

            sessionCapturedPhotos.push(newPhotoItem);
            const countEl = document.getElementById('sessionCapturedCount');
            if (countEl) countEl.textContent = sessionCapturedPhotos.length;

            // Add thumbnail to viewfinder filmstrip
            const filmstrip = document.getElementById('cameraFilmstrip');
            const filmstripWrap = document.getElementById('cameraFilmstripWrap');
            if (filmstripWrap) filmstripWrap.style.display = 'block';

            if (filmstrip) {
                const thumbDiv = document.createElement('div');
                thumbDiv.className = 'd-inline-block position-relative rounded overflow-hidden shadow-sm flex-shrink-0';
                thumbDiv.style.cssText = 'width:60px;height:60px;border:2px solid var(--primary);background:#000';
                thumbDiv.innerHTML = `<img src="${dataUrl}" style="width:100%;height:100%;object-fit:cover" />`;
                filmstrip.prepend(thumbDiv);
            }

            // Push to respective active target
            if (cameraActiveTarget === 'new') {
                newPhotosList.push(newPhotoItem);
                renderNewPhotosGallery();
            } else {
                editPhotosList.push(newPhotoItem);
                renderEditPhotosGallery();
            }
        }

        function handleNewPhotoFiles(files) {
            if (!files || !files.length) return;
            Array.from(files).forEach((file, idx) => {
                const reader = new FileReader();
                reader.onload = function(e) {
                    newPhotosList.push({
                        id: 'file_' + Date.now() + '_' + idx + '_' + Math.random().toString(36).substr(2, 4),
                        type: 'file',
                        dataUrl: e.target.result,
                        name: file.name,
                        file: file
                    });
                    renderNewPhotosGallery();
                };
                reader.readAsDataURL(file);
            });
        }

        function handleEditPhotoFiles(files) {
            if (!files || !files.length) return;
            Array.from(files).forEach((file, idx) => {
                const reader = new FileReader();
                reader.onload = function(e) {
                    editPhotosList.push({
                        id: 'edit_file_' + Date.now() + '_' + idx + '_' + Math.random().toString(36).substr(2, 4),
                        type: 'file',
                        dataUrl: e.target.result,
                        name: file.name,
                        file: file
                    });
                    renderEditPhotosGallery();
                };
                reader.readAsDataURL(file);
            });
        }

        function renderNewPhotosGallery() {
            const gallery = document.getElementById('newPhotosGallery');
            const badge = document.getElementById('newPhotoCountBadge');
            const countText = document.getElementById('newPhotosCountText');
            const clearBtn = document.getElementById('clearAllNewPhotosBtn');
            const hiddenContainer = document.getElementById('newCapturedPhotosContainer');

            const totalCount = newPhotosList.length;
            if (badge) badge.textContent = totalCount;
            if (countText) countText.textContent = `${totalCount} photo${totalCount !== 1 ? 's' : ''}`;
            if (clearBtn) clearBtn.style.display = totalCount > 0 ? 'inline-flex' : 'none';

            if (hiddenContainer) {
                hiddenContainer.innerHTML = '';
                newPhotosList.forEach(item => {
                    if (item.type === 'camera') {
                        const hiddenInput = document.createElement('input');
                        hiddenInput.type = 'hidden';
                        hiddenInput.name = 'capturedPhotos';
                        hiddenInput.value = item.dataUrl;
                        hiddenContainer.appendChild(hiddenInput);
                    }
                });
            }

            syncFileInputWithList('newDevicePhotoInput', newPhotosList);

            if (!gallery) return;

            if (totalCount === 0) {
                gallery.innerHTML = `
                    <div class="col-12 text-center py-4 text-muted" id="newPhotosEmptyState">
                        <i class="bi bi-card-image mb-2 d-block" style="font-size:36px;opacity:0.4"></i>
                        <div>No device photos added yet.</div>
                        <div style="font-size:11px">Snap photos using camera or select image files above.</div>
                    </div>`;
                return;
            }

            gallery.innerHTML = newPhotosList.map((item, idx) => `
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card-d position-relative overflow-hidden p-1 shadow-sm h-100" style="background:#111218;border:1px solid var(--border)">
                        <div class="position-relative overflow-hidden rounded" style="aspect-ratio:4/3;background:#000;cursor:pointer" onclick="openLightbox('${item.dataUrl}', '${item.name || 'Photo #' + (idx + 1)}')">
                            <img src="${item.dataUrl}" alt="Device Photo" style="width:100%;height:100%;object-fit:cover;display:block" />
                            <span class="badge position-absolute top-0 start-0 m-1 ${item.type === 'camera' ? 'bg-danger' : 'bg-primary'}" style="font-size:9px">
                                ${item.type === 'camera' ? '<i class="bi bi-camera-fill me-1"></i>Camera' : '<i class="bi bi-file-earmark-image me-1"></i>File'}
                            </span>
                            <span class="badge bg-dark bg-opacity-75 text-white position-absolute bottom-0 end-0 m-1" style="font-size:10px">
                                <i class="bi bi-arrows-fullscreen"></i>
                            </span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-1 px-1">
                            <span class="text-truncate text-muted" style="font-size:11px;max-width:110px" title="${item.name}">${item.name}</span>
                            <button type="button" class="btn btn-sm text-danger p-0 border-0" onclick="removeNewPhoto('${item.id}')" title="Delete Photo">
                                <i class="bi bi-trash-fill" style="font-size:13px"></i>
                            </button>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        function removeNewPhoto(id) {
            newPhotosList = newPhotosList.filter(p => p.id !== id);
            renderNewPhotosGallery();
        }

        function clearAllNewPhotos() {
            if (confirm('Clear all attached photos?')) {
                newPhotosList = [];
                renderNewPhotosGallery();
            }
        }

        function renderEditPhotosGallery() {
            const existingGallery = document.getElementById('editExistingPhotosGallery');
            const existingInputs = document.getElementById('editExistingPhotosInputs');
            const newSection = document.getElementById('editNewPhotosSection');
            const newGallery = document.getElementById('editNewPhotosGallery');
            const countBadge = document.getElementById('editPhotoCountBadge');
            const countText = document.getElementById('editPhotosCountText');
            const capturedContainer = document.getElementById('editCapturedPhotosContainer');

            const totalCount = editExistingPhotos.length + editPhotosList.length;
            if (countBadge) countBadge.textContent = totalCount;
            if (countText) countText.textContent = `${totalCount} photo${totalCount !== 1 ? 's' : ''}`;

            if (existingInputs) {
                existingInputs.innerHTML = '';
                editExistingPhotos.forEach(url => {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'existingPhotos';
                    input.value = url;
                    existingInputs.appendChild(input);
                });
            }

            if (existingGallery) {
                if (editExistingPhotos.length === 0) {
                    existingGallery.innerHTML = '<div class="col-12 text-muted small py-2">No saved photos for this device.</div>';
                } else {
                    existingGallery.innerHTML = editExistingPhotos.map((url, idx) => `
                        <div class="col-6 col-md-4 col-lg-3">
                            <div class="card-d position-relative overflow-hidden p-1 shadow-sm h-100" style="background:#111218;border:1px solid var(--border)">
                                <div class="position-relative overflow-hidden rounded" style="aspect-ratio:4/3;background:#000;cursor:pointer" onclick="openLightbox('${url}', 'Saved Photo #${idx + 1}')">
                                    <img src="${url}" alt="Saved Photo" style="width:100%;height:100%;object-fit:cover;display:block" />
                                    <span class="badge bg-success position-absolute top-0 start-0 m-1" style="font-size:9px">Saved</span>
                                    <span class="badge bg-dark bg-opacity-75 text-white position-absolute bottom-0 end-0 m-1" style="font-size:10px">
                                        <i class="bi bi-arrows-fullscreen"></i>
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-1 px-1">
                                    <span class="text-muted" style="font-size:11px">Photo #${idx + 1}</span>
                                    <button type="button" class="btn btn-sm text-danger p-0 border-0" onclick="removeExistingPhoto('${url}')" title="Delete Saved Photo">
                                        <i class="bi bi-trash-fill" style="font-size:13px"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    `).join('');
                }
            }

            if (capturedContainer) {
                capturedContainer.innerHTML = '';
                editPhotosList.forEach(item => {
                    if (item.type === 'camera') {
                        const hiddenInput = document.createElement('input');
                        hiddenInput.type = 'hidden';
                        hiddenInput.name = 'capturedPhotos';
                        hiddenInput.value = item.dataUrl;
                        capturedContainer.appendChild(hiddenInput);
                    }
                });
            }

            syncFileInputWithList('editDevicePhotoInput', editPhotosList);

            if (newSection && newGallery) {
                if (editPhotosList.length > 0) {
                    newSection.style.display = 'block';
                    newGallery.innerHTML = editPhotosList.map((item, idx) => `
                        <div class="col-6 col-md-4 col-lg-3">
                            <div class="card-d position-relative overflow-hidden p-1 shadow-sm h-100" style="background:#111218;border:1px solid var(--border)">
                                <div class="position-relative overflow-hidden rounded" style="aspect-ratio:4/3;background:#000;cursor:pointer" onclick="openLightbox('${item.dataUrl}', '${item.name || 'New Photo'}')">
                                    <img src="${item.dataUrl}" alt="New Photo" style="width:100%;height:100%;object-fit:cover;display:block" />
                                    <span class="badge position-absolute top-0 start-0 m-1 ${item.type === 'camera' ? 'bg-danger' : 'bg-primary'}" style="font-size:9px">
                                        ${item.type === 'camera' ? 'New (Camera)' : 'New (File)'}
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-1 px-1">
                                    <span class="text-truncate text-muted" style="font-size:11px;max-width:110px" title="${item.name}">${item.name}</span>
                                    <button type="button" class="btn btn-sm text-danger p-0 border-0" onclick="removeEditPhoto('${item.id}')" title="Remove">
                                        <i class="bi bi-trash-fill" style="font-size:13px"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    `).join('');
                } else {
                    newSection.style.display = 'none';
                    newGallery.innerHTML = '';
                }
            }
        }

        function removeExistingPhoto(url) {
            if (confirm('Remove this saved photo?')) {
                editExistingPhotos = editExistingPhotos.filter(p => p !== url);
                renderEditPhotosGallery();
            }
        }

        function removeEditPhoto(id) {
            editPhotosList = editPhotosList.filter(p => p.id !== id);
            renderEditPhotosGallery();
        }

        function syncFileInputWithList(inputId, list) {
            try {
                const input = document.getElementById(inputId);
                if (!input) return;
                const dt = new DataTransfer();
                list.forEach(item => {
                    if (item.file) {
                        dt.items.add(item.file);
                    }
                });
                input.files = dt.files;
            } catch (e) {
                // Older browsers without DataTransfer fallback
            }
        }

