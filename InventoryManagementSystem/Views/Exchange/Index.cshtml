@model IEnumerable<InventoryManagementSystem.Models.ExchangeRecord>
@{
    ViewData["Title"] = "Mobile Phone Trade-In & Exchange";
}

<div class="ph">
    <div>
        <h1 class="ph-title"><i class="bi bi-arrow-repeat me-2" style="color:var(--primary)"></i>Mobile Trade-In &amp; Exchange</h1>
        <p class="ph-sub">Process used mobile phone valuations, inspect device health, and transfer trade-in inventory.</p>
    </div>
    <div class="ph-actions d-flex align-items-center gap-2">
        <button type="button" class="btn-d btn-outline" id="exchangeFilterToggleBtn" onclick="toggleFilterPanel('exchangeFilterPanel', 'exchangeFilterToggleBtn')">
            <i class="bi bi-funnel-fill text-primary me-1"></i> <span>Filters: ON</span>
        </button>
        <button type="button" class="btn-d btn-primary" data-bs-toggle="modal" data-bs-target="#processExchangeModal">
            <i class="bi bi-plus-lg me-1"></i> Record New Trade-In
        </button>
    </div>
</div>

<!-- Detailed Filters Bar (Toggleable Panel) -->
<div class="card-d card-p mb-4" id="exchangeFilterPanel">
    <form method="get" class="row g-3">
        <!-- Row 1: Primary Device Filters -->
        <div class="col-md-3">
            <div class="fg mb-0">
                <label class="fg-label"><i class="bi bi-search me-1"></i>Keyword Search</label>
                <input type="text" name="search" value="@ViewBag.Search" class="fg-control" placeholder="Exchange #, IMEI, Phone, Customer...">
            </div>
        </div>
        <div class="col-md-2">
            <div class="fg mb-0">
                <label class="fg-label"><i class="bi bi-phone-fill me-1"></i>Brand</label>
                <select name="brand" class="fg-control">
                    <option value="">All Brands</option>
                    <option value="Apple" selected="@(ViewBag.Brand == "Apple")">Apple</option>
                    <option value="Samsung" selected="@(ViewBag.Brand == "Samsung")">Samsung</option>
                    <option value="OnePlus" selected="@(ViewBag.Brand == "OnePlus")">OnePlus</option>
                    <option value="Xiaomi" selected="@(ViewBag.Brand == "Xiaomi")">Xiaomi</option>
                    <option value="Vivo" selected="@(ViewBag.Brand == "Vivo")">Vivo</option>
                    <option value="Oppo" selected="@(ViewBag.Brand == "Oppo")">Oppo</option>
                    <option value="Google" selected="@(ViewBag.Brand == "Google")">Google Pixel</option>
                    <option value="Motorola" selected="@(ViewBag.Brand == "Motorola")">Motorola</option>
                    <option value="Nothing" selected="@(ViewBag.Brand == "Nothing")">Nothing</option>
                    <option value="Other" selected="@(ViewBag.Brand == "Other")">Other</option>
                </select>
            </div>
        </div>
        <div class="col-md-2">
            <div class="fg mb-0">
                <label class="fg-label"><i class="bi bi-phone me-1"></i>Model Name</label>
                <input type="text" name="model" value="@ViewBag.Model" class="fg-control" placeholder="e.g. iPhone 11, S21">
            </div>
        </div>
        <div class="col-md-2">
            <div class="fg mb-0">
                <label class="fg-label"><i class="bi bi-palette me-1"></i>Color</label>
                <input type="text" name="color" value="@ViewBag.Color" class="fg-control" placeholder="Black, Gold, Blue...">
            </div>
        </div>
        <div class="col-md-3">
            <div class="fg mb-0">
                <label class="fg-label"><i class="bi bi-shield-check me-1"></i>Device Condition</label>
                <select name="condition" class="fg-control">
                    <option value="">All Conditions</option>
                    <option value="Like New" selected="@(ViewBag.Condition == "Like New")">Like New</option>
                    <option value="Good Condition" selected="@(ViewBag.Condition == "Good Condition")">Good Condition</option>
                    <option value="Fair" selected="@(ViewBag.Condition == "Fair")">Fair</option>
                    <option value="Damaged / Defective" selected="@(ViewBag.Condition == "Damaged / Defective")">Damaged / Defective</option>
                </select>
            </div>
        </div>

        <!-- Row 2: Valuation & Inventory Destination Filters -->
        <div class="col-md-3">
            <div class="fg mb-0">
                <label class="fg-label"><i class="bi bi-box-seam me-1"></i>Destination Status</label>
                <select name="destinationStatus" class="fg-control">
                    <option value="">All Destination Statuses</option>
                    <option value="InStock" selected="@(ViewBag.DestinationStatus == "InStock")">In Stock (Sellable)</option>
                    <option value="UnderRepair" selected="@(ViewBag.DestinationStatus == "UnderRepair")">Under Repair</option>
                    <option value="Damaged" selected="@(ViewBag.DestinationStatus == "Damaged")">Damaged / Scrap</option>
                    <option value="Pending" selected="@(ViewBag.DestinationStatus == "Pending")">Pending Inspection</option>
                </select>
            </div>
        </div>
        <div class="col-md-3">
            <div class="fg mb-0">
                <label class="fg-label"><i class="bi bi-currency-rupee me-1"></i>Min Valuation (₹)</label>
                <input type="number" step="100" name="minValuation" value="@ViewBag.MinValuation" class="fg-control" placeholder="Min ₹">
            </div>
        </div>
        <div class="col-md-3">
            <div class="fg mb-0">
                <label class="fg-label"><i class="bi bi-currency-rupee me-1"></i>Max Valuation (₹)</label>
                <input type="number" step="100" name="maxValuation" value="@ViewBag.MaxValuation" class="fg-control" placeholder="Max ₹">
            </div>
        </div>
        <div class="col-md-3 d-flex align-items-end gap-2">
            <button type="submit" class="btn-d btn-primary flex-grow-1"><i class="bi bi-funnel me-1"></i> Apply Filters</button>
            <a href="@Url.Action("Index")" class="btn-d btn-outline" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i> Reset</a>
        </div>
    </form>
</div>

<!-- Table -->
<div class="card-d">
    <div class="tbl-wrap">
        <div class="tbl-scroll">
            <table class="tbl">
                <thead>
                    <tr>
                        <th style="width:130px">Exchange #</th>
                        <th>Date &amp; Time</th>
                        <th>Customer</th>
                        <th>Device &amp; Specs</th>
                        <th>Color</th>
                        <th>IMEI 1 / Serial</th>
                        <th>Condition</th>
                        <th>Battery</th>
                        <th>Valuation (₹)</th>
                        <th>Destination</th>
                        <th>Cashier</th>
                        <th class="col-actions" style="width:100px">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="12" class="text-center py-5 text-muted">No mobile trade-in exchange records found.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var e in Model)
                        {
                            <tr>
                                <td class="td-strong font-monospace" style="color:var(--primary-text)">@e.ExchangeNumber</td>
                                <td style="font-size:12px;color:var(--text-secondary)">@e.Date.ToIstString("yyyy-MM-dd HH:mm IST")</td>
                                <td>
                                    <div class="td-strong">@e.CustomerName</div>
                                    <div style="font-size:11px;color:var(--text-muted)">@e.CustomerPhone</div>
                                </td>
                                <td>
                                    <div class="td-strong">@e.OldBrand @e.OldModel</div>
                                    <div style="font-size:11px;color:var(--text-muted)">@e.OldStorage @(string.IsNullOrEmpty(e.OldRam) ? "" : "/ " + e.OldRam)</div>
                                    @if (e.DevicePhotos != null && e.DevicePhotos.Any())
                                    {
                                        <div class="mt-1">
                                            <span class="badge-d badge-purple" style="font-size:10px;cursor:pointer" onclick="openDetailsModal('@e.Id')" title="View @e.DevicePhotos.Count photos">
                                                <i class="bi bi-camera-fill me-1"></i>@e.DevicePhotos.Count photo@(e.DevicePhotos.Count > 1 ? "s" : "")
                                            </span>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <span class="badge-d badge-blue" style="font-family:monospace">@e.OldColor</span>
                                </td>
                                <td>
                                    <div style="font-family:monospace;font-size:12px;color:var(--primary-text)">@e.OldImei1</div>
                                    @if (!string.IsNullOrEmpty(e.OldImei2))
                                    {
                                        <div style="font-family:monospace;font-size:10px;color:var(--text-muted)">SIM2: @e.OldImei2</div>
                                    }
                                </td>
                                <td>
                                    <span class="badge-d badge-gray">@e.Condition</span>
                                </td>
                                <td>
                                    @if (e.BatteryHealthPercentage.HasValue)
                                    {
                                        <span class="badge-d @(e.BatteryHealthPercentage >= 80 ? "badge-green" : e.BatteryHealthPercentage >= 60 ? "badge-amber" : "badge-red")">
                                            <i class="bi bi-battery-charging me-1"></i>@e.BatteryHealthPercentage%
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="font-size:11px;color:var(--text-muted)">N/A</span>
                                    }
                                </td>
                                <td class="td-strong" style="color:var(--success);font-size:15px">₹@e.FinalExchangeValue.ToString("N2")</td>
                                <td>
                                    @if (e.InventoryDestinationStatus == "InStock")
                                    {
                                        <span class="badge-d badge-green"><i class="bi bi-check-circle-fill me-1"></i> In Stock</span>
                                    }
                                    else if (e.InventoryDestinationStatus == "UnderRepair")
                                    {
                                        <span class="badge-d badge-amber"><i class="bi bi-wrench me-1"></i> Under Repair</span>
                                    }
                                    else if (e.InventoryDestinationStatus == "Damaged")
                                    {
                                        <span class="badge-d badge-red"><i class="bi bi-x-octagon-fill me-1"></i> Damaged</span>
                                    }
                                    else
                                    {
                                        <span class="badge-d badge-purple"><i class="bi bi-hourglass-split me-1"></i> Pending</span>
                                    }
                                </td>
                                <td style="font-size:12px;color:var(--text-secondary)">@e.ExecutedBy</td>
                                <td class="col-actions">
                                    <div class="d-flex gap-1">
                                        <button type="button" class="btn-d btn-outline btn-sm-d" onclick="openDetailsModal('@e.Id')" title="View Full Inspection Sheet">
                                            <i class="bi bi-eye"></i> Details
                                        </button>
                                        <button type="button" class="btn-d btn-outline btn-sm-d" onclick="openEditExchangeModal('@e.Id')" title="Edit Trade-In Record">
                                            <i class="bi bi-pencil"></i> Edit
                                        </button>
                                        <form asp-action="DeleteExchange" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete Trade-In #@e.ExchangeNumber?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@e.Id" />
                                            <button type="submit" class="btn-d btn-outline btn-sm-d" style="color:var(--danger)" title="Delete Trade-In Record">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: New Trade-In Inspection Form -->
<div class="modal fade" id="processExchangeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content" style="background:var(--bg-card);border:1px solid var(--border);color:var(--text-primary)">
            <div class="modal-header" style="border-bottom:1px solid var(--border)">
                <h5 class="modal-title fw-bold" style="color:var(--primary-text)">
                    <i class="bi bi-arrow-repeat me-2"></i>Record Mobile Phone Trade-In &amp; Inspection
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="ProcessExchange" method="post" id="tradeInForm" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4" style="max-height:75vh;overflow-y:auto">
                    <!-- Form Navigation Tabs -->
                    <ul class="nav nav-tabs mb-4" id="tradeInTabs" role="tablist" style="border-bottom-color:var(--border)">
                        <li class="nav-item">
                            <button class="nav-link active fw-bold" id="cust-tab" data-bs-toggle="tab" data-bs-target="#cust-tab-pane" type="button"><i class="bi bi-person me-1"></i> 1. Customer</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link fw-bold" id="device-tab" data-bs-toggle="tab" data-bs-target="#device-tab-pane" type="button"><i class="bi bi-phone me-1"></i> 2. Old Device Specs</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link fw-bold" id="condition-tab" data-bs-toggle="tab" data-bs-target="#condition-tab-pane" type="button"><i class="bi bi-cpu me-1"></i> 3. Condition Inspection</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link fw-bold" id="security-tab" data-bs-toggle="tab" data-bs-target="#security-tab-pane" type="button"><i class="bi bi-shield-lock me-1"></i> 4. Security Locks</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link fw-bold" id="accessories-tab" data-bs-toggle="tab" data-bs-target="#accessories-tab-pane" type="button"><i class="bi bi-box-seam me-1"></i> 5. Accessories</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link fw-bold" id="photos-tab" data-bs-toggle="tab" data-bs-target="#photos-tab-pane" type="button">
                                <i class="bi bi-camera me-1"></i> 6. Device Photos <span class="badge rounded-pill bg-primary ms-1" id="newPhotoCountBadge">0</span>
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link fw-bold" id="valuation-tab" data-bs-toggle="tab" data-bs-target="#valuation-tab-pane" type="button"><i class="bi bi-cash-stack me-1"></i> 7. Valuation &amp; Destination</button>
                        </li>
                    </ul>

                    <div class="tab-content" id="tradeInTabsContent">
                        <!-- TAB 1: Customer Information -->
                        <div class="tab-pane fade show active" id="cust-tab-pane">
                            <div class="s-title mb-3"><i class="bi bi-person-vcard me-2" style="color:var(--primary)"></i>Customer Information</div>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="fg">
                                        <label class="fg-label">Customer Full Name <span class="req">*</span></label>
                                        <input type="text" name="CustomerName" required class="fg-control" placeholder="e.g. Vijay Kumar" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="fg">
                                        <label class="fg-label">Contact Phone Number <span class="req">*</span></label>
                                         <input type="tel" name="CustomerPhone" required class="fg-control phone-input" placeholder="e.g. 9876543210" maxlength="10" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="fg">
                                        <label class="fg-label">Customer Email Address</label>
                                        <input type="email" name="CustomerEmail" class="fg-control" placeholder="customer@domain.com" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="fg">
                                        <label class="fg-label">Customer Residential Address</label>
                                        <input type="text" name="CustomerAddress" class="fg-control" placeholder="Street, City, State, Pincode" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- TAB 2: Device Identification -->
                        <div class="tab-pane fade" id="device-tab-pane">
                            <div class="s-title mb-3"><i class="bi bi-phone me-2" style="color:var(--primary)"></i>Old Device Specifications</div>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <div class="fg">
                                        <label class="fg-label">Brand <span class="req">*</span></label>
                                        <select id="brandSelect" class="fg-control" onchange="onBrandSelectChange(this)" required>
                                            <option value="">— Select Brand —</option>
                                            <option value="Apple">Apple</option>
                                            <option value="Samsung">Samsung</option>
                                            <option value="OnePlus">OnePlus</option>
                                            <option value="Xiaomi">Xiaomi / Redmi / POCO</option>
                                            <option value="Realme">Realme</option>
                                            <option value="Vivo">Vivo</option>
                                            <option value="Oppo">Oppo</option>
                                            <option value="Google">Google Pixel</option>
                                            <option value="Motorola">Motorola</option>
                                            <option value="Nothing">Nothing</option>
                                            <option value="Nokia">Nokia</option>
                                            <option value="Other">Other Brand...</option>
                                        </select>
                                        <input type="hidden" name="OldBrand" id="finalBrandInput" required />
                                    </div>
                                </div>
                                <div class="col-md-4" id="customBrandBox" style="display:none">
                                    <div class="fg">
                                        <label class="fg-label">Specify Custom Brand <span class="req">*</span></label>
                                        <input type="text" id="customBrandInput" class="fg-control" placeholder="e.g. Lava, Micromax, Honor, Tecno" oninput="updateBrandValue()" />
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="fg">
                                        <label class="fg-label">Model Name <span class="req">*</span></label>
                                        <input type="text" name="OldModel" required class="fg-control" placeholder="e.g. iPhone 11, Galaxy S21" />
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="fg">
                                        <label class="fg-label">Edition / Variant</label>
                                        <input type="text" name="OldStorage" class="fg-control" placeholder="e.g. 128GB / 6GB RAM" />
                                    </div>
                                </div>

                                <!-- Color Selection (Mandatory Requirements) -->
                                <div class="col-md-4">
                                    <div class="fg">
                                        <label class="fg-label">Phone Physical Color <span class="req">*</span></label>
                                        <select id="colorSelect" class="fg-control" onchange="onColorSelectChange(this)" required>
                                            <option value="">— Select Color —</option>
                                            <option value="Black">Black</option>
                                            <option value="White">White</option>
                                            <option value="Blue">Blue</option>
                                            <option value="Green">Green</option>
                                            <option value="Red">Red</option>
                                            <option value="Gold">Gold</option>
                                            <option value="Silver">Silver</option>
                                            <option value="Purple">Purple</option>
                                            <option value="Graphite">Graphite</option>
                                            <option value="Midnight">Midnight</option>
                                            <option value="Starlight">Starlight</option>
                                            <option value="Titanium">Titanium</option>
                                            <option value="Other">Other Custom Color...</option>
                                        </select>
                                        <input type="hidden" name="OldColor" id="finalColorInput" required />
                                    </div>
                                </div>
                                <div class="col-md-4" id="customColorBox" style="display:none">
                                    <div class="fg">
                                        <label class="fg-label">Specify Custom Color <span class="req">*</span></label>
                                        <input type="text" id="customColorInput" class="fg-control" placeholder="e.g. Sierra Blue, Sunset Gold" oninput="updateColorValue()" />
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="fg">
                                        <label class="fg-label">RAM Capacity</label>
                                        <input type="text" name="OldRam" class="fg-control" placeholder="e.g. 4GB, 6GB, 8GB" />
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="fg">
                                        <label class="fg-label">Primary IMEI (IMEI 1) <span class="req">*</span></label>
                                        <input type="text" name="OldImei1" required class="fg-control font-monospace" placeholder="15-digit primary IMEI 1" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="fg">
                                        <label class="fg-label">Secondary IMEI (IMEI 2 - Dual SIM)</label>
                                        <input type="text" name="OldImei2" class="fg-control font-monospace" placeholder="15-digit secondary IMEI 2 (Optional)" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="fg">
                                        <label class="fg-label">Serial Number</label>
                                        <input type="text" name="SerialNumber" class="fg-control font-monospace" placeholder="Factory Serial Number (Optional)" />
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="fg">
                                        <label class="fg-label">Device Type</label>
                                        <select name="DeviceType" class="fg-control">
                                            <option value="Smartphone" selected>Smartphone</option>
                                            <option value="Feature Phone">Feature Phone</option>
                                            <option value="Tablet">Tablet / iPad</option>
                                            <option value="Smartwatch">Smartwatch</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="fg">
                                        <label class="fg-label">SIM Network Type</label>
                                        <select name="SimType" class="fg-control">
                                            <option value="Dual SIM" selected>Dual SIM (eSIM / Physical)</option>
                                            <option value="Single SIM">Single SIM</option>
                                            <option value="eSIM Only">eSIM Only</option>
                                            <option value="Wi-Fi Only">Wi-Fi Only (No SIM)</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- TAB 3: Condition Inspection -->
                        <div class="tab-pane fade" id="condition-tab-pane">
                            <div class="s-title mb-3"><i class="bi bi-cpu me-2" style="color:var(--primary)"></i>Physical Condition &amp; Technical Inspection</div>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="fg">
                                        <label class="fg-label">Overall Physical Condition <span class="req">*</span></label>
                                        <select name="Condition" required class="fg-control">
                                            <option value="Flawless / Like New">Flawless / Like New (No scratches/dents)</option>
                                            <option value="Good Condition" selected>Good Condition (Minor body wear)</option>
                                            <option value="Fair Condition">Fair Condition (Visible scratches/scuffs)</option>
                                            <option value="Damaged">Damaged / Display Cracked</option>
                                            <option value="Non-Working">Non-Working / Dead Motherboard</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="fg">
                                        <label class="fg-label">Battery Health Percentage (%)</label>
                                        <div class="fg-prefix-wrap">
                                            <input type="number" name="BatteryHealthPercentage" min="0" max="100" class="fg-control" placeholder="e.g. 87" />
                                            <span class="fg-prefix">%</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="fg">
                                        <label class="fg-label">Battery State</label>
                                        <select name="BatteryCondition" class="fg-control">
                                            <option value="Excellent">Excellent (&gt; 85%)</option>
                                            <option value="Good" selected>Good (75% - 85%)</option>
                                            <option value="Weak">Weak (&lt; 75%)</option>
                                            <option value="Needs Replacement">Needs Replacement</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-12"><hr class="s-divider my-2" /><span class="td-strong" style="color:var(--primary-text)">Component Inspection Checklist:</span></div>

                                <div class="col-md-3">
                                    <div class="fg">
                                        <label class="fg-label">Screen &amp; Display</label>
                                        <select name="ScreenCondition" class="fg-control">
                                            <option value="Excellent">Excellent (Original)</option>
                                            <option value="Good" selected>Good (Minor scratches)</option>
                                            <option value="Scratched">Heavy Scratches</option>
                                            <option value="Cracked">Glass Cracked</option>
                                            <option value="Display Issue">Display Dots / Lines</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="fg">
                                        <label class="fg-label">Body &amp; Housing</label>
                                        <select name="BodyCondition" class="fg-control">
                                            <option value="Excellent">Excellent</option>
                                            <option value="Good" selected>Good</option>
                                            <option value="Scratches">Scratches</option>
                                            <option value="Dents">Dents / Scuffs</option>
                                            <option value="Heavy Damage">Heavy Frame Damage</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="fg">
                                        <label class="fg-label">Front &amp; Rear Camera</label>
                                        <select name="CameraCondition" class="fg-control">
                                            <option value="Working" selected>Working (Clear)</option>
                                            <option value="Minor Issue">Minor Blur / Dust</option>
                                            <option value="Faulty">Faulty / Lens Cracked</option>
