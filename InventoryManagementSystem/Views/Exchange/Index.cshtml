                            <div class="row g-3">
                                <div class="col-md-4">
                                    <div class="fg">
                                        <label class="fg-label">Passcode Unlocked?</label>
                                        <select name="IsDeviceUnlocked" id="editIsDeviceUnlocked" class="fg-control">
                                            <option value="true">Yes (Screen Passcode Removed)</option>
                                            <option value="false">No (Locked with Passcode)</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="fg">
                                        <label class="fg-label">Apple Activation Lock (iCloud)</label>
                                        <select name="AppleActivationLock" id="editAppleActivationLock" class="fg-control">
                                            <option value="Clear">Clear (Signed Out)</option>
                                            <option value="Enabled">Enabled (iCloud Locked ⚠️)</option>
                                            <option value="Not Checked">Not Checked</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="fg">
                                        <label class="fg-label">Google Account Lock (FRP)</label>
                                        <select name="GoogleFRPAccountLock" id="editGoogleFRPAccountLock" class="fg-control">
                                            <option value="Clear">Clear (Signed Out)</option>
                                            <option value="Enabled">Enabled (FRP Locked ⚠️)</option>
                                            <option value="Not Checked">Not Checked</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- TAB 5: Accessories Received -->
                        <div class="tab-pane fade" id="edit-accessories-tab-pane">
                            <div class="s-title mb-3"><i class="bi bi-box-seam me-2" style="color:var(--primary)"></i>Accessories Included</div>
                            <div class="row g-3">
                                <div class="col-12">
                                    <div class="d-flex flex-wrap gap-4 p-3 rounded" style="background:var(--bg);border:1px solid var(--border)">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="AccessoriesReceived" value="Original Box" id="editAcc1">
                                            <label class="form-check-label text-light" for="editAcc1">Original Box</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="AccessoriesReceived" value="Original Charger" id="editAcc2">
                                            <label class="form-check-label text-light" for="editAcc2">Charger</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="AccessoriesReceived" value="USB Cable" id="editAcc3">
                                            <label class="form-check-label text-light" for="editAcc3">USB Cable</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="AccessoriesReceived" value="Earphones" id="editAcc4">
                                            <label class="form-check-label text-light" for="editAcc4">Earphones</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="AccessoriesReceived" value="Case" id="editAcc5">
                                            <label class="form-check-label text-light" for="editAcc5">Protective Case</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="AccessoriesReceived" value="Original Invoice" id="editAcc6">
                                            <label class="form-check-label text-light" for="editAcc6">Purchase Invoice</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="AccessoriesReceived" value="SIM Ejector" id="editAcc7">
                                            <label class="form-check-label text-light" for="editAcc7">SIM Ejector Pin</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="fg">
                                        <label class="fg-label">Other Accessories / Additional Notes</label>
                                        <input type="text" name="OtherAccessoriesNotes" id="editOtherAccessoriesNotes" class="fg-control" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- TAB 6: Valuation & Destination -->
                        <div class="tab-pane fade" id="edit-valuation-tab-pane">
                            <div class="s-title mb-3"><i class="bi bi-cash-stack me-2" style="color:var(--primary)"></i>Valuation &amp; Inventory Routing</div>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="fg">
                                        <label class="fg-label">Estimated Valuation (₹)</label>
                                        <input type="number" step="0.01" name="EstimatedValue" id="editEstimatedValue" class="fg-control" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="fg">
                                        <label class="fg-label">Final Valuation Credit (Acquisition Cost) (₹) <span class="req">*</span></label>
                                        <input type="number" step="0.01" name="FinalExchangeValue" id="editFinalExchangeValue" required class="fg-control fw-bold" style="color:var(--success)" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="fg">
                                        <label class="fg-label">Inventory Destination Status <span class="req">*</span></label>
                                        <select name="InventoryDestinationStatus" id="editInventoryDestinationStatus" required class="fg-control">
                                            <option value="InStock">In Stock (Available for POS Sale)</option>
                                            <option value="UnderRepair">Under Repair (Sent to Service)</option>
                                            <option value="Damaged">Damaged (Scrap / Parts)</option>
                                            <option value="Pending">Pending Inspection</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="fg">
                                        <label class="fg-label">Inspector Name</label>
                                        <input type="text" name="InspectorName" id="editInspectorName" class="fg-control" />
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="fg">
                                        <label class="fg-label">Remarks &amp; Inspector Notes</label>
                                        <textarea name="Remarks" id="editRemarks" rows="3" class="fg-control"></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="modal-footer justify-content-end" style="border-top:1px solid var(--border)">
                    <button type="button" class="btn-d btn-outline" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-d btn-primary"><i class="bi bi-check2-circle me-1"></i> Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const wizardTabIds = ['cust-tab', 'device-tab', 'condition-tab', 'security-tab', 'accessories-tab', 'valuation-tab'];
        const wizardTabLabels = [
            'Next: 2. Old Device Specs',
            'Next: 3. Condition Inspection',
            'Next: 4. Security Locks',
            'Next: 5. Accessories',
            'Next: 6. Valuation & Destination',
            'Accept Trade-In'
        ];

        let currentTabIdx = 0;

        function updateWizardButtons() {
            const prevBtn = document.getElementById('prevTabBtn');
            const nextBtn = document.getElementById('nextTabBtn');
            const submitBtn = document.getElementById('submitTradeInBtn');

            prevBtn.disabled = (currentTabIdx === 0);

            if (currentTabIdx === wizardTabIds.length - 1) {
                nextBtn.style.display = 'none';
                submitBtn.style.display = 'inline-flex';
            } else {
                nextBtn.style.display = 'inline-flex';
                submitBtn.style.display = 'none';
                nextBtn.innerHTML = `${wizardTabLabels[currentTabIdx]} <i class="bi bi-chevron-right ms-1"></i>`;
            }
        }

        function navigateWizard(direction) {
            if (direction > 0) {
                // Validate inputs in current active tab before moving forward
                const currentPaneId = wizardTabIds[currentTabIdx].replace('-tab', '-tab-pane');
                const currentPane = document.getElementById(currentPaneId);
                if (currentPane) {
                    const inputs = currentPane.querySelectorAll('input, select, textarea');
                    for (let input of inputs) {
                        if (!input.checkValidity()) {
                            input.reportValidity();
                            return false;
                        }
                    }
                }
            }

            const newIdx = currentTabIdx + direction;
            if (newIdx >= 0 && newIdx < wizardTabIds.length) {
                const tabBtn = document.getElementById(wizardTabIds[newIdx]);
                if (tabBtn) {
                    const bsTab = bootstrap.Tab.getOrCreateInstance(tabBtn);
                    bsTab.show();
                }
            }
        }

        // Sync button states when user manually clicks tab headers
        document.querySelectorAll('#tradeInTabs button[data-bs-toggle="tab"]').forEach((btn, idx) => {
            btn.addEventListener('shown.bs.tab', (e) => {
                const targetId = e.target.id;
                const foundIdx = wizardTabIds.indexOf(targetId);
                if (foundIdx !== -1) {
                    currentTabIdx = foundIdx;
                    updateWizardButtons();
                }
            });
        });

        function onBrandSelectChange(select) {
            const val = select.value;
            const customBox = document.getElementById('customBrandBox');
            const customInput = document.getElementById('customBrandInput');
            const finalInput = document.getElementById('finalBrandInput');

            if (val === 'Other') {
                customBox.style.display = 'block';
                customInput.required = true;
                finalInput.value = customInput.value.trim();
            } else {
                customBox.style.display = 'none';
                customInput.required = false;
                finalInput.value = val;
            }
        }

        function updateBrandValue() {
            const select = document.getElementById('brandSelect');
            if (select.value === 'Other') {
                document.getElementById('finalBrandInput').value = document.getElementById('customBrandInput').value.trim();
            }
        }

        function onColorSelectChange(select) {
            const val = select.value;
            const customBox = document.getElementById('customColorBox');
            const customInput = document.getElementById('customColorInput');
            const finalInput = document.getElementById('finalColorInput');

            if (val === 'Other') {
                customBox.style.display = 'block';
                customInput.required = true;
                finalInput.value = customInput.value.trim();
            } else {
                customBox.style.display = 'none';
                customInput.required = false;
                finalInput.value = val;
            }
        }

        function updateColorValue() {
            const select = document.getElementById('colorSelect');
            if (select.value === 'Other') {
                document.getElementById('finalColorInput').value = document.getElementById('customColorInput').value.trim();
            }
        }

        async function openDetailsModal(id) {
            const modalBody = document.getElementById('detailsModalBody');
            modalBody.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary"></div><div class="mt-2 text-muted">Loading complete trade-in inspection sheet...</div></div>';
            
            const modal = new bootstrap.Modal(document.getElementById('tradeInDetailsModal'));
            modal.show();

            try {
                const res = await fetch(`@Url.Action("GetDetails", "Exchange")?id=${id}`);
                const data = await res.json();
                if (data.success) {
                    let lockTag = data.hasAccountLock 
                        ? `<span class="badge-d badge-red"><i class="bi bi-lock-fill me-1"></i> Locked (iCloud/FRP Flagged)</span>` 
                        : `<span class="badge-d badge-green"><i class="bi bi-unlock-fill me-1"></i> Unlocked / Clear</span>`;

                    let accBadges = (data.accessoriesReceived || []).map(a => `<span class="badge-d badge-gray me-1 mb-1">${a}</span>`).join('');

                    modalBody.innerHTML = `
                        <div class="row g-4">
                            <!-- HEADER BAR -->
                            <div class="col-12">
                                <div class="card-d card-p d-flex flex-wrap justify-content-between align-items-center">
                                    <div>
                                        <span class="badge-d badge-purple fs-6">Trade-In #${data.exchangeNumber}</span>
                                        <span class="ms-2 text-muted" style="font-size:12px"><i class="bi bi-clock me-1"></i>${data.date}</span>
                                    </div>
                                    <div>
                                        <span class="me-3"><strong>Inspector:</strong> ${data.inspectorName || data.executedBy}</span>
                                        <span><strong>Inspection Status:</strong> <span class="badge-d badge-green">${data.inspectionStatus || 'Passed'}</span></span>
                                    </div>
                                </div>
                            </div>

                            <!-- CUSTOMER INFO -->
                            <div class="col-md-6">
                                <div class="card-d card-p h-100">
                                    <div class="s-title"><i class="bi bi-person me-2" style="color:var(--primary)"></i>1. Customer Details</div>
                                    <div class="mb-1"><strong>Full Name:</strong> ${data.customerName}</div>
                                    <div class="mb-1"><strong>Phone Number:</strong> <code style="color:var(--primary-text)">${data.customerPhone}</code></div>
                                    <div class="mb-1"><strong>Email Address:</strong> ${data.customerEmail || 'N/A'}</div>
                                    <div><strong>Address:</strong> ${data.customerAddress || 'N/A'}</div>
                                </div>
                            </div>

                            <!-- DEVICE SPECS -->
                            <div class="col-md-6">
                                <div class="card-d card-p h-100">
                                    <div class="s-title"><i class="bi bi-phone me-2" style="color:var(--success)"></i>2. Old Device Specifications</div>
                                    <div class="mb-1"><strong>Brand &amp; Model:</strong> ${data.brand} ${data.model}</div>
                                    <div class="mb-1"><strong>Physical Color:</strong> <span class="badge-d badge-blue">${data.color}</span></div>
                                    <div class="mb-1"><strong>Storage &amp; RAM:</strong> ${data.storage} ${data.ram ? '(' + data.ram + ' RAM)' : ''}</div>
                                    <div class="mb-1"><strong>Device Type &amp; SIM:</strong> ${data.deviceType || 'Smartphone'} (${data.simType || 'Dual SIM'})</div>
                                    <div class="mb-1"><strong>Primary IMEI (SIM 1):</strong> <code style="color:var(--primary-text);font-weight:bold">${data.imei1}</code></div>
                                    ${data.imei2 ? `<div class="mb-1"><strong>Secondary IMEI (SIM 2):</strong> <code style="color:var(--text-muted)">${data.imei2}</code></div>` : ''}
                                    ${data.serialNumber ? `<div><strong>Serial Number:</strong> <code>${data.serialNumber}</code></div>` : ''}
                                </div>
                            </div>

                            <!-- TECHNICAL INSPECTION & CONDITION -->
                            <div class="col-md-6">
                                <div class="card-d card-p h-100">
                                    <div class="s-title"><i class="bi bi-cpu me-2" style="color:var(--warning)"></i>3. Physical Condition &amp; Component Health</div>
                                    <div class="mb-2"><strong>Overall Grade:</strong> <span class="badge-d badge-gray">${data.condition}</span></div>
                                    <div class="mb-2"><strong>Battery Health:</strong> ${data.batteryHealthPercentage ? data.batteryHealthPercentage + '%' : 'N/A'} (${data.batteryCondition || 'Good'})</div>
                                    <div class="p-2 rounded mb-2" style="background:var(--bg);font-size:12px">
                                        <div>• <strong>Screen/Display:</strong> ${data.screenCondition || 'Good'}</div>
                                        <div>• <strong>Body/Housing:</strong> ${data.bodyCondition || 'Good'}</div>
                                        <div>• <strong>Camera (Front/Rear):</strong> ${data.cameraCondition || 'Working'}</div>
                                        <div>• <strong>Speaker &amp; Earpiece:</strong> ${data.speakerCondition || 'Working'}</div>
                                        <div>• <strong>Microphone:</strong> ${data.microphoneCondition || 'Working'}</div>
                                        <div>• <strong>Charging Port:</strong> ${data.chargingPortCondition || 'Working'}</div>
                                        <div>• <strong>Physical Buttons:</strong> ${data.buttonsCondition || 'Working'}</div>
                                        <div>• <strong>Face ID / Biometrics:</strong> ${data.faceIdFingerprintCondition || 'Working'}</div>
                                    </div>
                                </div>
                            </div>

                            <!-- SECURITY LOCKS & ACCESSORIES -->
                            <div class="col-md-6">
                                <div class="card-d card-p h-100">
                                    <div class="s-title"><i class="bi bi-shield-lock me-2" style="color:var(--info)"></i>4. Security Locks &amp; Accessories</div>
                                    <div class="mb-2"><strong>Overall Security:</strong> ${lockTag}</div>
                                    <div class="mb-1"><strong>Passcode Unlocked?</strong> ${data.isDeviceUnlocked ? '<span class="text-success">Yes (Screen Passcode Removed)</span>' : '<span class="text-danger">No (Locked)</span>'}</div>
                                    <div class="mb-1"><strong>Apple Activation Lock (iCloud):</strong> <span class="badge-d ${data.appleActivationLock === 'Enabled' ? 'badge-red' : 'badge-green'}">${data.appleActivationLock || 'Clear'}</span></div>
                                    <div class="mb-3"><strong>Google Account Lock (FRP):</strong> <span class="badge-d ${data.googleFRPAccountLock === 'Enabled' ? 'badge-red' : 'badge-green'}">${data.googleFRPAccountLock || 'Clear'}</span></div>
                                    <hr class="s-divider my-2" />
                                    <div class="mb-1"><strong>Accessories Included:</strong></div>
                                    <div class="mb-2">${accBadges || '<span class="text-muted">No accessories included</span>'}</div>
                                    ${data.otherAccessoriesNotes ? `<div><strong>Accessory Notes:</strong> ${data.otherAccessoriesNotes}</div>` : ''}
                                </div>
                            </div>

                            <!-- VALUATION & INVENTORY ROUTING -->
                            <div class="col-12">
                                <div class="card-d card-p">
                                    <div class="s-title"><i class="bi bi-cash-stack me-2" style="color:var(--success)"></i>5. Trade-In Valuation &amp; Inventory Transfer</div>
                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <div><strong>Estimated Valuation:</strong> ₹${(data.estimatedValue || 0).toFixed(2)}</div>
                                            <div><strong>Final Valuation Credit:</strong> <span class="td-strong" style="color:var(--success);font-size:20px">₹${data.finalExchangeValue.toFixed(2)}</span></div>
                                        </div>
                                        <div class="col-md-4">
                                            <div><strong>Inventory Status:</strong> <span class="badge-d badge-blue">${data.inventoryDestinationStatus}</span></div>
                                            <div><strong>Created / Processed By:</strong> ${data.executedBy}</div>
                                        </div>
                                        <div class="col-md-4">
                                            <div><strong>Remarks / Inspector Notes:</strong></div>
                                            <div class="text-muted" style="font-size:13px">${data.remarks || 'No additional notes entered.'}</div>
                                            ${(data.devicePhotos && data.devicePhotos.length > 0) ? `
                                                <div class="mt-2">
                                                    <div class="fw-semibold mb-1" style="font-size:11px;color:var(--text-muted)">DEVICE PHOTOS:</div>
                                                    <div class="d-flex flex-wrap gap-2">
                                                        ${data.devicePhotos.map(p => `<a href="${p}" target="_blank" rel="noopener"><img src="${p}" style="width:50px;height:50px;object-fit:cover;border-radius:6px;border:1px solid var(--border)" alt="Device Photo" /></a>`).join('')}
                                                    </div>
                                                </div>
                                            ` : ''}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                } else {
                    modalBody.innerHTML = `<div class="alert-d alert-danger">${data.message || 'Error loading details.'}</div>`;
                }
            } catch (err) {
                modalBody.innerHTML = `<div class="alert-d alert-danger">Failed to fetch trade-in details: ${err}</div>`;
            }
        }

        async function openEditExchangeModal(id) {
            try {
                const resp = await fetch(`/Exchange/GetDetails?id=${id}`);
                const data = await resp.json();
                if (!data.success) {
                    alert(data.message || 'Record not found');
                    return;
                }

                // 1. Customer Info
                document.getElementById('editExchangeId').value = data.id || '';
                document.getElementById('editCustomerName').value = data.customerName || '';
                document.getElementById('editCustomerPhone').value = data.customerPhone || '';
                document.getElementById('editCustomerEmail').value = data.customerEmail || '';
                document.getElementById('editCustomerAddress').value = data.customerAddress || '';

                // 2. Device Specs
                document.getElementById('editOldBrand').value = data.brand || '';
                document.getElementById('editOldModel').value = data.model || '';
                document.getElementById('editOldColor').value = data.color || '';
                document.getElementById('editOldStorage').value = data.storage || '';
                document.getElementById('editOldRam').value = data.ram || '';
                document.getElementById('editOldImei1').value = data.imei1 || '';
                document.getElementById('editOldImei2').value = data.imei2 || '';
                document.getElementById('editSerialNumber').value = data.serialNumber || '';
                document.getElementById('editDeviceType').value = data.deviceType || 'Smartphone';
                document.getElementById('editSimType').value = data.simType || 'Dual SIM';

                // 3. Inspection Checklist
                document.getElementById('editCondition').value = data.condition || 'Good Condition';
                document.getElementById('editBatteryHealthPercentage').value = data.batteryHealthPercentage !== null ? data.batteryHealthPercentage : '';
                document.getElementById('editBatteryCondition').value = data.batteryCondition || 'Good';
                document.getElementById('editScreenCondition').value = data.screenCondition || 'Good';
                document.getElementById('editBodyCondition').value = data.bodyCondition || 'Good';
                document.getElementById('editCameraCondition').value = data.cameraCondition || 'Working';
                document.getElementById('editSpeakerCondition').value = data.speakerCondition || 'Working';
                document.getElementById('editMicrophoneCondition').value = data.microphoneCondition || 'Working';
                document.getElementById('editChargingPortCondition').value = data.chargingPortCondition || 'Working';
                document.getElementById('editButtonsCondition').value = data.buttonsCondition || 'Working';
                document.getElementById('editFaceIdFingerprintCondition').value = data.faceIdFingerprintCondition || 'Working';

                // 4. Security Locks
                document.getElementById('editIsDeviceUnlocked').value = data.isDeviceUnlocked !== undefined ? data.isDeviceUnlocked.toString() : 'true';
                document.getElementById('editAppleActivationLock').value = data.appleActivationLock || 'Clear';
                document.getElementById('editGoogleFRPAccountLock').value = data.googleFRPAccountLock || 'Clear';

                // 5. Accessories
                const accList = data.accessoriesReceived || [];
                document.querySelectorAll('#editExchangeModal input[name="AccessoriesReceived"]').forEach(cb => {
                    cb.checked = accList.includes(cb.value);
                });
                document.getElementById('editOtherAccessoriesNotes').value = data.otherAccessoriesNotes || '';

                // 6. Valuation & Destination
                document.getElementById('editEstimatedValue').value = data.estimatedValue || 0;
                document.getElementById('editFinalExchangeValue').value = data.finalExchangeValue || 0;
                document.getElementById('editInventoryDestinationStatus').value = data.inventoryDestinationStatus || 'InStock';
                document.getElementById('editInspectorName').value = data.inspectorName || '';
                document.getElementById('editRemarks').value = data.remarks || '';

                // Show first tab in Edit Modal by default
                const firstEditTab = document.getElementById('edit-cust-tab');
                if (firstEditTab) bootstrap.Tab.getOrCreateInstance(firstEditTab).show();

                const modalEl = document.getElementById('editExchangeModal');
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
            } catch (err) {
                alert('Failed to load trade-in record for editing.');
            }
        }

        // Auto-switch to tab containing invalid input if submit fails
        document.getElementById('tradeInForm').addEventListener('submit', function(e) {
            const colorSel = document.getElementById('colorSelect').value;
            if (!colorSel) {
                alert('Please select a physical Color for the old phone on Tab 2 (Device Specs).');
                e.preventDefault();
                navigateWizard(1);
                return false;
            }

            const invalidInput = this.querySelector(':invalid');
            if (invalidInput) {
                const pane = invalidInput.closest('.tab-pane');
                if (pane) {
                    const tabBtn = document.querySelector(`button[data-bs-target="#${pane.id}"]`);
                    if (tabBtn) {
                        bootstrap.Tab.getOrCreateInstance(tabBtn).show();
                        setTimeout(() => {
                            invalidInput.focus();
                            invalidInput.reportValidity();
                        }, 200);
                    }
                }
            }
        });

        // Initialize button state when modal opens
        document.getElementById('processExchangeModal').addEventListener('shown.bs.modal', function () {
            currentTabIdx = 0;
            const firstTab = document.getElementById(wizardTabIds[0]);
            if (firstTab) bootstrap.Tab.getOrCreateInstance(firstTab).show();
            updateWizardButtons();
        });

        document.addEventListener("DOMContentLoaded", function() {
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('openModal') === 'true') {
                const modal = new bootstrap.Modal(document.getElementById('processExchangeModal'));
                modal.show();
            }
        });
    </script>
}
