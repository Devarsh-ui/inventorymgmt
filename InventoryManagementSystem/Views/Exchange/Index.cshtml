                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="AccessoriesReceived" value="SIM Ejector" id="acc7">
                                            <label class="form-check-label text-light" for="acc7"><i class="bi bi-pin-angle me-1"></i> SIM Ejector Pin</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="fg">
                                        <label class="fg-label">Other Accessories / Additional Notes</label>
                                        <input type="text" name="OtherAccessoriesNotes" class="fg-control" placeholder="e.g. Tempered glass applied, original bill available..." />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- TAB 6: Valuation & Destination -->
                        <div class="tab-pane fade" id="valuation-tab-pane">
                            <div class="s-title mb-3"><i class="bi bi-cash-stack me-2" style="color:var(--primary)"></i>Trade-In Valuation &amp; Inventory Routing</div>
