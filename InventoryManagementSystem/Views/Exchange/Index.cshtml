                        </li>
                        <li class="nav-item">
                            <button class="nav-link fw-bold" id="edit-accessories-tab" data-bs-toggle="tab" data-bs-target="#edit-accessories-tab-pane" type="button"><i class="bi bi-box-seam me-1"></i> 5. Accessories</button>
