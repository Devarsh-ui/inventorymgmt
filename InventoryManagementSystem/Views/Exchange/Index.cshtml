                            <div class="alert-d alert-warning mb-4">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                <strong>Important Security Protocol</strong>: Devices with active Apple Activation Lock (iCloud) or Google FRP Account Lock will be flagged with <code>HasAccountLock = true</code> and assigned to <strong>Pending Inspection</strong> status until unlocked.
                            </div>

                            <div class="row g-3">
                                <div class="col-md-4">
                                    <div class="fg">
                                        <label class="fg-label">Device Screen Passcode Unlocked?</label>
                                        <select name="IsDeviceUnlocked" class="fg-control">
                                            <option value="true" selected>Yes (Screen Passcode Removed)</option>
                                            <option value="false">No (Locked with Passcode)</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="fg">
                                        <label class="fg-label">Apple Activation Lock (iCloud / Find My)</label>
                                        <select name="AppleActivationLock" class="fg-control">
                                            <option value="Clear" selected>Clear (Signed Out)</option>
                                            <option value="Enabled">Enabled (iCloud Locked ⚠️)</option>
                                            <option value="Not Checked">Not Checked / N/A</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="fg">
                                        <label class="fg-label">Google Account Lock (FRP)</label>
                                        <select name="GoogleFRPAccountLock" class="fg-control">
                                            <option value="Clear" selected>Clear (Signed Out)</option>
                                            <option value="Enabled">Enabled (FRP Locked ⚠️)</option>
                                            <option value="Not Checked">Not Checked / N/A</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- TAB 5: Accessories Received -->
                        <div class="tab-pane fade" id="accessories-tab-pane">
                            <div class="s-title mb-3"><i class="bi bi-box-seam me-2" style="color:var(--primary)"></i>Accessories &amp; Items Included in Trade-In</div>
                            <div class="row g-3">
                                <div class="col-12">
                                    <div class="d-flex flex-wrap gap-4 p-3 rounded" style="background:var(--bg);border:1px solid var(--border)">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="AccessoriesReceived" value="Original Box" id="acc1">
                                            <label class="form-check-label text-light" for="acc1"><i class="bi bi-box me-1"></i> Original Box</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="AccessoriesReceived" value="Original Charger" id="acc2" checked>
                                            <label class="form-check-label text-light" for="acc2"><i class="bi bi-plug me-1"></i> Charger</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="AccessoriesReceived" value="USB Cable" id="acc3" checked>
                                            <label class="form-check-label text-light" for="acc3"><i class="bi bi-usb-c me-1"></i> USB Cable</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="AccessoriesReceived" value="Earphones" id="acc4">
                                            <label class="form-check-label text-light" for="acc4"><i class="bi bi-headphones me-1"></i> Earphones</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="AccessoriesReceived" value="Case" id="acc5">
                                            <label class="form-check-label text-light" for="acc5"><i class="bi bi-shield me-1"></i> Protective Case</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="AccessoriesReceived" value="Original Invoice" id="acc6">
                                            <label class="form-check-label text-light" for="acc6"><i class="bi bi-file-earmark-text me-1"></i> Purchase Invoice</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="AccessoriesReceived" value="SIM Ejector" id="acc7">
                                            <label class="form-check-label text-light" for="acc7"><i class="bi bi-pin-angle me-1"></i> SIM Ejector Pin</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="fg">
                                        <label class="fg-label">Other Accessories / Additional Notes</label>
                                        <input type="text" name="OtherAccessoriesNotes" class="fg-control" placeholder="e.g. Tempered glass applied, original bill available..." />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- TAB 6: Device Photos (Camera + File Upload) -->
                        <div class="tab-pane fade" id="photos-tab-pane">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="s-title mb-0"><i class="bi bi-camera me-2" style="color:var(--primary)"></i>Trade-In Device Condition Photos</div>
                                <span class="text-muted" style="font-size:12px"><i class="bi bi-info-circle me-1"></i>Attach clear photos for device verification and trade-in audit</span>
                            </div>

                            <!-- Suggested Photos Banner -->
                            <div class="alert-d alert-info mb-3 d-flex flex-wrap gap-2 align-items-center justify-content-between py-2">
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="fw-bold" style="font-size:12px"><i class="bi bi-lightbulb-fill text-warning me-1"></i>Recommended Angles:</span>
                                    <span class="badge-d badge-blue" style="font-size:11px">📱 Front Screen On</span>
                                    <span class="badge-d badge-blue" style="font-size:11px">🔄 Back Cover & Cameras</span>
                                    <span class="badge-d badge-blue" style="font-size:11px">🏷️ IMEI / Barcode Sticker</span>
                                    <span class="badge-d badge-blue" style="font-size:11px">⚡ Charging Port & Edges</span>
                                    <span class="badge-d badge-blue" style="font-size:11px">🔍 Scratches / Dents (if any)</span>
                                </div>
                                <div class="text-muted" style="font-size:11px">Multiple photos supported</div>
                            </div>

                            <!-- Actions Bar: Camera + File Upload -->
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <div class="p-3 rounded text-center h-100 d-flex flex-column align-items-center justify-content-center" style="background:var(--bg);border:2px dashed var(--primary);transition:all 0.2s ease">
                                        <i class="bi bi-camera-fill text-primary mb-2" style="font-size:32px"></i>
                                        <h6 class="fw-bold mb-1" style="color:var(--text-primary)">Capture Live via Camera</h6>
                                        <p class="text-muted mb-2" style="font-size:12px">Use your device webcam or phone back-camera to snap live photos.</p>
                                        <button type="button" class="btn-d btn-primary" onclick="openLiveCamera('new')">
                                            <i class="bi bi-camera me-1"></i> Open Live Camera
                                        </button>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="p-3 rounded text-center h-100 d-flex flex-column align-items-center justify-content-center" style="background:var(--bg);border:2px dashed var(--border);transition:all 0.2s ease" id="newPhotoDropzone">
                                        <i class="bi bi-cloud-arrow-up-fill text-secondary mb-2" style="font-size:32px"></i>
                                        <h6 class="fw-bold mb-1" style="color:var(--text-primary)">Upload from Device Files</h6>
                                        <p class="text-muted mb-2" style="font-size:12px">Choose one or more image files (JPG, PNG, WEBP).</p>
                                        <input type="file" id="newDevicePhotoInput" name="devicePhotos" multiple accept="image/*" class="d-none" onchange="handleNewPhotoFiles(this.files)" />
                                        <button type="button" class="btn-d btn-outline" onclick="document.getElementById('newDevicePhotoInput').click()">
                                            <i class="bi bi-folder2-open me-1"></i> Select Image Files
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Hidden Container for Camera Base64 Captures -->
                            <div id="newCapturedPhotosContainer" style="display:none"></div>

                            <!-- Gallery Preview Grid -->
                            <div class="card-d card-p">
                                <div class="d-flex justify-content-between align-items-center mb-2 pb-2" style="border-bottom:1px solid var(--border)">
                                    <span class="fw-bold" style="font-size:13px"><i class="bi bi-images me-1 text-primary"></i> Attached Photos (<span id="newPhotosCountText">0 photos</span>)</span>
                                    <button type="button" class="btn-d btn-outline btn-sm-d" id="clearAllNewPhotosBtn" onclick="clearAllNewPhotos()" style="display:none;color:var(--danger)">
                                        <i class="bi bi-trash me-1"></i> Clear All
                                    </button>
                                </div>
                                <div class="row g-2" id="newPhotosGallery">
                                    <!-- Empty state -->
                                    <div class="col-12 text-center py-4 text-muted" id="newPhotosEmptyState">
                                        <i class="bi bi-card-image mb-2 d-block" style="font-size:36px;opacity:0.4"></i>
                                        <div>No device photos added yet.</div>
                                        <div style="font-size:11px">Snap photos using camera or select image files above.</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- TAB 7: Valuation & Destination -->
                        <div class="tab-pane fade" id="valuation-tab-pane">
                            <div class="s-title mb-3"><i class="bi bi-cash-stack me-2" style="color:var(--primary)"></i>Trade-In Valuation &amp; Inventory Routing</div>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="fg">
                                        <label class="fg-label">Estimated Valuation (₹)</label>
                                        <div class="fg-prefix-wrap">
                                            <span class="fg-prefix">₹</span>
                                            <input type="number" step="0.01" name="EstimatedValue" class="fg-control" placeholder="e.g. 5000.00" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="fg">
                                        <label class="fg-label">Final Valuation Credit (Acquisition Cost) (₹) <span class="req">*</span></label>
                                        <div class="fg-prefix-wrap">
                                            <span class="fg-prefix">₹</span>
                                            <input type="number" step="0.01" name="FinalExchangeValue" required class="fg-control fw-bold" style="color:var(--success);font-size:18px" placeholder="e.g. 4545.00" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="fg">
                                        <label class="fg-label">Inventory Destination Status <span class="req">*</span></label>
                                        <select name="InventoryDestinationStatus" required class="fg-control">
                                            <option value="InStock" selected>In Stock (Available for POS Sale)</option>
                                            <option value="UnderRepair">Under Repair (Sent to Service)</option>
                                            <option value="Damaged">Damaged (Scrap / Parts)</option>
                                            <option value="Pending">Pending Inspection</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="fg">
                                        <label class="fg-label">Inspector Name</label>
                                        <input type="text" name="InspectorName" value="@User.Identity?.Name" class="fg-control" />
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="fg">
                                        <label class="fg-label">Remarks &amp; Detailed Inspector Notes</label>
                                        <textarea name="Remarks" rows="2" class="fg-control" placeholder="Enter physical inspection summary and details..."></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer justify-content-between" style="border-top:1px solid var(--border)">
                    <div>
                        <button type="button" class="btn-d btn-outline" data-bs-dismiss="modal">Cancel</button>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn-d btn-outline" id="prevTabBtn" onclick="navigateWizard(-1)" disabled>
                            <i class="bi bi-chevron-left me-1"></i> Previous
                        </button>
                        <button type="button" class="btn-d btn-primary" id="nextTabBtn" onclick="navigateWizard(1)">
                            Next: Old Device Specs <i class="bi bi-chevron-right ms-1"></i>
                        </button>
                        <button type="submit" class="btn-d btn-success" id="submitTradeInBtn" style="display:none">
                            <i class="bi bi-check2-circle me-1"></i> Accept Trade-In &amp; Transfer to Inventory
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: View Trade-In Details -->
