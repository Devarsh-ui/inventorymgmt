                                            <option value="Not Working">Not Working / Disabled</option>
                                            <option value="Not Available">Not Available</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- TAB 4: Security Locks -->
                        <div class="tab-pane fade" id="security-tab-pane">
