                        </li>
                        <li class="nav-item">
                            <button class="nav-link fw-bold" id="edit-condition-tab" data-bs-toggle="tab" data-bs-target="#edit-condition-tab-pane" type="button"><i class="bi bi-cpu me-1"></i> 3. Inspection Checklist</button>
                        </li>
                        <li class="nav-item">
