                                            <option value="Faulty">Faulty (No Sound)</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="fg">
                                        <label class="fg-label">Microphone</label>
                                        <select name="MicrophoneCondition" class="fg-control">
                                            <option value="Working" selected>Working (Clear Audio)</option>
                                            <option value="Minor Issue">Low Input Voice</option>
                                            <option value="Faulty">Faulty (Muted Mic)</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="fg">
                                        <label class="fg-label">Charging Port</label>
                                        <select name="ChargingPortCondition" class="fg-control">
                                            <option value="Working" selected>Working (Fast Charge)</option>
                                            <option value="Loose">Loose Contact</option>
                                            <option value="Damaged">Damaged / Not Charging</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="fg">
                                        <label class="fg-label">Physical Buttons</label>
                                        <select name="ButtonsCondition" class="fg-control">
                                            <option value="Working" selected>Working (Tactile)</option>
                                            <option value="Damaged">Stuck / Damaged</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="fg">
                                        <label class="fg-label">Face ID / Biometrics</label>
                                        <select name="FaceIdFingerprintCondition" class="fg-control">
