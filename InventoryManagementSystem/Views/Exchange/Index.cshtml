            const img = document.getElementById('lightboxImg');
            const titleEl = document.getElementById('lightboxTitle');
            if (img) img.src = src;
            if (titleEl) titleEl.innerHTML = `<i class="bi bi-image me-2 text-primary"></i>${title || 'Device Photo Preview'}`;
