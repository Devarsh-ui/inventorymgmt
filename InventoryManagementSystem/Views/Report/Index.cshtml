@{
    ViewData["Title"] = "Reports Center";
    var categories = ViewBag.Categories as IEnumerable<InventoryManagementSystem.Models.Category> ?? new List<InventoryManagementSystem.Models.Category>();
    var products = ViewBag.Products as IEnumerable<InventoryManagementSystem.Models.Product> ?? new List<InventoryManagementSystem.Models.Product>();
    var users = ViewBag.Users as IEnumerable<InventoryManagementSystem.Models.User> ?? new List<InventoryManagementSystem.Models.User>();
}

<div class="ph d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
        <h1 class="ph-title"><i class="bi bi-file-earmark-bar-graph me-2" style="color:var(--primary)"></i>Enterprise Reports Center</h1>
        <p class="ph-sub">Generate, filter, preview, and download real-time business reports in Excel (.xlsx) &amp; PDF (.pdf).</p>
    </div>
    <div class="d-flex gap-2">
        <button id="exportExcelBtn" class="btn-d btn-primary" style="background:#16a34a;border-color:#16a34a">
            <i class="bi bi-file-earmark-excel me-1"></i> Export Excel (.xlsx)
        </button>
        <button id="exportPdfBtn" class="btn-d btn-primary" style="background:#dc2626;border-color:#dc2626">
            <i class="bi bi-file-earmark-pdf me-1"></i> Download PDF (.pdf)
        </button>
    </div>
</div>

<!-- 1. Report Type Selector Bar -->
<div class="card-d card-p p-3 mb-4" style="background:rgba(255,255,255,0.02)">
    <div class="text-muted small mb-2 fw-semibold"><i class="bi bi-collection-play me-1"></i>SELECT REPORT TYPE</div>
    <div class="d-flex flex-wrap gap-2" id="reportTypeSelector">
        <button type="button" class="btn-d btn-outline r-type-btn active" data-type="Sales">
            <i class="bi bi-receipt me-1" style="color:var(--success)"></i> Sales Report
        </button>
        <button type="button" class="btn-d btn-outline r-type-btn" data-type="ImeiInventory">
            <i class="bi bi-upc-scan me-1" style="color:#0dcaf0"></i> IMEI Device Inventory
        </button>
        <button type="button" class="btn-d btn-outline r-type-btn" data-type="TradeIn">
            <i class="bi bi-arrow-repeat me-1" style="color:#a855f7"></i> Trade-In Exchange
        </button>
        <button type="button" class="btn-d btn-outline r-type-btn" data-type="Returns">
            <i class="bi bi-arrow-return-left me-1" style="color:#ef4444"></i> Customer Returns
        </button>
        <button type="button" class="btn-d btn-outline r-type-btn" data-type="PurchaseReturns">
            <i class="bi bi-arrow-return-left me-1" style="color:#3b82f6"></i> Supplier Purchase Returns
        </button>
        <button type="button" class="btn-d btn-outline r-type-btn" data-type="Repairs">
            <i class="bi bi-wrench-adjustable me-1" style="color:#f59e0b"></i> Repair Tickets
        </button>
        <button type="button" class="btn-d btn-outline r-type-btn" data-type="Warranty">
            <i class="bi bi-shield-check me-1" style="color:#10b981"></i> Warranty Tracking
        </button>
        <button type="button" class="btn-d btn-outline r-type-btn" data-type="Customer">
            <i class="bi bi-person-vcard me-1" style="color:#3b82f6"></i> Customer Accounts
        </button>
        <button type="button" class="btn-d btn-outline r-type-btn" data-type="Supplier">
            <i class="bi bi-truck me-1" style="color:#64748b"></i> Supplier Directory
        </button>
        <button type="button" class="btn-d btn-outline r-type-btn" data-type="Inventory">
            <i class="bi bi-box-seam me-1" style="color:var(--primary)"></i> General Inventory
        </button>
        <button type="button" class="btn-d btn-outline r-type-btn" data-type="StockMovement">
            <i class="bi bi-arrow-left-right me-1" style="color:var(--warning)"></i> Stock Movements
        </button>
        <button type="button" class="btn-d btn-outline r-type-btn" data-type="EmployeeActivity">
            <i class="bi bi-person-badge me-1" style="color:#a855f7"></i> Employee Activity
        </button>
        <button type="button" class="btn-d btn-outline r-type-btn" data-type="Alerts">
            <i class="bi bi-exclamation-triangle me-1" style="color:#ef4444"></i> Low Stock Alerts
        </button>
        <button type="button" class="btn-d btn-outline r-type-btn" data-type="ExecutiveSummary">
            <i class="bi bi-briefcase me-1" style="color:#f59e0b"></i> Executive Summary
        </button>
    </div>
</div>

<!-- 2. Dynamic Summary Dashboard Cards -->
<div class="row g-3 mb-4" id="summaryCardsContainer">
    <div class="col-xl-3 col-sm-6">
        <div class="stat-card">
            <div>
                <div class="sc-label">Gross Sales</div>
                <div class="sc-value" id="cardGrossSales" style="font-size:22px">₹0.00</div>
                <span class="sc-trend trend-flat"><i class="bi bi-receipt"></i> Original Checkout Total</span>
            </div>
            <div class="sc-icon ic-blue">
                <i class="bi bi-receipt-cutoff"></i>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6">
        <div class="stat-card">
            <div>
                <div class="sc-label">Returns &amp; Refunds</div>
                <div class="sc-value text-danger" id="cardReturnsRefunds" style="font-size:22px">₹0.00</div>
                <span class="sc-trend trend-flat text-danger"><i class="bi bi-arrow-return-left"></i> Real-time Refunds Reversal</span>
            </div>
            <div class="sc-icon ic-amber" style="background:rgba(239, 68, 68, 0.1);color:#ef4444">
                <i class="bi bi-arrow-counterclockwise"></i>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6">
        <div class="stat-card">
            <div>
                <div class="sc-label">Net Revenue</div>
                <div class="sc-value text-success" id="cardRevenue" style="font-size:22px">₹0.00</div>
                <span class="sc-trend trend-flat text-success"><i class="bi bi-check-circle"></i> Gross Sales − Refunds</span>
            </div>
            <div class="sc-icon ic-green">
                <i class="bi bi-currency-rupee"></i>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6">
        <div class="stat-card" id="cardLowStockBorder">
            <div>
                <div class="sc-label">Stock &amp; Valuation Assets</div>
                <div class="sc-value" id="cardAssetValue" style="font-size:22px">₹0.00</div>
                <span class="sc-trend trend-flat" id="cardAssetSub"><i class="bi bi-box"></i> Sellable Stock Cost</span>
            </div>
            <div class="sc-icon ic-sky">
                <i class="bi bi-box-seam"></i>
            </div>
        </div>
    </div>
</div>

<!-- 3. Global Filters Panel -->
<div class="card-d card-p-lg mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="s-title mb-0"><i class="bi bi-funnel me-2" style="color:var(--primary)"></i>Global Report Filters</div>
        <!-- Date Preset Pills -->
        <div class="d-flex flex-wrap gap-1" id="datePresetPills">
            <button type="button" class="btn-d btn-outline btn-sm date-preset-btn" data-preset="Today">Today</button>
            <button type="button" class="btn-d btn-outline btn-sm date-preset-btn" data-preset="Yesterday">Yesterday</button>
            <button type="button" class="btn-d btn-outline btn-sm date-preset-btn" data-preset="ThisWeek">This Week</button>
            <button type="button" class="btn-d btn-outline btn-sm date-preset-btn active" data-preset="ThisMonth">This Month</button>
            <button type="button" class="btn-d btn-outline btn-sm date-preset-btn" data-preset="LastMonth">Last Month</button>
            <button type="button" class="btn-d btn-outline btn-sm date-preset-btn" data-preset="ThisYear">This Year</button>
            <button type="button" class="btn-d btn-outline btn-sm date-preset-btn" data-preset="Custom">Custom</button>
        </div>
    </div>

    <form id="filterForm">
        <input type="hidden" id="reportType" name="ReportType" value="@(ViewBag.InitialReportType ?? "Sales")" />
        <input type="hidden" id="datePreset" name="DatePreset" value="@(ViewBag.InitialDatePreset ?? "ThisMonth")" />
        <input type="hidden" id="currentPage" name="Page" value="1" />
        <input type="hidden" id="sortBy" name="SortBy" value="" />

        <div class="row g-3">
            <!-- Custom Date Range -->
            <div class="col-md-3 date-custom-container" style="display:none">
                <div class="fg">
                    <label class="fg-label">From Date</label>
                    <input type="date" id="startDate" name="StartDate" class="fg-control" value="@ViewBag.InitialStartDate" />
                </div>
            </div>
            <div class="col-md-3 date-custom-container" style="display:none">
                <div class="fg">
                    <label class="fg-label">To Date</label>
                    <input type="date" id="endDate" name="EndDate" class="fg-control" value="@ViewBag.InitialEndDate" />
                </div>
            </div>

            <!-- Product Filter -->
            <div class="col-md-3">
                <div class="fg">
                    <label class="fg-label">Product</label>
                    <select id="productId" name="ProductId" class="fg-control">
                        <option value="">All Products</option>
                        @foreach (var p in products)
                        {
                            <option value="@p.Id">@p.Name (@p.Code)</option>
                        }
                    </select>
                </div>
            </div>

            <!-- Category Filter -->
            <div class="col-md-3">
                <div class="fg">
                    <label class="fg-label">Category</label>
                    <select id="categoryId" name="CategoryId" class="fg-control">
                        <option value="">All Categories</option>
                        @foreach (var c in categories)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                </div>
            </div>

            <!-- User / Employee Filter -->
            <div class="col-md-3">
                <div class="fg">
                    <label class="fg-label">User / Employee</label>
                    <select id="employeeId" name="EmployeeId" class="fg-control">
                        <option value="">All Users</option>
                        @foreach (var u in users)
                        {
                            <option value="@u.Username">@u.FullName (@u.Username)</option>
                        }
                    </select>
                </div>
            </div>

            <!-- Payment Status -->
            <div class="col-md-3">
                <div class="fg">
                    <label class="fg-label">Payment Status</label>
                    <select id="paymentStatus" name="PaymentStatus" class="fg-control">
                        <option value="">All Payment Statuses</option>
                        <option value="Paid">Paid</option>
                        <option value="Unpaid">Unpaid</option>
                        <option value="Partial">Partial</option>
                        <option value="Draft">Draft</option>
                    </select>
                </div>
            </div>

            <!-- Return Status -->
            <div class="col-md-3">
                <div class="fg">
                    <label class="fg-label">Return Status</label>
                    <select id="returnStatus" name="ReturnStatus" class="fg-control">
                        <option value="All">All Invoices (Sales &amp; Returns)</option>
                        <option value="None">Normal Sales (No Returns)</option>
                        <option value="Partially Returned">Partially Returned</option>
                        <option value="Fully Returned">Fully Refunded / Returned</option>
                    </select>
                </div>
            </div>

            <!-- Device Restock Destination -->
            <div class="col-md-3">
                <div class="fg">
                    <label class="fg-label">Return Destination / Device Status</label>
                    <select id="returnDestination" name="ReturnDestination" class="fg-control">
                        <option value="All">All Statuses / Destinations</option>
                        <option value="Returned">Restocked to Inventory (InStock)</option>
                        <option value="Damaged">Marked Damaged / Defective</option>
                        <option value="UnderRepair">Sent to Repair Workshop</option>
                    </select>
                </div>
            </div>

            <!-- Keyword Search -->
            <div class="col-md-3">
                <div class="fg">
                    <label class="fg-label">Search Keyword / IMEI / Invoice</label>
                    <input type="text" id="searchTerm" name="SearchTerm" class="fg-control" placeholder="Search SKU, IMEI, Invoice..." />
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top border-secondary border-opacity-25">
            <div class="d-flex gap-2">
                <button type="submit" class="btn-d btn-primary">
                    <i class="bi bi-funnel-fill me-1"></i> Apply Filters
                </button>
                <button type="button" id="resetFiltersBtn" class="btn-d btn-outline">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Reset Filters
                </button>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted small">Items per page:</span>
                <select id="pageSize" name="PageSize" class="fg-control form-select-sm" style="width:auto">
                    <option value="10">10</option>
                    <option value="20" selected>20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
        </div>
    </form>
</div>

<!-- 4. Live Data Preview Section & Table -->
<div class="card-d card-p-lg">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h3 class="s-title mb-0" id="previewTitle">Report Preview</h3>
            <div class="text-muted small" id="previewSubtitle">Applied Filters: None</div>
        </div>
        <div class="badge bg-dark border border-secondary text-light px-3 py-2" id="previewCountBadge">
            0 Records Found
        </div>
    </div>

    <!-- Table Container -->
    <div class="table-responsive" style="min-height:300px">
        <table class="table table-dark table-hover align-middle mb-0" id="reportPreviewTable">
            <thead>
                <tr id="tableHeaderRow">
                    <!-- Dynamic Headers injected here -->
                </tr>
            </thead>
            <tbody id="tableBody">
                <!-- Loading State by default -->
                <tr>
                    <td colspan="12" class="text-center py-5 text-muted">
                        <div class="spinner-border text-primary me-2" role="status"></div> Loading report data...
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Pagination Controls Footer -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-4 pt-3 border-top border-secondary border-opacity-25">
        <div class="text-muted small" id="paginationInfo">
            Showing 0 to 0 of 0 records
        </div>
        <div class="d-flex gap-1" id="paginationButtons">
            <!-- Dynamic Page Buttons -->
        </div>
    </div>
</div>

<!-- Modal: Enterprise Report Record View Details -->
<div class="modal fade" id="reportRecordDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4" style="background:var(--card-bg);color:var(--text-primary)">
            <div class="modal-header border-bottom pb-3" style="border-color:var(--border)!important">
                <div>
                    <h5 class="fw-bold modal-title mb-1" style="color:var(--text-primary)"><i class="bi bi-file-earmark-text me-2 text-primary"></i><span id="rptModalTitle">Report Record Audit Details</span></h5>
                    <div class="text-muted small" id="rptModalSub">Report Type Record Detail View</div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-4">
                <div class="row g-3" id="rptModalGrid">
                    <!-- Dynamic Key-Value Details Cards Injected Here -->
                </div>
            </div>
            <div class="modal-footer border-top py-2" style="border-color:var(--border)!important">
                <button type="button" class="btn-d btn-ghost" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // State
            let currentReportType = '@(ViewBag.InitialReportType ?? "Sales")';
            let currentDatePreset = '@(ViewBag.InitialDatePreset ?? "ThisMonth")';

            // DOM Elements
            const filterForm = document.getElementById('filterForm');
            const reportTypeInput = document.getElementById('reportType');
            const datePresetInput = document.getElementById('datePreset');
            const currentPageInput = document.getElementById('currentPage');
            const dateCustomContainers = document.querySelectorAll('.date-custom-container');

            // 1. Report Type Pills Handler
            document.querySelectorAll('.r-type-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    document.querySelectorAll('.r-type-btn').forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                    currentReportType = this.dataset.type;
                    reportTypeInput.value = currentReportType;
                    currentPageInput.value = 1;
                    fetchReportPreview();
                });
            });

            // 2. Date Preset Pills Handler
            document.querySelectorAll('.date-preset-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    document.querySelectorAll('.date-preset-btn').forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                    currentDatePreset = this.dataset.preset;
                    datePresetInput.value = currentDatePreset;

                    if (currentDatePreset === 'Custom') {
                        dateCustomContainers.forEach(el => el.style.display = 'block');
                    } else {
                        dateCustomContainers.forEach(el => el.style.display = 'none');
                    }
                    currentPageInput.value = 1;
                    fetchReportPreview();
                });
            });

            // Form Submit
            filterForm.addEventListener('submit', function (e) {
                e.preventDefault();
                currentPageInput.value = 1;
                fetchReportPreview();
            });

            // Reset Filters
            document.getElementById('resetFiltersBtn').addEventListener('click', function () {
                filterForm.reset();
                reportTypeInput.value = 'Sales';
                datePresetInput.value = 'ThisMonth';
                currentPageInput.value = 1;

                document.querySelectorAll('.r-type-btn').forEach(b => b.classList.remove('active'));
                document.querySelector('.r-type-btn[data-type="Sales"]').classList.add('active');

                document.querySelectorAll('.date-preset-btn').forEach(b => b.classList.remove('active'));
                document.querySelector('.date-preset-btn[data-preset="ThisMonth"]').classList.add('active');

                dateCustomContainers.forEach(el => el.style.display = 'none');
                fetchReportPreview();
            });

            // Page Size Change
            document.getElementById('pageSize').addEventListener('change', function () {
                currentPageInput.value = 1;
                fetchReportPreview();
            });

            // Export Excel
            document.getElementById('exportExcelBtn').addEventListener('click', function () {
                const params = new URLSearchParams(new FormData(filterForm)).toString();
                window.location.href = '@Url.Action("ExportExcel", "Report")?' + params;
            });

            // Export PDF
            document.getElementById('exportPdfBtn').addEventListener('click', function () {
                const params = new URLSearchParams(new FormData(filterForm)).toString();
                window.open('@Url.Action("ExportPdf", "Report")?' + params, '_blank');
            });

            // Fetch AJAX Preview Data
            async function fetchReportPreview() {
                const tbody = document.getElementById('tableBody');
                tbody.innerHTML = `<tr><td colspan="13" class="text-center py-5 text-muted"><div class="spinner-border text-primary me-2"></div> Fetching latest database report data...</td></tr>`;

                try {
                    const params = new URLSearchParams(new FormData(filterForm)).toString();
                    const resp = await fetch('@Url.Action("Preview", "Report")?' + params);
                    const json = await resp.json();

                    if (!json.success) {
                        tbody.innerHTML = `<tr><td colspan="13" class="text-center py-4 text-danger"><i class="bi bi-exclamation-triangle me-2"></i> ${json.message}</td></tr>`;
                        return;
                    }

                    renderReport(json.data);
                } catch (err) {
                    tbody.innerHTML = `<tr><td colspan="13" class="text-center py-4 text-danger"><i class="bi bi-exclamation-octagon me-2"></i> Error connecting to report server.</td></tr>`;
                }
            }

            // Formatting Helpers
            function fmtCurr(val) {
                const n = Number(val) || 0;
                return '₹' + n.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }
            function fmtNum(val) {
                const n = Number(val) || 0;
                return n.toLocaleString('en-IN');
            }

            // Render Report Table & Summary Cards
            function renderReport(data) {
                window.currentReportData = data;
                window.currentReportRows = data.rows || [];

                // Update Titles & Subtitles
                document.getElementById('previewTitle').innerText = data.reportTitle;
                document.getElementById('previewSubtitle').innerText = `Filters: ${data.appliedFiltersText || 'All Records'}`;
                document.getElementById('previewCountBadge').innerText = `${data.totalCount} Records Found`;

                // Update Executive Dashboard Cards
                const stats = data.summaryStats || {};
                const grossVal = stats.grossSales || stats.totalSalesRevenue || 0;
                const returnsVal = stats.totalReturnsAmount || 0;
                const netVal = stats.netRevenue !== undefined ? stats.netRevenue : (grossVal - returnsVal);

                if (document.getElementById('cardGrossSales')) document.getElementById('cardGrossSales').innerText = fmtCurr(grossVal);
                if (document.getElementById('cardReturnsRefunds')) document.getElementById('cardReturnsRefunds').innerText = fmtCurr(returnsVal);
                if (document.getElementById('cardRevenue')) document.getElementById('cardRevenue').innerText = fmtCurr(netVal);
                if (document.getElementById('cardAssetValue')) document.getElementById('cardAssetValue').innerText = fmtCurr(stats.sellableInventoryValue || stats.currentInventoryValue);

                // Table Headers (Append Actions Column)
                const theadRow = document.getElementById('tableHeaderRow');
                theadRow.innerHTML = data.headers.map(h => `<th class="text-nowrap">${h}</th>`).join('') + `<th class="text-nowrap text-end pe-3">Actions</th>`;

                // Table Rows
                const tbody = document.getElementById('tableBody');
                if (!data.rows || data.rows.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="${data.headers.length + 1}" class="text-center py-5 text-muted"><i class="bi bi-inbox fs-3 d-block mb-2"></i>No matching records found for the selected filters.</td></tr>`;
                    renderPagination(data);
                    return;
                }

                const rType = (data.reportType || '').toLowerCase();

                tbody.innerHTML = data.rows.map((row, idx) => {
                    const rowNum = (data.page - 1) * data.pageSize + idx + 1;
                    const actionBtn = `<td class="text-end pe-3"><button type="button" class="btn-d btn-ghost btn-icon-d text-info py-1 px-2" style="width:auto;height:auto" onclick="openReportRowDetailsModal(${idx})" title="View Details"><i class="bi bi-eye me-1"></i>Details</button></td>`;

                    if (rType === 'sales' || rType === 'executivesummary') {
                        return `
                            <tr>
                                <td>${rowNum}</td>
                                <td><span class="font-monospace text-primary fw-bold">${escapeHtml(row.primaryText)}</span></td>
                                <td>${escapeHtml(row.dateString)}</td>
                                <td>${escapeHtml(row.customerInfo)}</td>
                                <td class="text-truncate" style="max-width:220px">${escapeHtml(row.secondaryText)}</td>
                                <td>${fmtCurr(row.grandTotal)}</td>
                                <td>${fmtCurr(row.discount)}</td>
                                <td>${fmtCurr(row.taxAmount)}</td>
                                <td><span class="fw-bold text-danger">${fmtCurr(row.refundedAmount || 0)}</span></td>
                                <td><span class="fw-bold text-success">${fmtCurr(row.netAmount !== undefined ? row.netAmount : (row.grandTotal - (row.refundedAmount || 0)))}</span></td>
                                <td><span class="badge ${row.badgeClass}">${escapeHtml(row.badgeText)}</span></td>
                                <td>${escapeHtml(row.userExecutor)}</td>
                                ${actionBtn}
                            </tr>`;
                    } else if (rType === 'returns' || rType === 'return') {
                        return `
                            <tr>
                                <td>${rowNum}</td>
                                <td><span class="font-monospace text-primary fw-bold">${escapeHtml(row.primaryText)}</span></td>
                                <td><span class="font-monospace text-info">${escapeHtml(row.referenceInfo || '-')}</span></td>
                                <td>${escapeHtml(row.dateString)}</td>
                                <td>${escapeHtml(row.customerInfo)}</td>
                                <td>${escapeHtml(row.productInfo)}</td>
                                <td><span class="font-monospace text-warning">${escapeHtml(row.secondaryText)}</span></td>
                                <td><span class="badge bg-secondary">${escapeHtml(row.reason)}</span></td>
                                <td><span class="badge ${row.badgeClass}">${escapeHtml(row.badgeText)}</span></td>
                                <td><span class="fw-bold text-danger">${fmtCurr(row.refundedAmount || row.grandTotal)}</span></td>
                                <td>${escapeHtml(row.userExecutor)}</td>
                                ${actionBtn}
                            </tr>`;
                    } else if (rType === 'purchasereturns' || rType === 'purchasereturn') {
                        return `
                            <tr>
                                <td>${rowNum}</td>
                                <td><span class="font-monospace text-primary fw-bold">${escapeHtml(row.primaryText)}</span></td>
                                <td><span class="font-monospace text-info">${escapeHtml(row.referenceInfo || '-')}</span></td>
                                <td>${escapeHtml(row.dateString)}</td>
                                <td><span class="fw-bold">${escapeHtml(row.customerInfo)}</span></td>
                                <td><span class="badge bg-light text-dark border">${escapeHtml(row.reason)}</span></td>
                                <td><span class="badge bg-primary bg-opacity-10 text-primary border">${escapeHtml(row.categoryName)}</span></td>
                                <td><span class="fw-bold">${fmtNum(row.stockQty)} Items</span></td>
                                <td><span class="fw-bold text-primary">${fmtCurr(row.grandTotal)}</span></td>
                                <td><span class="badge ${row.badgeClass}">${escapeHtml(row.badgeText)}</span></td>
                                <td>${escapeHtml(row.userExecutor)}</td>
                                ${actionBtn}
                            </tr>`;
                    } else if (rType === 'inventory') {
                        return `
                            <tr>
                                <td>${rowNum}</td>
                                <td><span class="font-monospace text-primary">${escapeHtml(row.code)}</span></td>
                                <td><span class="fw-bold text-light">${escapeHtml(row.name)}</span></td>
                                <td><span class="badge bg-dark border border-secondary">${escapeHtml(row.categoryName)}</span></td>
                                <td><span class="fw-bold fs-6 ${row.quantity === 0 ? 'text-danger' : (row.quantity <= row.previousStock ? 'text-warning' : 'text-success')}">${fmtNum(row.quantity)}</span></td>
                                <td>${fmtNum(row.previousStock)}</td>
                                <td><span class="badge ${row.badgeClass}">${escapeHtml(row.badgeText)}</span></td>
                                <td>${fmtCurr(row.unitPrice)}</td>
                                <td>${fmtCurr(row.salesValue)}</td>
                                <td><span class="fw-bold text-info">${fmtCurr(row.costValue)}</span></td>
                                <td>${fmtCurr(row.grandTotal)}</td>
                                <td><span class="fw-bold text-success">${fmtCurr(row.profitValue)}</span></td>
                                ${actionBtn}
                            </tr>`;
                    } else if (rType === 'stockmovement' || rType === 'stockhistory') {
                        return `
                            <tr>
                                <td>${rowNum}</td>
                                <td>${escapeHtml(row.dateString)}</td>
                                <td><span class="fw-bold">${escapeHtml(row.name)}</span></td>
                                <td><span class="font-monospace text-muted">${escapeHtml(row.code)}</span></td>
                                <td><span class="badge ${row.badgeClass}">${escapeHtml(row.badgeText)}</span></td>
                                <td><span class="fw-bold fs-6">${row.quantity > 0 ? '+' : ''}${fmtNum(row.quantity)}</span></td>
                                <td>${fmtNum(row.previousStock)}</td>
                                <td>${fmtNum(row.newStock)}</td>
                                <td>${escapeHtml(row.reason)}</td>
                                <td>${escapeHtml(row.userExecutor)}</td>
                                ${actionBtn}
                            </tr>`;
                    } else if (rType === 'employeeactivity') {
                        return `
                            <tr>
                                <td>${rowNum}</td>
                                <td>${escapeHtml(row.dateString)}</td>
                                <td><span class="fw-bold text-light">${escapeHtml(row.userExecutor)}</span></td>
                                <td><span class="badge bg-dark border border-secondary">${escapeHtml(row.secondaryText)}</span></td>
                                <td><span class="badge bg-primary">${escapeHtml(row.categoryName)}</span></td>
                                <td><span class="fw-semibold text-info">${escapeHtml(row.name)}</span></td>
                                <td class="text-truncate" style="max-width:250px">${escapeHtml(row.primaryText)}</td>
                                <td><span class="font-monospace text-muted">${escapeHtml(row.code)}</span></td>
                                <td><span class="badge ${row.badgeClass}">${escapeHtml(row.badgeText)}</span></td>
                                ${actionBtn}
                            </tr>`;
                    } else if (rType === 'alerts') {
                        return `
                            <tr>
                                <td>${rowNum}</td>
                                <td><span class="font-monospace text-primary">${escapeHtml(row.code)}</span></td>
                                <td><span class="fw-bold text-light">${escapeHtml(row.name)}</span></td>
                                <td><span class="badge bg-dark border border-secondary">${escapeHtml(row.categoryName)}</span></td>
                                <td><span class="fw-bold fs-6 ${row.quantity === 0 ? 'text-danger' : 'text-warning'}">${fmtNum(row.quantity)}</span></td>
                                <td>${fmtNum(row.previousStock)}</td>
                                <td><span class="badge ${row.badgeClass}">${escapeHtml(row.badgeText)}</span></td>
                                <td>${fmtCurr(row.unitPrice)}</td>
                                <td>${fmtCurr(row.salesValue)}</td>
                                <td><span class="fw-bold text-danger">${fmtNum(row.newStock)}</span></td>
                                ${actionBtn}
                            </tr>`;
                    } else if (rType === 'category') {
                        return `
                            <tr>
                                <td>${rowNum}</td>
                                <td><span class="fw-bold text-light">${escapeHtml(row.name)}</span></td>
                                <td>${fmtNum(row.quantity)} Products</td>
                                <td>${fmtNum(row.newStock)} Units</td>
                                <td>${fmtCurr(row.costValue)}</td>
                                <td>${fmtCurr(row.salesValue)}</td>
                                <td><span class="fw-bold text-success">${fmtCurr(row.grandTotal)}</span></td>
                                <td><span class="badge bg-warning text-dark">${fmtNum(row.previousStock)} Low</span></td>
                                <td><span class="badge bg-danger">${fmtNum(row.discount)} Out</span></td>
                                ${actionBtn}
                            </tr>`;
                    } else if (rType === 'productperformance') {
                        return `
                            <tr>
                                <td>${rowNum}</td>
                                <td><span class="font-monospace text-primary">${escapeHtml(row.code)}</span></td>
                                <td><span class="fw-bold text-light">${escapeHtml(row.name)}</span></td>
                                <td><span class="badge bg-dark border border-secondary">${escapeHtml(row.categoryName)}</span></td>
                                <td><span class="fw-bold text-info">${fmtNum(row.quantity)}</span></td>
                                <td><span class="fw-bold text-success">${fmtCurr(row.grandTotal)}</span></td>
                                <td>${fmtCurr(row.discount)}</td>
                                <td>${fmtNum(row.previousStock)}</td>
                                <td>${fmtCurr(row.costValue)}</td>
                                <td><span class="fw-bold text-primary">${fmtCurr(row.profitValue)}</span></td>
                                ${actionBtn}
                            </tr>`;
                    } else {
                        return `
                            <tr>
                                <td>${rowNum}</td>
                                <td>${escapeHtml(row.code || row.primaryText)}</td>
                                <td>${escapeHtml(row.name || row.customerInfo)}</td>
                                <td>${escapeHtml(row.categoryName || row.secondaryText)}</td>
                                <td>${fmtNum(row.quantity)}</td>
                                <td>${fmtCurr(row.grandTotal || row.costValue)}</td>
                                <td>${escapeHtml(row.badgeText || row.userExecutor)}</td>
                                ${actionBtn}
                            </tr>`;
                    }
                }).join('');

                renderPagination(data);
            }

            // Render Pagination Buttons
            function renderPagination(data) {
                const startRec = data.totalCount === 0 ? 0 : (data.page - 1) * data.pageSize + 1;
                const endRec = Math.min(data.totalCount, data.page * data.pageSize);
                document.getElementById('paginationInfo').innerText = `Showing ${startRec} to ${endRec} of ${data.totalCount} records`;

                const nav = document.getElementById('paginationButtons');
                if (data.totalPages <= 1) {
                    nav.innerHTML = '';
                    return;
                }

                let html = '';
                html += `<button type="button" class="btn-d btn-outline btn-sm ${data.page === 1 ? 'disabled' : ''}" onclick="goToPage(${data.page - 1})"><i class="bi bi-chevron-left"></i> Prev</button>`;

                for (let p = 1; p <= data.totalPages; p++) {
                    if (p === 1 || p === data.totalPages || (p >= data.page - 2 && p <= data.page + 2)) {
                        html += `<button type="button" class="btn-d ${p === data.page ? 'btn-primary' : 'btn-outline'} btn-sm" onclick="goToPage(${p})">${p}</button>`;
                    } else if (p === data.page - 3 || p === data.page + 3) {
                        html += `<span class="px-1 text-muted">...</span>`;
                    }
                }

                html += `<button type="button" class="btn-d btn-outline btn-sm ${data.page === data.totalPages ? 'disabled' : ''}" onclick="goToPage(${data.page + 1})">Next <i class="bi bi-chevron-right"></i></button>`;
                nav.innerHTML = html;
            }

            // Helper Pagination Function
            window.goToPage = function (p) {
                currentPageInput.value = p;
                fetchReportPreview();
            };

            // Global Row Details Modal Handler
            window.openReportRowDetailsModal = function (idx) {
                const row = window.currentReportRows ? window.currentReportRows[idx] : null;
                if (!row) return;

                const titleEl = document.getElementById('rptModalTitle');
                const subEl = document.getElementById('rptModalSub');
                const gridEl = document.getElementById('rptModalGrid');

                titleEl.innerText = `${window.currentReportData ? window.currentReportData.reportTitle : 'Report Record'} Details`;
                subEl.innerText = `Record Reference: ${row.primaryText || row.code || row.name || '#' + (idx + 1)}`;

                let fields = [];

                if (row.id) fields.push({ label: 'Database ID', value: `<code>${escapeHtml(row.id)}</code>` });
                if (row.primaryText) fields.push({ label: 'Primary Ref / Invoice / SKU', value: `<span class="fw-bold text-primary">${escapeHtml(row.primaryText)}</span>` });
                if (row.code && row.code !== row.primaryText) fields.push({ label: 'SKU / Code', value: `<span class="font-monospace">${escapeHtml(row.code)}</span>` });
                if (row.name && row.name !== row.primaryText) fields.push({ label: 'Product / Item Name', value: `<span class="fw-bold">${escapeHtml(row.name)}</span>` });
                if (row.dateString) fields.push({ label: 'Timestamp (IST)', value: escapeHtml(row.dateString) });
                if (row.customerInfo) fields.push({ label: 'Customer Info', value: escapeHtml(row.customerInfo) });
                if (row.productInfo) fields.push({ label: 'Product / Device Specs', value: escapeHtml(row.productInfo) });
                if (row.secondaryText) fields.push({ label: 'Secondary / Items Summary', value: escapeHtml(row.secondaryText) });
                if (row.categoryName) fields.push({ label: 'Category / Variant', value: `<span class="badge bg-dark border border-secondary">${escapeHtml(row.categoryName)}</span>` });
                if (row.reason) fields.push({ label: 'Reason / Problem Notes', value: escapeHtml(row.reason) });
                if (row.badgeText) fields.push({ label: 'Status Badge', value: `<span class="badge ${row.badgeClass || 'bg-info'}">${escapeHtml(row.badgeText)}</span>` });

                if (row.grandTotal !== undefined && row.grandTotal !== null && row.grandTotal !== 0) fields.push({ label: 'Grand Total / Value', value: `<span class="fw-bold text-success fs-6">${fmtCurr(row.grandTotal)}</span>` });
                if (row.subTotal !== undefined && row.subTotal !== null && row.subTotal !== 0) fields.push({ label: 'SubTotal', value: fmtCurr(row.subTotal) });
                if (row.discount !== undefined && row.discount !== null && row.discount !== 0) fields.push({ label: 'Discount Amount', value: `<span class="text-warning">${fmtCurr(row.discount)}</span>` });
                if (row.taxAmount !== undefined && row.taxAmount !== null && row.taxAmount !== 0) fields.push({ label: 'GST Tax Amount', value: fmtCurr(row.taxAmount) });
                if (row.refundedAmount !== undefined && row.refundedAmount !== null && row.refundedAmount !== 0) fields.push({ label: 'Refunded Amount', value: `<span class="text-danger fw-bold">${fmtCurr(row.refundedAmount)}</span>` });
                if (row.costPrice !== undefined && row.costPrice !== null && row.costPrice !== 0) fields.push({ label: 'Purchase Cost Price', value: fmtCurr(row.costPrice) });
                if (row.sellingPrice !== undefined && row.sellingPrice !== null && row.sellingPrice !== 0) fields.push({ label: 'Retail Selling Price', value: fmtCurr(row.sellingPrice) });
                if (row.costValuation !== undefined && row.costValuation !== null && row.costValuation !== 0) fields.push({ label: 'Cost Valuation', value: `<span class="text-info fw-bold">${fmtCurr(row.costValuation)}</span>` });
                if (row.salesValuation !== undefined && row.salesValuation !== null && row.salesValuation !== 0) fields.push({ label: 'Retail Value Potential', value: fmtCurr(row.salesValuation) });
                if (row.profitPotential !== undefined && row.profitPotential !== null && row.profitPotential !== 0) fields.push({ label: 'Profit Potential', value: `<span class="text-success fw-bold">${fmtCurr(row.profitPotential)}</span>` });

                if (row.quantity !== undefined && row.quantity !== null) fields.push({ label: 'Quantity', value: fmtNum(row.quantity) });
                if (row.stockQty !== undefined && row.stockQty !== null) fields.push({ label: 'Stock Quantity', value: fmtNum(row.stockQty) });
                if (row.minStockQty !== undefined && row.minStockQty !== null) fields.push({ label: 'Min Stock Threshold', value: fmtNum(row.minStockQty) });
                if (row.userExecutor) fields.push({ label: 'Operator / Cashier', value: `<span class="badge bg-secondary">${escapeHtml(row.userExecutor)}</span>` });

                gridEl.innerHTML = fields.map(f => `
                    <div class="col-md-6">
                        <div class="p-3 rounded-3" style="background:var(--bg);border:1px solid var(--border)">
                            <div style="color:var(--text-muted);font-size:11px;font-weight:600;text-transform:uppercase;margin-bottom:4px">${f.label}</div>
                            <div style="color:var(--text-primary);font-size:13px">${f.value}</div>
                        </div>
                    </div>
                `).join('');

                const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('reportRecordDetailsModal'));
                modal.show();
            };

            function escapeHtml(str) {
                if (!str) return '';
                return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
            }

            // Initial Fetch
            fetchReportPreview();
        });
    </script>
}
