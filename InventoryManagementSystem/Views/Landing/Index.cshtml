@section Scripts {
<script>
    (function () {
        function initMotion() {
            var home = document.querySelector('.pz-home');
            if (!home) return;

            var prefersReducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (prefersReducedMotion || !('IntersectionObserver' in window)) {
                document.documentElement.classList.remove('pz-motion-enabled');
                document.querySelectorAll('.pz-count-up').forEach(function (el) {
                    var target = el.getAttribute('data-target');
                    if (target) el.textContent = target;
                });
                return;
            }

            document.documentElement.classList.add('pz-motion-enabled');

            var footer = document.querySelector('.ecom-footer');
            if (footer) {
                footer.classList.add('pz-footer-animated');
            }

            function animateCounter(el) {
                if (el.dataset.animated === "true") return;
                el.dataset.animated = "true";
                var target = parseFloat(el.getAttribute('data-target'));
                if (isNaN(target)) return;

                var startTime = null;
                var duration = 1200;

                function frame(timestamp) {
                    if (!startTime) startTime = timestamp;
                    var progress = Math.min((timestamp - startTime) / duration, 1);
                    var ease = progress === 1 ? 1 : 1 - Math.pow(2, -10 * progress);
                    var current = Math.round(target * ease);
                    el.textContent = current;
                    if (progress < 1) {
                        requestAnimationFrame(frame);
                    } else {
                        el.textContent = target;
                    }
                }
                requestAnimationFrame(frame);
            }

            var revealTargets = Array.prototype.slice.call(document.querySelectorAll('.pz-home .pz-reveal, .pz-prefooter-fullwidth, .pz-footer-animated'));
            var vh = window.innerHeight || document.documentElement.clientHeight;

            // Elements in viewport on initial load are immediately revealed
            revealTargets.forEach(function (el) {
                var rect = el.getBoundingClientRect();
                if (rect.top <= vh - 20 && rect.bottom >= 0) {
                    el.classList.add('is-visible');
                }
            });

            var observer = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('is-visible');
                        observer.unobserve(entry.target);
                    }
                });
            }, {
                root: null,
                threshold: 0.05,
                rootMargin: '0px 0px -40px 0px'
            });

            revealTargets.forEach(function (el) {
                if (!el.classList.contains('is-visible')) {
                    observer.observe(el);
                }
            });

            // Passive scroll fallback: any element entering viewport or scrolled past is revealed
            function onScrollFallback() {
                var viewportHeight = window.innerHeight || document.documentElement.clientHeight;
                var unrevealed = 0;
                revealTargets.forEach(function (el) {
                    if (!el.classList.contains('is-visible')) {
                        var r = el.getBoundingClientRect();
                        if (r.top <= viewportHeight - 20) {
                            el.classList.add('is-visible');
                            observer.unobserve(el);
                        } else {
                            unrevealed++;
                        }
                    }
                });
                if (unrevealed === 0) {
                    window.removeEventListener('scroll', onScrollFallback);
                    window.removeEventListener('resize', onScrollFallback);
                }
            }
            window.addEventListener('scroll', onScrollFallback, { passive: true });
            window.addEventListener('resize', onScrollFallback, { passive: true });

            var trustStrip = document.querySelector('.pz-trust-micro');
            if (trustStrip) {
                var countObserver = new IntersectionObserver(function (entries) {
                    entries.forEach(function (entry) {
                        if (entry.isIntersecting) {
                            entry.target.querySelectorAll('.pz-count-up').forEach(animateCounter);
                            countObserver.unobserve(entry.target);
                        }
                    });
                }, { threshold: 0.1 });
                countObserver.observe(trustStrip);
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initMotion);
        } else {
            initMotion();
        }
    })();
</script>
}
