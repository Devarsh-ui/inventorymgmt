<!-- Dynamic Package Details Modal (High Contrast) -->
<div class="modal fade" id="packageDetailsModal" tabindex="-1" aria-modal="true" role="dialog">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg" style="border-radius: var(--pz-radius-md); background: #FFFFFF;">
            <div class="modal-header border-bottom py-3 px-4" style="background: var(--pz-surface-soft);">
                <h5 class="modal-title fw-bold mb-0" id="detModalTitle" style="color: var(--pz-text-main);">
                    Package Feature Breakdown
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="detModalBody" style="background: #FFFFFF;">
                <!-- Dynamic Content injected via JS with High Contrast -->
            </div>
            <div class="modal-footer border-top py-3 px-4 justify-content-between">
                <button type="button" class="pz-modal-btn-close" data-bs-dismiss="modal">Close</button>
                <a id="detRegisterBtn" href="@Url.Action("Register", "Landing")" class="pz-btn-primary text-decoration-none">
