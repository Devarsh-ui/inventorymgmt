@section Scripts {
    <script>
        const rawPackages = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(p => new {
            id = p.Id,
            name = p.Name,
            desc = p.Description,
            monthly = p.MonthlyPrice,
            yearly = p.YearlyPrice > 0 ? p.YearlyPrice : (p.MonthlyPrice * 10),
            trialDays = p.TrialDays,
            features = p.EnabledFeatures ?? p.EnabledModules ?? new List<string>(),
            maxAdmins = p.MaxAdmins,
            maxEmployees = p.MaxEmployees,
            maxProducts = p.MaxProducts,
            maxSuppliers = p.MaxSuppliers
        })));

        const rawAllFeatures = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(allFeatures.Select(f => new {
            key = f.FeatureKey,
            name = f.FeatureName,
            cat = f.Category,
            desc = f.Description,
            icon = f.Icon
        })));

        function isYearlyBilling() {
            const toggle = document.getElementById('billingToggle');
            return toggle ? toggle.checked : false;
        }

        function updateModalPricing(pkgId, isYearly) {
            const pkg = (rawPackages || []).find(p => String(p.id || '').toLowerCase() === String(pkgId || '').toLowerCase());
            if (!pkg) return;

            const amtEl = document.getElementById('detModalPriceAmount');
            const perEl = document.getElementById('detModalPricePeriod');
            const blockEl = document.getElementById('detModalPriceBlock');
            if (!amtEl || !perEl || !blockEl) return;

            const amount = isYearly ? (pkg.yearly ?? 0) : (pkg.monthly ?? 0);
            const period = isYearly ? '/ yr' : '/ mo';

            amtEl.innerText = Number(amount).toLocaleString('en-IN');
            perEl.innerText = period;

            const existingPill = document.getElementById('detModalSavePill');
            if (existingPill) existingPill.remove();

            if (isYearly && (pkg.monthly ?? 0) > 0) {
                blockEl.insertAdjacentHTML('beforeend', '<span class="pz-save-pill ms-2" id="detModalSavePill">SAVE 20%</span>');
            }
        }

        function setBillingCycle(isYearly) {
            const toggle = document.getElementById('billingToggle');
            if (toggle) toggle.checked = isYearly;
            
            const lblM = document.getElementById('labelMonthly');
            const lblY = document.getElementById('labelYearly');
            if (lblM) lblM.classList.toggle('active', !isYearly);
            if (lblY) lblY.classList.toggle('active', isYearly);

            document.querySelectorAll('.price-monthly-block').forEach(b => {
                b.classList.toggle('d-none', isYearly);
                b.classList.toggle('d-flex', !isYearly);
            });
            document.querySelectorAll('.price-yearly-block').forEach(b => {
                b.classList.toggle('d-none', !isYearly);
                b.classList.toggle('d-flex', isYearly);
            });

            // Synchronize pricing info modal if currently open
            if (window.currentModalPkgId) {
                updateModalPricing(window.currentModalPkgId, isYearly);
            }
        }

        window.openPackageDetailsModal = function(pkgId) {
            const pkg = (rawPackages || []).find(p => String(p.id || p.Id || '').toLowerCase() === String(pkgId || '').toLowerCase());
            if (!pkg) {
                console.warn('Package details not found for ID:', pkgId);
                return;
            }

            window.currentModalPkgId = pkg.id || pkgId;
            const isYearly = isYearlyBilling();
            const pName = pkg.name || pkg.Name || 'Package Details';
            const pDesc = pkg.desc || pkg.Description || '';
            const pMonthly = pkg.monthly ?? pkg.MonthlyPrice ?? 0;
            const pYearly = pkg.yearly ?? pkg.YearlyPrice ?? (pMonthly * 10);
            const pAmount = isYearly ? pYearly : pMonthly;
            const pPeriod = isYearly ? '/ yr' : '/ mo';
            const pSaveBadge = (isYearly && pMonthly > 0) ? '<span class="pz-save-pill ms-2" id="detModalSavePill">SAVE 20%</span>' : '';
            const pFeatures = pkg.features || pkg.EnabledFeatures || pkg.EnabledModules || [];
            const pMaxAdmins = pkg.maxAdmins ?? 1;
            const pMaxStaff = pkg.maxEmployees ?? 0;
            const pMaxProducts = pkg.maxProducts ?? 0;
            const pMaxSuppliers = pkg.maxSuppliers ?? 0;

            const titleEl = document.getElementById('detModalTitle');
            if (titleEl) titleEl.innerText = `${pName} — Included Capabilities`;

            const regBtn = document.getElementById('detRegisterBtn');
            if (regBtn) {
                regBtn.href = `@Url.Action("Register", "Landing")?packageId=${pkg.id || pkgId}`;
                const btnSpan = regBtn.querySelector('span');
                if (btnSpan) {
                    btnSpan.innerText = (pMonthly === 0) ? 'Start Free' : `Start ${pkg.trialDays || 14}-Day Free Trial`;
                }
            }

            let html = `
                <div class="mb-4 pb-3 border-bottom">
                    <div class="d-flex flex-wrap align-items-baseline justify-content-between gap-2 mb-2">
                        <h4 class="fw-bold mb-0" style="color: var(--pz-text-main, #17181B);">${pName}</h4>
                        <div class="pz-modal-price-block d-flex align-items-baseline" id="detModalPriceBlock">
                            <div class="pz-tier-price-row mb-0">
                                <span class="pz-tier-currency">₹</span>
                                <span class="pz-tier-amount" id="detModalPriceAmount">${Number(pAmount).toLocaleString('en-IN')}</span>
                                <span class="pz-tier-period" id="detModalPricePeriod">${pPeriod}</span>
                            </div>
                            ${pSaveBadge}
                        </div>
                    </div>
                    <p class="fs-7 mb-3" style="color: var(--pz-text-secondary, #555B66);">${pDesc}</p>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="pz-modal-limit-pill"><i class="bi bi-shield-lock"></i>Admins: ${pMaxAdmins > 0 ? (pMaxAdmins >= 2147483647 ? 'Unlimited' : pMaxAdmins) : 'Unlimited'}</span>
                        <span class="pz-modal-limit-pill"><i class="bi bi-people"></i>Staff: ${pMaxStaff > 0 ? (pMaxStaff >= 2147483647 ? 'Unlimited' : pMaxStaff) : 'Unlimited'}</span>
                        <span class="pz-modal-limit-pill"><i class="bi bi-box-seam"></i>Products: ${pMaxProducts > 0 ? (pMaxProducts >= 2147483647 ? 'Unlimited' : Number(pMaxProducts).toLocaleString('en-IN')) : 'Unlimited'}</span>
                        <span class="pz-modal-limit-pill"><i class="bi bi-truck"></i>Suppliers: ${pMaxSuppliers > 0 ? (pMaxSuppliers >= 2147483647 ? 'Unlimited' : pMaxSuppliers) : 'Unlimited'}</span>
                    </div>
                </div>
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h6 class="fw-bold mb-0 text-uppercase fs-8" style="letter-spacing: 0.08em; color: var(--pz-text-main, #17181B);">Included Modules &amp; Capabilities</h6>
                </div>
            `;

            // Group features by Category
            const cats = {};
            (rawAllFeatures || []).forEach(f => {
                const fCat = f.cat || f.Category || 'General';
                const fKey = f.key || f.FeatureKey || '';
                const fName = f.name || f.FeatureName || '';
                const fDesc = f.desc || f.Description || '';
                const fIcon = f.icon || f.Icon || 'bi-check2-circle';

                if (!cats[fCat]) cats[fCat] = [];
                const isIncluded = pFeatures.some(k => String(k || '').toLowerCase() === String(fKey || '').toLowerCase());
                if (isIncluded) {
                    cats[fCat].push({ key: fKey, name: fName, cat: fCat, desc: fDesc, icon: fIcon });
                }
            });

            let featCount = 0;
            for (const [catName, featList] of Object.entries(cats)) {
                if (!featList || featList.length === 0) continue;
                featCount += featList.length;
                const isSingle = (featList.length === 1);
                html += `
                    <div class="pz-modal-cat-section">
                        <div class="pz-modal-cat-head">
                            <span class="pz-modal-cat-title"><i class="bi bi-folder2"></i>${catName}</span>
                            <span class="pz-modal-cat-badge">${featList.length} ${featList.length === 1 ? 'feature' : 'features'}</span>
                        </div>
                        <div class="pz-modal-feat-grid ${isSingle ? 'is-single' : ''}">
                `;
                featList.forEach(f => {
                    html += `
                        <div class="pz-modal-feat-card">
                            <div class="pz-modal-feat-icon">
                                <i class="bi bi-check-circle-fill"></i>
                            </div>
                            <div class="pz-modal-feat-content">
                                <strong class="pz-modal-feat-title">${f.name}</strong>
                                <p class="pz-modal-feat-desc">${f.desc}</p>
                            </div>
                        </div>
                    `;
                });
                html += `</div></div>`;
            }

            if (featCount === 0) {
                html += `<div class="alert alert-light border" style="color: #555B66;"><i class="bi bi-info-circle me-2"></i>Includes all standard shop management modules.</div>`;
            }

            const modalBody = document.getElementById('detModalBody');
            if (modalBody) modalBody.innerHTML = html;

            const modalEl = document.getElementById('packageDetailsModal');
            if (modalEl) {
                modalEl.addEventListener('hidden.bs.modal', function () {
                    window.currentModalPkgId = null;
                }, { once: true });
                const bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
                bsModal.show();
            }
        };

        // --- Brevo Comparison Table Accordion, Intelligent Tooltip & Scroll Sync ---
        document.addEventListener('DOMContentLoaded', function () {
            // 1. Accordion Toggle for Category Boxes
            const categoryBoxes = document.querySelectorAll('.pz-brevo-category-box');
            categoryBoxes.forEach(box => {
                const header = box.querySelector('.pz-brevo-cat-header');
                if (!header) return;

                header.addEventListener('click', function () {
                    const isCollapsed = box.classList.toggle('collapsed');
                    header.setAttribute('aria-expanded', !isCollapsed);
                    const chevronIcon = header.querySelector('.pz-brevo-cat-chevron i');
                    if (chevronIcon) {
                        chevronIcon.className = isCollapsed ? 'bi bi-chevron-down' : 'bi bi-chevron-up';
                    }
                    updateToggleAllState();
                });
            });

            // Toggle All Categories Button
            const btnToggleAll = document.getElementById('btnToggleAllCategories');
            const toggleAllText = document.getElementById('toggleAllText');
            const toggleAllIcon = document.getElementById('toggleAllIcon');

            function updateToggleAllState() {
                if (!btnToggleAll || !toggleAllText) return;
                const total = categoryBoxes.length;
                const collapsedCount = document.querySelectorAll('.pz-brevo-category-box.collapsed').length;
                const allCollapsed = (collapsedCount === total);

                toggleAllText.textContent = allCollapsed ? 'Expand All' : 'Collapse All';
                if (toggleAllIcon) {
                    toggleAllIcon.className = allCollapsed ? 'bi bi-arrows-expand me-1' : 'bi bi-arrows-collapse me-1';
                }
            }

            if (btnToggleAll) {
                btnToggleAll.addEventListener('click', function () {
                    const collapsedCount = document.querySelectorAll('.pz-brevo-category-box.collapsed').length;
                    const shouldCollapse = collapsedCount < categoryBoxes.length;

                    categoryBoxes.forEach(box => {
                        box.classList.toggle('collapsed', shouldCollapse);
                        const header = box.querySelector('.pz-brevo-cat-header');
                        if (header) {
                            header.setAttribute('aria-expanded', !shouldCollapse);
                            const chevronIcon = header.querySelector('.pz-brevo-cat-chevron i');
                            if (chevronIcon) {
                                chevronIcon.className = shouldCollapse ? 'bi bi-chevron-down' : 'bi bi-chevron-up';
                            }
                        }
                    });
                    updateToggleAllState();
                });
            }

            // 2. Brevo Intelligent Floating Tooltip Logic
            const tooltip = document.getElementById('pzBrevoTooltip');
            const tooltipTitle = document.getElementById('pzBrevoTooltipTitle');
            const tooltipDesc = document.getElementById('pzBrevoTooltipDesc');
            const tooltipArrow = document.getElementById('pzBrevoTooltipArrow');
            let activeTrigger = null;

            function showTooltip(triggerEl) {
                if (!tooltip || !triggerEl) return;
                const title = triggerEl.getAttribute('data-title') || '';
                const desc = triggerEl.getAttribute('data-tooltip') || '';
                if (!desc && !title) return;

                if (tooltipTitle) {
                    tooltipTitle.textContent = title;
                    tooltipTitle.style.display = title ? 'block' : 'none';
                }
                if (tooltipDesc) {
                    tooltipDesc.textContent = desc;
                }

                // Deselect previous
                if (activeTrigger && activeTrigger !== triggerEl) {
                    activeTrigger.classList.remove('active');
                }
                activeTrigger = triggerEl;
                activeTrigger.classList.add('active');

                // Positioning with boundary safety
                const rect = triggerEl.getBoundingClientRect();
                const ttWidth = Math.min(290, window.innerWidth - 24);
                tooltip.style.width = ttWidth + 'px';

                tooltip.classList.add('show');
                tooltip.setAttribute('aria-hidden', 'false');

                const ttHeight = tooltip.offsetHeight;
                let left = rect.left + (rect.width / 2) - (ttWidth / 2);
                if (left < 12) left = 12;
                if (left + ttWidth > window.innerWidth - 12) left = window.innerWidth - 12 - ttWidth;

                // Position above if enough room, else below
                let isAbove = true;
                let top = rect.top - ttHeight - 10;
                if (top < 65) {
                    top = rect.bottom + 10;
                    isAbove = false;
                }

                tooltip.style.left = `${Math.round(left)}px`;
                tooltip.style.top = `${Math.round(top)}px`;

                if (tooltipArrow) {
                    const arrowLeft = rect.left + (rect.width / 2) - left - 5;
                    tooltipArrow.style.left = `${Math.max(12, Math.min(ttWidth - 22, arrowLeft))}px`;
                    if (isAbove) {
                        tooltipArrow.style.bottom = '-5px';
                        tooltipArrow.style.top = 'auto';
                    } else {
                        tooltipArrow.style.top = '-5px';
                        tooltipArrow.style.bottom = 'auto';
                    }
                }
            }

            function hideTooltip() {
                if (!tooltip) return;
                tooltip.classList.remove('show');
                tooltip.setAttribute('aria-hidden', 'true');
                if (activeTrigger) {
                    activeTrigger.classList.remove('active');
                    activeTrigger = null;
                }
            }

            // Bind triggers
            const infoTriggers = document.querySelectorAll('.pz-info-trigger');
            infoTriggers.forEach(btn => {
                // Hover (Desktop)
                btn.addEventListener('mouseenter', function () {
                    showTooltip(btn);
                });
                btn.addEventListener('mouseleave', function () {
                    hideTooltip();
                });

                // Keyboard Focus (Desktop / Accessibility)
                btn.addEventListener('focus', function () {
                    showTooltip(btn);
                });
                btn.addEventListener('blur', function () {
                    hideTooltip();
                });

                // Tap / Click (Mobile & Touch)
                btn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    if (activeTrigger === btn) {
                        hideTooltip();
                    } else {
                        showTooltip(btn);
                    }
                });
            });

            // Close on click outside
            document.addEventListener('click', function (e) {
                if (activeTrigger && !e.target.closest('.pz-info-trigger') && !e.target.closest('#pzBrevoTooltip')) {
                    hideTooltip();
                }
            });

            // Close on Escape key
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    hideTooltip();
                }
            });

            // Hide or reposition on scroll
            window.addEventListener('scroll', function () {
                if (activeTrigger) {
                    hideTooltip();
                }
            }, { passive: true });

            // 3. Horizontal Scroll Synchronization for Table & Sticky Header
            const rawContainers = [
                document.getElementById('pzBrevoStickyScroll'),
                ...document.querySelectorAll('.pz-brevo-scroll-sync')
            ].filter(Boolean);
            const scrollContainers = [...new Set(rawContainers)];

            let isSyncing = false;
            scrollContainers.forEach(container => {
                container.addEventListener('scroll', function () {
                    if (isSyncing) return;
                    isSyncing = true;
                    const sl = container.scrollLeft;
                    scrollContainers.forEach(c => {
                        if (c !== container) {
                            c.scrollLeft = sl;
                        }
                    });
                    requestAnimationFrame(() => {
                        isSyncing = false;
                    });
                }, { passive: true });
            });
        });
    </script>
}
