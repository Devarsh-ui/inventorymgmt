@model IEnumerable<InventoryManagementSystem.Models.SubscriptionPackage>
@{
    ViewData["Title"] = "Pricing Plans — SIMS Smart Inventory Management System";
    Layout = "_Layout";
    var groupedFeatures = ViewBag.GroupedFeatures as Dictionary<string, List<FeatureDefinition>> ?? new Dictionary<string, List<FeatureDefinition>>();
    var allFeatures = ViewBag.AllFeatures as List<FeatureDefinition> ?? new List<FeatureDefinition>();
}

<div class="pz-page-wrap">
    <div class="pz-container">

        <!-- A. Pricing Introduction with Correct Accent Order -->
        <div class="pz-section-head mb-4 text-center">
            <span class="pz-accent-eyebrow">TRANSPARENT PREDICTABLE PRICING</span>
            <h1 class="pz-section-title">Simple, transparent plans tailored for your business</h1>
            <span class="pz-heading-accent" aria-hidden="true"></span>
            <p class="pz-section-sub">
                Select the ideal plan for your business and retail counters. Every tier includes a 14-day full feature trial with zero setup fees and seamless Excel migration.
            </p>
        </div>

        <!-- Monthly / Yearly Billing Toggle Switch -->
        <div class="d-flex justify-content-center align-items-center mb-5">
            <div class="pz-billing-toggle-wrap">
                <span class="pz-toggle-label active" id="labelMonthly" onclick="setBillingCycle(false)">Monthly Billing</span>
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input cursor-pointer" type="checkbox" id="billingToggle" style="width:46px;height:24px" onchange="setBillingCycle(this.checked)">
                </div>
                <span class="pz-toggle-label" id="labelYearly" onclick="setBillingCycle(true)">
                    Yearly Billing <span class="pz-save-pill">SAVE 20%</span>
                </span>
            </div>
        </div>

        <!-- B. Compact & Highly Scannable Pricing Cards Grid (Reference Matched) -->
        <div class="row g-4 mb-3 justify-content-center">
            @if (Model != null && Model.Any())
            {
                var pkgList = Model.OrderBy(p => p.DisplayOrder).ToList();
                var count = pkgList.Count;
                var colClass = count == 1 ? "col-lg-6 col-md-8 col-12" : count == 2 ? "col-lg-5 col-md-6 col-12" : count == 3 ? "col-lg-4 col-md-6 col-12" : "col-xl-3 col-lg-4 col-md-6 col-12";
                
                for (int i = 0; i < count; i++)
                {
                    var pkg = pkgList[i];
                    var prevPkg = i > 0 ? pkgList[i - 1] : null;
                    var pkgFeatures = allFeatures.Where(f => pkg.EnabledFeatures != null && pkg.EnabledFeatures.Contains(f.FeatureKey, StringComparer.OrdinalIgnoreCase)).ToList();

                    <div class="@colClass">
                        <div class="pz-tier-card h-100 d-flex flex-column @(pkg.IsFeatured ? "is-featured" : "")">
                            @if (pkg.IsFeatured)
                            {
                                <div class="pz-tier-badge">
                                    MOST POPULAR
                                </div>
                            }

                            <div>
                                <h3 class="pz-tier-name">@pkg.Name</h3>
                                <p class="pz-tier-desc">@pkg.Description</p>

                                <!-- Price Display -->
                                <div class="pz-tier-price-row">
                                    <div class="price-monthly-block d-flex align-items-baseline">
                                        <span class="pz-tier-currency">₹</span>
                                        <span class="pz-tier-amount">@pkg.MonthlyPrice.ToString("N0")</span>
                                        <span class="pz-tier-period">/ mo</span>
                                    </div>
                                    <div class="price-yearly-block d-none d-flex align-items-baseline">
                                        <span class="pz-tier-currency">₹</span>
                                        <span class="pz-tier-amount">@(pkg.YearlyPrice > 0 ? pkg.YearlyPrice.ToString("N0") : (pkg.MonthlyPrice * 10).ToString("N0"))</span>
                                        <span class="pz-tier-period">/ yr</span>
                                    </div>
                                </div>

                                <!-- Reference Matched CTA Button Directly Below Price -->
                                <div class="pz-tier-cta-block">
                                    <a href="@Url.Action("Register", "Landing", new { packageId = pkg.Id })" class="@(pkg.IsFeatured ? "pz-btn-primary" : "pz-btn-dark") text-decoration-none">
                                        <span>Start @pkg.TrialDays-Day Free Trial</span>
                                    </a>
                                </div>

                                <!-- Feature Section Title -->
                                <div class="pz-feat-group-title">
                                    @(i == 0 ? "What included:" : $"Everything in {prevPkg?.Name}, plus:")
                                </div>

                                <!-- Compact Feature Checklist with Green Circular Checks -->
                                <ul class="pz-tier-feat-list">
                                    <li class="pz-tier-feat-item">
                                        <span class="pz-feat-check"><i class="bi bi-check-lg"></i></span>
                                        <span>@(pkg.MaxProducts == int.MaxValue ? "Unlimited" : pkg.MaxProducts.ToString("N0")) Serialized Devices (IMEI tracking)</span>
                                    </li>
                                    <li class="pz-tier-feat-item">
                                        <span class="pz-feat-check"><i class="bi bi-check-lg"></i></span>
                                        <span>@(pkg.MaxEmployees == int.MaxValue ? "Unlimited" : pkg.MaxEmployees.ToString()) Staff &amp; Cashier Accounts</span>
                                    </li>
                                    <li class="pz-tier-feat-item">
                                        <span class="pz-feat-check"><i class="bi bi-check-lg"></i></span>
                                        <span>POS Billing with Thermal &amp; WhatsApp GST Invoices</span>
                                    </li>
                                    @if (pkgFeatures.Any())
                                    {
                                        foreach (var feat in pkgFeatures.Take(3))
                                        {
                                            <li class="pz-tier-feat-item">
                                                <span class="pz-feat-check"><i class="bi bi-check-lg"></i></span>
                                                <span>@feat.FeatureName</span>
                                            </li>
                                        }
                                    }
                                </ul>
                            </div>

                            <!-- Full capabilities modal trigger aligned to bottom -->
                            <div class="pt-3 border-top mt-auto">
                                <button type="button" class="pz-more-features-btn w-100 justify-content-center" onclick="openPackageDetailsModal('@pkg.Id')">
                                    <i class="bi bi-info-circle me-1 text-primary"></i> View all included capabilities
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Trust Strip Directly Below Pricing Cards (Reference Matched) -->
        <div class="pz-pricing-trust-strip text-center">
            <span class="pz-trust-title mb-3">TRUSTED BY OVER 1,200+ RETAILERS &amp; GROWING BUSINESSES</span>
            <div class="d-flex flex-wrap justify-content-center align-items-center gap-4 gap-md-5">
                <span class="pz-trust-logo"><i class="bi bi-phone me-1"></i> Apex Mobiles</span>
                <span class="pz-trust-logo"><i class="bi bi-shield-check me-1"></i> iCare Solutions</span>
                <span class="pz-trust-logo"><i class="bi bi-shop me-1"></i> Bharat Retailers</span>
                <span class="pz-trust-logo"><i class="bi bi-laptop me-1"></i> DigiTech Hub</span>
                <span class="pz-trust-logo"><i class="bi bi-cpu me-1"></i> Prime Wireless</span>
            </div>
        </div>

        <!-- C. Brevo-Inspired SaaS Plan Feature Comparison Table -->
        @{
            var comparePkgList = Model != null ? Model.OrderBy(p => p.DisplayOrder).ToList() : new List<InventoryManagementSystem.Models.SubscriptionPackage>();
            var planCount = comparePkgList.Count;

            string FormatCategoryTitle(string cat)
            {
                if (string.IsNullOrWhiteSpace(cat)) return "General Capabilities";
                var upper = cat.Trim().ToUpperInvariant();
                if (upper.Contains("DASHBOARD")) return "Main Dashboard & Overview";
                if (upper.Contains("MOBILE")) return "Retail Operations & POS Billing";
                if (upper.Contains("DIRECTORY")) return "Customer & Supplier Directories";
                if (upper.Contains("INVENTORY") || upper.Contains("STOCK")) return "Inventory & Serial Stock Control";
                if (upper.Contains("RECORDS") || upper.Contains("REPORT")) return "Records, Invoices & Financial Reports";
                if (upper.Contains("SYSTEM") || upper.Contains("MANAGEMENT")) return "System Configuration & Automation";
                return System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(cat.ToLower());
            }

            string GetCategoryIcon(string catKeyOrTitle, string fallbackTitle = "")
            {
                var combined = $"{catKeyOrTitle} {fallbackTitle}".Trim();
                if (string.IsNullOrWhiteSpace(combined)) return "bi-folder2-open";
                var norm = combined.ToUpperInvariant();

                // 1. Plan Capacities & Core Limits
                if (norm.Contains("CAPACIT") || norm.Contains("LIMIT") || norm.Contains("CORE"))
                    return "bi-shield-check";

                // 2. Main Dashboard & Overview
                if (norm.Contains("DASHBOARD") || norm.Contains("OVERVIEW"))
                    return "bi-speedometer2";

                // 3. Retail Operations & POS Billing
                if (norm.Contains("POS") || norm.Contains("RETAIL") || norm.Contains("MOBILE") || norm.Contains("CHECKOUT") || norm.Contains("COUNTER"))
                    return "bi-cart3";

                // 4. Customer & Supplier Directories
                if (norm.Contains("DIRECTORY") || norm.Contains("CUSTOMER") || norm.Contains("PEOPLE") || norm.Contains("CLIENT"))
                    return "bi-people";

                // 5. Inventory & Serial Stock Control
                if (norm.Contains("INVENTORY") || norm.Contains("SERIAL") || norm.Contains("STOCK CONTROL") || norm.Contains("BOX"))
                    return "bi-boxes";

                // 6. Product Catalog & Specifications
                if (norm.Contains("PRODUCT") || norm.Contains("CATALOG") || norm.Contains("SPEC") || norm.Contains("DEVICE") || norm.Contains("MODEL"))
                    return "bi-phone";

                // 7. Stock In & Stock Out
                if (norm.Contains("STOCK IN") || norm.Contains("STOCK OUT") || norm.Contains("TRANSFER") || norm.Contains("MOVEMENT"))
                    return "bi-arrow-down-up";

                // 8. Purchase Orders & Returns
                if (norm.Contains("PURCHASE") || norm.Contains("ORDER") || norm.Contains("RETURN") || norm.Contains("PROCUREMENT"))
                    return "bi-clipboard-data";

                // 9. Records, Invoices, Sales & Payments
                if (norm.Contains("RECORD") || norm.Contains("INVOICE") || norm.Contains("PAYMENT") || norm.Contains("BILL") || norm.Contains("RECEIPT") || norm.Contains("SALES"))
                    return "bi-receipt";

                // 10. Reports & Analytics
                if (norm.Contains("REPORT") || norm.Contains("ANALYTIC") || norm.Contains("FINANCIAL") || norm.Contains("INSIGHT") || norm.Contains("METRIC"))
                    return "bi-graph-up-arrow";

                // 11. Employee & Administrator Management
                if (norm.Contains("EMPLOYEE") || norm.Contains("ADMIN") || norm.Contains("STAFF") || norm.Contains("ROLE") || norm.Contains("PERMISSION"))
                    return "bi-person-gear";

                // 12. Supplier Portal
                if (norm.Contains("SUPPLIER") || norm.Contains("VENDOR") || norm.Contains("LOGISTIC") || norm.Contains("SHIPMENT"))
                    return "bi-truck";

                // 13. Service & Repairs
                if (norm.Contains("SERVICE") || norm.Contains("REPAIR") || norm.Contains("MAINTENANCE") || norm.Contains("JOB") || norm.Contains("WARRANTY"))
                    return "bi-wrench-adjustable";

                // 14. Notifications & Email Alerts
                if (norm.Contains("NOTIF") || norm.Contains("ALERT") || norm.Contains("EMAIL") || norm.Contains("SMS") || norm.Contains("WHATSAPP"))
                    return "bi-bell";

                // 15. Security, Audit & System Logs
                if (norm.Contains("SECURITY") || norm.Contains("AUDIT") || norm.Contains("LOG") || norm.Contains("ACTIVITY"))
                    return "bi-shield-lock";

                // 16. Subscription & License Management
                if (norm.Contains("SUBSCRIPTION") || norm.Contains("LICENSE") || norm.Contains("PLAN") || norm.Contains("BILLING CYCLE"))
                    return "bi-patch-check";

                // 17. Settings, Configuration & Automation
                if (norm.Contains("SYSTEM") || norm.Contains("SETTING") || norm.Contains("CONFIG") || norm.Contains("AUTOMATION") || norm.Contains("PREFERENCE"))
                    return "bi-sliders";

                // 18. Integrations & API Access
                if (norm.Contains("INTEGRAT") || norm.Contains("API") || norm.Contains("WEBHOOK") || norm.Contains("PLUGIN"))
                    return "bi-plug";

                // Safe neutral fallback
                return "bi-folder2-open";
            }
        }

        <div class="pz-brevo-compare-wrapper" id="compareSection" style="--plan-count: @planCount;">
            <!-- Section Header -->
            <div class="pz-section-head mb-4 text-start">
                <span class="pz-accent-eyebrow">DETAILED COMPARISON</span>
                <h2 class="pz-section-title">Compare plan capabilities side-by-side</h2>
                <span class="pz-heading-accent" aria-hidden="true"></span>
                <p class="pz-section-sub">A clear, categorized breakdown of features and entitlements included across each subscription tier.</p>
            </div>

            <!-- Toolbar with Brevo hint and Toggle All Button -->
            <div class="pz-brevo-toolbar">
                <span class="pz-brevo-hint-text">
                    <i class="bi bi-info-circle text-success me-1"></i> Click any section header to expand or collapse. Hover the <strong>?</strong> icon for full feature details.
                </span>
                <button type="button" class="pz-brevo-toggle-all-btn" id="btnToggleAllCategories" aria-label="Toggle all feature categories">
                    <i class="bi bi-arrows-collapse me-1" id="toggleAllIcon"></i>
                    <span id="toggleAllText">Collapse All</span>
                </button>
            </div>

            <!-- Sticky Plan Headers (Brevo Reference Matched) -->
            <div class="pz-brevo-sticky-bar" id="pzBrevoStickyBar">
                <div class="pz-brevo-sticky-scroll pz-brevo-scroll-sync" id="pzBrevoStickyScroll">
                    <div class="pz-brevo-sticky-row">
                        <!-- Left Column Header -->
                        <div class="pz-brevo-sticky-head-left">
                            <h4 class="pz-brevo-head-title">Features &amp; Plans</h4>
                            <p class="pz-brevo-head-subtitle">Detailed module comparison</p>
                        </div>

                        <!-- Plan Cards for Each Subscription Tier -->
                        @foreach (var pkg in comparePkgList)
                        {
                            <div class="pz-brevo-plan-card @(pkg.IsFeatured ? "is-featured" : "")" data-package-id="@pkg.Id">
                                @if (pkg.IsFeatured)
                                {
                                    <div class="pz-brevo-badge-popular">MOST POPULAR</div>
                                }

                                <div>
                                    <h3 class="pz-brevo-plan-name">@pkg.Name</h3>
                                    <div class="pz-brevo-plan-price-wrap">
                                        <span class="pz-brevo-price-label">Starts from</span>
                                        <div class="price-monthly-block d-flex justify-content-center align-items-baseline">
                                            <span class="pz-brevo-price-amount">@(pkg.MonthlyPrice == 0 ? "₹0" : $"₹{pkg.MonthlyPrice:N0}")</span>
                                            <span class="pz-brevo-price-period">&nbsp;/ mo</span>
                                        </div>
                                        <div class="price-yearly-block d-none d-flex justify-content-center align-items-baseline">
                                            <span class="pz-brevo-price-amount">@(pkg.YearlyPrice == 0 ? "₹0" : $"₹{pkg.YearlyPrice:N0}")</span>
                                            <span class="pz-brevo-price-period">&nbsp;/ yr</span>
                                        </div>
                                    </div>
                                </div>

                                <div>
                                    <a href="@Url.Action("Register", "Landing", new { packageId = pkg.Id })" class="pz-brevo-plan-btn @(pkg.IsFeatured ? "featured" : "")">
                                        @(pkg.MonthlyPrice == 0 ? "Start Free" : $"Start {pkg.TrialDays}-Day Trial")
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Category 0: Plan Capacities & Core Limits -->
            <div class="pz-brevo-category-box" data-category-box="capacities">
                <button type="button" class="pz-brevo-cat-header" aria-expanded="true">
                    <h3 class="pz-brevo-cat-title">
                        <i class="bi @GetCategoryIcon("Plan Capacities & Core Limits") pz-cat-icon" aria-hidden="true"></i>
                        <span>Plan Capacities &amp; Core Limits</span>
                        <span class="pz-brevo-cat-count">5 limits</span>
                    </h3>
                    <span class="pz-brevo-cat-chevron"><i class="bi bi-chevron-up"></i></span>
                </button>
                <div class="pz-brevo-cat-body pz-brevo-scroll-sync">
                    <table class="pz-brevo-table">
                        <colgroup>
                            <col class="pz-col-feat">
                            @foreach (var pkg in comparePkgList)
                            {
                                <col class="pz-col-plan" data-package-id="@pkg.Id">
                            }
                        </colgroup>
                        <tbody>
                            <!-- Row 1: Max Serialized Products / Devices -->
                            <tr>
                                <td class="pz-brevo-col-feature">
                                    <div class="pz-brevo-feat-wrap">
                                        <span class="pz-brevo-feat-name">Serialized Devices (IMEI tracking)</span>
                                        <button type="button" class="pz-info-trigger" data-title="Serialized Devices (IMEI tracking)" data-tooltip="The maximum number of IMEI-tracked smartphones, serialized gadgets, and retail accessories you can concurrently manage across all counters." aria-label="More details about Serialized Devices" tabindex="0">?</button>
                                    </div>
                                </td>
                                @foreach (var pkg in comparePkgList)
                                {
                                    <td class="pz-brevo-col-plan @(pkg.IsFeatured ? "is-featured" : "")">
                                        <span class="pz-brevo-val-text">
                                            @(pkg.MaxProducts == int.MaxValue || pkg.MaxProducts <= 0 ? "Unlimited" : $"{pkg.MaxProducts:N0} Devices")
                                        </span>
                                    </td>
                                }
                            </tr>

                            <!-- Row 2: Staff & Cashier Accounts -->
                            <tr>
                                <td class="pz-brevo-col-feature">
                                    <div class="pz-brevo-feat-wrap">
                                        <span class="pz-brevo-feat-name">Staff &amp; Cashier Accounts</span>
                                        <button type="button" class="pz-info-trigger" data-title="Staff &amp; Cashier Accounts" data-tooltip="Total cashier, technician, and inventory manager user accounts with granular role-based permissions." aria-label="More details about Staff Accounts" tabindex="0">?</button>
                                    </div>
                                </td>
                                @foreach (var pkg in comparePkgList)
                                {
                                    <td class="pz-brevo-col-plan @(pkg.IsFeatured ? "is-featured" : "")">
                                        <span class="pz-brevo-val-text">
                                            @(pkg.MaxEmployees == int.MaxValue || pkg.MaxEmployees <= 0 ? "Unlimited" : $"{pkg.MaxEmployees} Staff Accounts")
                                        </span>
                                    </td>
                                }
                            </tr>

                            <!-- Row 3: Shop Administrators -->
                            <tr>
                                <td class="pz-brevo-col-feature">
                                    <div class="pz-brevo-feat-wrap">
                                        <span class="pz-brevo-feat-name">Shop Administrators</span>
                                        <button type="button" class="pz-info-trigger" data-title="Shop Administrators" data-tooltip="Owner and top-level manager credentials with full control over business settings, profit audits, and tax setup." aria-label="More details about Shop Administrators" tabindex="0">?</button>
                                    </div>
                                </td>
                                @foreach (var pkg in comparePkgList)
                                {
                                    <td class="pz-brevo-col-plan @(pkg.IsFeatured ? "is-featured" : "")">
                                        <span class="pz-brevo-val-text">
                                            @(pkg.MaxAdmins == int.MaxValue || pkg.MaxAdmins <= 0 ? "Unlimited" : $"{pkg.MaxAdmins} Shop Admin")
                                        </span>
                                    </td>
                                }
                            </tr>

                            <!-- Row 4: Wholesale Suppliers -->
                            <tr>
                                <td class="pz-brevo-col-feature">
                                    <div class="pz-brevo-feat-wrap">
                                        <span class="pz-brevo-feat-name">Supplier Directory &amp; Ledgers</span>
                                        <button type="button" class="pz-info-trigger" data-title="Supplier Directory &amp; Ledgers" data-tooltip="Maximum number of registered wholesale distributors, vendors, and consigners with automated ledger balances." aria-label="More details about Supplier Directory" tabindex="0">?</button>
                                    </div>
                                </td>
                                @foreach (var pkg in comparePkgList)
                                {
                                    <td class="pz-brevo-col-plan @(pkg.IsFeatured ? "is-featured" : "")">
                                        <span class="pz-brevo-val-text">
                                            @(pkg.MaxSuppliers == int.MaxValue || pkg.MaxSuppliers <= 0 ? "Unlimited" : $"{pkg.MaxSuppliers} Suppliers")
                                        </span>
                                    </td>
                                }
                            </tr>

                            <!-- Row 5: Free Trial Duration -->
                            <tr>
                                <td class="pz-brevo-col-feature">
                                    <div class="pz-brevo-feat-wrap">
                                        <span class="pz-brevo-feat-name">Full-Feature Free Trial</span>
                                        <button type="button" class="pz-info-trigger" data-title="Full-Feature Free Trial" data-tooltip="Access every capability in your selected tier for 14 days without entering credit card or payment credentials." aria-label="More details about Free Trial" tabindex="0">?</button>
                                    </div>
                                </td>
                                @foreach (var pkg in comparePkgList)
                                {
                                    <td class="pz-brevo-col-plan @(pkg.IsFeatured ? "is-featured" : "")">
                                        <span class="pz-brevo-val-text">
                                            @(pkg.TrialDays > 0 ? $"{pkg.TrialDays} Days Included" : "14 Days Included")
                                        </span>
                                    </td>
                                }
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Dynamic Category Boxes From Feature Catalog -->
            @foreach (var group in groupedFeatures)
            {
                var catName = group.Key;
                var displayTitle = FormatCategoryTitle(catName);
                var catIcon = GetCategoryIcon(displayTitle, catName);
                var feats = group.Value ?? new List<FeatureDefinition>();
                if (!feats.Any()) continue;

                <div class="pz-brevo-category-box" data-category-box="@catName.ToLowerInvariant().Replace(" ", "-").Replace("/", "-")">
                    <button type="button" class="pz-brevo-cat-header" aria-expanded="true">
                        <h3 class="pz-brevo-cat-title">
                            <i class="bi @catIcon pz-cat-icon" aria-hidden="true"></i>
                            <span>@displayTitle</span>
                            <span class="pz-brevo-cat-count">@feats.Count @(feats.Count == 1 ? "feature" : "features")</span>
                        </h3>
                        <span class="pz-brevo-cat-chevron"><i class="bi bi-chevron-up"></i></span>
                    </button>
                    <div class="pz-brevo-cat-body pz-brevo-scroll-sync">
                        <table class="pz-brevo-table">
                            <colgroup>
                                <col class="pz-col-feat">
                                @foreach (var pkg in comparePkgList)
                                {
                                    <col class="pz-col-plan" data-package-id="@pkg.Id">
                                }
                            </colgroup>
                            <tbody>
                                @foreach (var feat in feats)
                                {
                                    <tr>
                                        <td class="pz-brevo-col-feature">
                                            <div class="pz-brevo-feat-wrap">
                                                <span class="pz-brevo-feat-name">@feat.FeatureName</span>
                                                @if (!string.IsNullOrWhiteSpace(feat.Description))
                                                {
                                                    <button type="button" class="pz-info-trigger" data-title="@feat.FeatureName" data-tooltip="@feat.Description" aria-label="More info on @feat.FeatureName" tabindex="0">?</button>
                                                }
                                            </div>
                                        </td>
                                        @foreach (var pkg in comparePkgList)
                                        {
                                            var isInc = pkg.EnabledFeatures != null && pkg.EnabledFeatures.Contains(feat.FeatureKey, StringComparer.OrdinalIgnoreCase);
                                            <td class="pz-brevo-col-plan @(pkg.IsFeatured ? "is-featured" : "")">
                                                @if (isInc)
                                                {
                                                    <span class="pz-brevo-check-svg" title="Included in @pkg.Name">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                            <polyline points="20 6 9 17 4 12"></polyline>
                                                        </svg>
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="pz-brevo-cross-svg" title="Not included in @pkg.Name">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                            <line x1="18" y1="6" x2="6" y2="18"></line>
                                                            <line x1="6" y1="6" x2="18" y2="18"></line>
                                                        </svg>
                                                    </span>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>

        <!-- Brevo Intelligent Dark Charcoal Floating Tooltip Element -->
        <div id="pzBrevoTooltip" class="pz-brevo-floating-tooltip" role="tooltip" aria-hidden="true">
            <span class="pz-brevo-tt-title" id="pzBrevoTooltipTitle"></span>
            <p class="pz-brevo-tt-desc" id="pzBrevoTooltipDesc"></p>
            <div class="pz-brevo-tt-arrow" id="pzBrevoTooltipArrow"></div>
        </div>

        <!-- D. Pricing FAQ Accordion Section (Reference Matched) -->
        <div class="mb-5">
            <div class="pz-section-head mb-4 text-center">
                <span class="pz-accent-eyebrow">FAQ</span>
                <h2 class="pz-section-title">Everything you need to know about SIMS</h2>
                <span class="pz-heading-accent" aria-hidden="true"></span>
                <p class="pz-section-sub">Clear answers to help you choose the right tier for your business.</p>
            </div>

            <div class="pz-faq-wrap">
                <!-- FAQ 1 -->
                <div class="pz-faq-card">
                    <button class="pz-faq-header" type="button" data-bs-toggle="collapse" data-bs-target="#faq1" aria-expanded="true">
                        <span class="pz-faq-icon"><i class="bi bi-plus"></i></span>
                        <span class="pz-faq-title">How does the 14-day free trial work?</span>
                    </button>
                    <div id="faq1" class="collapse show">
                        <div class="pz-faq-body">
                            You get full access to all features in your selected package for 14 days without entering credit card details. You can scan barcodes, generate GST invoices, inward supplier inventory, and invite staff users immediately.
                        </div>
                    </div>
                </div>

                <!-- FAQ 2 -->
                <div class="pz-faq-card">
                    <button class="pz-faq-header collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2" aria-expanded="false">
                        <span class="pz-faq-icon"><i class="bi bi-plus"></i></span>
                        <span class="pz-faq-title">Are there any proprietary hardware requirements or hidden fees?</span>
                    </button>
                    <div id="faq2" class="collapse">
                        <div class="pz-faq-body">
                            No. SIMS works with your existing PC, Mac, laptop, tablet, barcode scanner (USB or Bluetooth), and standard ESC/POS thermal receipt printers or regular A4 laser printers. There are zero mandatory hardware purchases.
                        </div>
                    </div>
                </div>

                <!-- FAQ 3 -->
                <div class="pz-faq-card">
                    <button class="pz-faq-header collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3" aria-expanded="false">
                        <span class="pz-faq-icon"><i class="bi bi-plus"></i></span>
                        <span class="pz-faq-title">Can I upgrade or downgrade my package as my shop expands?</span>
                    </button>
                    <div id="faq3" class="collapse">
                        <div class="pz-faq-body">
                            Yes. You can switch between Starter, Pro, and Multi-Store Enterprise tiers anytime directly from your Shop Admin billing settings. Upgrades apply immediately with prorated billing.
                        </div>
                    </div>
                </div>

                <!-- FAQ 4 -->
                <div class="pz-faq-card">
                    <button class="pz-faq-header collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq4" aria-expanded="false">
                        <span class="pz-faq-icon"><i class="bi bi-plus"></i></span>
                        <span class="pz-faq-title">Can I import my existing phone stock from Excel?</span>
                    </button>
                    <div id="faq4" class="collapse">
                        <div class="pz-faq-body">
                            Yes. SIMS provides a 1-click Excel bulk import tool for products, IMEI numbers, accessories, categories, and customer directories. You can migrate your entire shop inventory in under 10 minutes.
                        </div>
                    </div>
                </div>
            </div>

            <div class="pz-faq-footer-note text-center mt-4">
                Can't find the answer you're looking for? Please <a href="@Url.Action("Contact", "Landing")" class="text-decoration-underline fw-bold" style="color: var(--pz-coral);">chat to our friendly team</a>.
        </div>

    </div>
</div>

