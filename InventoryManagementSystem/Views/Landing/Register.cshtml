@{
    ViewData["Title"] = "Register Your Business — SIMS SaaS";
    Layout = "_Layout";
    var packages = (IEnumerable<InventoryManagementSystem.Models.SubscriptionPackage>)ViewBag.Packages;
    var selectedPackageId = (string)ViewBag.SelectedPackageId;
}

<div class="pz-page-wrap">
    <div class="pz-container" style="max-width: 820px;">

        <!-- Page Header with Standardized Accent Hierarchy -->
        <div class="pz-section-head mb-5 text-center">
            <span class="pz-accent-eyebrow">RAPID 2-MINUTE ONBOARDING</span>
            <h1 class="pz-section-title">Create your business account</h1>
            <span class="pz-heading-accent" aria-hidden="true"></span>
            <p class="pz-section-sub">
                Start your 14-day full feature trial. No credit card required. Experience synchronized inventory, product tracking, and POS billing instantly.
            </p>
        </div>

        <div class="pz-card pz-register-card p-4 p-md-5">
            <form method="post" action="@Url.Action("RegisterShop", "Landing")">
                @Html.AntiForgeryToken()

                <!-- Step 1: Subscription Tier -->
                <div class="mb-4 pb-4 border-bottom">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="badge rounded-circle p-2" style="width: 26px; height: 26px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.75rem; background: #17181B; color: #FFFFFF;">1</span>
                        <h4 class="pz-card-title mb-0 fs-6" style="color: #17181B;">Select Subscription Package</h4>
                    </div>
                    <div>
                        <label class="pz-form-label" style="color: #17181B;">Subscription Tier <span class="text-danger">*</span></label>
                        <select name="packageId" class="pz-form-select" required style="background-color: #FFFFFF !important; color: #17181B !important;">
                            @if (packages != null)
                            {
                                foreach (var p in packages)
                                {
                                    <option value="@p.Id" selected="@(p.Id == selectedPackageId)">
                                        @p.Name — ₹@p.MonthlyPrice.ToString("N0")/month (@p.Description)
                                    </option>
                                }
                            }
                        </select>
                        <div class="form-text fs-8 mt-1" style="color: #555B66;">Includes a 14-day full-access trial period before any billing begins.</div>
                    </div>
                </div>

                <!-- Step 2: Business & Store Details -->
                <div class="mb-4 pb-4 border-bottom">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="badge rounded-circle p-2" style="width: 26px; height: 26px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.75rem; background: #17181B; color: #FFFFFF;">2</span>
                        <h4 class="pz-card-title mb-0 fs-6" style="color: #17181B;">Business &amp; Store Information</h4>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="pz-form-label" style="color: #17181B;">Business / Store Name <span class="text-danger">*</span></label>
                            <input type="text" name="shopName" class="pz-form-control" placeholder="e.g. Apex Retail Hub" required />
                        </div>
                        <div class="col-md-6">
                            <label class="pz-form-label" style="color: #17181B;">GSTIN (Optional)</label>
                            <input type="text" name="gstin" class="pz-form-control" placeholder="22AAAAA0000A1Z5" />
                        </div>
                        <div class="col-12">
                            <label class="pz-form-label" style="color: #17181B;">Business Address</label>
                            <input type="text" name="address" class="pz-form-control" placeholder="Store #12, Central Commercial Market, City" />
                        </div>
                    </div>
                </div>

                <!-- Step 3: Owner Account Credentials -->
                <div class="mb-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="badge rounded-circle p-2" style="width: 26px; height: 26px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.75rem; background: #17181B; color: #FFFFFF;">3</span>
                        <h4 class="pz-card-title mb-0 fs-6" style="color: #17181B;">Owner Account Credentials</h4>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="pz-form-label" style="color: #17181B;">Owner Full Name <span class="text-danger">*</span></label>
                            <input type="text" name="ownerName" class="pz-form-control" placeholder="e.g. Rahul Sharma" required />
                        </div>
                        <div class="col-md-6">
                            <label class="pz-form-label" style="color: #17181B;">Phone Number</label>
                            <div class="pz-phone-field-group">
                                <select class="pz-country-select country-code-select" name="countryCode" aria-label="Country calling code" id="phoneCountryCode">
                                    <option value="+91" selected>🇮🇳 +91</option>
                                    <option value="+1">🇺🇸 +1</option>
                                    <option value="+44">🇬🇧 +44</option>
                                    <option value="+971">🇦🇪 +971</option>
                                    <option value="+65">🇸🇬 +65</option>
                                    <option value="+61">🇦🇺 +61</option>
                                    <option value="+966">🇸🇦 +966</option>
                                    <option value="+974">🇶🇦 +974</option>
                                    <option value="+965">🇰🇼 +965</option>
                                    <option value="+968">🇴🇲 +968</option>
                                    <option value="+973">🇧🇭 +973</option>
                                    <option value="+977">🇳🇵 +977</option>
                                    <option value="+880">🇧🇩 +880</option>
                                    <option value="+94">🇱🇰 +94</option>
                                    <option value="+60">🇲🇾 +60</option>
                                    <option value="+49">🇩🇪 +49</option>
                                    <option value="+33">🇫🇷 +33</option>
                                    <option value="+86">🇨🇳 +86</option>
                                    <option value="+81">🇯🇵 +81</option>
                                </select>
                                <div class="pz-phone-divider" aria-hidden="true"></div>
                                <input type="tel" name="phone" id="phone" class="pz-phone-input phone-input" placeholder="98765 43210" data-cc-init="true" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="pz-form-label" style="color: #17181B;">Email Address (Login Username) <span class="text-danger">*</span></label>
                            <input type="email" name="contactEmail" class="pz-form-control" placeholder="owner@apexretail.com" required />
                        </div>
                        <div class="col-md-6">
                            <label class="pz-form-label" style="color: #17181B;">Create Password <span class="text-danger">*</span></label>
                            <input type="password" name="password" class="pz-form-control" placeholder="Choose a secure password" required />
                        </div>
                    </div>
                </div>

                <div class="pt-3 border-top">
                    <button type="submit" class="pz-btn-primary w-100 py-3 text-center justify-content-center text-decoration-none d-flex align-items-center gap-2">
                        <span>Register Business &amp; Launch System</span>
                        <i class="bi bi-rocket-takeoff ms-1"></i>
                    </button>
                    <div class="text-center mt-3 fs-8" style="color: #555B66;">
                        Already have an active account? <a href="@Url.Action("Login", "Account")" class="fw-bold" style="color: #17181B;">Sign In here</a>
                    </div>
                </div>
            </form>
        </div>

        <!-- Safe Contextual Help Strip (Does Not Compete with Registration) -->
        @await Html.PartialAsync("_PublicPreFooterCta", new InventoryManagementSystem.Models.PublicCtaViewModel
        {
            IsMinimalStrip = true,
            Title = "Need help choosing a plan or importing your existing inventory?",
            Description = "Our onboarding team assists with free Excel product stock mapping and hardware setup.",
            PrimaryButtonText = "Contact Support",
            PrimaryButtonUrl = Url.Action("Contact", "Landing"),
            SecondaryButtonText = "View Pricing Plans",
            SecondaryButtonUrl = Url.Action("Pricing", "Landing")
        })

    </div>
</div>
