@model Sale
@{
    ViewData["Title"] = "POS Terminal";
    List<Product> products = ViewBag.ProductsList as List<Product> ?? new List<Product>();
    var settings = ViewBag.Settings as Settings ?? new Settings();
}

<div class="ph">
    <div>
        <h1 class="ph-title">POS Checkout Terminal</h1>
        <p class="ph-sub">Perform instant customer checkouts, record partial/due amounts, and issue invoices.</p>
    </div>
    <div class="ph-actions">
        <a href="@Url.Action("Index","Sales")" class="btn-d btn-outline">
            <i class="bi bi-file-text"></i> Invoice Records
        </a>
    </div>
</div>

<form asp-action="Create" method="post" id="posForm">
    <div asp-validation-summary="ModelOnly" class="alert-d alert-danger mb-4"></div>

    <div class="row g-4">
        <!-- Left Column: Customer & Items -->
        <div class="col-lg-8">
            <!-- Customer Card -->
            <div class="card-d card-p-lg mb-4">
                <div class="s-title"><i class="bi bi-person-badge me-2" style="color:var(--primary)"></i>Customer Information</div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="fg">
                            <label class="fg-label" asp-for="CustomerName">Customer Name <span class="req">*</span></label>
                            <input asp-for="CustomerName" class="fg-control" placeholder="Walk-in Customer" required />
                            <span asp-validation-for="CustomerName" class="fg-error"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="fg">
                            <label class="fg-label" asp-for="CustomerPhone">Customer Contact</label>
                            <div class="fg-prefix-wrap">
                                <span class="fg-prefix"><i class="bi bi-telephone me-1" style="font-size:11px"></i>+91</span>
                                <input asp-for="CustomerPhone" class="fg-control" placeholder="98765 43210" />
                            </div>
                            <span asp-validation-for="CustomerPhone" class="fg-error"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Items Card -->
            <div class="card-d card-p-lg">
                <div class="s-title"><i class="bi bi-cart-plus me-2" style="color:var(--success)"></i>Billing Lines</div>
                
                <div class="row g-3 align-items-end mb-3">
                    <div class="col-md-6">
                        <div class="fg mb-0">
                            <label class="fg-label">Product Search <span class="req">*</span></label>
                            <select id="productSelect" class="fg-control" onchange="onProductSelectChange()">
                                <option value="">— Choose Product SKU —</option>
                                @foreach (var prod in products)
                                {
                                    bool isImeiTracked = prod.IsImeiRequired || prod.ProductType == "Smartphone" || prod.ProductType == "Feature Phone" || prod.ProductType == "Tablet" || prod.ProductType == "Smartwatch";
                                    <option value="@prod.Id" 
                                            data-name="@prod.Name" 
                                            data-code="@prod.Code" 
                                            data-price="@prod.SellingPrice" 
                                            data-stock="@prod.CurrentStock"
                                            data-imei-required="@isImeiTracked.ToString().ToLower()">
                                        @prod.Name (SKU: @prod.Code - Price: ₹@prod.SellingPrice - Stock: @prod.CurrentStock)
                                    </option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="fg mb-0">
                            <label class="fg-label">Quantity</label>
                            <input type="number" id="qtyInput" min="1" value="1" class="fg-control" oninput="onQtyChange()" onchange="onQtyChange()" />
                        </div>
                    </div>
                    <div class="col-md-4 text-end">
                        <button type="button" class="btn-d btn-primary w-100" onclick="addProductLine()">
                            <i class="bi bi-plus-lg me-1"></i> Add Item(s) to Cart
                        </button>
                    </div>
                </div>

                <!-- Dynamic IMEI Inputs Container for Each Device Unit -->
                <div id="dynamicImeiWrapper" class="mb-4 p-3 rounded" style="background:var(--bg);border:1px solid var(--border);display:none;">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h6 class="mb-0 text-primary font-weight-bold"><i class="bi bi-shield-lock me-2"></i>Device IMEI Numbers (<span id="imeiDeviceCountBadge">1 Device</span>)</h6>
                        <span class="badge bg-warning text-dark font-monospace" style="font-size:11px;"><i class="bi bi-upc-scan me-1"></i>IMEI required for each physical device</span>
                    </div>
                    <div id="dynamicImeiList" class="row g-2">
                        <!-- Individual Device IMEI input rows populated dynamically by JavaScript -->
                    </div>
                </div>

                <!-- Table -->
                <div class="tbl-wrap">
                    <div class="tbl-scroll">
                        <table class="tbl" id="posTable">
                            <thead>
                                <tr>
                                    <th style="width:45px">#</th>
                                    <th>Product &amp; Unit IMEI Details</th>
                                    <th style="width:110px">Price</th>
                                    <th style="width:80px">Qty</th>
                                    <th style="width:120px">Total</th>
                                    <th class="col-actions" style="width:60px">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr id="emptyRow">
                                    <td colspan="6">
                                        <div class="empty-s" style="padding:24px">
                                            <div class="empty-s-title">Cart is empty</div>
                                            <div class="empty-s-desc">Select products and enter IMEI numbers for each unit above to build invoice cart.</div>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Summary & Payment -->
        <div class="col-lg-4">
            <div class="card-d card-p-lg">
                <div class="s-title"><i class="bi bi-receipt me-2" style="color:var(--primary)"></i>Checkout Summary</div>

                <div class="d-flex justify-content-between mb-3">
                    <span style="color:var(--text-secondary)">Sub-Total:</span>
                    <span class="td-strong" id="summarySubtotal">₹0.00</span>
                </div>

                <div class="fg">
                    <label class="fg-label" asp-for="Discount">Flat Discount (₹)</label>
                    <div class="fg-prefix-wrap">
                        <span class="fg-prefix">₹</span>
                        <input asp-for="Discount" id="discountInput" class="fg-control" value="0.00" oninput="calculateSummary()" />
                    </div>
                    <span asp-validation-for="Discount" class="fg-error"></span>
                </div>

                <div class="fg">
                    <label class="fg-label" asp-for="GstPercentage">GST Rate (%)</label>
                    <select asp-for="GstPercentage" id="gstSelect" class="fg-control" onchange="calculateSummary()">
                        <option value="18.0" selected="@(Model.GstPercentage == 18.0m)">GST - 18.0% (Standard)</option>
                        <option value="12.0" selected="@(Model.GstPercentage == 12.0m)">GST - 12.0%</option>
                        <option value="5.0" selected="@(Model.GstPercentage == 5.0m)">GST - 5.0%</option>
                        <option value="0.0" selected="@(Model.GstPercentage == 0.0m)">GST - 0.0% (Exempt)</option>
                    </select>
                    <span asp-validation-for="GstPercentage" class="fg-error"></span>
                </div>

                <div class="d-flex justify-content-between mb-3">
                    <span style="color:var(--text-secondary)">Tax GST Amount:</span>
                    <span class="td-strong" id="summaryGst">₹0.00</span>
                </div>

                <hr class="s-divider my-3" />

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span style="font-weight:700;color:var(--text-primary)">Grand Total:</span>
                    <span style="font-size:24px;font-weight:800;color:var(--success)" id="summaryGrandtotal">₹0.00</span>
                </div>

                <hr class="s-divider my-3" />

                <div class="s-title"><i class="bi bi-wallet2 me-2" style="color:var(--warning)"></i>Payment &amp; Due Info</div>

                <!-- Payment Status -->
                <div class="fg">
                    <label class="fg-label" asp-for="PaymentStatus">Payment Status <span class="req">*</span></label>
                    <select asp-for="PaymentStatus" id="paymentStatusSelect" class="fg-control" onchange="onPaymentStatusChange()">
                        <option value="Paid" selected>Paid (Full Payment Received)</option>
                        <option value="Partial">Partial / Credit (Partial Paid)</option>
                        <option value="Unpaid">Unpaid (Full Due / Credit)</option>
                        <option value="Draft">Draft Invoice</option>
                    </select>
                    <span asp-validation-for="PaymentStatus" class="fg-error"></span>
                </div>

                <!-- Amount Paid (₹) -->
                <div class="fg" id="amountPaidGroup">
                    <label class="fg-label" asp-for="AmountPaid">Amount Paid (₹)</label>
                    <div class="fg-prefix-wrap">
                        <span class="fg-prefix">₹</span>
                        <input asp-for="AmountPaid" id="amountPaidInput" class="fg-control" value="0.00" oninput="calculateSummary()" />
                    </div>
                    <span asp-validation-for="AmountPaid" class="fg-error"></span>
                </div>

                <!-- Remaining / Due Amount (₹) -->
                <div class="d-flex justify-content-between align-items-center mb-4 p-2 rounded" id="dueAmountBox" style="background:var(--danger-dim);border:1px solid var(--danger-dim)">
                    <span style="font-weight:600;color:var(--danger);font-size:13px"><i class="bi bi-exclamation-circle me-1"></i>Due Amount:</span>
                    <span style="font-size:16px;font-weight:700;color:var(--danger)" id="summaryDueAmount">₹0.00</span>
                </div>

                <button type="submit" class="btn-d btn-primary w-100" style="height:46px;font-size:15px">
                    <i class="bi bi-credit-card-2-back me-1"></i> Complete Order &amp; Issue Invoice
                </button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var itemIndex = 0;

        function onProductSelectChange() {
            renderImeiFields();
        }

        function onQtyChange() {
            renderImeiFields();
        }

        function renderImeiFields() {
            var select = document.getElementById('productSelect');
            if (!select || select.selectedIndex < 0) return;
            var option = select.options[select.selectedIndex];
            var wrapper = document.getElementById('dynamicImeiWrapper');
            var list = document.getElementById('dynamicImeiList');
            var countBadge = document.getElementById('imeiDeviceCountBadge');

            if (!option || !option.value) {
                wrapper.style.display = 'none';
                list.innerHTML = '';
                return;
            }

            var isImeiRequired = option.getAttribute('data-imei-required') === 'true';
            var qty = parseInt(document.getElementById('qtyInput').value) || 1;

            if (!isImeiRequired || qty <= 0) {
                wrapper.style.display = 'none';
                list.innerHTML = '';
                return;
            }

            wrapper.style.display = 'block';
            countBadge.innerText = qty + (qty === 1 ? ' Mobile Device' : ' Mobile Devices');

            // Preserve any previously typed IMEIs
            var existingImeis = [];
            $('.device-imei-card').each(function() {
                var i1 = $(this).find('.imei1-val').val() || '';
                var i2 = $(this).find('.imei2-val').val() || '';
                existingImeis.push({ imei1: i1, imei2: i2 });
            });

            var html = '';
            for (var i = 1; i <= qty; i++) {
                var prev = existingImeis[i - 1] || { imei1: '', imei2: '' };
                html += `
                    <div class="col-12 device-imei-card" data-card-idx="${i}">
                        <div class="p-2.5 rounded border" style="background: rgba(13, 110, 253, 0.03); border-color: rgba(13, 110, 253, 0.2) !important;">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="fw-bold small text-primary"><i class="bi bi-phone me-1"></i>Device #${i} Details</span>
                                <span class="badge bg-secondary font-monospace" style="font-size:10px">Device ${i} of ${qty}</span>
                            </div>
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <input type="text" class="fg-control fg-control-sm font-monospace imei1-val" 
                                           value="${prev.imei1}"
                                           placeholder="Device #${i} Primary IMEI 1 (15 digits) *" required />
                                </div>
                                <div class="col-md-6">
                                    <input type="text" class="fg-control fg-control-sm font-monospace imei2-val" 
                                           value="${prev.imei2}"
                                           placeholder="Device #${i} Secondary IMEI 2 (Optional)" />
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }

            list.innerHTML = html;
        }

        function addProductLine() {
            var select = document.getElementById('productSelect');
            var productId = select.value;
            if (!productId) {
                alert('Please select a product SKU first.');
                return;
            }

            var option = select.options[select.selectedIndex];
            var name = option.getAttribute('data-name');
            var code = option.getAttribute('data-code');
            var price = parseFloat(option.getAttribute('data-price'));
            var stock = parseInt(option.getAttribute('data-stock'));
            var quantity = parseInt(document.getElementById('qtyInput').value);
            var isImeiRequired = option.getAttribute('data-imei-required') === 'true';

            if (isNaN(quantity) || quantity <= 0) {
                alert('Please enter a valid quantity.');
                return;
            }

            if (quantity > stock) {
                alert('Requested quantity exceeds available stock (' + stock + ' units available).');
                return;
            }

            var deviceEntries = [];

            if (isImeiRequired) {
                var cards = $('.device-imei-card');
                if (cards.length < quantity) {
                    alert('Please enter IMEI numbers for all ' + quantity + ' devices.');
                    return;
                }

                for (var i = 0; i < quantity; i++) {
                    var card = cards.eq(i);
                    var imei1 = card.find('.imei1-val').val().trim();
                    var imei2 = card.find('.imei2-val').val().trim();

                    if (!imei1) {
                        alert('Please enter Primary IMEI 1 for Device #' + (i + 1) + '.');
                        card.find('.imei1-val').focus();
                        return;
                    }

                    if (imei1.length < 14 || imei1.length > 16 || !/^\d+$/.test(imei1)) {
                        alert('Device #' + (i + 1) + ' IMEI 1 must be 14-16 digits.');
                        card.find('.imei1-val').focus();
                        return;
                    }

                    if (imei2 && (imei2.length < 14 || imei2.length > 16 || !/^\d+$/.test(imei2))) {
                        alert('Device #' + (i + 1) + ' IMEI 2 must be 14-16 digits.');
                        card.find('.imei2-val').focus();
                        return;
                    }

                    // Check duplicate IMEI in existing cart
                    var duplicateFound = false;
                    $('#posTable tbody tr').each(function() {
                        var existingImei1 = $(this).find('input[name*="IMEI1"]').val();
                        if (existingImei1 === imei1) {
                            duplicateFound = true;
                            return false;
                        }
                    });

                    if (duplicateFound) {
                        alert('IMEI ' + imei1 + ' is already added in the cart.');
                        return;
                    }

                    deviceEntries.push({ imei1: imei1, imei2: imei2 });
                }
            }

            $('#emptyRow').hide();
            var tbody = document.querySelector('#posTable tbody');

            if (isImeiRequired) {
                // For mobile devices, add 1 row per unit with its dedicated IMEI
                for (var d = 0; d < deviceEntries.length; d++) {
                    var dev = deviceEntries[d];
                    var lineTotal = price * 1;
                    var row = document.createElement('tr');
                    row.className = 'pos-item-row';

                    var imeiBadges = `<div style="font-size:11px;color:var(--primary);font-family:monospace;margin-top:2px"><i class="bi bi-upc-scan me-1"></i>IMEI 1: ${dev.imei1}${dev.imei2 ? ' | IMEI 2: ' + dev.imei2 : ''}</div>`;

                    row.innerHTML = `
                        <td class="row-num" style="color:var(--text-muted)"></td>
                        <td>
                            <div class="td-strong">${name}</div>
                            <span class="code-pill">${code}</span>
                            ${imeiBadges}
                            <input type="hidden" name="Items[${itemIndex}].ProductId" value="${productId}" />
                            <input type="hidden" name="Items[${itemIndex}].Quantity" value="1" />
                            <input type="hidden" name="Items[${itemIndex}].IMEI1" value="${dev.imei1}" />
                            <input type="hidden" name="Items[${itemIndex}].IMEI2" value="${dev.imei2}" />
                        </td>
                        <td style="color:var(--text-secondary)">₹${price.toFixed(2)}</td>
                        <td style="color:var(--text-primary);font-weight:600">1</td>
                        <td class="line-total td-strong" data-total="${lineTotal}">₹${lineTotal.toFixed(2)}</td>
                        <td class="col-actions">
                            <button type="button" class="btn-d btn-ghost btn-icon-d" style="color:var(--danger)" onclick="removeProductLine(this)"><i class="bi bi-trash"></i></button>
                        </td>
                    `;
                    tbody.appendChild(row);
                    itemIndex++;
                }
            } else {
                // Non-IMEI accessory
                var lineTotal = price * quantity;
                var row = document.createElement('tr');
                row.className = 'pos-item-row';

                row.innerHTML = `
                    <td class="row-num" style="color:var(--text-muted)"></td>
                    <td>
                        <div class="td-strong">${name}</div>
                        <span class="code-pill">${code}</span>
                        <input type="hidden" name="Items[${itemIndex}].ProductId" value="${productId}" />
                        <input type="hidden" name="Items[${itemIndex}].Quantity" value="${quantity}" />
                        <input type="hidden" name="Items[${itemIndex}].IMEI1" value="" />
                        <input type="hidden" name="Items[${itemIndex}].IMEI2" value="" />
                    </td>
                    <td style="color:var(--text-secondary)">₹${price.toFixed(2)}</td>
                    <td style="color:var(--text-primary);font-weight:600">${quantity}</td>
                    <td class="line-total td-strong" data-total="${lineTotal}">₹${lineTotal.toFixed(2)}</td>
                    <td class="col-actions">
                        <button type="button" class="btn-d btn-ghost btn-icon-d" style="color:var(--danger)" onclick="removeProductLine(this)"><i class="bi bi-trash"></i></button>
                    </td>
                `;
                tbody.appendChild(row);
                itemIndex++;
            }

            reindexItems();
            calculateSummary();

            select.value = "";
            document.getElementById('qtyInput').value = 1;
            renderImeiFields();
        }

        function removeProductLine(btn) {
            $(btn).closest('tr').remove();
            reindexItems();
            calculateSummary();

            if ($('#posTable tbody tr.pos-item-row').length === 0) {
                $('#emptyRow').show();
            }
        }

        function reindexItems() {
            itemIndex = 0;
            $('#posTable tbody tr.pos-item-row').each(function(index, row) {
                $(row).find('td.row-num').text(index + 1);
                $(row).find('input[name*="ProductId"]').attr('name', `Items[${index}].ProductId`);
                $(row).find('input[name*="Quantity"]').attr('name', `Items[${index}].Quantity`);
                $(row).find('input[name*="IMEI1"]').attr('name', `Items[${index}].IMEI1`);
                $(row).find('input[name*="IMEI2"]').attr('name', `Items[${index}].IMEI2`);
                itemIndex = index + 1;
            });
        }

        function onPaymentStatusChange() {
            calculateSummary();
        }

        function calculateSummary() {
            var subTotal = 0;
            $('.line-total').each(function() {
                subTotal += parseFloat($(this).attr('data-total'));
            });

            var discount = parseFloat(document.getElementById('discountInput').value) || 0;
            if (discount < 0) discount = 0;
            if (discount > subTotal) discount = subTotal;

            var gstPercentage = parseFloat(document.getElementById('gstSelect').value) || 0;
            var taxableAmount = subTotal - discount;
            var gstAmount = taxableAmount * (gstPercentage / 100);
            var grandTotal = taxableAmount + gstAmount;

            var status = document.getElementById('paymentStatusSelect').value;
            var paidInput = document.getElementById('amountPaidInput');

            if (status === 'Paid') {
                paidInput.value = grandTotal.toFixed(2);
                paidInput.readOnly = true;
            } else if (status === 'Unpaid' || status === 'Draft') {
                paidInput.value = '0.00';
                paidInput.readOnly = true;
            } else { // Partial
                paidInput.readOnly = false;
            }

            var amountPaid = parseFloat(paidInput.value) || 0;
            if (amountPaid > grandTotal) amountPaid = grandTotal;

            var dueAmount = grandTotal - amountPaid;
            if (dueAmount < 0) dueAmount = 0;

            document.getElementById('summarySubtotal').innerText = '₹' + subTotal.toFixed(2);
            document.getElementById('summaryGst').innerText = '₹' + gstAmount.toFixed(2);
            document.getElementById('summaryGrandtotal').innerText = '₹' + grandTotal.toFixed(2);
            document.getElementById('summaryDueAmount').innerText = '₹' + dueAmount.toFixed(2);

            const dueBox = document.getElementById('dueAmountBox');
            if (dueBox) {
                dueBox.style.display = dueAmount > 0 ? 'flex' : 'none';
            }
        }

        $(document).ready(function() {
            calculateSummary();
        });
    </script>
}
