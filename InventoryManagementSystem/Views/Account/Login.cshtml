@model LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign In – SIMS</title>
  <link rel="icon" type="image/png" href="~/favicon.png" />
  <link rel="shortcut icon" type="image/png" href="~/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-page-body">

<div class="auth-split-viewport">
  <div class="auth-split-card">
    
    <!-- LEFT SIDE: 50% EQUAL GRID FORM PANEL -->
    <div class="auth-split-form">
      <div class="auth-split-form-inner">
      
        <!-- SIMS Original Branding Logo (White logo for dark panel) -->
        <div class="auth-hero-brand mb-4">
          <img src="~/images/logo-dark.png" alt="SIMS Logo" class="auth-brand-logo" onerror="this.src='/images/logo-light.png';this.onerror=function(){this.style.display='none';this.nextElementSibling.style.display='flex';}">
          <div class="sb-brand-icon" style="display:none"><i class="bi bi-box-seam-fill"></i><span class="ms-2 fw-bold text-white">SIMS</span></div>
        </div>

        <div class="auth-hero-header mb-4">
          <h1 class="auth-hero-title">Welcome <span class="auth-title-accent">back</span></h1>
          <p class="auth-hero-subtitle">Sign in to access your SIMS workspace</p>
        </div>

        @{
          var errors = ViewData.ModelState.Values.SelectMany(v => v.Errors).ToList();
        }
        @if (errors.Any())
        {
          <div class="alert-d alert-danger mb-4">
            <i class="bi bi-exclamation-circle-fill flex-shrink-0" style="margin-top:2px"></i>
            <div>@errors.First().ErrorMessage</div>
          </div>
        }

        <form asp-action="Login" method="post" asp-route-returnUrl="@ViewData["ReturnUrl"]">
          <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

          <!-- Username / Email -->
          <div class="fg mb-3">
            <label class="fg-label" asp-for="UsernameOrEmail">Username or Email</label>
            <div class="fg-icon-wrap" style="position:relative">
              <i class="bi bi-person fg-icon"></i>
              <input asp-for="UsernameOrEmail" class="fg-control auth-glass-input" placeholder="Enter username or email"
                     autocomplete="username" required>
            </div>
            <span asp-validation-for="UsernameOrEmail" class="fg-error"></span>
          </div>

          <!-- Password -->
          <div class="fg mb-3">
            <div class="d-flex align-items-center justify-content-between mb-1">
              <label class="fg-label mb-0" asp-for="Password">Password</label>
              <a href="@Url.Action("ForgotPassword","Account")" class="auth-forgot-link">
                Forgot password?
              </a>
            </div>
            <div class="fg-icon-wrap" style="position:relative">
              <i class="bi bi-lock fg-icon"></i>
              <input asp-for="Password" id="pwd-in" class="fg-control auth-glass-input"
                     style="padding-left:42px;padding-right:44px"
                     placeholder="Enter your password"
                     autocomplete="current-password" required>
              <button type="button" id="pwd-eye" aria-label="Toggle password" class="pwd-eye-btn">
                <i class="bi bi-eye" id="pwd-eye-icon"></i>
              </button>
            </div>
            <span asp-validation-for="Password" class="fg-error"></span>
          </div>

          <!-- Remember Me -->
          <div class="d-flex align-items-center justify-content-between mb-4">
            <div class="d-flex align-items-center gap-2">
              <input asp-for="RememberMe" type="checkbox" id="RememberMe" class="auth-checkbox">
              <label asp-for="RememberMe" class="auth-checkbox-label">
                Remember me
              </label>
            </div>
          </div>

          <!-- Submit Button -->
          <button type="submit" class="btn-d w-100 auth-submit-btn">
            Sign In <i class="bi bi-arrow-right ms-1"></i>
          </button>
        </form>

        <div class="auth-hero-footer mt-4">
          <span>&copy; @DateTime.Now.Year SIMS. All rights reserved.</span>
        </div>

      </div>
    </div>

    <!-- RIGHT SIDE: 50% EQUAL GRID SIDE VISUAL PANEL -->
    <div class="auth-split-image-panel">
      <img src="~/images/loginpageui.png" alt="SIMS Workspace" class="auth-split-img" />
      <div class="auth-split-img-overlay"></div>
    </div>

  </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<partial name="_ValidationScriptsPartial" />
<script>
  document.getElementById('pwd-eye').addEventListener('click', function(){
    var i = document.getElementById('pwd-in'), icon = document.getElementById('pwd-eye-icon');
    i.type = i.type === 'password' ? 'text' : 'password';
    icon.className = 'bi ' + (i.type === 'password' ? 'bi-eye' : 'bi-eye-slash');
  });
</script>
</body>
</html>
