@model LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign In – SIMS</title>
  <link rel="icon" type="image/png" href="~/favicon.png" />
  <link rel="shortcut icon" type="image/png" href="~/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body class="auth-page-body sims-login-page">

<div class="sims-login-wrapper">
  
  <!-- LEFT SIDE: 50% MINIMALIST SPLIT FORM PANEL (WHITE THEME) -->
  <main class="sims-login-form-panel">
    
    <!-- Top Header: Logo & Back Link -->
    <header class="sims-login-header">
      <a href="/" class="sims-login-brand-link" title="SIMS Homepage">
        <img src="~/images/logo-light.png" alt="SIMS Logo" class="sims-login-logo" onerror="this.src='/images/logo.png';this.onerror=function(){this.style.display='none';this.nextElementSibling.style.display='flex';}">
        <div class="sims-fallback-logo" style="display:none">
          <i class="bi bi-box-seam-fill"></i>
          <span>SIMS</span>
        </div>
      </a>
      <a href="/" class="sims-back-website-btn" title="Back to website">
        <i class="bi bi-arrow-left"></i>
        <span>Back to website</span>
      </a>
    </header>

    <!-- Center Form Section -->
    <div class="sims-login-form-center">
      <div class="sims-login-form-box">
        
        <div class="sims-login-intro">
          <h1 class="sims-login-title">Sign in to SIMS</h1>
          <p class="sims-login-desc">Enter your credentials to access your management workspace</p>
        </div>

        @{
          var modelLevelErrors = ViewData.ModelState[string.Empty]?.Errors
              ?.Select(e => e.ErrorMessage)
              ?.Where(m => !string.IsNullOrWhiteSpace(m))
              ?.Distinct()
              ?.ToList() ?? new List<string>();

          var allErrors = ViewData.ModelState.Values
              .SelectMany(v => v.Errors)
              .Select(e => e.ErrorMessage)
              .Where(m => !string.IsNullOrWhiteSpace(m))
              .Distinct()
              .ToList();

          var flashMsg = TempData["ToastMessage"] as string 
                      ?? TempData["ErrorMessage"] as string 
                      ?? TempData["SuccessMessage"] as string 
                      ?? TempData["InfoMessage"] as string 
                      ?? ViewBag.ErrorMessage as string 
                      ?? ViewBag.SuccessMessage as string 
                      ?? ViewBag.InfoMessage as string;

          var flashType = ((TempData["ToastType"] as string 
                         ?? (TempData["ErrorMessage"] != null || ViewBag.ErrorMessage != null ? "danger" : 
                            (TempData["SuccessMessage"] != null || ViewBag.SuccessMessage != null ? "success" : "info")))).ToLower();

          var isSuccess = flashType == "success";
          var isInfo = flashType == "info";

          var activeErrors = modelLevelErrors.Any() ? modelLevelErrors : (allErrors.Any() ? allErrors : new List<string>());
          var hasErrors = activeErrors.Any() || (!string.IsNullOrEmpty(flashMsg) && !isSuccess && !isInfo);
        }

        @if (hasErrors)
        {
          var errList = activeErrors.Any() ? activeErrors : new List<string> { flashMsg! };
          <div class="sims-alert-box sims-alert-danger" role="alert" aria-live="assertive">
            <div class="sims-alert-icon-w">
              <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <div class="sims-alert-content">
              @if (errList.Count == 1)
              {
                <div class="sims-alert-text">@errList[0]</div>
              }
              else
              {
                <div class="sims-alert-title">Please correct the following:</div>
                <ul class="sims-alert-list">
                  @foreach (var err in errList)
                  {
                    <li>@err</li>
                  }
                </ul>
              }
            </div>
          </div>
        }
        else if (!string.IsNullOrEmpty(flashMsg))
        {
          <div class="sims-alert-box @(isSuccess ? "sims-alert-success" : "sims-alert-info")" role="status" aria-live="polite">
            <div class="sims-alert-icon-w">
              <i class="bi @(isSuccess ? "bi-check-circle-fill" : "bi-info-circle-fill")"></i>
            </div>
            <div class="sims-alert-content">
              <div class="sims-alert-text">@flashMsg</div>
            </div>
          </div>
        }

        <form asp-action="Login" method="post" asp-route-returnUrl="@ViewData["ReturnUrl"]">
          <div asp-validation-summary="ModelOnly" class="sims-validation-summary"></div>

          <!-- Username or Email -->
          <div class="sims-field-group">
            <label class="sims-field-label" asp-for="UsernameOrEmail">Username or Email</label>
            <div class="sims-input-container">
              <i class="bi bi-person sims-input-icon"></i>
              <input asp-for="UsernameOrEmail" class="sims-text-input" placeholder="Enter username or email"
                     autocomplete="username" required />
            </div>
            <span asp-validation-for="UsernameOrEmail" class="sims-field-error"></span>
          </div>

          <!-- Password -->
          <div class="sims-field-group">
            <div class="sims-label-row">
              <label class="sims-field-label" asp-for="Password">Password</label>
              <a href="@Url.Action("ForgotPassword","Account")" class="sims-forgot-password-link">
                Forgot password?
              </a>
            </div>
            <div class="sims-input-container">
              <i class="bi bi-lock sims-input-icon"></i>
              <input asp-for="Password" id="pwd-in" class="sims-text-input sims-input-pwd"
                     placeholder="Enter your password"
                     autocomplete="current-password" required />
              <button type="button" id="pwd-eye" aria-label="Toggle password" class="sims-pwd-toggle-btn">
                <i class="bi bi-eye" id="pwd-eye-icon"></i>
              </button>
            </div>
            <span asp-validation-for="Password" class="sims-field-error"></span>
          </div>

          <!-- Remember Me -->
          <div class="sims-actions-row">
            <label class="sims-checkbox-container" asp-for="RememberMe">
              <input asp-for="RememberMe" type="checkbox" id="RememberMe" class="sims-checkbox" />
              <span class="sims-checkbox-text">Remember me</span>
            </label>
          </div>

          <!-- Submit Button -->
          <button type="submit" class="sims-submit-btn" id="login-submit-btn">
            <span>Sign In</span>
            <i class="bi bi-arrow-right"></i>
          </button>
        </form>

      </div>
    </div>

    <!-- Bottom Footer -->
    <footer class="sims-login-footer">
      <span class="sims-copyright">&copy; @DateTime.Now.Year SIMS. All rights reserved.</span>
      <div class="sims-security-badge">
        <i class="bi bi-shield-lock-fill"></i>
        <span>Enterprise Security</span>
      </div>
    </footer>

  </main>

  <!-- RIGHT SIDE: MONOCHROME ARCHITECTURAL COURTYARD VISUAL PANEL -->
  <aside class="sims-login-visual-panel" aria-label="Visual showcase">
    <div class="sims-visual-inner">
      <img src="~/images/monochrome-courtyard.png" 
           alt="Monochrome Architectural Courtyard Beneath Mountain Skies" 
           class="sims-monochrome-img" />
      <div class="sims-visual-overlay"></div>
      
      <!-- Architectural Editorial Caption -->
      <div class="sims-visual-caption">
        <h2 class="sims-caption-title">
          <span class="sims-headline-wrap">
            Engineered for precision. Built for scale.
            <svg class="sims-headline-underline" viewBox="0 0 340 10" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" aria-hidden="true">
              <path d="M 4 5.5 C 75 7.0, 175 6.5, 255 5.0 C 290 4.3, 318 3.8, 336 3.5" stroke="#FFFFFF" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </h2>
      </div>
    </div>
  </aside>

</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<partial name="_ValidationScriptsPartial" />
<script>
  (function(){
    var eyeBtn = document.getElementById('pwd-eye');
    var pwdInput = document.getElementById('pwd-in');
    var eyeIcon = document.getElementById('pwd-eye-icon');
    if (eyeBtn && pwdInput && eyeIcon) {
      eyeBtn.addEventListener('click', function(e){
        e.preventDefault();
        var isPwd = pwdInput.type === 'password';
        pwdInput.type = isPwd ? 'text' : 'password';
        eyeIcon.className = isPwd ? 'bi bi-eye-slash' : 'bi bi-eye';
      });
    }
  })();
</script>
</body>
</html>
