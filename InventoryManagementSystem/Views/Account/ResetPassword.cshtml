@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reset Password – SIMS</title>
  <link rel="icon" type="image/png" href="~/favicon.png" />
  <link rel="shortcut icon" type="image/png" href="~/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-page-body" style="background:#0F172A;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px">

<div class="auth-card">
  <div class="auth-logo">
    <img src="~/images/logo.png" alt="SIMS Logo" class="auth-logo-img" style="width:40px;height:40px;border-radius:8px;object-fit:cover;flex-shrink:0" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
    <div class="auth-logo-icon" style="display:none"><i class="bi bi-key-fill"></i></div>
    <span class="auth-logo-name">SIMS</span>
  </div>

  <h1 class="auth-title">Reset Password</h1>
  <p class="auth-subtitle">Set a new secure password for your account.</p>

  <form asp-action="ResetPassword" method="post">
    <div asp-validation-summary="ModelOnly" class="alert-d alert-danger mb-4"></div>
    <input type="hidden" asp-for="Email" />
    <input type="hidden" asp-for="Token" />

    <div class="fg">
      <label class="fg-label" asp-for="Password">New Password</label>
      <div class="fg-icon-wrap">
        <i class="bi bi-lock fg-icon"></i>
        <input asp-for="Password" type="password" class="fg-control" placeholder="Min 6 characters" required />
      </div>
      <span asp-validation-for="Password" class="fg-error"></span>
    </div>

    <div class="fg mb-4">
      <label class="fg-label" asp-for="ConfirmPassword">Confirm Password</label>
      <div class="fg-icon-wrap">
        <i class="bi bi-lock-fill fg-icon"></i>
        <input asp-for="ConfirmPassword" type="password" class="fg-control" placeholder="Repeat new password" required />
      </div>
      <span asp-validation-for="ConfirmPassword" class="fg-error"></span>
    </div>

    <button type="submit" class="btn-d btn-primary w-100" style="height:44px">
      Update Password
    </button>
  </form>
</div>

</body>
</html>
