@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Forgot Password – SIMS</title>
  <link rel="icon" type="image/png" href="~/favicon.png" />
  <link rel="shortcut icon" type="image/png" href="~/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-page-body" style="background:#0F172A;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px">

<div class="auth-card">
  <div class="auth-logo">
    <img src="~/images/logo.png" alt="SIMS Logo" class="auth-logo-img" style="width:40px;height:40px;border-radius:8px;object-fit:cover;flex-shrink:0" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
    <div class="auth-logo-icon" style="display:none"><i class="bi bi-shield-lock-fill"></i></div>
    <span class="auth-logo-name">SIMS</span>
  </div>

  <h1 class="auth-title">Forgot password</h1>
  <p class="auth-subtitle">Enter your registered email address to receive a password reset link.</p>

  @if (ViewBag.Message != null)
  {
    <div class="alert-d alert-info mb-4">
      <i class="bi bi-info-circle-fill" style="margin-top:2px;flex-shrink:0"></i>
      <div>@ViewBag.Message</div>
    </div>
    <a href="@Url.Action("Login","Account")" class="btn-d btn-outline w-100" style="height:44px">
      Back to Sign In
    </a>
  }
  else
  {
    <form asp-action="ForgotPassword" method="post">
      <div class="fg">
        <label class="fg-label" asp-for="Email">Email Address</label>
        <div class="fg-icon-wrap">
          <i class="bi bi-envelope fg-icon"></i>
          <input asp-for="Email" type="email" class="fg-control" placeholder="name@example.com" required />
        </div>
        <span asp-validation-for="Email" class="fg-error"></span>
      </div>

      <button type="submit" class="btn-d btn-primary w-100 mb-3" style="height:44px">
        Send Reset Link
      </button>

      <div class="text-center">
        <a href="@Url.Action("Login","Account")" style="font-size:13px;color:var(--text-muted);text-decoration:none">
          <i class="bi bi-arrow-left me-1"></i> Back to Sign In
        </a>
      </div>
    </form>
  }
</div>

</body>
</html>
