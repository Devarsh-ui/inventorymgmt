    setVal('Specs_RearCameraCount', document.getElementById('m_RearCamCount').value);
    setVal('Specs_PrimaryRearCameraMp', document.getElementById('m_RearCam').value);
    setVal('Specs_UltrawideCameraMp', document.getElementById('m_UltrawideCam').value);
    setVal('Specs_TelephotoCameraMp', document.getElementById('m_TelephotoCam').value);
    setVal('Specs_FrontCameraCount', document.getElementById('m_FrontCamCount').value);
    setVal('Specs_FrontCameraMp', document.getElementById('m_FrontCam').value);
    setVal('Specs_CameraFeatures', document.getElementById('m_CamFeatures').value);

    setVal('Specs_BatteryCapacityMah', document.getElementById('m_BattCap').value);
    setVal('Specs_FastChargingWattage', document.getElementById('m_Wattage').value);
    setVal('Specs_WirelessCharging', document.getElementById('m_WirelessCharging').value === 'Yes');
    setVal('Specs_ChargingPortType', document.getElementById('m_Port').value);

    setVal('Specs_Network5G', document.getElementById('m_Network5G').value === 'Yes');
    setVal('Specs_Network4G', document.getElementById('m_Network4G').value === 'Yes');
    setVal('Specs_VoLte', document.getElementById('m_VoLte').value === 'Yes');
    setVal('Specs_SimType', document.getElementById('m_SimType').value);
    setVal('Specs_EsimSupport', document.getElementById('m_EsimSupport').value === 'Yes');

    setVal('Specs_WifiVersion', document.getElementById('m_WifiVer').value);
    setVal('Specs_BluetoothVersion', document.getElementById('m_BluetoothVer').value);
    setVal('Specs_Nfc', document.getElementById('m_Nfc').value === 'Yes');
    setVal('Specs_AudioFeatures', document.getElementById('m_AudioFeatures').value);

    setVal('Specs_OperatingSystem', document.getElementById('m_OS').value);
    setVal('Specs_OsVersion', document.getElementById('m_OSVer').value);
    setVal('Specs_FingerprintSensor', document.getElementById('m_Fingerprint').value);
    setVal('Specs_FaceUnlock', document.getElementById('m_FaceUnlock').value === 'Yes');

    setVal('Specs_WaterResistance', document.getElementById('m_WaterResistance').value);
    setVal('Specs_OfficialColors', document.getElementById('m_OfficialColors').value);
    setVal('Specs_DimensionsWeight', document.getElementById('m_DimensionsWeight').value);
    setVal('Specs_Sensors', document.getElementById('m_Sensors').value);

    const modalEl = document.getElementById('specReviewModal');
    const modalInstance = bootstrap.Modal.getInstance(modalEl);
    if (modalInstance) modalInstance.hide();

    if (window.showToast) window.showToast('All matching specifications applied to product form! Click Save Product to persist.', 'success');
}

function previewGalleryImgs(input) {
    const container = document.getElementById('gallery-preview-container');
    if (!container) return;
    container.innerHTML = '';
    if (input.files) {
        Array.from(input.files).slice(0, 50).forEach(file => {
            const reader = new FileReader();
            reader.onload = function(e) {
                const img = document.createElement('img');
                img.src = e.target.result;
                img.className = 'rounded border';
                img.style.cssText = 'width:50px;height:50px;object-fit:cover';
                container.appendChild(img);
            };
            reader.readAsDataURL(file);
        });
    }
}

let isAppleMode = false;

function setDeviceArchitectureMode(mode) {
    isAppleMode = (mode === 'apple');
    
    const btnStd = document.getElementById('btnModeStandard');
    const btnApple = document.getElementById('btnModeApple');
    const alertBox = document.getElementById('appleModeAlert');
    const introText = document.getElementById('variantsIntroText');

    if (btnStd && btnApple) {
        if (isAppleMode) {
            btnStd.style.cssText = "color: #cbd5e1 !important; background: rgba(255, 255, 255, 0.08) !important; border: 1px solid rgba(255, 255, 255, 0.2) !important; font-weight: 500 !important; cursor: pointer;";
            btnApple.style.cssText = "color: #000000 !important; background: #ffffff !important; border: 1px solid #ffffff !important; font-weight: 700 !important; box-shadow: 0 0 14px rgba(255, 255, 255, 0.45) !important; cursor: pointer;";
            if (alertBox) {
                alertBox.classList.remove('d-none');
                alertBox.classList.add('d-flex');
            }
            if (introText) {
                introText.textContent = 'Define sellable internal Storage capacities (e.g. 128GB, 256GB, 512GB, 1TB) and color options for this Apple device.';
                introText.style.color = '#ffffff';
            }
            const osSelect = document.getElementById('Specs_OperatingSystem');
            if (osSelect) osSelect.value = 'iOS';
        } else {
            btnApple.style.cssText = "color: #ffffff !important; background: rgba(255, 255, 255, 0.08) !important; border: 1px solid rgba(255, 255, 255, 0.28) !important; font-weight: 500 !important; cursor: pointer;";
            btnStd.style.cssText = "color: #ffffff !important; background: #2563eb !important; border: 1px solid #3b82f6 !important; font-weight: 700 !important; box-shadow: 0 0 12px rgba(37, 99, 235, 0.5) !important; cursor: pointer;";
            if (alertBox) {
                alertBox.classList.add('d-none');
                alertBox.classList.remove('d-flex');
            }
            if (introText) {
                introText.textContent = 'Define sellable RAM/Storage combinations and color options with color-specific product gallery images.';
                introText.style.color = 'rgba(255, 255, 255, 0.7)';
            }
        }
    }

    // Toggle RAM inputs in all existing variant cards
    document.querySelectorAll('.variant-ram-col').forEach(el => {
        if (isAppleMode) {
            el.classList.add('d-none');
            const inp = el.querySelector('input');
            if (inp) inp.value = '';
        } else {
            el.classList.remove('d-none');
        }
    });

    document.querySelectorAll('.variant-storage-col').forEach(el => {
        if (isAppleMode) {
            el.classList.remove('col-md-5');
            el.classList.add('col-md-10');
            const lbl = el.querySelector('.storage-label-text');
            if (lbl) lbl.textContent = 'Storage Capacity (128GB, 256GB, 512GB, 1TB, etc.)';
        } else {
            el.classList.remove('col-md-10');
            el.classList.add('col-md-5');
            const lbl = el.querySelector('.storage-label-text');
            if (lbl) lbl.textContent = 'Storage Capacity';
        }
    });

    // Hide RAM Type in Hardware Specs Performance Tab
    const ramTypeContainer = document.getElementById('ramTypeContainer');
    if (ramTypeContainer) {
        if (isAppleMode) {
            ramTypeContainer.classList.add('d-none');
            const rInput = ramTypeContainer.querySelector('input');
            if (rInput) rInput.value = '';
        } else {
            ramTypeContainer.classList.remove('d-none');
        }
    }

    // Hide RAM Type in Auto Spec Review Modal
    const modalRamTypeCol = document.getElementById('modalRamTypeCol');
    if (modalRamTypeCol) {
        if (isAppleMode) {
            modalRamTypeCol.classList.add('d-none');
            const mInput = document.getElementById('m_RamType');
            if (mInput) mInput.value = '';
        } else {
            modalRamTypeCol.classList.remove('d-none');
        }
    }
}

document.getElementById('productCreateForm')?.addEventListener('submit', function() {
    if (isAppleMode) {
        document.querySelectorAll('.variant-ram-col input').forEach(inp => {
            inp.value = '';
        });
        const rInput = document.getElementById('Specs_RamType');
        if (rInput) rInput.value = '';
        const osSelect = document.getElementById('Specs_OperatingSystem');
        if (osSelect) osSelect.value = 'iOS';
    }
});

function checkAutoDetectApple() {
    const brand = (document.getElementById('Brand')?.value || document.getElementById('autoSearchBrand')?.value || '').trim().toLowerCase();
    const model = (document.getElementById('ModelName')?.value || document.getElementById('autoSearchModel')?.value || '').trim().toLowerCase();
    const name = (document.getElementById('Name')?.value || '').trim().toLowerCase();
    const os = (document.getElementById('Specs_OperatingSystem')?.value || document.getElementById('m_OS')?.value || '').trim().toLowerCase();
    const catEl = document.getElementById('CategoryId') || document.querySelector('select[name="CategoryId"]');
    const catText = catEl && catEl.selectedIndex >= 0 ? (catEl.options[catEl.selectedIndex]?.text || '').trim().toLowerCase() : '';
    const prodType = (document.getElementById('productTypeSelect')?.value || '').trim().toLowerCase();

    if (brand.includes('apple') || model.includes('iphone') || model.includes('ipad') || 
        name.includes('iphone') || name.includes('ipad') || name.includes('apple') ||
        os.includes('ios') || os.includes('ipados') || 
        catText.includes('ios') || catText.includes('apple') ||
        prodType.includes('ios') || prodType.includes('apple')) {
        setDeviceArchitectureMode('apple');
    }
}

let variantCount = 0;

function addVariantCard(ram = '', storage = '', purPrice = '', sellPrice = '', initialStock = '0') {
    const vIndex = variantCount++;
    const container = document.getElementById('variantsContainer');
    if (!container) return;
    
    const ramColClass = isAppleMode ? 'd-none' : '';
    const storageColClass = isAppleMode ? 'col-md-10' : 'col-md-5';
    const storageLabel = isAppleMode ? 'Storage Capacity (128GB, 256GB, 512GB, 1TB, etc.)' : 'Storage Capacity';
    const effectiveRam = isAppleMode ? '' : ram;

    const cardHtml = `
    <div class="card border rounded p-3 bg-light-subtle shadow-sm" id="variantCard_${vIndex}">
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
            <h6 class="mb-0 fw-bold text-primary"><i class="bi bi-cpu me-2"></i>Variant ${vIndex + 1} Configuration</h6>
            <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeVariantCard(${vIndex})">
                <i class="bi bi-trash me-1"></i> Remove Variant
            </button>
        </div>
        <div class="row g-3">
            <div class="col-md-5 variant-ram-col ${ramColClass}" id="ramCol_${vIndex}">
                <label class="fg-label">RAM Config</label>
                <input type="text" name="Variants[${vIndex}].Ram" value="${effectiveRam}" class="fg-control" placeholder="e.g. 8GB, 12GB" />
            </div>
            <div class="${storageColClass} variant-storage-col" id="storageCol_${vIndex}">
                <label class="fg-label"><span class="storage-label-text">${storageLabel}</span> <span class="req">*</span></label>
                <input type="text" name="Variants[${vIndex}].Storage" value="${storage}" class="fg-control" placeholder="e.g. 128GB, 256GB, 512GB, 1TB" required />
            </div>
            <div class="col-md-2">
                <label class="fg-label">Initial Stock</label>
                <input type="number" name="Variants[${vIndex}].InitialStock" value="${initialStock}" class="fg-control" placeholder="0" min="0" />
            </div>
        </div>

        <div class="mt-4 pt-3 border-top">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="fw-bold small text-secondary"><i class="bi bi-palette me-1"></i>Color Options &amp; Images</span>
                <button type="button" class="btn btn-sm btn-outline-success" onclick="addColorRow(${vIndex})">
                    <i class="bi bi-plus-lg me-1"></i> Add Color
                </button>
            </div>
            <div id="colorsContainer_${vIndex}" class="d-flex flex-column gap-2 mt-2">
                <!-- Color rows populated here -->
            </div>
        </div>
    </div>`;

    container.insertAdjacentHTML('beforeend', cardHtml);
    addColorRow(vIndex);
}

function removeVariantCard(vIndex) {
    const card = document.getElementById(`variantCard_${vIndex}`);
    if (card) card.remove();
}

function addColorRow(vIndex, colorName = '', colorCode = '', initialStock = '0', purPrice = '', sellPrice = '') {
    const colorContainer = document.getElementById(`colorsContainer_${vIndex}`);
    if (!colorContainer) return;
    const cIndex = colorContainer.children.length;

    const colorHtml = `
    <div class="row g-2 align-items-center p-2 rounded border bg-white" id="colorRow_${vIndex}_${cIndex}">
        <div class="col-md-2">
            <input type="text" name="Variants[${vIndex}].Colors[${cIndex}].Name" value="${colorName}" class="fg-control form-control-sm" placeholder="Color Name" required />
        </div>
        <div class="col-md-1">
            <div class="d-flex align-items-center gap-1">
                <input type="color" name="Variants[${vIndex}].Colors[${cIndex}].Code" value="${colorCode || '#000000'}" class="form-control form-control-color form-control-sm" title="Choose color swatch" style="width:34px;height:31px;padding:2px" />
            </div>
        </div>
        <div class="col-md-2">
            <input type="number" step="0.01" name="Variants[${vIndex}].Colors[${cIndex}].PurchasePrice" value="${purPrice}" class="fg-control form-control-sm" placeholder="Wholesale Price (₹)" min="0" title="Wholesale / Supplier Price for this color" />
        </div>
        <div class="col-md-2">
            <input type="number" step="0.01" name="Variants[${vIndex}].Colors[${cIndex}].SellingPrice" value="${sellPrice}" class="fg-control form-control-sm" placeholder="Retail Price (₹)" min="0" title="Retail Price for this color" />
        </div>
        <div class="col-md-2">
            <input type="number" name="Variants[${vIndex}].Colors[${cIndex}].InitialStock" value="${initialStock}" class="fg-control form-control-sm" placeholder="Initial Stock" min="0" title="Initial Stock for this color" />
        </div>
        <div class="col-md-2">
            <label class="btn btn-sm btn-outline-secondary mb-0 w-100 text-truncate">
                <i class="bi bi-upload me-1"></i> Images
                <input type="file" name="Variants[${vIndex}].Colors[${cIndex}].ImageFiles" multiple accept="image/*" class="d-none" onchange="updateColorFileBadge(this)" />
            </label>
            <span class="badge bg-light text-dark border color-file-badge mt-1 d-none">0 files</span>
        </div>
        <div class="col-md-1 text-end">
            <button type="button" class="btn btn-sm btn-link text-danger p-0" onclick="this.closest('.row').remove()">
                <i class="bi bi-x-circle fs-6"></i>
            </button>
        </div>
    </div>`;

    colorContainer.insertAdjacentHTML('beforeend', colorHtml);
}

function updateColorFileBadge(input) {
    const badge = input.closest('.row').querySelector('.color-file-badge');
    if (badge && input.files) {
        badge.textContent = `${input.files.length} images selected`;
        badge.classList.remove('d-none');
    }
}

document.addEventListener('DOMContentLoaded', function() {
    const container = document.getElementById('variantsContainer');
    if (container && container.children.length === 0) {
        addVariantCard();
    }

    // Auto-detect Apple/iOS on inputs
    ['Brand', 'autoSearchBrand', 'ModelName', 'autoSearchModel', 'Name', 'Specs_OperatingSystem', 'm_OS', 'CategoryId', 'productTypeSelect'].forEach(id => {
        const el = document.getElementById(id);
        if (el) {
            el.addEventListener('input', checkAutoDetectApple);
            el.addEventListener('change', checkAutoDetectApple);
        }
    });
    checkAutoDetectApple();
});
</script>
}
