    setVal('Specs_CpuCores', document.getElementById('m_CpuCores').value);
    setVal('Specs_CpuClockSpeed', document.getElementById('m_CpuClockSpeed').value);
    setVal('Specs_Gpu', document.getElementById('m_Gpu').value);

    if (isAppleMode) {
        setVal('Specs_RamType', '');
    } else {
        setVal('Specs_RamType', document.getElementById('m_RamType').value);
    }
    setVal('Specs_StorageType', document.getElementById('m_StorageType').value);
    setVal('Specs_ExpandableStorage', document.getElementById('m_ExpandableStorage').value === 'Yes');
    setVal('Specs_MaxExpandableStorage', document.getElementById('m_MaxExpandableStorage').value);

    setVal('Specs_DisplaySize', document.getElementById('m_DispSize').value);
    setVal('Specs_DisplayType', document.getElementById('m_DispType').value);
    setVal('Specs_Resolution', document.getElementById('m_Resolution').value);
    setVal('Specs_RefreshRate', document.getElementById('m_RefreshRate').value);
    setVal('Specs_ScreenProtection', document.getElementById('m_ScreenProtection').value);
