@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
function toggleHardwareTabs(type) {
    const card = document.getElementById('hardwareSpecsCard');
    const isImei = document.getElementById('isImeiSelect');

    const accessoryTypes = ['Charger', 'Cable', 'Mobile Cover', 'Tempered Glass', 'Earphones', 'Headphones', 'Power Bank', 'Memory Card', 'Speaker', 'Other'];
    if (accessoryTypes.includes(type)) {
        card.style.display = 'none';
        if (isImei) isImei.value = 'false';
    } else {
        card.style.display = 'block';
        if (isImei) isImei.value = 'true';
    }
}

document.addEventListener('DOMContentLoaded', function() {
    const sel = document.getElementById('productTypeSelect');
    if (sel) toggleHardwareTabs(sel.value);
});

function previewImg(input) {
  if (!input.files[0]) return;
  const reader = new FileReader();
  reader.onload = e => { document.getElementById('image-preview').src = e.target.result; };
  reader.readAsDataURL(input.files[0]);
}

function generateSKU() {
  const nameInput = document.getElementById('Name');
  const codeInput = document.getElementById('Code');
  let prefix = 'MOB';

  if (nameInput && nameInput.value.trim()) {
    const words = nameInput.value.trim().split(/\s+/);
    if (words.length >= 2) {
      prefix = (words[0][0] + words[1][0] + (words[2] ? words[2][0] : words[1][1] || 'X')).toUpperCase();
    } else if (words[0].length >= 3) {
      prefix = words[0].substring(0, 3).toUpperCase();
    }
  }

  const randomNum = Math.floor(100 + Math.random() * 900);
  const sku = `${prefix}-${randomNum}`;
  if (codeInput) {
    codeInput.value = sku;
    if (window.showToast) window.showToast(`Generated SKU: ${sku}`, 'success');
  }
}

function generateBarcode() {
  const barcodeInput = document.getElementById('Barcode');
  const prefix = '890';
  let middle = '';
  for (let i = 0; i < 9; i++) {
    middle += Math.floor(Math.random() * 10);
  }
  const barcode = prefix + middle;
  if (barcodeInput) {
    barcodeInput.value = barcode;
    if (window.showToast) window.showToast(`Generated Barcode: ${barcode}`, 'success');
  }
}

let activeSpecResult = null;

async function searchOnlineSpecs(allowThirdParty = false) {
    const brand = document.getElementById('autoSearchBrand')?.value || document.getElementById('Brand')?.value || '';
    const modelName = document.getElementById('autoSearchModel')?.value || document.getElementById('ModelName')?.value || document.getElementById('Name')?.value || '';
    const variant = document.getElementById('autoSearchVariant')?.value || '';

    if (!brand.trim() && !modelName.trim()) {
        alert('Please enter at least a Brand or Model Name to search specifications.');
        return;
    }

    const modeText = allowThirdParty ? 'Searching trusted third-party reference sources...' : 'Searching official manufacturer website...';
    if (window.showToast) window.showToast(modeText, 'info');

    try {
        const url = `/SupplierDashboard/SearchSpecsOnline?brand=${encodeURIComponent(brand)}&modelName=${encodeURIComponent(modelName)}&variant=${encodeURIComponent(variant)}&allowThirdPartyFallback=${allowThirdParty}`;
        const response = await fetch(url);
        const data = await response.json();

        activeSpecResult = data;
        populateModalWithSpecs(data);

        const modalEl = document.getElementById('specReviewModal');
        const bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
        bsModal.show();

    } catch (err) {
        console.error('Spec search error:', err);
        alert('Error searching specifications. You can continue by entering details manually.');
    }
}

function toggleDirectUrlMode() {
    const box = document.getElementById('directUrlBannerInput');
    box.classList.toggle('d-none');
    if (!box.classList.contains('d-none')) {
        document.getElementById('directBannerUrl').focus();
    }
}

async function extractFromBannerUrl() {
    const customUrl = document.getElementById('directBannerUrl').value.trim();
    if (!customUrl) {
        alert('Please enter or paste a valid specification page URL.');
        return;
    }

    const brand = document.getElementById('autoSearchBrand')?.value || document.getElementById('Brand')?.value || '';
    const modelName = document.getElementById('autoSearchModel')?.value || document.getElementById('ModelName')?.value || document.getElementById('Name')?.value || '';

    if (window.showToast) window.showToast('Extracting specifications from provided URL...', 'info');

    try {
        const url = `/SupplierDashboard/SearchSpecsOnline?brand=${encodeURIComponent(brand)}&modelName=${encodeURIComponent(modelName)}&customUrl=${encodeURIComponent(customUrl)}`;
        const response = await fetch(url);
        const data = await response.json();

        activeSpecResult = data;
        populateModalWithSpecs(data);

        const modalEl = document.getElementById('specReviewModal');
        const bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
        bsModal.show();
    } catch (err) {
        alert('Failed to extract specifications from URL.');
    }
}

function populateModalWithSpecs(data) {
    const specs = data.extractedSpecs || {};
    const fallbackBox = document.getElementById('modalFallbackNoticeBox');

    const b = ((data.brand || document.getElementById('autoSearchBrand')?.value || document.getElementById('Brand')?.value || '')).toLowerCase();
    const os = ((specs.operatingSystem || '')).toLowerCase();
    const m = ((data.modelName || document.getElementById('autoSearchModel')?.value || document.getElementById('ModelName')?.value || '')).toLowerCase();
    if (b.includes('apple') || os.includes('ios') || os.includes('ipados') || m.includes('iphone') || m.includes('ipad')) {
        setDeviceArchitectureMode('apple');
        specs.ramType = '';
    }

    const total = data.totalFieldsCount || 44;
    const populated = data.populatedFieldsCount || 0;
    const official = data.officialFieldsCount || 0;
    const unavailable = data.unavailableFieldsCount || (total - populated);

    document.getElementById('modalStatsPill').innerText = `Specifications Found: ${populated} / ${total}`;
    document.getElementById('modalOfficialCountPill').innerText = `Official: ${official}`;
    document.getElementById('modalUnavailablePill').innerText = `Unavailable: ${unavailable}`;
    
    if (!data.success) {
        fallbackBox.classList.remove('d-none');
        document.getElementById('modalSourceBadge').className = 'badge rounded-pill bg-danger fs-6 px-3 py-2';
        document.getElementById('modalSourceBadge').innerText = '🔴 Not Found on Official Site';
        document.getElementById('modalConfidenceReason').innerText = data.errorMessage || 'Official manufacturer page not found.';
    } else {
        fallbackBox.classList.add('d-none');
        const isOfficial = data.primarySourceType === 'Official Manufacturer';
        document.getElementById('modalSourceBadge').className = isOfficial ? 'badge rounded-pill bg-success fs-6 px-3 py-2' : 'badge rounded-pill bg-warning text-dark fs-6 px-3 py-2';
        document.getElementById('modalSourceBadge').innerText = isOfficial ? '🟢 Official Manufacturer' : '🟡 Third-Party Source';
        document.getElementById('modalConfidenceReason').innerText = data.confidenceReason || '';
    }

    document.getElementById('modalConfidenceBadge').innerText = data.confidenceMatch === 'High' ? 'High Match' : 'Needs Verification';

    const sourceLinksDiv = document.getElementById('modalSourceLinks');
    if (data.sourceWebsites && data.sourceWebsites.length > 0) {
        sourceLinksDiv.innerHTML = data.sourceWebsites.map(s => `<a href="${s.url}" target="_blank" class="badge bg-secondary text-decoration-none me-1">${s.siteName} <i class="bi bi-box-arrow-up-right ms-1"></i></a>`).join('');
    } else {
        sourceLinksDiv.innerHTML = '<span class="text-muted">No Direct Link</span>';
    }

    document.getElementById('m_ProcBrand').value = specs.processorBrand || '';
    document.getElementById('m_ProcName').value = specs.processorName || '';
    document.getElementById('m_Chipset').value = specs.chipsetModel || specs.chipset || '';
    document.getElementById('m_CpuCores').value = specs.cpuCores || '';
    document.getElementById('m_CpuClockSpeed').value = specs.cpuClockSpeed || '';
    document.getElementById('m_Gpu').value = specs.gpu || '';

    document.getElementById('m_RamType').value = specs.ramType || '';
    document.getElementById('m_StorageType').value = specs.storageType || '';
    document.getElementById('m_ExpandableStorage').value = specs.expandableStorage ? 'Yes' : 'No';
    document.getElementById('m_MaxExpandableStorage').value = specs.maxExpandableStorage || '';

    document.getElementById('m_DispSize').value = specs.displaySize || '';
    document.getElementById('m_DispType').value = specs.displayType || '';
    document.getElementById('m_Resolution').value = specs.resolution || '';
    document.getElementById('m_RefreshRate').value = specs.refreshRate || '';
    document.getElementById('m_ScreenProtection').value = specs.screenProtection || '';
    document.getElementById('m_Touchscreen').value = specs.touchscreen ? 'Yes' : 'No';

    document.getElementById('m_RearCamCount').value = specs.rearCameraCount || 3;
    document.getElementById('m_RearCam').value = specs.primaryRearCameraMp || '';
    document.getElementById('m_UltrawideCam').value = specs.ultrawideCameraMp || '';
    document.getElementById('m_TelephotoCam').value = specs.telephotoCameraMp || '';
    document.getElementById('m_FrontCamCount').value = specs.frontCameraCount || 1;
    document.getElementById('m_FrontCam').value = specs.frontCameraMp || '';
    document.getElementById('m_CamFeatures').value = specs.cameraFeatures || '';

    document.getElementById('m_BattCap').value = specs.batteryCapacityMah || '';
    document.getElementById('m_Wattage').value = specs.fastChargingWattage || '';
    document.getElementById('m_WirelessCharging').value = specs.wirelessCharging ? 'Yes' : 'No';
    document.getElementById('m_Port').value = specs.chargingPortType || '';

    document.getElementById('m_Network5G').value = specs.network5G ? 'Yes' : 'No';
    document.getElementById('m_Network4G').value = specs.network4G ? 'Yes' : 'No';
    document.getElementById('m_VoLte').value = specs.voLte ? 'Yes' : 'No';
    document.getElementById('m_SimType').value = specs.simType || '';
    document.getElementById('m_EsimSupport').value = specs.esimSupport ? 'Yes' : 'No';

    document.getElementById('m_WifiVer').value = specs.wifiVersion || '';
    document.getElementById('m_BluetoothVer').value = specs.bluetoothVersion || '';
    document.getElementById('m_Nfc').value = specs.nfc ? 'Yes' : 'No';
    document.getElementById('m_AudioFeatures').value = specs.audioFeatures || '';

    document.getElementById('m_OS').value = specs.operatingSystem || '';
    document.getElementById('m_OSVer').value = specs.osVersion || '';
    document.getElementById('m_Fingerprint').value = specs.fingerprintSensor || '';
    document.getElementById('m_FaceUnlock').value = specs.faceUnlock ? 'Yes' : 'No';

    document.getElementById('m_WaterResistance').value = specs.waterResistance || '';
    document.getElementById('m_OfficialColors').value = specs.officialColors || '';
    document.getElementById('m_DimensionsWeight').value = specs.dimensionsWeight || '';
    document.getElementById('m_Sensors').value = specs.sensors || '';
}

async function applyModalSpecsToForm() {
    const setVal = (id, val) => {
        const el = document.getElementById(id);
        if (el && val !== undefined && val !== null && val !== '') el.value = val;
    };

    const brandVal = (activeSpecResult && activeSpecResult.brand) || document.getElementById('autoSearchBrand')?.value || document.getElementById('m_ProcBrand')?.value || '';
    const modelVal = (activeSpecResult && activeSpecResult.modelName) || document.getElementById('autoSearchModel')?.value || '';
    const variantVal = (activeSpecResult && activeSpecResult.variant) || document.getElementById('autoSearchVariant')?.value || '';
    const colorVal = document.getElementById('m_OfficialColors')?.value || '';

    if (brandVal) setVal('Brand', brandVal);
    if (modelVal) setVal('ModelName', modelVal);
    if (variantVal) setVal('Variant', variantVal);
    if (colorVal) setVal('Color', colorVal);

    const nameEl = document.getElementById('Name');
    if (nameEl) {
        const titleParts = [brandVal, modelVal, variantVal].filter(Boolean).join(' ');
        if (titleParts && (!nameEl.value.trim() || nameEl.value === 'Smartphone')) {
            nameEl.value = titleParts;
        }
    }

    const codeEl = document.getElementById('Code');
    if (codeEl && !codeEl.value.trim()) generateSKU();

