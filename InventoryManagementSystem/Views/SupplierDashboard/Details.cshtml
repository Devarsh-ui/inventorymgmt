@model InventoryManagementSystem.Models.Product
@{
    ViewData["Title"] = $"{Model.Name} - Supplier Product Details";
    var images = new List<string>();
    if (!string.IsNullOrEmpty(Model.ImageUrl)) images.Add(Model.ImageUrl);
    if (Model.ImageUrls != null)
    {
        foreach (var img in Model.ImageUrls)
        {
            if (!images.Contains(img)) images.Add(img);
        }
    }
    var specs = Model.Specs ?? new InventoryManagementSystem.Models.MobileSpecifications();
}

<!-- Page Header -->
<div class="ph">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge-d badge-gray" style="font-size:12px">@Model.Brand</span>
            <span class="badge-d @(Model.Status == "Active" ? "badge-success" : "badge-gray")" style="font-size:12px">@Model.Status</span>
            <span class="code-pill" style="font-size:12px">SKU: @Model.Code</span>
        </div>
        <h1 class="ph-title"><i class="bi bi-box-seam me-2" style="color:var(--primary)"></i>@Model.Name</h1>
        <p class="ph-sub">Supplied Item Details · @Model.DisplayVariant · Color: @(string.IsNullOrEmpty(Model.Color) ? "-" : Model.Color)</p>
    </div>
    <div class="ph-actions">
        <a href="@Url.Action("EditProduct", "SupplierDashboard", new { id = Model.Id })" class="btn-d btn-primary">
            <i class="bi bi-pencil me-1"></i> Edit Supplied Product
        </a>
        <a href="@Url.Action("Products", "SupplierDashboard")" class="btn-d btn-outline">
            <i class="bi bi-arrow-left me-1"></i> Back to Catalog
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Left Column: Interactive Multi-Image Gallery -->
    <div class="col-lg-5">
        <div class="card-d card-p-lg h-100 style-img-gallery" style="background:var(--bg-card);border:1px solid var(--border)">
            <div class="s-title mb-3"><i class="bi bi-images me-2 text-info"></i>Product Gallery (@images.Count Images)</div>

            @if (images.Any())
            {
                <div class="main-img-wrap text-center p-3 rounded mb-3 position-relative" style="background:var(--bg);border:1px solid var(--border);min-height:300px;display:flex;align-items:center;justify-content:center">
                    <img id="mainDisplayImg" src="@images.First()" alt="@Model.Name" class="img-fluid rounded" style="max-height:320px;object-fit:contain;transition:all 0.3s ease" />
                </div>

                @if (images.Count > 1)
                {
                    <div class="d-flex flex-wrap gap-2 overflow-auto py-2" style="max-height:160px">
                        @for (int idx = 0; idx < images.Count; idx++)
                        {
                            var url = images[idx];
                            <img src="@url" alt="Thumb @idx" class="thumb-img rounded @(idx == 0 ? "active-thumb" : "")"
                                 onclick="switchMainImg('@url', this)"
                                 style="width:60px;height:60px;object-fit:cover;cursor:pointer;border:2px solid var(--border);transition:all 0.2s" />
                        }
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5 text-muted rounded style-no-img" style="background:var(--bg);border:1px dashed var(--border)">
                    <i class="bi bi-image text-muted d-block mb-2" style="font-size:40px"></i>
                    No product photos uploaded.
                </div>
            }
        </div>
    </div>

    <!-- Right Column: Commercial Metrics & Quick Specs -->
    <div class="col-lg-7">
        <div class="row g-3 mb-4">
            <div class="col-sm-4">
                <div class="card-d card-p text-center" style="background:var(--bg-card);border:1px solid var(--border)">
                    <div style="font-size:11px;color:var(--text-muted)">Wholesale Price</div>
                    <div style="font-size:22px;font-weight:800;color:var(--primary)">₹@((Model.SupplierPrice > 0 ? Model.SupplierPrice : Model.PurchasePrice).ToString("N2"))</div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="card-d card-p text-center" style="background:var(--bg-card);border:1px solid var(--border)">
                    <div style="font-size:11px;color:var(--text-muted)">Suggested Retail</div>
                    <div style="font-size:22px;font-weight:800;color:var(--success)">₹@Model.SellingPrice.ToString("N2")</div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="card-d card-p text-center" style="background:var(--bg-card);border:1px solid var(--border)">
                    <div style="font-size:11px;color:var(--text-muted)">Available Stock Qty</div>
                    <div style="font-size:22px;font-weight:800;color:var(--text-primary)">
                        @Model.CurrentStock Units
                    </div>
                </div>
            </div>
        </div>

        <div class="card-d card-p-lg" style="background:var(--bg-card);border:1px solid var(--border)">
            <!-- Spec Tabs Navigation -->
            <ul class="nav nav-tabs border-bottom mb-3" id="specTabs" role="tablist" style="border-color:var(--border)!important">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="tab-overview" data-bs-toggle="tab" data-bs-target="#spec-overview" type="button" role="tab"><i class="bi bi-info-circle me-1"></i> Overview</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-perf" data-bs-toggle="tab" data-bs-target="#spec-perf" type="button" role="tab"><i class="bi bi-cpu me-1"></i> Performance</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-display" data-bs-toggle="tab" data-bs-target="#spec-display" type="button" role="tab"><i class="bi bi-camera me-1"></i> Display & Camera</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-battery" data-bs-toggle="tab" data-bs-target="#spec-battery" type="button" role="tab"><i class="bi bi-battery-charging me-1"></i> Battery & Network</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-os" data-bs-toggle="tab" data-bs-target="#spec-os" type="button" role="tab"><i class="bi bi-shield-check me-1"></i> OS & Features</button>
                </li>
            </ul>

            <div class="tab-content" id="specTabsContent">
                <!-- Tab 1: Overview -->
                <div class="tab-pane fade show active" id="spec-overview" role="tabpanel">
                    <div class="row g-3">
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Brand</div><div style="font-weight:700">@Model.Brand</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Model Name</div><div style="font-weight:700">@Model.ModelName</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Category</div><div style="font-weight:700">@ViewBag.CategoryName</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Variant / Configuration</div><div style="font-weight:700">@Model.DisplayVariant</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Color</div><div style="font-weight:700">@(string.IsNullOrEmpty(Model.Color) ? "-" : Model.Color)</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Barcode</div><div style="font-weight:700">@(string.IsNullOrEmpty(Model.Barcode) ? "-" : Model.Barcode)</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Supplier Price</div><div style="font-weight:700;color:var(--primary)">₹@((Model.SupplierPrice > 0 ? Model.SupplierPrice : Model.PurchasePrice).ToString("N2"))</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Retail Price</div><div style="font-weight:700;color:var(--success)">₹@Model.SellingPrice.ToString("N2")</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Warranty Period</div><div style="font-weight:700">@Model.WarrantyDurationMonths Months</div></div>
                    </div>
                </div>

                <!-- Tab 2: Performance -->
                <div class="tab-pane fade" id="spec-perf" role="tabpanel">
                    <div class="row g-3">
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Processor / Chipset</div><div style="font-weight:700">@(string.IsNullOrEmpty(specs.ProcessorName) ? Model.Processor : specs.ProcessorName)</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">CPU Cores & Speed</div><div style="font-weight:700">@(string.IsNullOrEmpty(specs.CpuCores) ? "-" : specs.CpuCores)</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">GPU Graphics</div><div style="font-weight:700">@(string.IsNullOrEmpty(specs.Gpu) ? "-" : specs.Gpu)</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">RAM Type / GB</div><div style="font-weight:700">@(string.IsNullOrEmpty(specs.RamType) ? (!string.IsNullOrEmpty(Model.Ram) ? Model.Ram : "N/A (iOS/Standard)") : specs.RamType)</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Storage Type / GB</div><div style="font-weight:700">@(string.IsNullOrEmpty(specs.StorageType) ? Model.Storage : specs.StorageType)</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Expandable Storage Slot</div><div style="font-weight:700">@(specs.ExpandableStorage ? "Yes Supported" : "No Expandable Slot")</div></div>
                    </div>
                </div>

                <!-- Tab 3: Display & Camera -->
                <div class="tab-pane fade" id="spec-display" role="tabpanel">
                    <div class="row g-3">
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Display Screen Size</div><div style="font-weight:700">@(string.IsNullOrEmpty(specs.DisplaySize) ? Model.DisplaySize : specs.DisplaySize)</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Screen Resolution</div><div style="font-weight:700">@(string.IsNullOrEmpty(specs.Resolution) ? "-" : specs.Resolution)</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Refresh Rate</div><div style="font-weight:700">@(string.IsNullOrEmpty(specs.RefreshRate) ? "-" : specs.RefreshRate)</div></div>
                        <div class="col-6 col-md-6"><div style="font-size:11px;color:var(--text-muted)">Rear Main Camera</div><div style="font-weight:700">@(string.IsNullOrEmpty(specs.PrimaryRearCameraMp) ? "-" : specs.PrimaryRearCameraMp)</div></div>
                        <div class="col-6 col-md-6"><div style="font-size:11px;color:var(--text-muted)">Front Selfie Camera</div><div style="font-weight:700">@(string.IsNullOrEmpty(specs.FrontCameraMp) ? "-" : specs.FrontCameraMp)</div></div>
                    </div>
                </div>

                <!-- Tab 4: Battery & Network -->
                <div class="tab-pane fade" id="spec-battery" role="tabpanel">
                    <div class="row g-3">
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Battery Capacity</div><div style="font-weight:700">@(specs.BatteryCapacityMah > 0 ? $"{specs.BatteryCapacityMah} mAh" : Model.BatteryCapacity)</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Fast Charging Speed</div><div style="font-weight:700">@(string.IsNullOrEmpty(specs.FastChargingWattage) ? "-" : specs.FastChargingWattage)</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Network 5G Support</div><div style="font-weight:700">@(specs.Network5G ? "5G Supported" : "4G / LTE")</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">SIM Card Type</div><div style="font-weight:700">@(string.IsNullOrEmpty(specs.SimType) ? Model.SimType : specs.SimType)</div></div>
                    </div>
                </div>

                <!-- Tab 5: OS & Security -->
                <div class="tab-pane fade" id="spec-os" role="tabpanel">
                    <div class="row g-3">
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Operating System</div><div style="font-weight:700">@(string.IsNullOrEmpty(specs.OperatingSystem) ? Model.OperatingSystem : specs.OperatingSystem)</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Chipset Model</div><div style="font-weight:700">@(string.IsNullOrEmpty(specs.Chipset) ? "-" : specs.Chipset)</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Biometric Security</div><div style="font-weight:700">@(string.IsNullOrEmpty(specs.FingerprintSensor) ? "-" : specs.FingerprintSensor)</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">IP Water & Dust Protection</div><div style="font-weight:700">@(string.IsNullOrEmpty(specs.WaterResistance) ? "-" : specs.WaterResistance)</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">NFC & Bluetooth</div><div style="font-weight:700">@(specs.Nfc ? "NFC Available" : "Bluetooth")</div></div>
                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Audio & Speakers</div><div style="font-weight:700">@(string.IsNullOrEmpty(specs.AudioFeatures) ? "-" : specs.AudioFeatures)</div></div>
                    </div>
                </div>
            </div>

            <hr class="s-divider my-4" />

            <div class="fg mb-0">
                <label class="fg-label text-muted">Complete Description & Technical Notes</label>
                <div class="p-3 rounded" style="background:var(--bg);border:1px solid var(--border);font-size:13px;line-height:1.6;color:var(--text-primary)">
                    @(string.IsNullOrWhiteSpace(Model.Description) ? "No additional product description or notes specified." : Model.Description)
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .thumb-img:hover, .active-thumb {
        border-color: var(--primary) !important;
        transform: scale(1.05);
    }
</style>

@section Scripts {
    <script>
        function switchMainImg(url, el) {
            const mainImg = document.getElementById('mainDisplayImg');
            if (mainImg) mainImg.src = url;

            document.querySelectorAll('.thumb-img').forEach(t => t.classList.remove('active-thumb'));
            if (el) el.classList.add('active-thumb');
        }
    </script>
}
