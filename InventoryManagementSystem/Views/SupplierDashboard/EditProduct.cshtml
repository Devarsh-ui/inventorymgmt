@model ProductEditViewModel
@{
    ViewData["Title"] = "Edit Supplier Product — Catalog";
}

<div class="ph">
    <div>
        <h1 class="ph-title"><i class="bi bi-pencil-square me-2" style="color:var(--primary)"></i>Edit Supplier Product Details</h1>
        <p class="ph-sub">Update smartphone or accessory model hardware specifications, pricing, and status.</p>
    </div>
    <div class="ph-actions">
        <a href="@Url.Action("Products","SupplierDashboard")" class="btn-d btn-outline">
            <i class="bi bi-arrow-left"></i> Back to Catalog
        </a>
    </div>
</div>

<form asp-action="EditProduct" method="post" enctype="multipart/form-data" id="productEditForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Code" />
    <input type="hidden" asp-for="Barcode" />
    <input type="hidden" asp-for="CurrentImageUrl" />

    <!-- Automatic Mobile Specification Finder Banner -->
    <div class="card-d mb-4 border-primary shadow-sm" style="background: linear-gradient(135deg, rgba(25, 135, 84, 0.05), rgba(13, 202, 240, 0.05)); border: 1px solid rgba(25, 135, 84, 0.3);">
        <div class="card-body p-3">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                <div>
                    <h6 class="mb-1 text-success font-weight-bold"><i class="bi bi-shield-check me-2"></i>Official-Manufacturer-First Specification Finder</h6>
                    <p class="text-muted small mb-0">Search official technical specs automatically or paste a direct specification URL below.</p>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-outline-info" onclick="toggleDirectUrlMode()">
                        <i class="bi bi-link-45deg me-1"></i> Paste Spec URL
                    </button>
                    <button type="button" class="btn btn-sm btn-success" onclick="searchOnlineSpecs(false)">
                        <i class="bi bi-search me-1"></i> Search Official Specs
                    </button>
                </div>
            </div>

            <div class="row g-2 align-items-center" id="standardSearchInputs">
                <div class="col-md-4">
                    <input type="text" id="autoSearchBrand" class="fg-control form-control-sm" value="@Model.Brand" placeholder="Brand">
                </div>
                <div class="col-md-5">
                    <input type="text" id="autoSearchModel" class="fg-control form-control-sm" value="@Model.ModelName" placeholder="Model Name">
                </div>
                <div class="col-md-3">
                    <input type="text" id="autoSearchVariant" class="fg-control form-control-sm" value="@Model.Variant" placeholder="Variant">
                </div>
            </div>

            <div class="row g-2 align-items-center mt-2 d-none" id="directUrlBannerInput">
                <div class="col-md-9">
                    <input type="url" id="directBannerUrl" class="form-control form-control-sm" placeholder="Paste Direct Specification Page URL">
                </div>
                <div class="col-md-3">
                    <button type="button" class="btn btn-info text-white btn-sm w-100" onclick="extractFromBannerUrl()">
                        <i class="bi bi-download me-1"></i> Extract Specs from URL
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Main Form Column -->
        <div class="col-lg-8">
            <div class="card-d card-p-lg mb-4">
                <div class="s-title"><i class="bi bi-phone me-2" style="color:var(--primary)"></i>Product Classification &amp; Basic Info</div>
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="alert-d alert-danger mb-4"></div>
                }

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="fg">
                            <label class="fg-label">Product Type / Category <span class="req">*</span></label>
                            <select name="ProductType" id="productTypeSelect" class="fg-control" onchange="toggleHardwareTabs(this.value)" required>
                                <option value="Smartphone" selected="@(Model.ProductType == "Smartphone")">Smartphone (IMEI Tracked)</option>
                                <option value="Feature Phone" selected="@(Model.ProductType == "Feature Phone")">Feature Phone (IMEI Tracked)</option>
                                <option value="Tablet" selected="@(Model.ProductType == "Tablet")">Tablet (IMEI / Serial Tracked)</option>
                                <option value="Smartwatch" selected="@(Model.ProductType == "Smartwatch")">Smartwatch</option>
                                <option value="Charger" selected="@(Model.ProductType == "Charger")">Charger / Adapter</option>
                                <option value="Cable" selected="@(Model.ProductType == "Cable")">Cable / Converter</option>
                                <option value="Mobile Cover" selected="@(Model.ProductType == "Mobile Cover")">Mobile Cover / Case</option>
                                <option value="Tempered Glass" selected="@(Model.ProductType == "Tempered Glass")">Tempered Glass Screen Guard</option>
                                <option value="Earphones" selected="@(Model.ProductType == "Earphones")">Earphones / TWS Earbuds</option>
                                <option value="Headphones" selected="@(Model.ProductType == "Headphones")">Headphones</option>
                                <option value="Power Bank" selected="@(Model.ProductType == "Power Bank")">Power Bank</option>
                                <option value="Memory Card" selected="@(Model.ProductType == "Memory Card")">Memory Card / Flash Drive</option>
                                <option value="Speaker" selected="@(Model.ProductType == "Speaker")">Bluetooth Speaker</option>
                                <option value="Other" selected="@(Model.ProductType == "Other")">Other Mobile Accessory</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="fg">
                            <label class="fg-label" asp-for="Name">Product / Model Title <span class="req">*</span></label>
                            <input asp-for="Name" id="Name" class="fg-control" required>
                            <span asp-validation-for="Name" class="fg-error"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="fg">
                            <label class="fg-label" asp-for="Brand">Brand</label>
                            <input asp-for="Brand" id="Brand" class="fg-control">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="fg">
                            <label class="fg-label" asp-for="ModelName">Model Name</label>
                            <input asp-for="ModelName" id="ModelName" class="fg-control">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="fg">
                            <label class="fg-label">Warranty (Months)</label>
                            <input type="number" name="WarrantyDurationMonths" value="12" class="fg-control">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="fg">
                            <label class="fg-label">Requires IMEI Tracking?</label>
                            <select name="IsImeiRequired" id="isImeiSelect" class="fg-control">
                                <option value="true" selected>Yes — IMEI Tracked Device</option>
                                <option value="false">No — Quantity-based Accessory</option>
                            </select>
                        </div>
                    </div>



                    <div class="col-md-6">
                        <div class="fg">
                            <label class="fg-label" asp-for="CategoryId">Category <span class="req">*</span></label>
                            <select asp-for="CategoryId" asp-items="Model.Categories" class="fg-control" required>
                                <option value="">— Select Category —</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="fg-error"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="fg">
                            <label class="fg-label" asp-for="Status">Status</label>
                            <select asp-for="Status" class="fg-control">
                                <option value="Active" selected="@(Model.Status == "Active")">Active</option>
                                <option value="Inactive" selected="@(Model.Status == "Inactive")">Inactive</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="fg">
                            <label class="fg-label" asp-for="MinimumStock">Minimum Safety Stock <span class="req">*</span></label>
                            <input asp-for="MinimumStock" class="fg-control" type="number" min="0" required>
                            <span asp-validation-for="MinimumStock" class="fg-error"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Variants & Colors Card -->
            <div class="card-d card-p-lg mb-4" id="variantsColorsCard">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                    <div class="s-title mb-0 text-white"><i class="bi bi-layers me-2 text-primary"></i>Variants, Colors &amp; Images</div>
                    <div class="d-flex align-items-center gap-2">
                        <div class="btn-group btn-group-sm p-1 rounded-3" role="group" aria-label="Device Architecture" style="background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.2);">
                            <button type="button" class="btn btn-sm rounded-2 px-3 fw-semibold transition-all" id="btnModeStandard" onclick="setDeviceArchitectureMode('standard')" style="color: #ffffff; background: #2563eb; border: 1px solid #3b82f6; box-shadow: 0 0 12px rgba(37, 99, 235, 0.5);">
                                <i class="bi bi-phone me-1"></i> Standard / Android (RAM + Storage)
                            </button>
                            <button type="button" class="btn btn-sm rounded-2 px-3 fw-semibold transition-all" id="btnModeApple" onclick="setDeviceArchitectureMode('apple')" style="color: #ffffff; background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.28);">
                                <i class="bi bi-apple me-1"></i> Apple / iOS (Storage Only)
                            </button>
                        </div>
                        <button type="button" class="btn btn-sm btn-primary rounded-2 px-3 fw-semibold" onclick="addVariantCard()">
                            <i class="bi bi-plus-lg me-1"></i> Add Variant
                        </button>
                    </div>
                </div>
                <div id="appleModeAlert" class="d-none align-items-center gap-3 p-3 mb-3 rounded-3 shadow-lg" style="background: rgba(15, 23, 42, 0.95); border: 1.5px solid rgba(255, 255, 255, 0.35); color: #ffffff !important;">
                    <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0" style="width: 40px; height: 40px; background: #ffffff; color: #000000; box-shadow: 0 0 10px rgba(255, 255, 255, 0.4);">
                        <i class="bi bi-apple fs-5" style="color: #000000 !important;"></i>
                    </div>
                    <div style="color: #ffffff !important; font-size: 0.92rem; line-height: 1.5;">
                        <span style="color: #ffffff !important; font-weight: 800; font-size: 0.95rem; display: block; margin-bottom: 2px;">Apple / iOS Architecture:</span>
                        <span style="color: #ffffff !important; font-weight: 500;">Apple devices do not advertise RAM or RAM Types. RAM inputs are completely disabled and omitted — only Storage Capacity (128GB, 256GB, 512GB, 1TB) is used.</span>
                    </div>
                </div>
                <p class="small mb-3" id="variantsIntroText" style="color: rgba(255, 255, 255, 0.75) !important;">Manage sellable RAM/Storage combinations and color options with color-specific product gallery images.</p>

                <div id="variantsContainer" class="d-flex flex-column gap-3">
                    <!-- Dynamic Variant Cards populated dynamically -->
                </div>
            </div>

            <!-- Mobile Hardware Specifications Card -->
            <div class="card-d card-p-lg mb-4" id="hardwareSpecsCard">
                <div class="s-title"><i class="bi bi-cpu me-2" style="color:var(--primary)"></i>Mobile Hardware Specifications</div>
                
                <ul class="nav nav-tabs mb-3" id="specsTab" role="tablist" style="border-bottom-color:var(--border)">
                    <li class="nav-item">
                        <button class="nav-link active fw-bold" id="proc-tab" data-bs-toggle="tab" data-bs-target="#proc-tab-pane" type="button"><i class="bi bi-cpu me-1"></i> Performance</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-bold" id="disp-tab" data-bs-toggle="tab" data-bs-target="#disp-tab-pane" type="button"><i class="bi bi-display me-1"></i> Display &amp; Camera</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-bold" id="batt-tab" data-bs-toggle="tab" data-bs-target="#batt-tab-pane" type="button"><i class="bi bi-battery-charging me-1"></i> Battery &amp; Network</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-bold" id="os-tab" data-bs-toggle="tab" data-bs-target="#os-tab-pane" type="button"><i class="bi bi-shield-check me-1"></i> OS &amp; Security</button>
                    </li>
                </ul>

                <div class="tab-content" id="specsTabContent">
                    <!-- Tab 1: Performance -->
                    <div class="tab-pane fade show active" id="proc-tab-pane">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="fg">
                                    <label class="fg-label">Processor Brand</label>
                                    <input type="text" asp-for="Specs.ProcessorBrand" class="fg-control" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="fg">
                                    <label class="fg-label">Processor / Chipset Name</label>
                                    <input type="text" asp-for="Specs.ProcessorName" class="fg-control" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="fg">
                                    <label class="fg-label">CPU Cores &amp; Speed</label>
                                    <input type="text" asp-for="Specs.CpuCores" class="fg-control" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="fg">
                                    <label class="fg-label">GPU</label>
                                    <input type="text" asp-for="Specs.Gpu" class="fg-control" />
                                </div>
                            </div>
                            <div class="col-md-4" id="ramTypeContainer">
                                <div class="fg">
                                    <label class="fg-label">RAM Type</label>
                                    <input type="text" asp-for="Specs.RamType" id="Specs_RamType" class="fg-control" placeholder="Optional" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="fg">
                                    <label class="fg-label">Storage Type</label>
                                    <input type="text" asp-for="Specs.StorageType" class="fg-control" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tab 2: Display & Camera -->
                    <div class="tab-pane fade" id="disp-tab-pane">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <div class="fg">
                                    <label class="fg-label">Display Size (inches)</label>
                                    <input type="text" asp-for="Specs.DisplaySize" class="fg-control" placeholder="e.g. 6.8 inches" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="fg">
                                    <label class="fg-label">Display Type</label>
                                    <input type="text" asp-for="Specs.DisplayType" class="fg-control" placeholder="e.g. Dynamic AMOLED 2X" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="fg">
                                    <label class="fg-label">Display Resolution</label>
                                    <input type="text" asp-for="Specs.Resolution" class="fg-control" placeholder="e.g. 1440 x 3120 pixels, FHD+" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="fg">
                                    <label class="fg-label">Refresh Rate</label>
                                    <input type="text" asp-for="Specs.RefreshRate" class="fg-control" placeholder="e.g. 120Hz" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="fg">
                                    <label class="fg-label">Primary Rear Camera (MP)</label>
                                    <input type="text" asp-for="Specs.PrimaryRearCameraMp" class="fg-control" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="fg">
                                    <label class="fg-label">Front Selfie Camera (MP)</label>
                                    <input type="text" asp-for="Specs.FrontCameraMp" class="fg-control" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="fg">
                                    <label class="fg-label">Camera Features</label>
                                    <input type="text" asp-for="Specs.CameraFeatures" class="fg-control" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tab 3: Battery & Network -->
                    <div class="tab-pane fade" id="batt-tab-pane">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="fg">
                                    <label class="fg-label">Battery Capacity (mAh)</label>
                                    <input type="number" asp-for="Specs.BatteryCapacityMah" class="fg-control" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="fg">
                                    <label class="fg-label">Fast Charging (Wattage)</label>
                                    <input type="text" asp-for="Specs.FastChargingWattage" class="fg-control" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="fg">
                                    <label class="fg-label">Charging Port</label>
                                    <select asp-for="Specs.ChargingPortType" class="fg-control">
                                        <option value="USB Type-C">USB Type-C</option>
                                        <option value="Lightning">Lightning</option>
                                        <option value="Micro-USB">Micro-USB</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="fg">
                                    <label class="fg-label">5G Network Support?</label>
                                    <select asp-for="Specs.Network5G" class="fg-control">
                                        <option value="true">Yes — 5G Supported</option>
                                        <option value="false">No — 4G LTE Only</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="fg">
                                    <label class="fg-label">SIM Type</label>
                                    <select asp-for="Specs.SimType" class="fg-control">
                                        <option value="Dual SIM">Dual SIM (Nano + Nano)</option>
                                        <option value="eSIM + Physical SIM">eSIM + Physical SIM</option>
                                        <option value="Single SIM">Single SIM</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="fg">
                                    <label class="fg-label">NFC Support?</label>
                                    <select asp-for="Specs.Nfc" class="fg-control">
                                        <option value="true">Yes (Tap &amp; Pay)</option>
                                        <option value="false">No NFC</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="fg">
                                    <label class="fg-label">Wireless Charging?</label>
                                    <select asp-for="Specs.WirelessCharging" class="fg-control">
                                        <option value="false">No Wireless Charging</option>
                                        <option value="true">Yes Wireless Charging</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tab 4: OS & Security -->
                    <div class="tab-pane fade" id="os-tab-pane">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="fg">
                                    <label class="fg-label">Operating System</label>
                                    <select asp-for="Specs.OperatingSystem" class="fg-control">
                                        <option value="Android">Android</option>
                                        <option value="iOS">iOS</option>
                                        <option value="KaiOS">KaiOS</option>
                                        <option value="Other">Other OS</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="fg">
                                    <label class="fg-label">OS Version</label>
                                    <input type="text" asp-for="Specs.OsVersion" class="fg-control" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="fg">
                                    <label class="fg-label">Fingerprint Sensor</label>
                                    <select asp-for="Specs.FingerprintSensor" class="fg-control">
                                        <option value="In-Display Ultrasonic">In-Display Ultrasonic</option>
                                        <option value="Side-Mounted">Side-Mounted</option>
                                        <option value="Rear-Mounted">Rear-Mounted</option>
                                        <option value="None">None</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="fg">
                                    <label class="fg-label">Water/Dust Resistance Rating</label>
                                    <input type="text" asp-for="Specs.WaterResistance" class="fg-control" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="fg">
                                    <label class="fg-label">Audio &amp; Speakers</label>
                                    <input type="text" asp-for="Specs.AudioFeatures" class="fg-control" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Description -->
            <div class="card-d card-p-lg mb-4">
                <div class="s-title"><i class="bi bi-file-text me-2" style="color:var(--primary)"></i>Additional Description</div>
                <div class="fg mb-0">
                    <textarea asp-for="Description" class="fg-control" rows="3"></textarea>
                </div>
            </div>
        </div>

        <!-- Right Column -->
        <div class="col-lg-4">
            <div class="card-d card-p-lg">
                <div class="s-title">Product Image</div>

                <div class="upload-area" id="upload-area" onclick="document.getElementById('ProductImage').click()">
                    <img id="image-preview" src="@(string.IsNullOrEmpty(Model.CurrentImageUrl) ? "/images/default-product.png" : Model.CurrentImageUrl)" alt="Preview"
                         style="max-height:160px;max-width:100%;border-radius:var(--radius-md);object-fit:cover;display:block;margin:0 auto 12px">
                    <div class="upload-area-text">
                        <i class="bi bi-cloud-upload me-1"></i> Click to change image
                    </div>
                    <div class="upload-area-hint">JPG, PNG or WEBP · Max 5 MB</div>
                </div>

                <input asp-for="ProductImage"
                       id="ProductImage"
                       type="file"
                       accept=".jpg,.jpeg,.png,.webp"
                       style="display:none"
                       onchange="previewImg(this)">
                <span asp-validation-for="ProductImage" class="fg-error mt-2"></span>
            </div>

            <!-- Multi-Image Gallery Upload Card (Up to 50 Photos) -->
            <div class="card-d card-p-lg mt-3">
                <div class="s-title"><i class="bi bi-images me-1 text-info"></i>Product Gallery Photos</div>
                @if (Model.ExistingImageUrls != null && Model.ExistingImageUrls.Any())
                {
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        @foreach (var img in Model.ExistingImageUrls)
                        {
                            <img src="@img" class="rounded border" style="width:48px;height:48px;object-fit:cover" />
                        }
                    </div>
                }
                <div class="upload-area" id="gallery-upload-area" onclick="document.getElementById('ProductImages').click()">
                    <i class="bi bi-images text-muted d-block mb-2" style="font-size:32px"></i>
                    <div class="upload-area-text">
                        <i class="bi bi-cloud-upload me-1"></i> Add Up to 50 Gallery Images
                    </div>
                    <div class="upload-area-hint">Select multiple photos for product slider</div>
                </div>

                <input asp-for="ProductImages"
                       id="ProductImages"
                       type="file"
                       multiple
                       accept="image/*"
                       style="display:none"
                       onchange="previewGalleryImgs(this)">
                <div id="gallery-preview-container" class="d-flex flex-wrap gap-2 mt-2"></div>
            </div>
        </div>
    </div>

    <div class="d-flex align-items-center justify-content-end gap-3 mt-4">
        <a href="@Url.Action("Products","SupplierDashboard")" class="btn-d btn-outline">Cancel</a>
        <button type="submit" class="btn-d btn-primary">
            <i class="bi bi-check2"></i> Update Product
        </button>
    </div>
</form>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
function toggleHardwareTabs(type) {
    const card = document.getElementById('hardwareSpecsCard');
    const isImei = document.getElementById('isImeiSelect');

    const accessoryTypes = ['Charger', 'Cable', 'Mobile Cover', 'Tempered Glass', 'Earphones', 'Headphones', 'Power Bank', 'Memory Card', 'Speaker', 'Other'];
    if (accessoryTypes.includes(type)) {
        card.style.display = 'none';
        if (isImei) isImei.value = 'false';
    } else {
        card.style.display = 'block';
        if (isImei) isImei.value = 'true';
    }
}

document.addEventListener('DOMContentLoaded', function() {
    const sel = document.getElementById('productTypeSelect');
    if (sel) toggleHardwareTabs(sel.value);
});

function previewImg(input) {
  if (!input.files[0]) return;
  const reader = new FileReader();
  reader.onload = e => { document.getElementById('image-preview').src = e.target.result; };
  reader.readAsDataURL(input.files[0]);
}

function generateSKU() {
  const nameInput = document.getElementById('Name');
  const codeInput = document.getElementById('Code');
  let prefix = 'MOB';

  if (nameInput && nameInput.value.trim()) {
    const words = nameInput.value.trim().split(/\s+/);
    if (words.length >= 2) {
      prefix = (words[0][0] + words[1][0] + (words[2] ? words[2][0] : words[1][1] || 'X')).toUpperCase();
    } else if (words[0].length >= 3) {
      prefix = words[0].substring(0, 3).toUpperCase();
    }
  }

  const randomNum = Math.floor(100 + Math.random() * 900);
  const sku = `${prefix}-${randomNum}`;
  if (codeInput) {
    codeInput.value = sku;
    if (window.showToast) window.showToast(`Generated SKU: ${sku}`, 'success');
  }
}

function generateBarcode() {
  const barcodeInput = document.getElementById('Barcode');
  const prefix = '890';
  let middle = '';
  for (let i = 0; i < 9; i++) {
    middle += Math.floor(Math.random() * 10);
  }
  const barcode = prefix + middle;
  if (barcodeInput) {
    barcodeInput.value = barcode;
    if (window.showToast) window.showToast(`Generated Barcode: ${barcode}`, 'success');
  }
}

function previewGalleryImgs(input) {
    const container = document.getElementById('gallery-preview-container');
    if (!container) return;
    container.innerHTML = '';
    if (input.files) {
        Array.from(input.files).slice(0, 50).forEach(file => {
            const reader = new FileReader();
            reader.onload = function(e) {
                const img = document.createElement('img');
                img.src = e.target.result;
                img.className = 'rounded border';
                img.style.cssText = 'width:50px;height:50px;object-fit:cover';
                container.appendChild(img);
            };
            reader.readAsDataURL(file);
        });
    }
}

let isAppleMode = false;

function setDeviceArchitectureMode(mode) {
    isAppleMode = (mode === 'apple');
    
    const btnStd = document.getElementById('btnModeStandard');
    const btnApple = document.getElementById('btnModeApple');
    const alertBox = document.getElementById('appleModeAlert');
    const introText = document.getElementById('variantsIntroText');

    if (btnStd && btnApple) {
        if (isAppleMode) {
            btnStd.style.cssText = "color: #cbd5e1 !important; background: rgba(255, 255, 255, 0.08) !important; border: 1px solid rgba(255, 255, 255, 0.2) !important; font-weight: 500 !important; cursor: pointer;";
            btnApple.style.cssText = "color: #000000 !important; background: #ffffff !important; border: 1px solid #ffffff !important; font-weight: 700 !important; box-shadow: 0 0 14px rgba(255, 255, 255, 0.45) !important; cursor: pointer;";
            if (alertBox) {
                alertBox.classList.remove('d-none');
                alertBox.classList.add('d-flex');
            }
            if (introText) {
                introText.textContent = 'Manage sellable internal Storage capacities (e.g. 128GB, 256GB, 512GB, 1TB) and color options for this Apple device.';
                introText.style.color = '#ffffff';
            }
            const osSelect = document.getElementById('Specs_OperatingSystem');
            if (osSelect) osSelect.value = 'iOS';
        } else {
            btnApple.style.cssText = "color: #ffffff !important; background: rgba(255, 255, 255, 0.08) !important; border: 1px solid rgba(255, 255, 255, 0.28) !important; font-weight: 500 !important; cursor: pointer;";
            btnStd.style.cssText = "color: #ffffff !important; background: #2563eb !important; border: 1px solid #3b82f6 !important; font-weight: 700 !important; box-shadow: 0 0 12px rgba(37, 99, 235, 0.5) !important; cursor: pointer;";
            if (alertBox) {
                alertBox.classList.add('d-none');
                alertBox.classList.remove('d-flex');
            }
            if (introText) {
                introText.textContent = 'Manage sellable RAM/Storage combinations and color options with color-specific product gallery images.';
                introText.style.color = 'rgba(255, 255, 255, 0.7)';
            }
        }
    }

    // Toggle RAM inputs in all existing variant cards
    document.querySelectorAll('.variant-ram-col').forEach(el => {
        if (isAppleMode) {
            el.classList.add('d-none');
            const inp = el.querySelector('input');
            if (inp) inp.value = '';
        } else {
            el.classList.remove('d-none');
        }
    });

    document.querySelectorAll('.variant-storage-col').forEach(el => {
        if (isAppleMode) {
            el.classList.remove('col-md-5');
            el.classList.add('col-md-10');
            const lbl = el.querySelector('.storage-label-text');
            if (lbl) lbl.textContent = 'Storage Capacity (128GB, 256GB, 512GB, 1TB, etc.)';
        } else {
            el.classList.remove('col-md-10');
            el.classList.add('col-md-5');
            const lbl = el.querySelector('.storage-label-text');
            if (lbl) lbl.textContent = 'Storage Capacity';
        }
    });

    // Hide RAM Type in Hardware Specs Performance Tab
    const ramTypeContainer = document.getElementById('ramTypeContainer');
    if (ramTypeContainer) {
        if (isAppleMode) {
            ramTypeContainer.classList.add('d-none');
            const rInput = ramTypeContainer.querySelector('input');
            if (rInput) rInput.value = '';
        } else {
            ramTypeContainer.classList.remove('d-none');
        }
    }
}

document.getElementById('productEditForm')?.addEventListener('submit', function() {
    if (isAppleMode) {
        document.querySelectorAll('.variant-ram-col input').forEach(inp => {
            inp.value = '';
        });
        const rInput = document.getElementById('Specs_RamType');
        if (rInput) rInput.value = '';
        const osSelect = document.getElementById('Specs_OperatingSystem');
        if (osSelect) osSelect.value = 'iOS';
    }
});

function checkAutoDetectApple() {
    const brand = (document.getElementById('Brand')?.value || '').trim().toLowerCase();
    const model = (document.getElementById('ModelName')?.value || '').trim().toLowerCase();
    const name = (document.getElementById('Name')?.value || '').trim().toLowerCase();
    const os = (document.getElementById('Specs_OperatingSystem')?.value || '').trim().toLowerCase();
    const catEl = document.getElementById('CategoryId') || document.querySelector('select[name="CategoryId"]');
    const catText = catEl && catEl.selectedIndex >= 0 ? (catEl.options[catEl.selectedIndex]?.text || '').trim().toLowerCase() : '';
    const prodType = (document.getElementById('productTypeSelect')?.value || '').trim().toLowerCase();

    if (brand.includes('apple') || model.includes('iphone') || model.includes('ipad') || 
        name.includes('iphone') || name.includes('ipad') || name.includes('apple') ||
        os.includes('ios') || os.includes('ipados') || 
        catText.includes('ios') || catText.includes('apple') ||
        prodType.includes('ios') || prodType.includes('apple')) {
        setDeviceArchitectureMode('apple');
    }
}

let variantCount = 0;

function addVariantCard(ram = '', storage = '', purPrice = '', sellPrice = '', initialStock = '0', variantId = '', currentStock = '0') {
    const vIndex = variantCount++;
    const container = document.getElementById('variantsContainer');
    if (!container) return;
    
    const ramColClass = isAppleMode ? 'd-none' : '';
    const storageColClass = isAppleMode ? 'col-md-10' : 'col-md-5';
    const storageLabel = isAppleMode ? 'Storage Capacity (128GB, 256GB, 512GB, 1TB, etc.)' : 'Storage Capacity';
    const effectiveRam = isAppleMode ? '' : ram;

    const cardHtml = `
    <div class="card border rounded p-3 bg-light-subtle shadow-sm" id="variantCard_${vIndex}">
        <input type="hidden" name="Variants[${vIndex}].VariantId" value="${variantId}" />
        <input type="hidden" name="Variants[${vIndex}].CurrentStock" value="${currentStock}" />
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
            <h6 class="mb-0 fw-bold text-primary"><i class="bi bi-cpu me-2"></i>Variant ${vIndex + 1} Configuration</h6>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-sm btn-outline-primary" onclick="copyVariantCard(this)" title="Duplicate / Copy this variant configuration and colors">
                    <i class="bi bi-copy me-1"></i> Copy Variant
                </button>
                <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeVariantCard(this)">
                    <i class="bi bi-trash me-1"></i> Remove Variant
                </button>
            </div>
        </div>
        <div class="row g-3">
            <div class="col-md-5 variant-ram-col ${ramColClass}" id="ramCol_${vIndex}">
                <label class="fg-label">RAM Config</label>
                <input type="text" name="Variants[${vIndex}].Ram" value="${effectiveRam}" class="fg-control" placeholder="e.g. 8GB, 12GB" />
            </div>
            <div class="${storageColClass} variant-storage-col" id="storageCol_${vIndex}">
                <label class="fg-label"><span class="storage-label-text">${storageLabel}</span> <span class="req">*</span></label>
                <input type="text" name="Variants[${vIndex}].Storage" value="${storage}" class="fg-control" placeholder="e.g. 128GB, 256GB, 512GB, 1TB" required />
            </div>
            <div class="col-md-2">
                <label class="fg-label">Initial Stock</label>
                <input type="number" name="Variants[${vIndex}].InitialStock" value="${initialStock}" class="fg-control" placeholder="0" min="0" />
            </div>
        </div>

        <div class="mt-4 pt-3 border-top">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="fw-bold small text-secondary"><i class="bi bi-palette me-1"></i>Color Options &amp; Images</span>
                <button type="button" class="btn btn-sm btn-outline-success" onclick="addColorRow(${vIndex})">
                    <i class="bi bi-plus-lg me-1"></i> Add Color
                </button>
            </div>
            <div id="colorsContainer_${vIndex}" class="d-flex flex-column gap-2 mt-2">
                <!-- Color rows populated here -->
            </div>
        </div>
    </div>`;

    container.insertAdjacentHTML('beforeend', cardHtml);
    return vIndex;
}

function removeVariantCard(target) {
    const card = typeof target === 'number' 
        ? document.getElementById(`variantCard_${target}`) 
        : target.closest('.card[id^="variantCard_"]');
    if (card) {
        card.remove();
        reindexVariants();
    }
}

function copyVariantCard(target) {
    const srcCard = typeof target === 'number' 
        ? document.getElementById(`variantCard_${target}`) 
        : target.closest('.card[id^="variantCard_"]');
    if (!srcCard) return;

    const ramInp = srcCard.querySelector('input[name$=".Ram"]');
    const storageInp = srcCard.querySelector('input[name$=".Storage"]');
    const stockInp = srcCard.querySelector('input[name$=".InitialStock"]');

    const ram = ramInp ? ramInp.value : '';
    const storage = storageInp ? storageInp.value : '';
    const initialStock = stockInp ? stockInp.value : '0';

    // Collect source colors
    const colorContainer = srcCard.querySelector('[id^="colorsContainer_"]');
    const srcColorRows = colorContainer ? colorContainer.querySelectorAll('.row[id^="colorRow_"]') : [];
    const colorsData = [];

    srcColorRows.forEach(row => {
        const nameInp = row.querySelector('input[name*="].Name"]');
        const codeInp = row.querySelector('input[name*="].Code"]');
        const purInp = row.querySelector('input[name*="].PurchasePrice"]');
        const sellInp = row.querySelector('input[name*="].SellingPrice"]');
        const cStockInp = row.querySelector('input[name*="].InitialStock"]');
        const mainImgInp = row.querySelector('input[name*="].ImageUrl"]');
        
        const existingImgs = [];
        row.querySelectorAll('input[name*="].ExistingImageUrls"]').forEach(imgInp => {
            if (imgInp.value && !existingImgs.includes(imgInp.value)) {
                existingImgs.push(imgInp.value);
            }
        });
        if (mainImgInp && mainImgInp.value && !existingImgs.includes(mainImgInp.value)) {
            existingImgs.unshift(mainImgInp.value);
        }

        colorsData.push({
            name: nameInp ? nameInp.value : '',
            code: codeInp ? codeInp.value : '#000000',
            purchasePrice: purInp ? purInp.value : '',
            sellingPrice: sellInp ? sellInp.value : '',
            initialStock: cStockInp ? cStockInp.value : '0',
            imageUrl: mainImgInp ? mainImgInp.value : '',
            existingImages: existingImgs
        });
    });

    // Create new variant card (empty variantId and 0 currentStock so it's a new entity)
    const newVIndex = addVariantCard(ram, storage, '', '', initialStock, '', '0');
    const newColorContainer = document.getElementById(`colorsContainer_${newVIndex}`);
    if (newColorContainer) {
        newColorContainer.innerHTML = '';
    }

    if (colorsData.length > 0) {
        colorsData.forEach(c => {
            addColorRow(newVIndex, c.name, c.code, c.initialStock, c.purchasePrice, c.sellingPrice, '', c.imageUrl, '0', c.existingImages);
        });
    } else {
        addColorRow(newVIndex);
    }

    reindexVariants();

    const newCard = document.getElementById(`variantCard_${newVIndex}`);
    if (newCard) {
        newCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
    if (window.showToast) {
        window.showToast('Variant configuration copied! You can now adjust storage, prices, or stock.', 'success');
    }
}

function reindexVariants() {
    const container = document.getElementById('variantsContainer');
    if (!container) return;
    const variantCards = container.querySelectorAll('.card[id^="variantCard_"]');
    variantCards.forEach((card, vIdx) => {
        const titleEl = card.querySelector('h6');
        if (titleEl) {
            titleEl.innerHTML = `<i class="bi bi-cpu me-2"></i>Variant ${vIdx + 1} Configuration`;
        }
        
        const allInputs = card.querySelectorAll('input, select, textarea');
        allInputs.forEach(inp => {
            if (inp.name && inp.name.startsWith('Variants[')) {
                inp.name = inp.name.replace(/^Variants\[\d+\]/, `Variants[${vIdx}]`);
            }
        });

        const colorsContainer = card.querySelector('[id^="colorsContainer_"]');
        if (colorsContainer) {
            const colorRows = colorsContainer.querySelectorAll('.row[id^="colorRow_"]');
            colorRows.forEach((cRow, cIdx) => {
                const cInputs = cRow.querySelectorAll('input, select, textarea');
                cInputs.forEach(cInp => {
                    if (cInp.name && cInp.name.includes('.Colors[')) {
                        cInp.name = cInp.name.replace(/\.Colors\[\d+\]/, `.Colors[${cIdx}]`);
                    }
                });
            });
        }
    });
}

function addColorRow(vIndex, colorName = '', colorCode = '', initialStock = '0', purPrice = '', sellPrice = '', colorId = '', imageUrl = '', currentStock = '0', existingImageUrls = []) {
    const colorContainer = document.getElementById(`colorsContainer_${vIndex}`);
    if (!colorContainer) return;
    const cIndex = colorContainer.children.length;

    let thumbsHtml = '';
    const imagesToRender = [];
    if (imageUrl) imagesToRender.push(imageUrl);
    if (Array.isArray(existingImageUrls)) {
        existingImageUrls.forEach(u => {
            if (u && !imagesToRender.includes(u)) imagesToRender.push(u);
        });
    }

    if (imagesToRender.length > 0) {
        thumbsHtml = '<div class="d-flex flex-wrap gap-1 mt-1 color-thumbs-wrap">';
        imagesToRender.forEach(imgUrl => {
            thumbsHtml += `
                <div class="position-relative d-inline-block color-thumb-wrapper me-1 mb-1">
                    <img src="${imgUrl}" class="rounded border" style="width:34px;height:34px;object-fit:cover" />
                    <input type="hidden" name="Variants[${vIndex}].Colors[${cIndex}].ExistingImageUrls" value="${imgUrl}" />
                    <button type="button" class="btn btn-danger btn-sm p-0 position-absolute rounded-circle d-flex align-items-center justify-content-center shadow-sm" 
                            onclick="removeColorImageThumb(this, ${vIndex}, ${cIndex})" 
                            style="top:-4px;right:-4px;width:16px;height:16px;font-size:10px;line-height:1;z-index:2" title="Remove photo">
                        <i class="bi bi-x"></i>
                    </button>
                </div>
            `;
        });
        thumbsHtml += '</div>';
    }

    const firstImgUrl = imagesToRender.length > 0 ? imagesToRender[0] : (imageUrl || '');

    const colorHtml = `
    <div class="row g-2 align-items-center p-2 rounded border bg-white" id="colorRow_${vIndex}_${cIndex}">
        <input type="hidden" name="Variants[${vIndex}].Colors[${cIndex}].ColorId" value="${colorId}" />
        <input type="hidden" name="Variants[${vIndex}].Colors[${cIndex}].ImageUrl" value="${firstImgUrl}" />
        <input type="hidden" name="Variants[${vIndex}].Colors[${cIndex}].CurrentStock" value="${currentStock}" />
        <div class="col-md-2">
            <input type="text" name="Variants[${vIndex}].Colors[${cIndex}].Name" value="${colorName}" class="fg-control form-control-sm" placeholder="Color Name" required />
        </div>
        <div class="col-md-1">
            <div class="d-flex align-items-center gap-1">
                <input type="color" name="Variants[${vIndex}].Colors[${cIndex}].Code" value="${colorCode || '#000000'}" class="form-control form-control-color form-control-sm" title="Choose color swatch" style="width:34px;height:31px;padding:2px" />
            </div>
        </div>
        <div class="col-md-2">
            <input type="number" step="0.01" name="Variants[${vIndex}].Colors[${cIndex}].PurchasePrice" value="${purPrice}" class="fg-control form-control-sm" placeholder="Wholesale Price (₹)" min="0" title="Wholesale / Supplier Price for this color" />
        </div>
        <div class="col-md-2">
            <input type="number" step="0.01" name="Variants[${vIndex}].Colors[${cIndex}].SellingPrice" value="${sellPrice}" class="fg-control form-control-sm" placeholder="Retail Price (₹)" min="0" title="Retail Price for this color" />
        </div>
        <div class="col-md-2">
            <input type="number" name="Variants[${vIndex}].Colors[${cIndex}].InitialStock" value="${initialStock}" class="fg-control form-control-sm" placeholder="Initial Stock" min="0" title="Initial Stock for this color" />
        </div>
        <div class="col-md-2">
            <div class="d-flex flex-column gap-1">
                <label class="btn btn-sm btn-outline-secondary mb-0 w-100 text-truncate">
                    <i class="bi bi-upload me-1"></i> Add / Change Images
                    <input type="file" name="Variants[${vIndex}].Colors[${cIndex}].ImageFiles" multiple accept="image/*" class="d-none" onchange="updateColorFileBadge(this)" />
                </label>
                ${thumbsHtml}
            </div>
            <span class="badge bg-light text-dark border color-file-badge mt-1 d-none">0 files</span>
        </div>
        <div class="col-md-1 text-end">
            <button type="button" class="btn btn-sm btn-link text-danger p-0" onclick="this.closest('.row').remove()">
                <i class="bi bi-x-circle fs-6"></i>
            </button>
        </div>
    </div>`;

    colorContainer.insertAdjacentHTML('beforeend', colorHtml);
}

function removeColorImageThumb(btn, vIndex, cIndex) {
    const wrapper = btn.closest('.color-thumb-wrapper');
    if (wrapper) wrapper.remove();
    const colorRow = document.getElementById(`colorRow_${vIndex}_${cIndex}`);
    if (colorRow) {
        const remainingInputs = colorRow.querySelectorAll(`input[name="Variants[${vIndex}].Colors[${cIndex}].ExistingImageUrls"]`);
        const mainImgInput = colorRow.querySelector(`input[name="Variants[${vIndex}].Colors[${cIndex}].ImageUrl"]`);
        if (mainImgInput) {
            if (remainingInputs.length > 0) {
                mainImgInput.value = remainingInputs[0].value;
            } else {
                mainImgInput.value = '';
            }
        }
    }
}

function updateColorFileBadge(input) {
    const badge = input.closest('.row').querySelector('.color-file-badge');
    if (badge && input.files) {
        badge.textContent = `${input.files.length} images selected`;
        badge.classList.remove('d-none');
    }
}

document.addEventListener('DOMContentLoaded', function() {
    const container = document.getElementById('variantsContainer');
    if (!container) return;

@if (Model.Variants != null && Model.Variants.Any())
{
    int vCounter = 0;
    foreach (var v in Model.Variants)
    {
        <text>
        const vIdx_@vCounter = addVariantCard('@v.Ram', '@v.Storage', '@v.PurchasePrice', '@v.SellingPrice', '@v.InitialStock', '@v.VariantId', '@v.CurrentStock');
        </text>
        if (v.Colors != null && v.Colors.Any())
        {
            foreach (var c in v.Colors)
            {
                var imgsList = new List<string>();
                if (!string.IsNullOrEmpty(c.ImageUrl)) imgsList.Add(c.ImageUrl);
                if (c.ExistingImageUrls != null)
                {
                    foreach (var u in c.ExistingImageUrls)
                    {
                        if (!string.IsNullOrEmpty(u) && !imgsList.Contains(u)) imgsList.Add(u);
                    }
                }
                var jsonImgs = System.Text.Json.JsonSerializer.Serialize(imgsList);
                <text>
                addColorRow(vIdx_@vCounter, '@c.Name', '@c.Code', '@c.InitialStock', '@c.PurchasePrice', '@c.SellingPrice', '@c.ColorId', '@c.ImageUrl', '@c.CurrentStock', @Html.Raw(jsonImgs));
                </text>
            }
        }
        else
        {
            <text>
            addColorRow(vIdx_@vCounter);
            </text>
        }
        vCounter++;
    }
}
else
{
    <text>
    const vIdx_0 = addVariantCard('@Model.Ram', '@Model.Storage', '@Model.PurchasePrice', '@Model.SellingPrice', '0', 'default-variant', '0');
    addColorRow(vIdx_0);
    </text>
}

    // Auto-detect Apple/iOS on inputs
    ['Brand', 'ModelName', 'Name', 'Specs_OperatingSystem', 'CategoryId', 'productTypeSelect'].forEach(id => {
        const el = document.getElementById(id);
        if (el) {
            el.addEventListener('input', checkAutoDetectApple);
            el.addEventListener('change', checkAutoDetectApple);
        }
    });
    checkAutoDetectApple();

    const editForm = document.getElementById('productEditForm');
    if (editForm) {
        editForm.addEventListener('submit', function() {
            reindexVariants();
        });
    }
});
</script>
}
