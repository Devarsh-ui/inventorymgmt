@model InventoryManagementSystem.ViewModels.SupplierReturnStatsViewModel
@{
    ViewData["Title"] = "Damaged & Returned Stock Analytics";
}

<!-- Page Header -->
<div class="ph">
    <div>
        <h1 class="ph-title"><i class="bi bi-box-seam me-2" style="color:var(--danger)"></i>Damaged & Returned Stock Analytics</h1>
        <p class="ph-sub">Comprehensive statistics, detailed filters, and claim management for returned & damaged stock</p>
    </div>
    <div class="ph-actions">
        <a href="@Url.Action("Returns", "SupplierDashboard")" class="btn-d btn-outline me-2">
            <i class="bi bi-arrow-clockwise me-1"></i> Refresh Stats
        </a>
        <a href="@Url.Action("Orders", "SupplierDashboard")" class="btn-d btn-primary">
            <i class="bi bi-cart-check me-1"></i> View Received Orders
        </a>
    </div>
</div>

<!-- 1. KPI Summary Cards Grid -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card-d card-p border-start border-4 border-danger h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted text-uppercase fw-semibold" style="font-size:11px;letter-spacing:0.5px">Total Return Claims</span>
                    <h3 class="mb-0 mt-1 fw-bold text-danger">@Model.TotalReturnClaims</h3>
                    <small class="text-muted" style="font-size:12px">@Model.TotalDamagedItems Units Returned</small>
                </div>
                <div class="p-3 rounded-3" style="background:rgba(239, 68, 68, 0.1);color:#ef4444">
                    <i class="bi bi-box-seam fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card-d card-p border-start border-4 border-warning h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted text-uppercase fw-semibold" style="font-size:11px;letter-spacing:0.5px">Return Financial Value</span>
                    <h3 class="mb-0 mt-1 fw-bold text-warning">₹@Model.TotalReturnFinancialValue.ToString("N2")</h3>
                    <small class="text-muted" style="font-size:12px">Refund Value: ₹@Model.TotalRefundValue.ToString("N2")</small>
                </div>
                <div class="p-3 rounded-3" style="background:rgba(245, 158, 11, 0.1);color:#f59e0b">
                    <i class="bi bi-currency-rupee fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card-d card-p border-start border-4 border-info h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted text-uppercase fw-semibold" style="font-size:11px;letter-spacing:0.5px">Pending Action Needed</span>
                    <h3 class="mb-0 mt-1 fw-bold text-info">@Model.PendingClaimsCount</h3>
                    <small class="text-muted" style="font-size:12px">Awaiting Supplier Response</small>
                </div>
                <div class="p-3 rounded-3" style="background:rgba(6, 182, 212, 0.1);color:#06b6d4">
                    <i class="bi bi-clock-history fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card-d card-p border-start border-4 border-success h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted text-uppercase fw-semibold" style="font-size:11px;letter-spacing:0.5px">Accepted Claims</span>
                    <h3 class="mb-0 mt-1 fw-bold text-success">@Model.AcceptedClaimsCount</h3>
                    <small class="text-muted" style="font-size:12px">@Model.TotalReplacementItems Replacement Items</small>
                </div>
                <div class="p-3 rounded-3" style="background:rgba(16, 185, 129, 0.1);color:#10b981">
                    <i class="bi bi-check-circle fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 2. Breakdown Analytics Section -->
<div class="row g-3 mb-4">
    <!-- Reason Breakdown Card -->
    <div class="col-12 col-lg-6">
        <div class="card-d card-p h-100">
            <div class="d-flex align-items-center justify-content-between border-bottom pb-2 mb-3" style="border-color:var(--border)!important">
                <h6 class="fw-bold mb-0 text-primary"><i class="bi bi-pie-chart me-2"></i>Return Reason Breakdown</h6>
                <span class="badge-d badge-gray">@Model.ReasonBreakdown.Count Reasons</span>
            </div>
            @if (Model.ReasonBreakdown == null || !Model.ReasonBreakdown.Any())
            {
                <div class="text-center py-4 text-muted">No return reasons recorded yet.</div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var r in Model.ReasonBreakdown)
                    {
                        string progressColor = r.Reason.Contains("Damaged", StringComparison.OrdinalIgnoreCase) || r.Reason.Contains("Defective", StringComparison.OrdinalIgnoreCase) ? "bg-danger" :
                                              r.Reason.Contains("Wrong", StringComparison.OrdinalIgnoreCase) ? "bg-warning" : "bg-info";
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-1" style="font-size:13px">
                                <span class="fw-semibold text-truncate me-2" style="max-width:220px">
                                    <i class="bi bi-dot text-danger fs-5 align-middle"></i>@r.Reason
                                </span>
                                <span>
                                    <strong class="text-dark">@r.Count Claims</strong> (@r.ItemQuantity units) &bull; <span class="text-muted">₹@r.TotalValue.ToString("N0")</span>
                                </span>
                            </div>
                            <div class="progress" style="height:6px;background:var(--bg-tertiary)">
                                <div class="progress-bar @progressColor" role="progressbar" style="width: @(r.Percentage)%" aria-valuenow="@r.Percentage" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Top Returned Products Card -->
    <div class="col-12 col-lg-6">
        <div class="card-d card-p h-100">
            <div class="d-flex align-items-center justify-content-between border-bottom pb-2 mb-3" style="border-color:var(--border)!important">
                <h6 class="fw-bold mb-0 text-primary"><i class="bi bi-phone me-2"></i>Top Returned Product Models</h6>
                <span class="badge-d badge-gray">Top @Model.TopReturnedProducts.Count</span>
            </div>
            @if (Model.TopReturnedProducts == null || !Model.TopReturnedProducts.Any())
            {
                <div class="text-center py-4 text-muted">No returned product items recorded yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-borderless align-middle mb-0" style="font-size:13px">
                        <thead>
                            <tr class="text-muted border-bottom" style="border-color:var(--border)!important">
                                <th>Product / Model</th>
                                <th>Returned Qty</th>
                                <th>Total Value</th>
                                <th>Top Reason</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var prod in Model.TopReturnedProducts)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <img src="@prod.ImageUrl" alt="@prod.ProductName" class="rounded" style="width:32px;height:32px;object-fit:cover;background:var(--bg-tertiary)" onerror="this.onerror=null;this.src='/images/product-placeholder.png'" />
                                            <div>
                                                <div class="fw-bold text-dark text-truncate" style="max-width:160px">@prod.ProductName</div>
                                                <small class="text-muted">@prod.Brand @prod.ModelName</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="badge bg-danger-subtle text-danger fw-bold">@prod.ReturnedQuantity Units</span></td>
                                    <td><strong>₹@prod.TotalReturnPrice.ToString("N0")</strong></td>
                                    <td><span class="badge bg-secondary-subtle text-dark">@prod.TopReason</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- 3. Comprehensive Detailed Filters Form ("details filter not small") -->
<div class="card-d card-p mb-4" style="background:var(--bg-card);border:1px solid var(--border)">
    <div class="d-flex align-items-center justify-content-between border-bottom pb-2 mb-3" style="border-color:var(--border)!important">
        <h6 class="fw-bold mb-0 text-primary"><i class="bi bi-funnel-fill me-2"></i>Detailed Search & Filter Criteria</h6>
        @if (!string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.Reason) || !string.IsNullOrEmpty(Model.Resolution) || !string.IsNullOrEmpty(Model.Status) || Model.FromDate.HasValue || Model.ToDate.HasValue || !string.IsNullOrEmpty(Model.Brand) || !string.IsNullOrEmpty(Model.CategoryId))
        {
            <a href="@Url.Action("Returns", "SupplierDashboard")" class="btn btn-sm btn-outline-danger">
                <i class="bi bi-x-circle me-1"></i> Clear Active Filters
            </a>
        }
    </div>

    <form method="get" action="@Url.Action("Returns", "SupplierDashboard")" id="filterForm">
        <div class="row g-3">
            <!-- Search Keyword -->
            <div class="col-12 col-md-4 col-lg-3">
                <label class="form-label text-muted fw-semibold" style="font-size:12px">Search Return / Product / IMEI</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-transparent text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Return #, PO #, Brand, Model, IMEI..." />
                </div>
            </div>

            <!-- Return Reason Dropdown -->
            <div class="col-6 col-md-4 col-lg-2">
                <label class="form-label text-muted fw-semibold" style="font-size:12px">Return Reason</label>
                <select name="reason" class="form-select form-select-sm">
                    <option value="">All Reasons</option>
                    @foreach (var r in Model.Reasons)
                    {
                        <option value="@r" selected="@(Model.Reason == r ? "selected" : null)">@r</option>
                    }
                </select>
            </div>

            <!-- Settlement Resolution Dropdown -->
            <div class="col-6 col-md-4 col-lg-2">
                <label class="form-label text-muted fw-semibold" style="font-size:12px">Resolution Type</label>
                <select name="resolution" class="form-select form-select-sm">
                    <option value="">All Resolutions</option>
                    @foreach (var res in Model.Resolutions)
                    {
                        <option value="@res" selected="@(Model.Resolution == res ? "selected" : null)">@res</option>
                    }
                </select>
            </div>

            <!-- Claim Status Dropdown -->
            <div class="col-6 col-md-4 col-lg-2">
                <label class="form-label text-muted fw-semibold" style="font-size:12px">Claim Status</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    @foreach (var st in Model.Statuses)
                    {
                        <option value="@st" selected="@(Model.Status == st ? "selected" : null)">@st</option>
                    }
                </select>
            </div>

            <!-- Brand Dropdown -->
            <div class="col-6 col-md-4 col-lg-3">
                <label class="form-label text-muted fw-semibold" style="font-size:12px">Brand</label>
                <select name="brand" class="form-select form-select-sm">
                    <option value="">All Brands</option>
                    @foreach (var b in Model.Brands)
                    {
                        <option value="@b" selected="@(Model.Brand == b ? "selected" : null)">@b</option>
                    }
                </select>
            </div>

            <!-- From Date -->
            <div class="col-6 col-md-3 col-lg-2">
                <label class="form-label text-muted fw-semibold" style="font-size:12px">From Date</label>
                <input type="date" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>

            <!-- To Date -->
            <div class="col-6 col-md-3 col-lg-2">
                <label class="form-label text-muted fw-semibold" style="font-size:12px">To Date</label>
                <input type="date" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>

            <!-- Sort By -->
            <div class="col-6 col-md-3 col-lg-2">
                <label class="form-label text-muted fw-semibold" style="font-size:12px">Sort Order</label>
                <select name="sortBy" class="form-select form-select-sm">
                    <option value="newest" selected="@(Model.SortBy == "newest" ? "selected" : null)">Newest First</option>
                    <option value="oldest" selected="@(Model.SortBy == "oldest" ? "selected" : null)">Oldest First</option>
                    <option value="value_desc" selected="@(Model.SortBy == "value_desc" ? "selected" : null)">Highest Value (₹)</option>
                    <option value="value_asc" selected="@(Model.SortBy == "value_asc" ? "selected" : null)">Lowest Value (₹)</option>
                    <option value="qty_desc" selected="@(Model.SortBy == "qty_desc" ? "selected" : null)">Highest Return Qty</option>
                </select>
            </div>

            <!-- Page Size -->
            <div class="col-6 col-md-3 col-lg-2">
                <label class="form-label text-muted fw-semibold" style="font-size:12px">Rows Per Page</label>
                <select name="pageSize" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="10" selected="@(Model.PageSize == 10 ? "selected" : null)">10 Per Page</option>
                    <option value="25" selected="@(Model.PageSize == 25 ? "selected" : null)">25 Per Page</option>
                    <option value="50" selected="@(Model.PageSize == 50 ? "selected" : null)">50 Per Page</option>
                    <option value="100" selected="@(Model.PageSize == 100 ? "selected" : null)">100 Per Page</option>
                </select>
            </div>

            <!-- Filter Actions -->
            <div class="col-12 col-lg-4 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-sm btn-primary flex-grow-1">
                    <i class="bi bi-funnel me-1"></i> Apply Filters
                </button>
                <a href="@Url.Action("Returns", "SupplierDashboard")" class="btn btn-sm btn-outline-secondary">
                    Reset
                </a>
            </div>
        </div>
    </form>
</div>

<!-- 4. Filtered Returns Claims Data Table -->
<div class="card-d card-p p-0 overflow-hidden">
    <div class="d-flex align-items-center justify-content-between p-3 border-bottom" style="border-color:var(--border)!important">
        <div class="d-flex align-items-center gap-2">
            <span style="font-weight:700;font-size:14px;color:var(--text-primary)">Damaged & Returned Claims</span>
            <span class="badge-d badge-gray">@Model.TotalItems Results</span>
        </div>
    </div>

    <div class="tbl-scroll">
        <table class="tbl mb-0">
            <thead>
                <tr>
                    <th class="ps-4">Return # & PO #</th>
                    <th>Date Submitted</th>
                    <th>Returned Product(s)</th>
                    <th>Qty</th>
                    <th>Total Value (₹)</th>
                    <th>Reason</th>
                    <th>Resolution</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Returns == null || !Model.Returns.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-box-seam text-muted d-block mb-2" style="font-size:36px"></i>
                            No return records matched your filter criteria.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var ret in Model.Returns)
                    {
                        string reasonBadgeClass = ret.Reason switch
                        {
                            "Damaged on Arrival" => "bg-danger text-white",
                            "Defective" => "bg-danger text-white",
                            "Wrong Product" => "bg-warning text-dark",
                            "Wrong Variant" => "bg-warning text-dark",
                            "Quality Issue" => "bg-info text-white",
                            _ => "bg-secondary text-white"
                        };

                        string statusBadgeClass = ret.Status switch
                        {
                            "Submitted" => "bg-warning text-dark",
                            "Supplier Accepted" => "bg-success text-white",
                            "Completed" => "bg-success text-white",
                            "Supplier Rejected" => "bg-danger text-white",
                            "Cancelled" => "bg-secondary text-white",
                            _ => "bg-info text-white"
                        };

                        var firstItem = ret.Items.FirstOrDefault();

                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-primary">#@ret.ReturnNumber</div>
                                @if (!string.IsNullOrEmpty(ret.PurchaseOrderNumber))
                                {
                                    <small class="text-muted"><i class="bi bi-file-earmark-text me-1"></i>PO: #@ret.PurchaseOrderNumber</small>
                                }
                            </td>
                            <td>
                                <div>@ret.CreatedAt.ToString("dd-MMM-yyyy")</div>
                                <small class="text-muted">@ret.CreatedAt.ToString("hh:mm tt")</small>
                            </td>
                            <td>
                                @if (firstItem != null)
                                {
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="@firstItem.ImageUrl" alt="@firstItem.ProductName" class="rounded" style="width:36px;height:36px;object-fit:cover;background:var(--bg-tertiary)" onerror="this.onerror=null;this.src='/images/product-placeholder.png'" />
                                        <div>
                                            <div class="fw-bold text-dark">@firstItem.ProductName</div>
                                            <small class="text-muted">
                                                @firstItem.Brand @firstItem.ModelName
                                                @if (!string.IsNullOrEmpty(firstItem.Variant)) { <span>(@firstItem.Variant)</span> }
                                                @if (ret.Items.Count > 1)
                                                {
                                                    <span class="badge bg-secondary-subtle text-dark ms-1">+@(ret.Items.Count - 1) more</span>
                                                }
                                            </small>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">N/A</span>
                                }
                            </td>
                            <td><strong class="text-dark">@ret.TotalQuantity</strong></td>
                            <td><strong class="text-danger">₹@ret.TotalReturnValue.ToString("N2")</strong></td>
                            <td><span class="badge @reasonBadgeClass px-2 py-1">@ret.Reason</span></td>
                            <td><span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">@ret.ResolutionType</span></td>
                            <td><span class="badge @statusBadgeClass px-2 py-1">@ret.Status</span></td>
                            <td class="text-end pe-4">
                                <a href="@Url.Action("ReturnDetails", "SupplierDashboard", new { id = ret.Id })" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="bi bi-eye me-1"></i> Review
                                </a>
                                @if (ret.Status == InventoryManagementSystem.Models.PurchaseReturnStatus.Submitted || ret.Status == InventoryManagementSystem.Models.PurchaseReturnStatus.SupplierNotified)
                                {
                                    <form method="post" action="@Url.Action("AcceptReturn", "SupplierDashboard")" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@ret.Id" />
                                        <button type="submit" class="btn btn-sm btn-success" onclick="return confirm('Accept this purchase return claim #@ret.ReturnNumber?')">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- 5. Pagination Bar -->
    @if (Model.TotalPages > 1)
    {
        <div class="d-flex align-items-center justify-content-between p-3 border-top" style="border-color:var(--border)!important">
            <small class="text-muted">
                Showing @(((Model.Page - 1) * Model.PageSize) + 1) to @Math.Min(Model.Page * Model.PageSize, Model.TotalItems) of @Model.TotalItems entries
            </small>

            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Returns", "SupplierDashboard", new { search = Model.Search, reason = Model.Reason, resolution = Model.Resolution, status = Model.Status, fromDate = Model.FromDate?.ToString("yyyy-MM-dd"), toDate = Model.ToDate?.ToString("yyyy-MM-dd"), brand = Model.Brand, categoryId = Model.CategoryId, sortBy = Model.SortBy, pageSize = Model.PageSize, page = Model.Page - 1 })">Previous</a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(Model.Page == p ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Returns", "SupplierDashboard", new { search = Model.Search, reason = Model.Reason, resolution = Model.Resolution, status = Model.Status, fromDate = Model.FromDate?.ToString("yyyy-MM-dd"), toDate = Model.ToDate?.ToString("yyyy-MM-dd"), brand = Model.Brand, categoryId = Model.CategoryId, sortBy = Model.SortBy, pageSize = Model.PageSize, page = p })">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Returns", "SupplierDashboard", new { search = Model.Search, reason = Model.Reason, resolution = Model.Resolution, status = Model.Status, fromDate = Model.FromDate?.ToString("yyyy-MM-dd"), toDate = Model.ToDate?.ToString("yyyy-MM-dd"), brand = Model.Brand, categoryId = Model.CategoryId, sortBy = Model.SortBy, pageSize = Model.PageSize, page = Model.Page + 1 })">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
