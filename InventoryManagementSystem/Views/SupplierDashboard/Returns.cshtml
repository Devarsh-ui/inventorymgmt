@model IEnumerable<InventoryManagementSystem.Models.SupplierPurchaseReturn>
@{
    ViewData["Title"] = "Damaged & Returned Stock";
    var statusCounts = ViewBag.StatusCounts as Dictionary<string, long> ?? new Dictionary<string, long>();
    var currentStatus = ViewBag.Status as string;
    var currentReason = ViewBag.Reason as string;
    var search = ViewBag.Search as string;

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    long totalCount = ViewBag.TotalCount ?? 0;
    int pageSize = ViewBag.PageSize ?? 10;

    int startRecord = totalCount > 0 ? (currentPage - 1) * pageSize + 1 : 0;
    int endRecord = (int)System.Math.Min(currentPage * pageSize, totalCount);

    long totalClaims = ViewBag.TotalClaims ?? 0;
    long acceptedClaims = ViewBag.AcceptedClaims ?? 0;
    long rejectedClaims = ViewBag.RejectedClaims ?? 0;
    long totalReturnedUnits = ViewBag.TotalReturnedUnits ?? 0;
    decimal totalReturnValue = ViewBag.TotalReturnValue ?? 0m;
    long damagedCount = ViewBag.DamagedCount ?? 0;
    long defectiveCount = ViewBag.DefectiveCount ?? 0;
}

<!-- Page Header -->
<div class="ph">
    <div>
        <h1 class="ph-title"><i class="bi bi-box-seam me-2" style="color:var(--danger)"></i>Damaged & Returned Stock</h1>
        <p class="ph-sub">Track purchase return requests, review claims, and process stock deductions for defective goods</p>
    </div>
</div>

<!-- 4 Key KPI Statistics Cards -->
<div class="row g-3 mb-4">
    <!-- Total Return Claims Card -->
    <div class="col-md-3">
        <div class="card-d card-p border-start border-4 border-warning">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted style-sm fw-semibold mb-1">Total Return Claims</div>
                    <div class="fs-3 fw-bold" style="color:var(--text-primary)">@totalClaims</div>
                    <div class="style-xs text-muted mt-1">
                        <span class="text-success fw-bold">@acceptedClaims</span> Accepted · <span class="text-danger fw-bold">@rejectedClaims</span> Rejected
                    </div>
                </div>
                <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning">
                    <i class="bi bi-arrow-return-left fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Processed / Accepted Claims -->
    <div class="col-md-3">
        <div class="card-d card-p border-start border-4 border-success">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted style-sm fw-semibold mb-1">Approved & Deducted</div>
                    <div class="fs-3 fw-bold text-success">@acceptedClaims</div>
                    <div class="style-xs text-muted mt-1">Deducted from shop catalog</div>
                </div>
                <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success">
                    <i class="bi bi-check-circle fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Returned Units -->
    <div class="col-md-3">
        <div class="card-d card-p border-start border-4 border-info">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted style-sm fw-semibold mb-1">Total Returned Stock</div>
                    <div class="fs-3 fw-bold text-info">@totalReturnedUnits <span class="fs-6 text-muted">Units</span></div>
                    <div class="style-xs text-muted mt-1">
                        <span class="fw-bold">@damagedCount</span> Transit Damaged · <span class="fw-bold">@defectiveCount</span> Defective
                    </div>
                </div>
                <div class="rounded-circle bg-info bg-opacity-10 p-3 text-info">
                    <i class="bi bi-boxes fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Return Credit Value -->
    <div class="col-md-3">
        <div class="card-d card-p border-start border-4 border-primary">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted style-sm fw-semibold mb-1">Total Return Value</div>
                    <div class="fs-3 fw-bold text-primary">₹@totalReturnValue.ToString("N2")</div>
                    <div class="style-xs text-muted mt-1">Value of returned stock claims</div>
                </div>
                <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary">
                    <i class="bi bi-currency-rupee fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Detailed Filter Panel Card -->
<div class="card-d card-p mb-4">
    <form method="get" action="@Url.Action("Returns")">
        <div class="row g-3 align-items-end">
            <!-- Keyword Search -->
            <div class="col-md-4">
                <label class="form-label style-lbl" style="font-size:12px;font-weight:600;color:var(--text-muted)">Search Keywords</label>
                <div class="input-group">
                    <span class="input-group-text style-ig-text" style="background:var(--bg);border-color:var(--border)">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" name="search" value="@search" class="form-control fg-control" placeholder="Return #, PO #, Product, IMEI..." />
                </div>
            </div>

            <!-- Status Filter -->
            <div class="col-md-3">
                <label class="form-label style-lbl" style="font-size:12px;font-weight:600;color:var(--text-muted)">Filter by Status</label>
                <select name="status" class="form-select fg-control">
                    <option value="">All Return Statuses</option>
                    <option value="Submitted" selected="@(currentStatus == "Submitted")">Submitted / Pending</option>
                    <option value="Supplier Accepted" selected="@(currentStatus == "Supplier Accepted")">Supplier Accepted</option>
                    <option value="Supplier Rejected" selected="@(currentStatus == "Supplier Rejected")">Supplier Rejected</option>
                    <option value="Shipped" selected="@(currentStatus == "Shipped")">Shipped</option>
                    <option value="Completed" selected="@(currentStatus == "Completed")">Completed</option>
                </select>
            </div>

            <!-- Reason Filter -->
            <div class="col-md-3">
                <label class="form-label style-lbl" style="font-size:12px;font-weight:600;color:var(--text-muted)">Filter by Reason</label>
                <select name="reason" class="form-select fg-control">
                    <option value="">All Return Reasons</option>
                    <option value="Defective" selected="@(currentReason == "Defective")">Defective Product</option>
                    <option value="Damaged on Arrival" selected="@(currentReason == "Damaged on Arrival")">Damaged on Arrival</option>
                    <option value="Wrong Product" selected="@(currentReason == "Wrong Product")">Wrong Product</option>
                    <option value="IMEI Issue" selected="@(currentReason == "IMEI Issue")">IMEI Issue</option>
                    <option value="Quality Issue" selected="@(currentReason == "Quality Issue")">Quality Issue</option>
                </select>
            </div>

            <!-- Action Buttons -->
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn-d btn-primary flex-fill">
                    <i class="bi bi-funnel me-1"></i> Filter
                </button>
                <a href="@Url.Action("Returns")" class="btn-d btn-outline" title="Reset Filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </div>
    </form>
</div>

<!-- Table Container Card -->
<div class="card-d card-p p-0 overflow-hidden mb-4">
    <div class="tbl-scroll">
        <table class="tbl mb-0">
            <thead>
                <tr>
                    <th class="ps-4">Return Number</th>
                    <th>PO Number</th>
                    <th>Date Requested</th>
                    <th>Returned Items</th>
                    <th>Total Qty</th>
                    <th>Refund Value</th>
                    <th>Reason</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox text-muted d-block mb-2" style="font-size:32px"></i>
                            No damaged or returned stock entries found.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var r in Model)
                    {
                        var statusBadge = r.Status switch
                        {
                            "Submitted" => "badge-warning",
                            "Supplier Accepted" => "badge-success",
                            "Supplier Rejected" => "badge-danger",
                            "Shipped" => "badge-info",
                            "Completed" => "badge-success",
                            "Cancelled" => "badge-gray",
                            _ => "badge-gray"
                        };
                        <tr>
                            <td class="ps-4 fw-bold">
                                <a href="@Url.Action("ReturnDetails", new { id = r.Id })" class="text-decoration-none" style="color:var(--primary)">
                                    @r.ReturnNumber
                                </a>
                            </td>
                            <td><span class="text-muted fw-semibold">#@r.PurchaseOrderNumber</span></td>
                            <td style="font-size:12px;color:var(--text-primary)">@r.CreatedAt.ToString("dd-MMM-yyyy HH:mm") IST</td>
                            <td>
                                <span class="badge-d badge-gray">@r.Items.Count Products</span>
                                @if (r.TotalDeviceCount > 0)
                                {
                                    <span class="badge-d badge-info ms-1">@r.TotalDeviceCount IMEIs</span>
                                }
                            </td>
                            <td style="font-weight:700">@r.TotalQuantity Units</td>
                            <td style="font-weight:800;color:var(--danger)">₹@r.TotalReturnValue.ToString("N2")</td>
                            <td>
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 style-xs">
                                    @r.Reason
                                </span>
                            </td>
                            <td><span class="badge-d @statusBadge">@r.Status</span></td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-1 align-items-center">
                                    <a href="@Url.Action("ReturnDetails", new { id = r.Id })" class="btn-d btn-ghost btn-sm-d text-primary" title="View Return Details">
                                        <i class="bi bi-eye me-1"></i> View
                                    </a>
                                    @if (r.Status == "Submitted" || r.Status == "Supplier Notified" || r.Status == "Shipped")
                                    {
                                        <button type="button" class="btn-d btn-success btn-sm-d" onclick="openAcceptModal('@r.Id', '@r.ReturnNumber')">
                                            <i class="bi bi-check-lg me-1"></i> Accept
                                        </button>
                                        <button type="button" class="btn-d btn-outline-danger btn-sm-d" onclick="openRejectModal('@r.Id', '@r.ReturnNumber')">
                                            <i class="bi bi-x-lg me-1"></i> Reject
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Pagination Controls -->
@if (totalPages > 1)
{
    <div class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-3 bg-card p-3 rounded-3" style="border:1px solid var(--border)">
        <div class="text-muted style-sm" style="font-size:13px">
            Showing <strong class="text-primary">@startRecord</strong> to <strong class="text-primary">@endRecord</strong> of <strong>@totalCount</strong> return entries
        </div>
        <nav aria-label="Return Pagination">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <a class="page-link style-pl" href="@Url.Action("Returns", new { status = currentStatus, reason = currentReason, search, page = currentPage - 1 })">
                        <i class="bi bi-chevron-left"></i> Prev
                    </a>
                </li>
                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == currentPage ? "active" : "")">
                        <a class="page-link style-pl" href="@Url.Action("Returns", new { status = currentStatus, reason = currentReason, search, page = p })">@p</a>
                    </li>
                }
                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <a class="page-link style-pl" href="@Url.Action("Returns", new { status = currentStatus, reason = currentReason, search, page = currentPage + 1 })">
                        Next <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
}

<!-- Accept Return Modal -->
<div class="modal fade" id="acceptReturnModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-card border" style="border-color:var(--border)!important">
            <form method="post" action="@Url.Action("AcceptReturn")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnId" id="acceptReturnId" value="" />
                
                <div class="modal-header border-bottom" style="border-color:var(--border)!important">
                    <h5 class="modal-title fw-bold text-success"><i class="bi bi-check-circle me-2"></i>Accept Return Request</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="style-sm text-muted">
                        Are you sure you want to accept Purchase Return request <strong id="acceptReturnNumberText" class="text-primary"></strong>?
                    </p>
                    <div class="alert alert-info py-2 px-3 style-xs mb-3">
                        <i class="bi bi-info-circle me-1"></i> Accepting this return request will reduce the item stock from the <strong>Admin Shop Catalog</strong> and confirm credit return value.
                    </div>
                    <div class="mb-3">
                        <label class="form-label style-lbl fw-semibold">Supplier Acknowledgement Notes (Optional)</label>
                        <textarea name="supplierNotes" class="form-control fg-control" rows="3" placeholder="Add return approval notes, credit note details, or replacement instructions..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top" style="border-color:var(--border)!important">
                    <button type="button" class="btn-d btn-outline" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-d btn-success"><i class="bi bi-check-lg me-1"></i> Accept Return & Deduct Stock</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Reject Return Modal -->
<div class="modal fade" id="rejectReturnModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-card border" style="border-color:var(--border)!important">
            <form method="post" action="@Url.Action("RejectReturn")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnId" id="rejectReturnId" value="" />
                
                <div class="modal-header border-bottom" style="border-color:var(--border)!important">
                    <h5 class="modal-title fw-bold text-danger"><i class="bi bi-x-circle me-2"></i>Reject Return Request</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="style-sm text-muted">
                        Rejecting Purchase Return request <strong id="rejectReturnNumberText" class="text-danger"></strong>.
                    </p>
                    <div class="mb-3">
                        <label class="form-label style-lbl fw-semibold text-danger">Reason for Rejection <span class="text-danger">*</span></label>
                        <textarea name="rejectionReason" class="form-control fg-control" rows="3" required placeholder="Specify reason for rejecting this return request (e.g., Warranty expired, Physical damage not covered, Missing parts)..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top" style="border-color:var(--border)!important">
                    <button type="button" class="btn-d btn-outline" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-d btn-danger"><i class="bi bi-x-lg me-1"></i> Confirm Rejection</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openAcceptModal(id, number) {
        document.getElementById("acceptReturnId").value = id;
        document.getElementById("acceptReturnNumberText").textContent = "#" + number;
        var modal = new bootstrap.Modal(document.getElementById("acceptReturnModal"));
        modal.show();
    }

    function openRejectModal(id, number) {
        document.getElementById("rejectReturnId").value = id;
        document.getElementById("rejectReturnNumberText").textContent = "#" + number;
        var modal = new bootstrap.Modal(document.getElementById("rejectReturnModal"));
        modal.show();
    }
</script>
