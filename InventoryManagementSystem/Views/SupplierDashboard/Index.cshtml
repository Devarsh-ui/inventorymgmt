@model IEnumerable<InventoryManagementSystem.Models.SupplierOrder>
@{
    ViewData["Title"] = "Supplier Portal Dashboard";
    var supplier = ViewBag.Supplier as InventoryManagementSystem.Models.Supplier;
    var orderCounts = ViewBag.OrderCounts as Dictionary<string, long> ?? new Dictionary<string, long>();
    var totalProducts = ViewBag.TotalProducts ?? 0;
    var activeProducts = ViewBag.ActiveProducts ?? 0;
}

<!-- Page Header -->
<div class="ph">
    <div>
        <h1 class="ph-title"><i class="bi bi-speedometer2 me-2" style="color:var(--primary)"></i>Supplier Portal Dashboard</h1>
        <p class="ph-sub">Welcome back, <strong>@(supplier?.ContactPerson ?? supplier?.CompanyName)</strong> · @(supplier?.CompanyName)</p>
    </div>
    <div class="ph-actions">
        <a href="@Url.Action("StockIn")" class="btn-d btn-outline" style="border-color:var(--success);color:var(--success)">
            <i class="bi bi-arrow-down-circle me-1"></i> Stock In
        </a>
        <a href="@Url.Action("StockOut")" class="btn-d btn-outline" style="border-color:var(--danger);color:var(--danger)">
            <i class="bi bi-arrow-up-circle me-1"></i> Stock Out
        </a>
        <a href="@Url.Action("Inventory")" class="btn-d btn-outline">
            <i class="bi bi-boxes me-1"></i> Stock Inventory
        </a>
        <a href="@Url.Action("Stats")" class="btn-d btn-outline">
            <i class="bi bi-graph-up-arrow me-1"></i> Sales Stats
        </a>
        <a href="@Url.Action("Orders")" class="btn-d btn-primary">
            <i class="bi bi-cart-check me-1"></i> Orders (@(orderCounts.GetValueOrDefault("Total", 0)))
        </a>
    </div>
</div>

<!-- Summary Metrics Row -->
<div class="row g-3 mb-4">
    <div class="col-xl-3 col-sm-6">
        <div class="card-d card-p-lg h-100" style="background:var(--bg-card);border:1px solid var(--border)">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span style="font-size:12px;font-weight:700;color:var(--text-muted);text-transform:uppercase">Supplied Products</span>
                <div style="width:36px;height:36px;border-radius:10px;background:var(--primary-dim);display:flex;align-items:center;justify-content:center;color:var(--primary)">
                    <i class="bi bi-phone" style="font-size:18px"></i>
                </div>
            </div>
            <div style="font-size:28px;font-weight:800;color:var(--text-primary)">@totalProducts</div>
            <div style="font-size:12px;color:var(--success)" class="mt-1">
                <i class="bi bi-check-circle me-1"></i>@activeProducts Active Listings
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="card-d card-p-lg h-100" style="background:var(--bg-card);border:1px solid var(--border)">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span style="font-size:12px;font-weight:700;color:var(--text-muted);text-transform:uppercase">Pending Orders</span>
                <div style="width:36px;height:36px;border-radius:10px;background:rgba(234,179,8,0.15);display:flex;align-items:center;justify-content:center;color:var(--warning)">
                    <i class="bi bi-clock-history" style="font-size:18px"></i>
                </div>
            </div>
            <div style="font-size:28px;font-weight:800;color:var(--warning)">@(orderCounts.GetValueOrDefault("Pending", 0))</div>
            <div style="font-size:12px;color:var(--text-muted)" class="mt-1">Awaiting your acceptance</div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="card-d card-p-lg h-100" style="background:var(--bg-card);border:1px solid var(--border)">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span style="font-size:12px;font-weight:700;color:var(--text-muted);text-transform:uppercase">In Progress / Shipped</span>
                <div style="width:36px;height:36px;border-radius:10px;background:rgba(59,130,246,0.15);display:flex;align-items:center;justify-content:center;color:#3B82F6">
                    <i class="bi bi-truck" style="font-size:18px"></i>
                </div>
            </div>
            <div style="font-size:28px;font-weight:800;color:#3B82F6">@(orderCounts.GetValueOrDefault("Processing", 0) + orderCounts.GetValueOrDefault("Shipped", 0))</div>
            <div style="font-size:12px;color:var(--text-muted)" class="mt-1">Processing or in transit</div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="card-d card-p-lg h-100" style="background:var(--bg-card);border:1px solid var(--border)">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span style="font-size:12px;font-weight:700;color:var(--text-muted);text-transform:uppercase">Completed Orders</span>
                <div style="width:36px;height:36px;border-radius:10px;background:rgba(34,197,94,0.15);display:flex;align-items:center;justify-content:center;color:var(--success)">
                    <i class="bi bi-check2-all" style="font-size:18px"></i>
                </div>
            </div>
            <div style="font-size:28px;font-weight:800;color:var(--success)">@(orderCounts.GetValueOrDefault("Completed", 0) + orderCounts.GetValueOrDefault("Delivered", 0))</div>
            <div style="font-size:12px;color:var(--text-muted)" class="mt-1">Delivered & fulfilled</div>
        </div>
    </div>
</div>

<!-- Recent Orders Table Card -->
<div class="card-d card-p p-0 overflow-hidden">
    <div class="d-flex align-items-center justify-content-between p-3 border-bottom" style="border-color:var(--border)!important">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-receipt text-primary"></i>
            <span style="font-weight:700;font-size:14px;color:var(--text-primary)">Recent Purchase Orders Received</span>
        </div>
        <a href="@Url.Action("Orders")" style="font-size:12px;font-weight:600;color:var(--primary)" class="text-decoration-none">View All Orders →</a>
    </div>

    <div class="tbl-scroll">
        <table class="tbl mb-0">
            <thead>
                <tr>
                    <th class="ps-4">PO Number</th>
                    <th>Date & Time</th>
                    <th>Items Count</th>
                    <th>Total Qty</th>
                    <th>Grand Total</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-cart-x text-muted d-block mb-2" style="font-size:32px"></i>
                            No purchase orders received yet.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var o in Model)
                    {
                        var statusBadge = o.Status switch
                        {
                            "Pending" => "badge-warning",
                            "Accepted" => "badge-info",
                            "Processing" => "badge-primary",
                            "Shipped" => "badge-primary",
                            "Delivered" => "badge-success",
                            "Completed" => "badge-success",
                            "Rejected" => "badge-danger",
                            _ => "badge-gray"
                        };
                        <tr>
                            <td class="ps-4 fw-bold text-primary">
                                <a href="@Url.Action("OrderDetails", new { id = o.Id })" class="text-decoration-none" style="color:var(--primary)">
                                    @o.OrderNumber
                                </a>
                            </td>
                            <td style="font-size:12px;color:var(--text-primary)">@o.CreatedAt.ToString("dd-MMM-yyyy HH:mm") IST</td>
                            <td><span class="badge-d badge-gray">@o.Items.Count Products</span></td>
                            <td style="font-weight:700">@o.TotalQuantity Units</td>
                            <td style="font-weight:800;color:var(--success)">₹@o.GrandTotal.ToString("N2")</td>
                            <td><span class="badge-d @statusBadge">@o.Status</span></td>
                            <td class="text-end pe-4">
                                <a href="@Url.Action("OrderDetails", new { id = o.Id })" class="btn-d btn-ghost btn-icon-d text-primary" title="View Order Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
