@model InventoryManagementSystem.ViewModels.SupplierStatsViewModel
@{
    ViewData["Title"] = "Supplier Sales Statistics & Performance Analytics";
}

<!-- Page Header -->
<div class="ph mb-4">
    <div>
        <h1 class="ph-title"><i class="bi bi-graph-up-arrow me-2" style="color:var(--primary)"></i>Sales Stats & Performance Analytics</h1>
        <p class="ph-sub">Comprehensive financial insights, order fulfillment trends, best-selling supplied items, and category stats.</p>
    </div>
    <div class="ph-actions">
        <a href="@Url.Action("Inventory")" class="btn-d btn-outline">
            <i class="bi bi-boxes me-1"></i> Stock Inventory
        </a>
        <a href="@Url.Action("Orders")" class="btn-d btn-primary">
            <i class="bi bi-cart-check me-1"></i> Received Orders
        </a>
    </div>
</div>

<!-- Detailed Filter Controls -->
<div class="card-d card-p mb-4" style="background:var(--bg-card);border:1px solid var(--border)">
    <form method="get" action="@Url.Action("Stats")" class="row g-3 align-items-end" id="statsFilterForm">
        <div class="col-lg-3 col-md-6">
            <label class="form-label style-lbl mb-1"><i class="bi bi-calendar-range me-1"></i>Date Range Preset</label>
            <select name="rangePreset" id="rangePresetSelect" class="form-select" onchange="toggleCustomDates()">
                <option value="today" selected="@(Model.RangePreset == "today")">Today</option>
                <option value="7days" selected="@(Model.RangePreset == "7days")">Last 7 Days</option>
                <option value="30days" selected="@(Model.RangePreset == "30days")">Last 30 Days</option>
                <option value="thismonth" selected="@(Model.RangePreset == "thismonth")">This Month</option>
                <option value="custom" selected="@(Model.RangePreset == "custom")">Custom Date Range</option>
            </select>
        </div>

        <div class="col-lg-2 col-md-6 custom-date-field" style="display:@(Model.RangePreset == "custom" ? "block" : "none")">
            <label class="form-label style-lbl mb-1">Start Date</label>
            <input type="date" name="startDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>

        <div class="col-lg-2 col-md-6 custom-date-field" style="display:@(Model.RangePreset == "custom" ? "block" : "none")">
            <label class="form-label style-lbl mb-1">End Date</label>
            <input type="date" name="endDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>

        <div class="col-lg-3 col-md-6">
            <label class="form-label style-lbl mb-1"><i class="bi bi-filter-circle me-1"></i>Order Status Filter</label>
            <select name="statusFilter" class="form-select">
                <option value="All" selected="@(string.IsNullOrEmpty(Model.StatusFilter) || Model.StatusFilter == "All")">All Order Statuses</option>
                <option value="Delivered" selected="@(Model.StatusFilter == "Delivered")">Delivered & Fulfilled</option>
                <option value="Shipped" selected="@(Model.StatusFilter == "Shipped")">Shipped</option>
                <option value="Processing" selected="@(Model.StatusFilter == "Processing")">Processing / Accepted</option>
                <option value="Pending" selected="@(Model.StatusFilter == "Pending")">Pending Acceptance</option>
                <option value="Rejected" selected="@(Model.StatusFilter == "Rejected")">Rejected</option>
            </select>
        </div>

        <div class="col-lg-2 col-md-6 d-flex gap-2">
            <button type="submit" class="btn-d btn-primary flex-fill"><i class="bi bi-arrow-repeat me-1"></i>Apply</button>
            <a href="@Url.Action("Stats")" class="btn-d btn-outline" title="Reset Filters"><i class="bi bi-x-circle"></i></a>
        </div>
    </form>
</div>

<!-- Primary KPI Cards Row -->
<div class="row g-3 mb-4">
    <div class="col-xl-3 col-sm-6">
        <div class="card-d card-p-lg h-100" style="background:var(--bg-card);border:1px solid var(--border)">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span style="font-size:12px;font-weight:700;color:var(--text-muted);text-transform:uppercase">Fulfilled Revenue</span>
                <div style="width:36px;height:36px;border-radius:10px;background:rgba(34,197,94,0.15);display:flex;align-items:center;justify-content:center;color:var(--success)">
                    <i class="bi bi-cash-stack" style="font-size:18px"></i>
                </div>
            </div>
            <div style="font-size:26px;font-weight:800;color:var(--success)">₹@Model.TotalRevenue.ToString("N2")</div>
            <div style="font-size:12px;color:var(--text-muted)" class="mt-1">
                From @Model.CompletedOrdersCount fulfilled purchase orders
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="card-d card-p-lg h-100" style="background:var(--bg-card);border:1px solid var(--border)">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span style="font-size:12px;font-weight:700;color:var(--text-muted);text-transform:uppercase">Units Supplied</span>
                <div style="width:36px;height:36px;border-radius:10px;background:rgba(59,130,246,0.15);display:flex;align-items:center;justify-content:center;color:#3B82F6">
                    <i class="bi bi-box-seam" style="font-size:18px"></i>
                </div>
            </div>
            <div style="font-size:26px;font-weight:800;color:#3B82F6">@Model.TotalUnitsSupplied</div>
            <div style="font-size:12px;color:var(--text-muted)" class="mt-1">Total mobile units shipped & delivered</div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="card-d card-p-lg h-100" style="background:var(--bg-card);border:1px solid var(--border)">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span style="font-size:12px;font-weight:700;color:var(--text-muted);text-transform:uppercase">Acceptance Rate</span>
                <div style="width:36px;height:36px;border-radius:10px;background:var(--primary-dim);display:flex;align-items:center;justify-content:center;color:var(--primary)">
                    <i class="bi bi-check-circle" style="font-size:18px"></i>
                </div>
            </div>
            <div style="font-size:26px;font-weight:800;color:var(--primary)">@Model.AcceptanceRatePercentage%</div>
            <div style="font-size:12px;color:var(--text-muted)" class="mt-1">
                @Model.TotalOrdersCount Total POs received (@Model.RejectedOrdersCount Rejected)
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="card-d card-p-lg h-100" style="background:var(--bg-card);border:1px solid var(--border)">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span style="font-size:12px;font-weight:700;color:var(--text-muted);text-transform:uppercase">Avg Order Value</span>
                <div style="width:36px;height:36px;border-radius:10px;background:rgba(234,179,8,0.15);display:flex;align-items:center;justify-content:center;color:var(--warning)">
                    <i class="bi bi-calculator" style="font-size:18px"></i>
                </div>
            </div>
            <div style="font-size:26px;font-weight:800;color:var(--warning)">₹@Model.AverageOrderValue.ToString("N0")</div>
            <div style="font-size:12px;color:var(--text-muted)" class="mt-1">Top Category: <strong>@Model.TopCategoryName</strong></div>
        </div>
    </div>
</div>

<!-- Analytical Charts Section -->
<div class="row g-3 mb-4">
    <!-- Revenue & Sales Timeline Chart -->
    <div class="col-lg-8">
        <div class="card-d card-p h-100" style="background:var(--bg-card);border:1px solid var(--border)">
            <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2" style="border-color:var(--border)!important">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-graph-up text-primary"></i>
                    <span style="font-weight:700;font-size:15px;color:var(--text-primary)">Revenue & Fulfillment Trend</span>
                </div>
                <span class="badge-d badge-primary">@Model.RangePreset.ToUpper()</span>
            </div>
            <div style="height:280px;position:relative">
                <canvas id="timelineChart"></canvas>
            </div>
        </div>
    </div>

    <!-- PO Status Distribution -->
    <div class="col-lg-4">
        <div class="card-d card-p h-100" style="background:var(--bg-card);border:1px solid var(--border)">
            <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2" style="border-color:var(--border)!important">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-pie-chart text-primary"></i>
                    <span style="font-weight:700;font-size:15px;color:var(--text-primary)">PO Status Breakdown</span>
                </div>
            </div>
            <div style="height:220px;position:relative" class="d-flex align-items-center justify-content-center">
                <canvas id="statusChart"></canvas>
            </div>
            <div class="mt-3 pt-2 border-top" style="border-color:var(--border)!important">
                <div class="d-flex justify-content-between text-muted" style="font-size:12px">
                    <span>Delivered: <strong>@(Model.StatusDistribution.GetValueOrDefault("Delivered", 0) + Model.StatusDistribution.GetValueOrDefault("Completed", 0))</strong></span>
                    <span>Shipped: <strong>@Model.StatusDistribution.GetValueOrDefault("Shipped", 0)</strong></span>
                    <span>Pending: <strong>@Model.StatusDistribution.GetValueOrDefault("Pending", 0)</strong></span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Detailed Data Breakdown Section -->
<div class="row g-3 mb-4">
    <!-- Top 5 Best Selling Supplied Products -->
    <div class="col-lg-7">
        <div class="card-d card-p p-0 overflow-hidden h-100" style="background:var(--bg-card);border:1px solid var(--border)">
            <div class="p-3 border-bottom d-flex align-items-center gap-2" style="border-color:var(--border)!important">
                <i class="bi bi-trophy text-warning"></i>
                <span style="font-weight:700;font-size:14px;color:var(--text-primary)">Top 5 Best-Selling Supplied Mobile Products</span>
            </div>
            <div class="tbl-scroll">
                <table class="tbl mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Product Name</th>
                            <th>Category</th>
                            <th>Units Sold</th>
                            <th>Total Revenue</th>
                            <th class="pe-4 text-end">In Stock</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.TopProducts == null || !Model.TopProducts.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    No sales performance recorded for supplied items in this period.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var tp in Model.TopProducts)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-2">
                                            @if (!string.IsNullOrWhiteSpace(tp.ImageUrl))
                                            {
                                                <img src="@tp.ImageUrl" alt="@tp.ProductName" style="width:32px;height:32px;object-fit:contain;border-radius:6px;border:1px solid var(--border)" />
                                            }
                                            <div>
                                                <div class="fw-bold" style="font-size:13px;color:var(--text-primary)">@tp.ProductName</div>
                                                <div style="font-size:11px;color:var(--text-muted)">Brand: @tp.Brand</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="badge-d badge-gray">@tp.CategoryName</span></td>
                                    <td style="font-weight:700">@tp.UnitsSold Units</td>
                                    <td style="font-weight:800;color:var(--success)">₹@tp.TotalRevenue.ToString("N2")</td>
                                    <td class="pe-4 text-end fw-bold">@tp.CurrentStock</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Category Sales Breakdown -->
    <div class="col-lg-5">
        <div class="card-d card-p p-0 overflow-hidden h-100" style="background:var(--bg-card);border:1px solid var(--border)">
            <div class="p-3 border-bottom d-flex align-items-center gap-2" style="border-color:var(--border)!important">
                <i class="bi bi-diagram-3 text-primary"></i>
                <span style="font-weight:700;font-size:14px;color:var(--text-primary)">Category Revenue Share</span>
            </div>
            <div class="p-3">
                @if (Model.CategoryBreakdown == null || !Model.CategoryBreakdown.Any())
                {
                    <div class="text-center py-4 text-muted">No category breakdown data available.</div>
                }
                else
                {
                    foreach (var c in Model.CategoryBreakdown)
                    {
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1" style="font-size:13px">
                                <span class="fw-bold" style="color:var(--text-primary)">@c.CategoryName</span>
                                <span style="font-weight:700;color:var(--success)">₹@c.TotalRevenue.ToString("N0") <small class="text-muted">(@c.PercentageShare%)</small></span>
                            </div>
                            <div class="progress" style="height:6px;background:var(--border);border-radius:4px">
                                <div class="progress-bar bg-primary" role="progressbar" style="width: @c.PercentageShare%"></div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- Chart.js Libraries -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    function toggleCustomDates() {
        const val = document.getElementById('rangePresetSelect').value;
        const fields = document.querySelectorAll('.custom-date-field');
        fields.forEach(f => {
            f.style.display = (val === 'custom') ? 'block' : 'none';
        });
    }

    document.addEventListener("DOMContentLoaded", function () {
        // Timeline Chart Data
        const timelineLabels = @Json.Serialize(Model.TimelineStats.Select(t => t.DateLabel));
        const timelineRevenue = @Json.Serialize(Model.TimelineStats.Select(t => t.Revenue));
        const timelineUnits = @Json.Serialize(Model.TimelineStats.Select(t => t.UnitsSold));

        const ctxTimeline = document.getElementById('timelineChart').getContext('2d');
        new Chart(ctxTimeline, {
            type: 'line',
            data: {
                labels: timelineLabels.length > 0 ? timelineLabels : ['No Data'],
                datasets: [
                    {
                        label: 'Revenue (₹)',
                        data: timelineRevenue.length > 0 ? timelineRevenue : [0],
                        borderColor: '#22c55e',
                        backgroundColor: 'rgba(34,197,94,0.1)',
                        fill: true,
                        tension: 0.3,
                        yAxisID: 'y'
                    },
                    {
                        label: 'Units Supplied',
                        data: timelineUnits.length > 0 ? timelineUnits : [0],
                        borderColor: '#3b82f6',
                        backgroundColor: 'transparent',
                        borderDash: [5, 5],
                        tension: 0.3,
                        yAxisID: 'y1'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { labels: { color: '#94a3b8' } }
                },
                scales: {
                    x: { ticks: { color: '#94a3b8' }, grid: { color: 'rgba(255,255,255,0.05)' } },
                    y: {
                        type: 'linear',
                        display: true,
                        position: 'left',
                        ticks: { color: '#22c55e' },
                        grid: { color: 'rgba(255,255,255,0.05)' }
                    },
                    y1: {
                        type: 'linear',
                        display: true,
                        position: 'right',
                        ticks: { color: '#3b82f6' },
                        grid: { drawOnChartArea: false }
                    }
                }
            }
        });

        // Status Distribution Chart
        const statusKeys = @Json.Serialize(Model.StatusDistribution.Keys);
        const statusValues = @Json.Serialize(Model.StatusDistribution.Values);

        const ctxStatus = document.getElementById('statusChart').getContext('2d');
        new Chart(ctxStatus, {
            type: 'doughnut',
            data: {
                labels: statusKeys.length > 0 ? statusKeys : ['No Orders'],
                datasets: [{
                    data: statusValues.length > 0 ? statusValues : [1],
                    backgroundColor: [
                        '#22c55e', '#3b82f6', '#eab308', '#ef4444', '#a855f7', '#64748b'
                    ],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom', labels: { color: '#94a3b8', boxWidth: 12 } }
                }
            }
        });
    });
</script>
