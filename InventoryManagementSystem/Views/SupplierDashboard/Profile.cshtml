@model InventoryManagementSystem.Models.Supplier
@{
    ViewData["Title"] = "Supplier Portal Profile";
}

<!-- Page Header -->
<div class="ph">
    <div>
        <h1 class="ph-title"><i class="bi bi-person-badge me-2" style="color:var(--primary)"></i>Supplier Portal Profile</h1>
        <p class="ph-sub">Manage vendor identity, contact details, office location, and portal credentials</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card-d card-p-lg">
            <div class="s-title"><i class="bi bi-building me-2" style="color:var(--primary)"></i>Vendor Company & Account Identity</div>

            <form asp-action="Profile" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert-d alert-danger mb-4"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div class="fg">
                            <label class="fg-label">Vendor / Brand Name <span class="req">*</span></label>
                            <input asp-for="VendorName" class="fg-control" required placeholder="e.g. ABC Mobiles" />
                            <span asp-validation-for="VendorName" class="fg-error"></span>
                            <div style="font-size:11px;color:var(--text-muted);margin-top:2px">Commercial, trading, or storefront brand name.</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="fg">
                            <label class="fg-label">Company / Legal Name <span class="req">*</span></label>
                            <input asp-for="CompanyName" class="fg-control" required placeholder="e.g. ABC Mobile Distribution Pvt. Ltd." />
                            <span asp-validation-for="CompanyName" class="fg-error"></span>
                            <div style="font-size:11px;color:var(--text-muted);margin-top:2px">Registered company or corporate legal identity.</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="fg">
                            <label class="fg-label">Contact Person Name</label>
                            <input asp-for="ContactPerson" class="fg-control" placeholder="e.g. Account Representative" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="fg">
                            <label class="fg-label">Email Address (Portal Login) <span class="req">*</span></label>
                            <input asp-for="Email" type="email" class="fg-control" required />
                            <span asp-validation-for="Email" class="fg-error"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="fg">
                            <label class="fg-label">Phone Number</label>
                            <input asp-for="Phone" class="fg-control" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="fg">
                            <label class="fg-label">Vendor GSTIN <span style="font-size:11px;color:var(--text-muted);font-weight:normal">(Optional)</span></label>
                            <input asp-for="Gstin" class="fg-control text-uppercase" maxlength="15" placeholder="e.g. 27AAAAA0000A1Z5 (Optional)" oninput="this.value = this.value.toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 15);" />
                            <span asp-validation-for="Gstin" class="fg-error"></span>
                            <div style="font-size:11px;color:var(--text-muted);margin-top:2px">Optional tax registration ID. Max 15 alphanumeric characters, no emojis or symbols.</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="fg">
                            <label class="fg-label">Payment Terms</label>
                            <input asp-for="PaymentTerms" class="fg-control" readonly style="background:var(--bg);cursor:not-allowed" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="fg">
                            <label class="fg-label">City</label>
                            <input asp-for="City" class="fg-control" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="fg">
                            <label class="fg-label">State</label>
                            <input asp-for="State" class="fg-control" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="fg">
                            <label class="fg-label">Country</label>
                            <input asp-for="Country" class="fg-control" />
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="fg">
                            <label class="fg-label">Warehouse / Office Street Address</label>
                            <textarea asp-for="Address" rows="2" class="fg-control"></textarea>
                        </div>
                    </div>
                </div>

                <hr class="s-divider" />
                <div class="s-title"><i class="bi bi-key me-2" style="color:var(--warning)"></i>Change Portal Login Password</div>
                <p style="font-size:12px;color:var(--text-muted);margin-bottom:14px">
                    Leave password fields blank if you do not wish to change your password. To set a new password, provide your current password and satisfy the password policy.
                </p>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <div class="fg">
                            <label class="fg-label">Current Password</label>
                            <div class="position-relative">
                                <input type="password" id="supDashCurrentPwd" name="currentPassword" class="fg-control" style="padding-right:40px" placeholder="Enter current password" />
                                <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y text-muted p-2" onclick="toggleSupDashPwd('supDashCurrentPwd', this)" style="border:none;background:none;text-decoration:none;">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="fg">
                            <label class="fg-label">New Password</label>
                            <div class="position-relative">
                                <input type="password" id="supDashNewPwd" name="newPassword" class="fg-control" style="padding-right:40px" placeholder="Create new password" oninput="evaluateSupDashPolicy(this.value)" />
                                <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y text-muted p-2" onclick="toggleSupDashPwd('supDashNewPwd', this)" style="border:none;background:none;text-decoration:none;">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="fg">
                            <label class="fg-label">Confirm New Password</label>
                            <div class="position-relative">
                                <input type="password" id="supDashConfPwd" name="confirmPassword" class="fg-control" style="padding-right:40px" placeholder="Repeat new password" oninput="evaluateSupDashMatch()" />
                                <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y text-muted p-2" onclick="toggleSupDashPwd('supDashConfPwd', this)" style="border:none;background:none;text-decoration:none;">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <div class="text-danger small mt-1" id="supDashMatchErr"></div>
                        </div>
                    </div>
                </div>

                <!-- Password Policy Checklist -->
                <div class="p-3 mb-4 rounded" style="background:var(--bg);border:1px solid var(--border);font-size:12px">
                    <div style="font-weight:700;color:var(--text-muted);margin-bottom:6px;text-transform:uppercase;font-size:11px">
                        <i class="bi bi-shield-check text-primary me-1"></i>New password must contain:
                    </div>
                    <div id="sd-req-len" style="color:var(--text-muted);margin-bottom:2px">
                        <i class="bi bi-circle me-1" id="sd-icon-len"></i> Minimum 8 characters
                    </div>
                    <div id="sd-req-upper" style="color:var(--text-muted);margin-bottom:2px">
                        <i class="bi bi-circle me-1" id="sd-icon-upper"></i> One uppercase letter (A-Z)
                    </div>
                    <div id="sd-req-lower" style="color:var(--text-muted);margin-bottom:2px">
                        <i class="bi bi-circle me-1" id="sd-icon-lower"></i> One lowercase letter (a-z)
                    </div>
                    <div id="sd-req-num" style="color:var(--text-muted);margin-bottom:2px">
                        <i class="bi bi-circle me-1" id="sd-icon-num"></i> One number (0-9)
                    </div>
                    <div id="sd-req-spec" style="color:var(--text-muted);margin-bottom:2px">
                        <i class="bi bi-circle me-1" id="sd-icon-spec"></i> One special character (!@@#$%^&*...)
                    </div>
                </div>

                <div class="d-flex align-items-center justify-content-end gap-2">
                    <button type="submit" class="btn-d btn-primary">
                        <i class="bi bi-check2-circle me-1"></i> Save Profile Details
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Right Side Account Details Summary Card -->
    <div class="col-lg-4">
        <div class="card-d card-p-lg">
            <div class="s-title"><i class="bi bi-shield-check me-2" style="color:var(--success)"></i>Portal Credentials & Identity</div>
            <div class="mb-3">
                <div style="font-size:12px;color:var(--text-muted)">Vendor / Brand Name:</div>
                <div style="font-size:14px;font-weight:700;color:var(--text-primary)">@Model.DisplayVendorName</div>
            </div>
            <div class="mb-3">
                <div style="font-size:12px;color:var(--text-muted)">Company / Legal Name:</div>
                <div style="font-size:13px;color:var(--text-secondary)">@Model.DisplayCompanyName</div>
            </div>
            <div class="mb-3">
                <div style="font-size:12px;color:var(--text-muted)">Login Identifier:</div>
                <div style="font-size:14px;font-weight:700;color:var(--text-primary)">@Model.Email</div>
            </div>
            <div class="mb-3">
                <div style="font-size:12px;color:var(--text-muted)">Account Status:</div>
                <span class="badge-d badge-success">@Model.Status</span>
            </div>
            <div class="mb-3">
                <div style="font-size:12px;color:var(--text-muted)">Member Since:</div>
                <div style="font-size:13px;color:var(--text-primary)">@Model.CreatedDate.ToString("dd-MMM-yyyy")</div>
            </div>
            <div>
                <div style="font-size:12px;color:var(--text-muted)">Last Login:</div>
                <div style="font-size:13px;color:var(--text-primary)">@(Model.LastLogin.HasValue ? Model.LastLogin.Value.ToString("dd-MMM-yyyy HH:mm IST") : "First Session")</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleSupDashPwd(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = btn.querySelector('i');
            if (!input || !icon) return;
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'bi bi-eye';
            }
        }

        function setSdRule(rowId, iconId, isMet) {
            const row = document.getElementById(rowId);
            const icon = document.getElementById(iconId);
            if (!row || !icon) return;
            if (isMet) {
                row.style.color = '#34d399';
                row.style.fontWeight = '600';
                icon.className = 'bi bi-check-circle-fill text-success me-1';
            } else {
                row.style.color = 'var(--text-muted)';
                row.style.fontWeight = 'normal';
                icon.className = 'bi bi-circle me-1';
            }
        }

        function evaluateSupDashPolicy(val) {
            val = val || '';
            setSdRule('sd-req-len', 'sd-icon-len', val.length >= 8);
            setSdRule('sd-req-upper', 'sd-icon-upper', /[A-Z]/.test(val));
            setSdRule('sd-req-lower', 'sd-icon-lower', /[a-z]/.test(val));
            setSdRule('sd-req-num', 'sd-icon-num', /[0-9]/.test(val));
            setSdRule('sd-req-spec', 'sd-icon-spec', /[^A-Za-z0-9]/.test(val));
            evaluateSupDashMatch();
        }

        function evaluateSupDashMatch() {
            const pwd = document.getElementById('supDashNewPwd')?.value || '';
            const conf = document.getElementById('supDashConfPwd')?.value || '';
            const err = document.getElementById('supDashMatchErr');
            if (conf.length > 0 && pwd !== conf) {
                if (err) err.innerText = 'Passwords do not match.';
            } else {
                if (err) err.innerText = '';
            }
        }
    </script>
}
