@model IEnumerable<InventoryManagementSystem.Models.RepairTicket>
@{
    ViewData["Title"] = "Service & Repair Ticket Management";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-wrench-adjustable me-2 text-primary"></i>Service &amp; Repair Ticketing</h3>
        <p class="text-muted small mb-0">Track device repair tickets, technician assignment, job statuses, and service charges</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button type="button" class="btn btn-outline-primary rounded-pill px-3" id="repairFilterToggleBtn" onclick="toggleFilterPanel('repairFilterPanel', 'repairFilterToggleBtn')">
            <i class="bi bi-funnel-fill me-1"></i><span>Filters: ON</span>
        </button>
        <button type="button" class="btn btn-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#createRepairModal">
            <i class="bi bi-plus-circle me-1"></i> New Repair Job Ticket
        </button>
    </div>
</div>

<!-- Detailed Filters Bar (Toggleable Panel) -->
<div class="card border shadow-sm rounded-4 mb-4" id="repairFilterPanel">
    <div class="card-body p-3">
        <form method="get" class="row g-3">
            <!-- Row 1: Search & Hardware Specs -->
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted mb-1"><i class="bi bi-search me-1"></i>Search Keywords</label>
                <div class="search-pill">
                    <i class="bi bi-search search-pill-icon"></i>
                    <input type="text" name="search" value="@ViewBag.Search" class="search-pill-input" placeholder="Ticket #, IMEI, Customer, Problem...">
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1"><i class="bi bi-phone-fill me-1"></i>Brand</label>
                <select name="brand" class="form-select">
                    <option value="">All Brands</option>
                    <option value="Apple" selected="@(ViewBag.Brand == "Apple")">Apple</option>
                    <option value="Samsung" selected="@(ViewBag.Brand == "Samsung")">Samsung</option>
                    <option value="OnePlus" selected="@(ViewBag.Brand == "OnePlus")">OnePlus</option>
                    <option value="Xiaomi" selected="@(ViewBag.Brand == "Xiaomi")">Xiaomi</option>
                    <option value="Vivo" selected="@(ViewBag.Brand == "Vivo")">Vivo</option>
                    <option value="Oppo" selected="@(ViewBag.Brand == "Oppo")">Oppo</option>
                    <option value="Google" selected="@(ViewBag.Brand == "Google")">Google Pixel</option>
                    <option value="Other" selected="@(ViewBag.Brand == "Other")">Other</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1"><i class="bi bi-phone me-1"></i>Model Name</label>
                <input type="text" name="model" value="@ViewBag.Model" class="form-control" placeholder="e.g. iPhone 12, S20">
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted mb-1"><i class="bi bi-person-badge me-1"></i>Technician</label>
                <input type="text" name="technician" value="@ViewBag.Technician" class="form-control" placeholder="Technician name">
            </div>

            <!-- Row 2: Status & Cost Ranges -->
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted mb-1"><i class="bi bi-tag me-1"></i>Job Status</label>
                <select name="status" class="form-select">
                    <option value="">-- All Job Statuses --</option>
                    <option value="Received" selected="@(ViewBag.Status == "Received")">Received</option>
                    <option value="Diagnosing" selected="@(ViewBag.Status == "Diagnosing")">Diagnosing</option>
                    <option value="Repairing" selected="@(ViewBag.Status == "Repairing")">Repairing</option>
                    <option value="Ready" selected="@(ViewBag.Status == "Ready")">Ready for Delivery</option>
                    <option value="Delivered" selected="@(ViewBag.Status == "Delivered")">Delivered to Customer</option>
                    <option value="Cancelled" selected="@(ViewBag.Status == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1"><i class="bi bi-currency-rupee me-1"></i>Min Cost (₹)</label>
                <input type="number" step="100" name="minCost" value="@ViewBag.MinCost" class="form-control" placeholder="Min ₹">
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1"><i class="bi bi-currency-rupee me-1"></i>Max Cost (₹)</label>
                <input type="number" step="100" name="maxCost" value="@ViewBag.MaxCost" class="form-control" placeholder="Max ₹">
            </div>
            <div class="col-md-2 d-flex align-items-end gap-1">
                <button type="submit" class="btn btn-dark w-100 rounded-pill"><i class="bi bi-funnel me-1"></i>Filter</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary rounded-circle" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Table Card -->
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small uppercase">
                    <tr>
                        <th class="ps-4">Ticket #</th>
                        <th>Received Date</th>
                        <th>Customer</th>
                        <th>Device Model &amp; IMEI</th>
                        <th>Problem Reported</th>
                        <th>Technician</th>
                        <th>Est. / Final Cost</th>
                        <th>Status</th>
                        <th class="pe-4 text-end" style="width:160px">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">No active service tickets found.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var t in Model)
                        {
                            var badgeClass = t.Status switch
                            {
                                "Received" => "bg-secondary-subtle text-secondary border border-secondary-subtle",
                                "Diagnosing" => "bg-info-subtle text-info border border-info-subtle",
                                "Repairing" => "bg-warning-subtle text-warning border border-warning-subtle",
                                "Ready" => "bg-primary-subtle text-primary border border-primary-subtle",
                                "Delivered" => "bg-success-subtle text-success border border-success-subtle",
                                _ => "bg-light text-dark border"
                            };

                            <tr>
                                <td class="ps-4 font-monospace fw-bold text-primary">@t.TicketNumber</td>
                                <td class="small text-muted">@t.CreatedDate.ToString("yyyy-MM-dd HH:mm IST")</td>
                                <td>
                                    <div class="fw-semibold">@t.CustomerName</div>
                                    <div class="small text-muted">@t.CustomerPhone</div>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@t.DeviceBrand @t.DeviceModel</div>
                                    <div class="font-monospace small text-muted">IMEI: @(string.IsNullOrEmpty(t.IMEI) ? "-" : t.IMEI)</div>
                                </td>
                                <td>
                                    <div class="small text-wrap" style="max-width: 180px;">@t.ProblemDescription</div>
                                </td>
                                <td><span class="badge bg-light text-dark border">@(string.IsNullOrEmpty(t.TechnicianName) ? "Unassigned" : t.TechnicianName)</span></td>
                                <td>
                                    <div class="small text-muted">Est: ₹@t.EstimatedCost.ToString("N2")</div>
                                    <div class="fw-bold text-success">Final: ₹@t.FinalCost.ToString("N2")</div>
                                </td>
                                <td><span class="badge rounded-pill @badgeClass px-2 py-1">@t.Status</span></td>
                                <td class="pe-4 text-end">
                                    <div class="d-flex gap-1 justify-content-end">
                                        <button type="button" class="btn btn-sm btn-outline-info rounded-pill py-0 px-2" onclick="openRepairDetails('@t.Id')" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill py-0 px-2" onclick="openEditRepairModal('@t.Id')" title="Edit Ticket">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-warning rounded-pill py-0 px-2" data-bs-toggle="modal" data-bs-target="#updateStatusModal_@t.Id" title="Update Status">
                                            <i class="bi bi-gear"></i>
                                        </button>
                                        <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete Repair Ticket #@t.TicketNumber?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@t.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill py-0 px-2" title="Delete Ticket">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modals outside table for HTML validity -->
@if (Model != null)
{
    foreach (var t in Model)
    {
        <div class="modal fade" id="updateStatusModal_@t.Id" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow rounded-4">
                    <div class="modal-header border-0 pb-0">
                        <h5 class="fw-bold modal-title">Update Ticket #@t.TicketNumber</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <form asp-action="UpdateStatus" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@t.Id" />
                        <div class="modal-body py-3">
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Job Status</label>
                                <select name="status" class="form-select">
                                    <option value="Received" selected="@(t.Status == "Received")">Received</option>
                                    <option value="Diagnosing" selected="@(t.Status == "Diagnosing")">Diagnosing Problem</option>
                                    <option value="Repairing" selected="@(t.Status == "Repairing")">Repairing / Replacing Parts</option>
                                    <option value="Ready" selected="@(t.Status == "Ready")">Ready for Customer Pickup</option>
                                    <option value="Delivered" selected="@(t.Status == "Delivered")">Delivered &amp; Payment Collected</option>
                                    <option value="Cancelled" selected="@(t.Status == "Cancelled")">Cancelled</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Assigned Technician Name</label>
                                <input type="text" name="technicianName" value="@t.TechnicianName" class="form-control" placeholder="Technician Name">
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Final Repair &amp; Labor Cost (₹)</label>
                                <input type="number" step="0.01" name="finalCost" value="@t.FinalCost" class="form-control fw-bold text-success">
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Technician Notes</label>
                                <textarea name="notes" rows="2" class="form-control" placeholder="Replaced display touch panel, tested battery performance...">@t.Notes</textarea>
                            </div>
                        </div>
                        <div class="modal-footer border-0 pt-0">
                            <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary rounded-pill px-4">Update Status</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}

<!-- Modal: Create Repair Ticket -->
<div class="modal fade" id="createRepairModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="fw-bold modal-title"><i class="bi bi-wrench-adjustable me-2 text-primary"></i>Create Service &amp; Repair Job Ticket</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body py-3">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Customer Name <span class="text-danger">*</span></label>
                            <input type="text" name="CustomerName" required class="form-control" placeholder="Customer Name">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Customer Phone <span class="text-danger">*</span></label>
                            <input type="tel" name="CustomerPhone" required class="form-control phone-input" placeholder="Customer Phone">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Device Brand <span class="text-danger">*</span></label>
                            <input type="text" name="DeviceBrand" required class="form-control" placeholder="e.g. Samsung, Apple, Vivo">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Device Model <span class="text-danger">*</span></label>
                            <input type="text" name="DeviceModel" required class="form-control" placeholder="e.g. Galaxy S21, iPhone 12">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">IMEI Number</label>
                            <input type="text" name="IMEI" class="form-control font-monospace imei-input" placeholder="15-digit IMEI">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Estimated Repair Cost (₹)</label>
                            <input type="number" step="0.01" name="EstimatedCost" class="form-control" placeholder="e.g. 1500.00">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Assigned Technician</label>
                            <input type="text" name="TechnicianName" class="form-control" placeholder="Technician Name">
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Problem / Issue Reported <span class="text-danger">*</span></label>
                            <textarea name="ProblemDescription" required rows="2" class="form-control" placeholder="Screen broken, battery draining rapidly, charging port loose..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Create Repair Ticket</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: View Repair Ticket Details -->
<div class="modal fade" id="viewRepairModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="fw-bold modal-title"><i class="bi bi-info-circle me-2 text-info"></i>Repair Ticket Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-3" id="viewRepairModalBody">
                <div class="text-center py-4"><div class="spinner-border text-primary"></div></div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Edit Repair Ticket -->
<div class="modal fade" id="editRepairModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="fw-bold modal-title"><i class="bi bi-pencil-square me-2 text-primary"></i>Edit Repair Ticket</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="editRepairId" />
                <div class="modal-body py-3">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Customer Name <span class="text-danger">*</span></label>
                            <input type="text" name="CustomerName" id="editRepairCustomerName" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Customer Phone <span class="text-danger">*</span></label>
                            <input type="tel" name="CustomerPhone" id="editRepairCustomerPhone" class="form-control phone-input" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Device Brand</label>
                            <input type="text" name="DeviceBrand" id="editRepairDeviceBrand" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Device Model</label>
                            <input type="text" name="DeviceModel" id="editRepairDeviceModel" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">IMEI Number</label>
                            <input type="text" name="IMEI" id="editRepairIMEI" class="form-control font-monospace imei-input" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Job Status</label>
                            <select name="Status" id="editRepairStatus" class="form-select">
                                <option value="Received">Received</option>
                                <option value="Diagnosing">Diagnosing</option>
                                <option value="Repairing">Repairing</option>
                                <option value="Ready">Ready</option>
                                <option value="Delivered">Delivered</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Estimated Cost (₹)</label>
                            <input type="number" step="0.01" name="EstimatedCost" id="editRepairEstimatedCost" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Final Cost (₹)</label>
                            <input type="number" step="0.01" name="FinalCost" id="editRepairFinalCost" class="form-control fw-bold text-success" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Assigned Technician</label>
                            <input type="text" name="TechnicianName" id="editRepairTechnicianName" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Advance Paid (₹)</label>
                            <input type="number" step="0.01" name="AdvancePaid" id="editRepairAdvancePaid" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Problem / Issue Reported</label>
                            <textarea name="ProblemDescription" id="editRepairProblemDescription" class="form-control" rows="2" required></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Technician Notes</label>
                            <textarea name="Notes" id="editRepairNotes" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4"><i class="bi bi-check2-circle me-1"></i> Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
async function openRepairDetails(id) {
    const modalBody = document.getElementById('viewRepairModalBody');
    modalBody.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary"></div></div>';
    
    const modalEl = document.getElementById('viewRepairModal');
    const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
    modal.show();

    try {
        const res = await fetch(`/Repair/GetDetails?id=${id}`);
        const data = await res.json();
        if (data.success) {
            modalBody.innerHTML = `
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3">
                            <h6 class="fw-bold text-primary mb-2"><i class="bi bi-ticket-perforated me-1"></i>Ticket Info</h6>
                            <div><strong>Ticket #:</strong> <code class="fw-bold">${data.ticketNumber}</code></div>
                            <div><strong>Created:</strong> ${data.createdDate}</div>
                            ${data.completedDate ? `<div><strong>Completed:</strong> ${data.completedDate}</div>` : ''}
                            <div><strong>Status:</strong> <span class="badge bg-primary">${data.status}</span></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3">
                            <h6 class="fw-bold text-success mb-2"><i class="bi bi-person me-1"></i>Customer Details</h6>
                            <div><strong>Customer:</strong> ${data.customerName}</div>
                            <div><strong>Phone:</strong> ${data.customerPhone}</div>
                            <div><strong>Technician:</strong> ${data.technicianName || 'Unassigned'}</div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="p-3 bg-light rounded-3">
                            <h6 class="fw-bold text-dark mb-2"><i class="bi bi-phone me-1"></i>Device & Costs</h6>
                            <div><strong>Device:</strong> ${data.deviceBrand} ${data.deviceModel}</div>
                            ${data.imei ? `<div><strong>IMEI:</strong> <code class="text-primary fw-bold">${data.imei}</code></div>` : ''}
                            <div><strong>Problem:</strong> ${data.problemDescription}</div>
                            <div><strong>Est. Cost:</strong> ₹${data.estimatedCost.toFixed(2)} | <strong>Final Cost:</strong> <span class="fw-bold text-success">₹${data.finalCost.toFixed(2)}</span></div>
                            ${data.advancePaid ? `<div><strong>Advance Paid:</strong> ₹${data.advancePaid.toFixed(2)}</div>` : ''}
                            ${data.notes ? `<div class="mt-2"><strong>Notes:</strong> ${data.notes}</div>` : ''}
                        </div>
                    </div>
                </div>
            `;
        } else {
            modalBody.innerHTML = `<div class="alert alert-danger">${data.message || 'Failed to load details.'}</div>`;
        }
    } catch (err) {
        modalBody.innerHTML = `<div class="alert alert-danger">Error fetching ticket details: ${err}</div>`;
    }
}

async function openEditRepairModal(id) {
    try {
        const res = await fetch(`/Repair/GetDetails?id=${id}`);
        const data = await res.json();
        if (data.success) {
            document.getElementById('editRepairId').value = data.id;
            document.getElementById('editRepairCustomerName').value = data.customerName || '';
            document.getElementById('editRepairCustomerPhone').value = data.customerPhone || '';
            document.getElementById('editRepairDeviceBrand').value = data.deviceBrand || '';
            document.getElementById('editRepairDeviceModel').value = data.deviceModel || '';
            document.getElementById('editRepairIMEI').value = data.imei || '';
            document.getElementById('editRepairStatus').value = data.status || 'Received';
            document.getElementById('editRepairEstimatedCost').value = data.estimatedCost || 0;
            document.getElementById('editRepairFinalCost').value = data.finalCost || 0;
            document.getElementById('editRepairTechnicianName').value = data.technicianName || '';
            document.getElementById('editRepairAdvancePaid').value = data.advancePaid || 0;
            document.getElementById('editRepairProblemDescription').value = data.problemDescription || '';
            document.getElementById('editRepairNotes').value = data.notes || '';

            const modalEl = document.getElementById('editRepairModal');
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        } else {
            alert(data.message || 'Failed to load repair details.');
        }
    } catch (err) {
        alert('Error loading repair record for editing.');
    }
}
</script>
}
