@using InventoryManagementSystem.Models
@using InventoryManagementSystem.Interfaces
@model IEnumerable<AuditLog>
@{
    ViewData["Title"] = "System Activity Logs";
    var stats = ViewBag.Stats as AuditLogStats ?? new AuditLogStats();
    var userRoleStr = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var isAdmin = User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || string.Equals(userRoleStr, "Admin", StringComparison.OrdinalIgnoreCase) || string.Equals(userRoleStr, "SuperAdmin", StringComparison.OrdinalIgnoreCase);
}

<form id="anti-forgery-form" style="display:none">
    @Html.AntiForgeryToken()
</form>

<div class="ph">
    <div>
        <h1 class="ph-title"><i class="bi bi-journal-text text-primary me-2"></i>System Logs & Enterprise Audit Dashboard</h1>
        <p class="ph-sub">Central real-time activity, security events & audit monitoring system.</p>
    </div>
    <div class="ph-actions">
        <button type="button" class="btn-d btn-outline btn-sm-d" onclick="window.location.reload()">
            <i class="bi bi-arrow-clockwise"></i> Refresh
        </button>

        @if (isAdmin)
        {
            <button type="button" class="btn-d btn-outline text-danger btn-sm-d" onclick="executeClearAll()">
                <i class="bi bi-trash3"></i> Clear All Logs
            </button>
            <button type="button" class="btn-d btn-outline btn-sm-d" data-bs-toggle="modal" data-bs-target="#retentionModal" onclick="openRetentionModal()">
                <i class="bi bi-shield-slash"></i> Log Retention Policy
            </button>
            <div class="dropdown d-inline-block">
                <button class="btn-d btn-primary btn-sm-d dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    <i class="bi bi-download"></i> Export Logs
                </button>
                <ul class="dropdown-menu dropdown-menu-end dark-dropdown">
                    <li><a class="dropdown-item" href="#" onclick="triggerExport('csv')"><i class="bi bi-filetype-csv me-2 text-success"></i>Export as CSV</a></li>
                    <li><a class="dropdown-item" href="#" onclick="triggerExport('pdf')"><i class="bi bi-filetype-pdf me-2 text-danger"></i>Export as PDF Document</a></li>
                </ul>
            </div>
        }
    </div>
</div>

<!-- Hidden Export Form -->
<form id="export-form" method="post" action="/SystemLog/Export" style="display:none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="format" id="export-format" value="csv" />
    <input type="hidden" name="keyword" value="@ViewBag.Keyword" />
    <input type="hidden" name="module" value="@ViewBag.Module" />
    <input type="hidden" name="status" value="@ViewBag.Status" />
    <input type="hidden" name="logLevel" value="@ViewBag.LogLevel" />
</form>

<!-- Responsive Stats Grid -->
<div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3 mb-4">
    <div class="col">
        <div class="stat-card h-100">
            <div>
                <div class="sc-label">Total Audit Logs</div>
                <div class="sc-value text-primary">@stats.TotalLogs.ToString("N0")</div>
                <div class="sc-trend trend-flat"><i class="bi bi-clock-history me-1"></i>Today: @stats.TodayLogs.ToString("N0") events</div>
            </div>
            <div class="sc-icon ic-blue"><i class="bi bi-database"></i></div>
        </div>
    </div>
    <div class="col">
        <div class="stat-card h-100">
            <div>
                <div class="sc-label">Today's Employee Logins</div>
                <div class="sc-value text-success">@stats.TodayLogins.ToString("N0")</div>
                <div class="sc-trend trend-up"><i class="bi bi-person-check me-1"></i>Active sessions</div>
            </div>
            <div class="sc-icon ic-green"><i class="bi bi-person-badge"></i></div>
        </div>
    </div>
    <div class="col">
        <div class="stat-card h-100">
            <div>
                <div class="sc-label">Today's Sales & Invoices</div>
                <div class="sc-value text-info">@stats.TodaySales.ToString("N0")</div>
                <div class="sc-trend trend-up"><i class="bi bi-receipt me-1"></i>Processed transactions</div>
            </div>
            <div class="sc-icon ic-sky"><i class="bi bi-cart-check"></i></div>
        </div>
    </div>
    <div class="col">
        <div class="stat-card h-100">
            <div>
                <div class="sc-label">Errors & Security Alerts</div>
                <div class="sc-value text-danger">@(stats.ErrorLogs + stats.CriticalLogs)</div>
                <div class="sc-trend trend-down"><i class="bi bi-shield-exclamation me-1"></i>Critical & Security logs</div>
            </div>
            <div class="sc-icon ic-red"><i class="bi bi-shield-alert"></i></div>
        </div>
    </div>
</div>

<!-- Filters Bar -->
<div class="card-d mb-4 p-3">
    <form method="get" action="/SystemLog/Index" id="filter-form">
        <div class="row g-2 align-items-center">
            <div class="col-lg-3 col-md-4">
                <label class="form-label-d text-muted small mb-1">Search Everything</label>
                <div class="search-pill">
                    <i class="bi bi-search search-pill-icon"></i>
                    <input type="text" name="keyword" value="@ViewBag.Keyword" class="search-pill-input" placeholder="Employee, action, module, IP, target..." />
                </div>
            </div>
            <div class="col-lg-2 col-md-3">
                <label class="form-label-d text-muted small mb-1">Module</label>
                <select name="module" class="form-select form-select-d">
                    <option value="">All Modules</option>
                    <option value="Auth" selected="@(ViewBag.Module == "Auth")">Authentication</option>
                    <option value="Product" selected="@(ViewBag.Module == "Product")">Products</option>
                    <option value="Stock" selected="@(ViewBag.Module == "Stock")">Stock & Inventory</option>
                    <option value="Sales" selected="@(ViewBag.Module == "Sales")">Sales & Billing</option>
                    <option value="Category" selected="@(ViewBag.Module == "Category")">Categories</option>
                    <option value="User" selected="@(ViewBag.Module == "User")">User Management</option>
                    <option value="Security" selected="@(ViewBag.Module == "Security")">Security Firewall</option>
                    <option value="System" selected="@(ViewBag.Module == "System")">System Core</option>
                </select>
            </div>
            <div class="col-lg-2 col-md-3">
                <label class="form-label-d text-muted small mb-1">Operation Status</label>
                <select name="status" class="form-select form-select-d">
                    <option value="">All Statuses</option>
                    <option value="Success" selected="@(ViewBag.Status == "Success")">Success</option>
                    <option value="Warning" selected="@(ViewBag.Status == "Warning")">Warning</option>
                    <option value="Failed" selected="@(ViewBag.Status == "Failed")">Failed / Error</option>
                </select>
            </div>
            <div class="col-lg-2 col-md-3">
                <label class="form-label-d text-muted small mb-1">Severity Level</label>
                <select name="logLevel" class="form-select form-select-d">
                    <option value="">All Levels</option>
                    <option value="Information" selected="@(ViewBag.LogLevel == "Information")">Information</option>
                    <option value="Warning" selected="@(ViewBag.LogLevel == "Warning")">Warning</option>
                    <option value="Critical" selected="@(ViewBag.LogLevel == "Critical")">Critical</option>
                </select>
            </div>
            <div class="col-lg-3 col-md-12 d-flex align-items-end justify-content-end gap-2 mt-md-3 mt-lg-0">
                <a href="/SystemLog/Index" class="btn-d btn-outline btn-sm-d" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i> Reset</a>
                <button type="submit" class="btn-d btn-primary btn-sm-d"><i class="bi bi-funnel"></i> Filter Logs</button>
                <div class="btn-group" role="group">
                    <button type="button" class="btn-d btn-outline btn-sm-d active" id="btn-view-table" onclick="switchView('table')" title="Table View"><i class="bi bi-table"></i></button>
                    <button type="button" class="btn-d btn-outline btn-sm-d" id="btn-view-timeline" onclick="switchView('timeline')" title="Timeline View"><i class="bi bi-clock-history"></i></button>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- Main Table Container -->
<div id="panel-table-view" class="card-d mb-4">
    <div class="p-3 border-bottom border-secondary d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h5 class="mb-0 text-light"><i class="bi bi-list-columns-reverse me-2 text-primary"></i>System Activity Log Directory (@ViewBag.TotalCount)</h5>
        <div class="d-flex align-items-center gap-2">
            @if (isAdmin)
            {
                <button type="button" id="btnBulkDelete" class="btn-d btn-outline text-danger btn-sm-d" onclick="executeBulkDelete()" style="display:none;">
                    <i class="bi bi-trash me-1"></i> Delete Selected (<span id="selectedCount">0</span>)
                </button>
            }
            <span class="text-muted small"><i class="bi bi-arrows-expand me-1"></i>Grab or scroll table horizontally to view all columns</span>
        </div>
    </div>
    
    <div class="tbl-scroll" id="logs-table-container" style="overflow-x: auto; width: 100%; cursor: grab; user-select: none;">
        <table class="tbl mb-0" id="logs-table" style="min-width: 1200px;">
            <thead>
                <tr>
                    @if (isAdmin)
                    {
                        <th style="width: 38px; text-align: center;">
                            <input type="checkbox" id="selectAllLogs" class="form-check-input ms-0" onchange="toggleSelectAllLogs(this)" title="Select All Logs on Page" />
                        </th>
                    }
                    <th style="width: 40px;">#</th>
                    <th style="width: 180px;">TIMESTAMP (IST)</th>
                    <th style="width: 180px;">EMPLOYEE / USER</th>
                    <th style="width: 130px;">MODULE</th>
                    <th style="width: 180px;">ACTION</th>
                    <th>DESCRIPTION / TARGET</th>
                    <th style="width: 100px;">STATUS</th>
                    <th style="width: 180px;">IP & DEVICE</th>
                    <th style="width: 130px;" class="text-end">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int rowIdx = ((int)ViewBag.CurrentPage - 1) * (int)ViewBag.PageSize + 1;
                    foreach (var item in Model)
                    {
                        var statusBadge = item.Status switch
                        {
                            "Success" => "bg-success-subtle text-success border border-success-subtle",
                            "Warning" => "bg-warning-subtle text-warning border border-warning-subtle",
                            "Failed" => "bg-danger-subtle text-danger border border-danger-subtle",
                            _ => "bg-secondary-subtle text-secondary"
                        };

                        var levelIcon = item.LogLevel switch
                        {
                            "Critical" => "bi-exclamation-octagon-fill text-danger",
                            "Warning" => "bi-exclamation-triangle-fill text-warning",
                            _ => "bi-info-circle-fill text-info"
                        };

                        var moduleBadge = item.Module switch
                        {
                            "Auth" => "bg-primary-subtle text-primary",
                            "Security" => "bg-danger-subtle text-danger",
                            "Stock" => "bg-warning-subtle text-warning",
                            "Sales" => "bg-success-subtle text-success",
                            _ => "bg-dark text-muted"
                        };

                        <tr>
                            @if (isAdmin)
                            {
                                <td style="text-align: center;">
                                    <input type="checkbox" class="form-check-input ms-0 log-select-cb" value="@item.Id" onchange="updateBulkDeleteUI()" />
                                </td>
                            }
                            <td class="text-muted small">
                                <i class="bi @levelIcon me-1" title="@item.LogLevel Level"></i>
                            </td>
                            <td>
                                <span class="small font-monospace text-light"><i class="bi bi-clock me-1 text-primary"></i>@item.TimeIstString</span>
                            </td>
                            <td>
                                <div class="fw-semibold text-light">@(!string.IsNullOrWhiteSpace(item.EmployeeName) ? item.EmployeeName : item.ExecutedBy)</div>
                                <div class="small text-muted font-monospace">@@@(string.IsNullOrWhiteSpace(item.Username) ? "system" : item.Username) <span class="badge bg-dark text-muted ms-1">@item.UserRole</span></div>
                            </td>
                            <td>
                                <span class="badge @moduleBadge"><i class="bi bi-folder2 me-1"></i>@item.Module</span>
                            </td>
                            <td>
                                <div class="fw-semibold text-light">@item.Action</div>
                            </td>
                            <td>
                                <div class="text-light">@item.Target</div>
                                @if (!string.IsNullOrWhiteSpace(item.Details))
                                {
                                    <div class="small text-muted text-truncate" style="max-width: 380px;">@item.Details</div>
                                }
                            </td>
                            <td>
                                <span class="badge @statusBadge">
                                    <i class="bi bi-record-fill me-1 small"></i>@item.Status
                                </span>
                            </td>
                            <td>
                                <div class="small font-monospace text-muted"><i class="bi bi-pc-display me-1"></i>@item.IpAddress</div>
                                <div class="small text-muted text-truncate" style="max-width: 160px;" title="@item.Browser - @item.DeviceType">@item.Browser</div>
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-1">
                                    <button type="button" class="btn-d btn-outline btn-sm-d px-2 py-1" onclick="openLogModal('@item.Id')" title="View Log Audit Details">
                                        <i class="bi bi-eye"></i> View
                                    </button>
                                    @if (isAdmin)
                                    {
                                        <button type="button" class="btn-d btn-outline text-danger btn-sm-d px-2 py-1" onclick="deleteSoloLog('@item.Id')" title="Delete Log Record">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                        rowIdx++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-5">
                            <div class="text-muted mb-2"><i class="bi bi-inbox fs-1"></i></div>
                            <h5 class="text-muted fw-normal">No activity logs found matching your filter criteria</h5>
                            <p class="small text-muted mb-0">Try clearing filters or performing system actions to generate audit logs.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination Footer -->
    @if ((int)ViewBag.TotalPages > 1)
    {
        <div class="p-3 border-top border-secondary d-flex justify-content-between align-items-center">
            <div class="text-muted small">
                Showing Page <span class="text-light fw-bold">@ViewBag.CurrentPage</span> of <span class="text-light fw-bold">@ViewBag.TotalPages</span> (@ViewBag.TotalCount total records)
            </div>
            <div class="d-flex gap-1">
                @if (ViewBag.CurrentPage > 1)
                {
                    <a href="@Url.Action("Index","SystemLog", new { page = ViewBag.CurrentPage - 1, keyword = ViewBag.Keyword, module = ViewBag.Module, status = ViewBag.Status, logLevel = ViewBag.LogLevel })"
                       class="btn-d btn-outline btn-sm-d"><i class="bi bi-chevron-left"></i> Previous</a>
                }
                @for (int p = Math.Max(1, ViewBag.CurrentPage - 2); p <= Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2); p++)
                {
                    <a href="@Url.Action("Index","SystemLog", new { page = p, keyword = ViewBag.Keyword, module = ViewBag.Module, status = ViewBag.Status, logLevel = ViewBag.LogLevel })"
                       class="btn-d @(p == ViewBag.CurrentPage ? "btn-primary" : "btn-outline") btn-sm-d">@p</a>
                }
                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <a href="@Url.Action("Index","SystemLog", new { page = ViewBag.CurrentPage + 1, keyword = ViewBag.Keyword, module = ViewBag.Module, status = ViewBag.Status, logLevel = ViewBag.LogLevel })"
                       class="btn-d btn-outline btn-sm-d">Next <i class="bi bi-chevron-right"></i></a>
                }
            </div>
        </div>
    }
</div>

<!-- Chronological Timeline View Panel -->
<div id="panel-timeline-view" class="card-d mb-4" style="display:none">
    <div class="p-3 border-bottom border-secondary">
        <h5 class="mb-0 text-light"><i class="bi bi-clock-history me-2 text-primary"></i>Chronological Event Timeline</h5>
    </div>
    <div class="p-4">
        <div class="timeline position-relative ps-4 border-start border-secondary border-2">
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <div class="mb-4 position-relative">
                        <span class="position-absolute top-0 start-0 translate-middle p-2 bg-primary rounded-circle me-3"></span>
                        <div class="card-d p-3 ms-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-bold text-light">@item.Action</span>
                                <span class="small font-monospace text-primary">@item.TimeIstString</span>
                            </div>
                            <div class="small text-muted mb-2">Performed by <span class="text-light fw-semibold">@item.EmployeeName</span> (Module: @item.Module)</div>
                            <p class="text-light mb-0 small">@item.Target - @item.Details</p>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- Retention Modal -->
@if (isAdmin)
{
    <div class="modal fade" id="retentionModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content card-d border-secondary">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-light"><i class="bi bi-shield-slash text-warning me-2"></i>Log Retention & Purge Configuration</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-light">
                    <p class="text-muted small">Configure audit log cleanup policy to purge old system logs and maintain database performance.</p>
                    <div class="mb-3">
                        <label class="form-label-d text-light">Purge Logs Older Than</label>
                        <select id="purgeDaysSelect" class="form-select form-select-d">
                            <option value="7">7 Days</option>
                            <option value="14">14 Days</option>
                            <option value="30" selected>30 Days</option>
                            <option value="60">60 Days</option>
                            <option value="90">90 Days</option>
                            <option value="180">180 Days</option>
                            <option value="365">1 Year (365 Days)</option>
                        </select>
                    </div>
                    <div class="alert alert-warning-d bg-warning-subtle text-warning border-warning p-3 rounded mb-0">
                        <i class="bi bi-exclamation-triangle me-2"></i><strong>Warning:</strong> Purged log entries will be permanently deleted from MongoDB Atlas.
                    </div>
                </div>
                <div class="modal-footer border-secondary justify-content-between">
                    <button type="button" class="btn-d btn-danger btn-sm-d" onclick="executeClearAll()"><i class="bi bi-trash3 me-1"></i> Clear ALL Logs</button>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn-d btn-outline btn-sm-d" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn-d btn-warning btn-sm-d" onclick="executePurge()"><i class="bi bi-funnel me-1"></i> Purge Selected Retention</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Log Details Modal -->
<div class="modal fade" id="logDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content card-d border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-light"><i class="bi bi-journal-check text-primary me-2"></i>Audit Log Record Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-light" id="log-modal-body">
                <div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div></div>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn-d btn-outline btn-sm-d" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let currentLogId = '@(Model?.FirstOrDefault()?.Id ?? "")';

    function switchView(viewType) {
        const tblPanel = document.getElementById('panel-table-view');
        const tmlPanel = document.getElementById('panel-timeline-view');
        const btnTbl = document.getElementById('btn-view-table');
        const btnTml = document.getElementById('btn-view-timeline');

        if (viewType === 'table') {
            tblPanel.style.display = 'block';
            tmlPanel.style.display = 'none';
            btnTbl.classList.add('active');
            btnTml.classList.remove('active');
        } else {
            tblPanel.style.display = 'none';
            tmlPanel.style.display = 'block';
            btnTbl.classList.remove('active');
            btnTml.classList.add('active');
        }
    }

    // Grab-and-drag horizontal table scroll logic
    document.addEventListener('DOMContentLoaded', () => {
        const slider = document.getElementById('logs-table-container');
        if (!slider) return;

        let isDown = false;
        let startX;
        let scrollLeft;

        slider.addEventListener('mousedown', (e) => {
            isDown = true;
            slider.style.cursor = 'grabbing';
            startX = e.pageX - slider.offsetLeft;
            scrollLeft = slider.scrollLeft;
        });
        slider.addEventListener('mouseleave', () => {
            isDown = false;
            slider.style.cursor = 'grab';
        });
        slider.addEventListener('mouseup', () => {
            isDown = false;
            slider.style.cursor = 'grab';
        });
        slider.addEventListener('mousemove', (e) => {
            if (!isDown) return;
            e.preventDefault();
            const x = e.pageX - slider.offsetLeft;
            const walk = (x - startX) * 2;
            slider.scrollLeft = scrollLeft - walk;
        });

        slider.addEventListener('wheel', (e) => {
            if (e.deltaY !== 0) {
                e.preventDefault();
                slider.scrollLeft += e.deltaY;
            }
        }, { passive: false });
    });

    // openLogModal and helpers are in /js/systemlog-modal.js (loaded below)
    // escapeHtml is also defined there

    function triggerExport(format) {
        document.getElementById('export-format').value = format;
        document.getElementById('export-form').submit();
    }

    function openRetentionModal() {
        const modalEl = document.getElementById('retentionModal');
        if (!modalEl) return;
        let modal = bootstrap.Modal.getInstance(modalEl);
        if (!modal) {
            modal = new bootstrap.Modal(modalEl);
        }
        modal.show();
    }

    async function executePurge() {
        const days = document.getElementById('purgeDaysSelect').value;
        if (!confirm(`Are you sure you want to purge log entries older than ${days} days?`)) return;

        try {
            const tokenInput = document.querySelector('#anti-forgery-form input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : '';

            const formData = new FormData();
            formData.append('days', days);
            if (token) formData.append('__RequestVerificationToken', token);

            const resp = await fetch('/SystemLog/Purge', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token,
                    'X-CSRF-TOKEN': token
                },
                body: formData
            });

            if (!resp.ok) {
                alert(`Server returned HTTP ${resp.status}. Purge operation failed.`);
                return;
            }

            const data = await resp.json();
            if (data.success) {
                alert(data.message);
                window.location.reload();
            } else {
                alert(data.message || 'Failed to purge logs.');
            }
        } catch (e) {
            console.error(e);
            alert('An error occurred during log purge.');
        }
    }

    async function executeClearAll() {
        if (!confirm('CRITICAL WARNING: Are you sure you want to delete ALL system log entries? This action CANNOT be undone!')) return;

        try {
            const tokenInput = document.querySelector('#anti-forgery-form input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : '';

            const formData = new FormData();
            if (token) formData.append('__RequestVerificationToken', token);

            const resp = await fetch('/SystemLog/ClearAll', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token,
                    'X-CSRF-TOKEN': token
                },
                body: formData
            });

            if (!resp.ok) {
                alert(`Server returned HTTP ${resp.status}. Clear operation failed.`);
                return;
            }

            const data = await resp.json();
            if (data.success) {
                alert(data.message);
                window.location.reload();
            } else {
                alert(data.message || 'Failed to clear logs.');
            }
        } catch (e) {
            console.error(e);
            alert('An error occurred while clearing logs.');
        }
    }

    function toggleSelectAllLogs(masterCb) {
        const checkboxes = document.querySelectorAll('.log-select-cb');
        checkboxes.forEach(cb => cb.checked = masterCb.checked);
        updateBulkDeleteUI();
    }

    function updateBulkDeleteUI() {
        const selected = document.querySelectorAll('.log-select-cb:checked');
        const btnBulk = document.getElementById('btnBulkDelete');
        const countSpan = document.getElementById('selectedCount');
        const selectAllCb = document.getElementById('selectAllLogs');

        if (countSpan) countSpan.innerText = selected.length;
        if (btnBulk) btnBulk.style.display = selected.length > 0 ? 'inline-block' : 'none';

        const totalCbs = document.querySelectorAll('.log-select-cb');
        if (selectAllCb && totalCbs.length > 0) {
            selectAllCb.checked = selected.length === totalCbs.length;
        }
    }

    async function deleteSoloLog(logId) {
        if (!confirm('Are you sure you want to delete this log record?')) return;

        try {
            const tokenInput = document.querySelector('#anti-forgery-form input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : '';

            const formData = new FormData();
            formData.append('id', logId);
            if (token) formData.append('__RequestVerificationToken', token);

            const resp = await fetch('/SystemLog/Delete', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token,
                    'X-CSRF-TOKEN': token
                },
                body: formData
            });

            const data = await resp.json();
            if (data.success) {
                window.location.reload();
            } else {
                alert(data.message || 'Failed to delete log record.');
            }
        } catch (e) {
            console.error(e);
            alert('An error occurred while deleting the log record.');
        }
    }

    async function executeBulkDelete() {
        const selected = Array.from(document.querySelectorAll('.log-select-cb:checked')).map(cb => cb.value);
        if (selected.length === 0) {
            alert('Please select at least one log record to delete.');
            return;
        }

        if (!confirm(`Are you sure you want to delete the ${selected.length} selected log records?`)) return;

        try {
            const tokenInput = document.querySelector('#anti-forgery-form input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : '';

            const resp = await fetch('/SystemLog/BulkDelete', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token,
                    'X-CSRF-TOKEN': token
                },
                body: JSON.stringify(selected)
            });

            const data = await resp.json();
            if (data.success) {
                window.location.reload();
            } else {
                alert(data.message || 'Failed to bulk delete log records.');
            }
        } catch (e) {
            console.error(e);
            alert('An error occurred during bulk log deletion.');
        }
    }

    // Background live polling sync
    setInterval(async () => {
        try {
            const resp = await fetch(`/SystemLog/PollLive?lastLogId=${currentLogId}`);
            const data = await resp.json();
            if (data.hasNew) {
                currentLogId = data.latestId;
                if (typeof showToast === 'function') {
                    showToast(`New Activity: ${data.latestEmployee} - ${data.latestAction} (${data.latestModule})`, 'info');
                }
            }
        } catch (e) {}
    }, 7000);
</script>
<script src="~/js/systemlog-modal.js?v=@DateTime.UtcNow.Ticks"></script>
