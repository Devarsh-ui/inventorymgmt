@using System.Security.Claims
@using MongoDB.Driver
@inject InventoryManagementSystem.Interfaces.IFeatureCatalogService FeatureCatalogService
@inject InventoryManagementSystem.Interfaces.IPlatformSettingsService PlatformSettingsService
@inject InventoryManagementSystem.Interfaces.ISupplierService SupplierService
@inject InventoryManagementSystem.Interfaces.ILicenseService LayoutLicenseService
@inject InventoryManagementSystem.Data.MongoDbContext LayoutMongoContext
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="SIMS – Smart Inventory Management System" />
  <title>@ViewData["Title"] – SIMS</title>
  <link rel="icon" type="image/png" href="~/favicon.png" />
  <link rel="shortcut icon" type="image/png" href="~/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Doto:wght,ROND@600..900,0..100&family=Inter:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&family=Silkscreen:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/public-saas.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/home-ecom.css" asp-append-version="true" />
  <script>
    (function() {
      var isAuth = @(User.Identity?.IsAuthenticated == true ? "true" : "false");
      if (!isAuth) {
        document.documentElement.setAttribute('data-theme', 'light');
      } else {
        var t = localStorage.getItem('sims_theme');
        if (t === 'light') { document.documentElement.setAttribute('data-theme', 'light'); }
        else { document.documentElement.setAttribute('data-theme', 'dark'); }
      }
    })();
  </script>
</head>

@{
  var routeCtrl = ViewContext.RouteData.Values["controller"]?.ToString();
  var routeAct  = ViewContext.RouteData.Values["action"]?.ToString();
  var isPublicPage = (User.Identity?.IsAuthenticated != true);
}
<body class="@(isPublicPage ? "ecom-home-body" : "")"
  data-flash-msg="@TempData["ToastMessage"]"
  data-flash-type="@TempData["ToastType"]"
  data-perm-version="@((User.Identity?.IsAuthenticated == true) ? (await PermissionService.GetLiveUserStateAsync(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "")).PermissionVersion : 1)">

@if (!isPublicPage)
{
  <!-- Liquid Glass Atmospheric Ambient Background Layer -->
  <div class="glass-atmosphere" aria-hidden="true">
    <div class="glass-orb glass-orb-1"></div>
    <div class="glass-orb glass-orb-2"></div>
    <div class="glass-orb glass-orb-3"></div>
    <div class="glass-orb glass-orb-4"></div>
  </div>
}

@if (User.Identity?.IsAuthenticated == true)
{
  var ctrl     = ViewContext.RouteData.Values["controller"]?.ToString();
  var act      = ViewContext.RouteData.Values["action"]?.ToString();
  var fullName = User.FindFirst("FullName")?.Value ?? User.Identity.Name;
  var uname    = User.Identity.Name;
  var profPic  = User.FindFirst("ProfilePictureUrl")?.Value ?? "";
  var isAdmin    = User.IsInRole("Admin");
  var isSuperAdmin = User.IsInRole("SuperAdmin");
  var isSupplier = User.IsInRole("Supplier");

  var displayUserName = uname;
  var displayUserFullName = fullName;
  var displayInitial = fullName?.Length > 0 ? fullName[0].ToString().ToUpper() : "U";

  if (isSupplier)
  {
      var supId = User.FindFirst("SupplierId")?.Value ?? User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
      if (!string.IsNullOrEmpty(supId))
      {
          var sup = await SupplierService.GetSupplierByIdAsync(supId);
          if (sup != null)
          {
              var vName = (!string.IsNullOrWhiteSpace(sup.VendorName) ? sup.VendorName : (!string.IsNullOrWhiteSpace(sup.CompanyName) ? sup.CompanyName : uname)) ?? "Supplier";
              displayUserName = vName;
              displayUserFullName = vName;
              displayInitial = vName.Length > 0 ? vName[0].ToString().ToUpper() : "S";
          }
      }
      else
      {
          var vClaim = User.FindFirst("VendorName")?.Value;
          if (!string.IsNullOrWhiteSpace(vClaim))
          {
              displayUserName = vClaim;
              displayUserFullName = vClaim;
              displayInitial = vClaim.Length > 0 ? vClaim[0].ToString().ToUpper() : "S";
          }
      }
  }

  var layoutTenantId = User.FindFirst("TenantId")?.Value ?? User.FindFirst(ClaimTypes.GroupSid)?.Value;
  if (string.IsNullOrEmpty(layoutTenantId) && isSupplier)
  {
      var supIdClaim = User.FindFirst("SupplierId")?.Value ?? User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
      if (!string.IsNullOrEmpty(supIdClaim))
      {
          var supDoc = await SupplierService.GetSupplierByIdAsync(supIdClaim);
          layoutTenantId = supDoc?.TenantId;
      }
  }

  InventoryManagementSystem.Models.Tenant? currentShopTenant = null;
  InventoryManagementSystem.Models.TenantLicense? currentShopLicense = null;
  bool isCurrentShopLicenseExpired = false;
  int currentShopDaysRemaining = 999;
  bool isCurrentShopExpiringSoon = false;

  if (!string.IsNullOrEmpty(layoutTenantId) && !isSuperAdmin)
  {
      currentShopTenant = await LayoutMongoContext.Tenants.Find(t => t.Id == layoutTenantId || t.TenantCode == layoutTenantId).FirstOrDefaultAsync();
      if (currentShopTenant != null)
      {
          currentShopLicense = await LayoutLicenseService.GetActiveLicenseAsync(currentShopTenant.Id);
          isCurrentShopLicenseExpired = string.Equals(currentShopTenant.Status, "Expired", StringComparison.OrdinalIgnoreCase)
                                     || currentShopLicense == null
                                     || currentShopLicense.ExpiryDate < DateTime.UtcNow
                                     || string.Equals(currentShopLicense?.Status, "Expired", StringComparison.OrdinalIgnoreCase);
          if (currentShopLicense != null)
          {
              currentShopDaysRemaining = (int)Math.Ceiling((currentShopLicense.ExpiryDate - DateTime.UtcNow).TotalDays);
              isCurrentShopExpiringSoon = !isCurrentShopLicenseExpired && currentShopDaysRemaining <= 7;
          }
      }
  }

  <!-- Sidebar overlay (mobile) -->
  <div id="sb-overlay" class="sb-overlay"></div>

  <!-- ══════════════════════════════════════════
       SIDEBAR
  ══════════════════════════════════════════════ -->
  <aside id="sidebar" aria-label="Main Navigation">

    <!-- Brand -->
    <a class="sb-brand" href="@(isSuperAdmin ? Url.Action("Dashboard","PlatformAdmin") : isSupplier ? Url.Action("Index","SupplierDashboard") : Url.Action("Index","Home"))">
      <img src="~/images/logo-dark.png" alt="SIMS Logo" class="sb-brand-logo logo-dark-mode" style="height:32px;width:auto;object-fit:contain;flex-shrink:0" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
      <img src="~/images/logo-light.png" alt="SIMS Logo" class="sb-brand-logo logo-light-mode" style="height:32px;width:auto;object-fit:contain;flex-shrink:0" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
      <div class="sb-brand-icon" style="display:none"><i class="bi bi-box-seam-fill"></i></div>
      <span class="sb-brand-name">SIMS</span>
    </a>

    <!-- Nav scroll area -->
    <div class="sb-scroll">

    @if (isSuperAdmin)
    {
      <!-- SAAS PLATFORM MANAGEMENT -->
      <div class="sb-label">SAAS PLATFORM</div>

      <a href="@Url.Action("Dashboard","PlatformAdmin")"
         class="sb-link @(ctrl=="PlatformAdmin"&&act=="Dashboard"?"active":"")"
         data-bs-toggle="tooltip" data-bs-title="Platform Overview" data-bs-placement="right">
        <i class="bi bi-speedometer2 sb-icon" style="color:var(--primary)"></i>
        <span class="sb-text">SaaS Dashboard</span>
      </a>

      <a href="@Url.Action("Tenants","PlatformAdmin")"
         class="sb-link @(ctrl=="PlatformAdmin"&&act=="Tenants"?"active":"")"
         data-bs-toggle="tooltip" data-bs-title="Mobile Shop Tenants" data-bs-placement="right">
        <i class="bi bi-shop sb-icon" style="color:var(--success)"></i>
        <span class="sb-text">Registered Shops</span>
      </a>

      <a href="@Url.Action("CreateTenant","PlatformAdmin")"
         class="sb-link @(ctrl=="PlatformAdmin"&&act=="CreateTenant"?"active":"")"
         data-bs-toggle="tooltip" data-bs-title="Add New Shop" data-bs-placement="right">
        <i class="bi bi-plus-circle sb-icon" style="color:var(--info)"></i>
        <span class="sb-text">Provision New Shop</span>
      </a>

      <!-- SUBSCRIPTION & BILLING -->
      <div class="sb-label">BILLING & PACKAGES</div>

      <a href="@Url.Action("RenewalRequests","PlatformAdmin")"
         class="sb-link @(ctrl=="PlatformAdmin"&&act=="RenewalRequests"?"active":"")"
         data-bs-toggle="tooltip" data-bs-title="Shop Renewal Requests" data-bs-placement="right">
        <i class="bi bi-arrow-repeat sb-icon" style="color:var(--primary)"></i>
        <span class="sb-text">Renewal Requests</span>
      </a>

      <a href="@Url.Action("Packages","PlatformAdmin")"
         class="sb-link @(ctrl=="PlatformAdmin"&&act=="Packages"?"active":"")"
         data-bs-toggle="tooltip" data-bs-title="Subscription Plans" data-bs-placement="right">
        <i class="bi bi-tags sb-icon" style="color:var(--warning)"></i>
        <span class="sb-text">SaaS Packages</span>
      </a>

      <a href="@Url.Action("CustomPackages","PlatformAdmin")"
         class="sb-link @(ctrl=="PlatformAdmin"&&act=="CustomPackages"?"active":"")"
         data-bs-toggle="tooltip" data-bs-title="Custom Shop Packages" data-bs-placement="right">
        <i class="bi bi-award-fill sb-icon" style="color:#a855f7"></i>
        <span class="sb-text">Custom Packages</span>
      </a>

      <a href="@Url.Action("Payments","PlatformAdmin")"
         class="sb-link @(ctrl=="PlatformAdmin"&&act=="Payments"?"active":"")"
         data-bs-toggle="tooltip" data-bs-title="Revenue & Payments" data-bs-placement="right">
        <i class="bi bi-currency-dollar sb-icon" style="color:var(--success)"></i>
        <span class="sb-text">Payment Transactions</span>
      </a>

      <!-- SYSTEM & SECURITY -->
      <div class="sb-label">SYSTEM & AUDIT</div>

      <a href="@Url.Action("Settings","PlatformAdmin")"
         class="sb-link @(ctrl=="PlatformAdmin"&&act=="Settings"?"active":"")"
         data-bs-toggle="tooltip" data-bs-title="Platform Settings & Maintenance" data-bs-placement="right">
        <i class="bi bi-sliders2 sb-icon" style="color:var(--primary)"></i>
        <span class="sb-text">Platform Settings</span>
      </a>

      <a href="@Url.Action("Index","InventoryAlert")"
         class="sb-link @(ctrl=="InventoryAlert"?"active":"")"
         data-bs-toggle="tooltip" data-bs-title="Email Alerts & Engine" data-bs-placement="right">
        <i class="bi bi-bell-fill sb-icon" style="color:var(--warning)"></i>
        <span class="sb-text">Email Alerts & Logs</span>
      </a>

      <a href="@Url.Action("Index","SystemLog")"
         class="sb-link @(ctrl=="SystemLog"?"active":"")"
         data-bs-toggle="tooltip" data-bs-title="Platform Logs" data-bs-placement="right">
        <i class="bi bi-terminal sb-icon"></i>
        <span class="sb-text">System Audit Logs</span>
      </a>

      <a href="@Url.Action("Profile","Account")"
         class="sb-link @(ctrl=="Account"&&act=="Profile"?"active":"")"
         data-bs-toggle="tooltip" data-bs-title="SuperAdmin Profile" data-bs-placement="right">
        <i class="bi bi-person-circle sb-icon"></i>
        <span class="sb-text">My Profile</span>
      </a>
    }
    else if (isSupplier)
    {
      <div class="sb-label">Supplier Portal</div>

      <a href="@Url.Action("Index","SupplierDashboard")"
         class="sb-link @(ctrl=="SupplierDashboard"&&act=="Index"?"active":"")"
         data-bs-toggle="tooltip" data-bs-title="Portal Dashboard" data-bs-placement="right">
        <i class="bi bi-speedometer2 sb-icon"></i>
        <span class="sb-text">Portal Dashboard</span>
      </a>

      <a href="@Url.Action("Inventory","SupplierDashboard")"
         class="sb-link @(ctrl=="SupplierDashboard"&&act=="Inventory"?"active":"")"
         data-bs-toggle="tooltip" data-bs-title="Stock Inventory" data-bs-placement="right">
        <i class="bi bi-boxes sb-icon"></i>
        <span class="sb-text">Stock Inventory</span>
      </a>

      <a href="@Url.Action("StockIn","SupplierDashboard")"
         class="sb-link @(ctrl=="SupplierDashboard"&&act=="StockIn"?"active":"")"
         data-bs-toggle="tooltip" data-bs-title="Stock In Intake" data-bs-placement="right">
        <i class="bi bi-arrow-down-circle sb-icon" style="color:var(--success)"></i>
        <span class="sb-text">Stock In</span>
      </a>

      <a href="@Url.Action("StockOut","SupplierDashboard")"
         class="sb-link @(ctrl=="SupplierDashboard"&&act=="StockOut"?"active":"")"
         data-bs-toggle="tooltip" data-bs-title="Stock Out Deduction" data-bs-placement="right">
        <i class="bi bi-arrow-up-circle sb-icon" style="color:var(--danger)"></i>
        <span class="sb-text">Stock Out</span>
      </a>

      <a href="@Url.Action("Stats","SupplierDashboard")"
         class="sb-link @(ctrl=="SupplierDashboard"&&act=="Stats"?"active":"")"
         data-bs-toggle="tooltip" data-bs-title="Sales & Stats Analytics" data-bs-placement="right">
        <i class="bi bi-graph-up-arrow sb-icon"></i>
        <span class="sb-text">Sales & Stats</span>
      </a>

      <a href="@Url.Action("Products","SupplierDashboard")"
         class="sb-link @(ctrl=="SupplierDashboard"&&(act=="Products"||act=="CreateProduct"||act=="EditProduct")?"active":"")"
         data-bs-toggle="tooltip" data-bs-title="Supplied Products" data-bs-placement="right">
        <i class="bi bi-phone sb-icon"></i>
        <span class="sb-text">My Products</span>
      </a>

      <a href="@Url.Action("Index","Category")"
         class="sb-link @(ctrl=="Category"?"active":"")"
         data-bs-toggle="tooltip" data-bs-title="Product Categories" data-bs-placement="right">
        <i class="bi bi-tag sb-icon"></i>
        <span class="sb-text">Categories</span>
      </a>

      <a href="@Url.Action("Orders","SupplierDashboard")"
         class="sb-link @(ctrl=="SupplierDashboard"&&(act=="Orders"||act=="OrderDetails")?"active":"")"
         data-bs-toggle="tooltip" data-bs-title="Received Orders" data-bs-placement="right">
        <i class="bi bi-cart-check sb-icon"></i>
        <span class="sb-text">Received Orders</span>
      </a>

      <a href="@Url.Action("Returns","SupplierDashboard")"
         class="sb-link @(ctrl=="SupplierDashboard"&&(act=="Returns"||act=="ReturnDetails"||act=="PurchaseReturns"||act=="PurchaseReturnDetails")?"active":"")"
         data-bs-toggle="tooltip" data-bs-title="Damaged & Returned Stock" data-bs-placement="right">
        <i class="bi bi-box-seam sb-icon" style="color:var(--danger)"></i>
        <span class="sb-text">Damaged & Returned Stock</span>
      </a>

      <a href="@Url.Action("Profile","SupplierDashboard")"
         class="sb-link @(ctrl=="SupplierDashboard"&&act=="Profile"?"active":"")"
         data-bs-toggle="tooltip" data-bs-title="Supplier Profile" data-bs-placement="right">
        <i class="bi bi-person-circle sb-icon"></i>
        <span class="sb-text">My Profile</span>
      </a>
    }
    else
    {
      var tenantIdForNav = User.FindFirst("TenantId")?.Value ?? User.FindFirst(System.Security.Claims.ClaimTypes.GroupSid)?.Value ?? "";
      var enabledKeys = await FeatureCatalogService.GetEnabledFeatureKeysForTenantAsync(tenantIdForNav);
      bool hasFeat(string key) => enabledKeys.Contains(key, StringComparer.OrdinalIgnoreCase);

      <!-- MAIN / DASHBOARD -->
      if (hasFeat("DASHBOARD"))
      {
        <div class="sb-label">MAIN / DASHBOARD</div>

        <a href="@Url.Action("Index","Home")"
           class="sb-link @(ctrl=="Home"&&act=="Index"?"active":"")"
           data-bs-toggle="tooltip" data-bs-title="Dashboard" data-bs-placement="right">
          <i class="bi bi-grid-1x2 sb-icon"></i>
          <span class="sb-text">Dashboard</span>
        </a>
      }

      <!-- MOBILE SHOP -->
      if (hasFeat("IMEI_DEVICES") || hasFeat("POS_BILLING") || hasFeat("TRADE_IN_EXCHANGE") || hasFeat("RETURNS_REFUNDS") || hasFeat("SERVICE_REPAIRS"))
      {
        <div class="sb-label">MOBILE SHOP</div>

        if (hasFeat("IMEI_DEVICES"))
        {
          <a href="@Url.Action("Index","Imei")"
             class="sb-link @(ctrl=="Imei"?"active":"")"
             data-bs-toggle="tooltip" data-bs-title="IMEI & Devices" data-bs-placement="right">
            <i class="bi bi-qr-code-scan sb-icon"></i>
            <span class="sb-text">IMEI & Devices</span>
          </a>
        }

        if (hasFeat("POS_BILLING"))
        {
          <a href="@Url.Action("Create","Sales")"
             class="sb-link @(ctrl=="Sales"&&act=="Create"?"active":"")"
             data-bs-toggle="tooltip" data-bs-title="POS Billing" data-bs-placement="right">
            <i class="bi bi-receipt sb-icon"></i>
            <span class="sb-text">POS Billing</span>
          </a>
        }

        if (hasFeat("TRADE_IN_EXCHANGE"))
        {
          <a href="@Url.Action("Index","Exchange")"
             class="sb-link @(ctrl=="Exchange"?"active":"")"
             data-bs-toggle="tooltip" data-bs-title="Trade-In Exchange" data-bs-placement="right">
            <i class="bi bi-arrow-left-right sb-icon"></i>
            <span class="sb-text">Trade-In Exchange</span>
          </a>
        }

        if (hasFeat("RETURNS_REFUNDS"))
        {
          <a href="@Url.Action("Index","Return")"
             class="sb-link @(ctrl=="Return"?"active":"")"
             data-bs-toggle="tooltip" data-bs-title="Returns & Refunds" data-bs-placement="right">
            <i class="bi bi-arrow-counterclockwise sb-icon"></i>
            <span class="sb-text">Returns & Refunds</span>
          </a>
        }

        if (hasFeat("SERVICE_REPAIRS"))
        {
          <a href="@Url.Action("Index","Repair")"
             class="sb-link @(ctrl=="Repair"?"active":"")"
             data-bs-toggle="tooltip" data-bs-title="Service & Repairs" data-bs-placement="right">
            <i class="bi bi-tools sb-icon"></i>
            <span class="sb-text">Service & Repairs</span>
          </a>
        }
      }

      <!-- DIRECTORY -->
      if (hasFeat("CUSTOMERS") || hasFeat("SUPPLIERS"))
      {
        <div class="sb-label">DIRECTORY</div>

        if (hasFeat("CUSTOMERS"))
        {
          <a href="@Url.Action("Index","Customer")"
             class="sb-link @(ctrl=="Customer"?"active":"")"
             data-bs-toggle="tooltip" data-bs-title="Customers" data-bs-placement="right">
            <i class="bi bi-person-heart sb-icon"></i>
            <span class="sb-text">Customers</span>
          </a>
        }

        if (hasFeat("SUPPLIERS"))
        {
          <a href="@Url.Action("Index","Supplier")"
             class="sb-link @(ctrl=="Supplier"?"active":"")"
             data-bs-toggle="tooltip" data-bs-title="Suppliers" data-bs-placement="right">
            <i class="bi bi-truck sb-icon"></i>
            <span class="sb-text">Suppliers</span>
          </a>
        }
      }

      <!-- INVENTORY & STOCK -->
      if (hasFeat("PRODUCTS_SPECS") || hasFeat("CATEGORIES") || hasFeat("STOCK_IN") || hasFeat("STOCK_OUT") || hasFeat("STOCK_HISTORY") || hasFeat("PURCHASE_RETURNS") || hasFeat("INVENTORY_SUMMARY"))
      {
        <div class="sb-label">INVENTORY & STOCK</div>

        if (hasFeat("PRODUCTS_SPECS"))
        {
          <a href="@Url.Action("Index","Product")"
             class="sb-link @(ctrl=="Product"&&act=="Index"?"active":"")"
             data-bs-toggle="tooltip" data-bs-title="Products & Specs" data-bs-placement="right">
            <i class="bi bi-box-seam sb-icon"></i>
            <span class="sb-text">Products & Specs</span>
          </a>
        }

        if (hasFeat("CATEGORIES"))
        {
          <a href="@Url.Action("Index","Category")"
             class="sb-link @(ctrl=="Category"?"active":"")"
             data-bs-toggle="tooltip" data-bs-title="Categories" data-bs-placement="right">
            <i class="bi bi-tag sb-icon"></i>
            <span class="sb-text">Categories</span>
          </a>
        }

        if (hasFeat("STOCK_IN"))
        {
          <a href="@Url.Action("StockIn","Stock")"
             class="sb-link @(ctrl=="Stock"&&act=="StockIn"?"active":"")"
             data-bs-toggle="tooltip" data-bs-title="Stock In Intake" data-bs-placement="right">
            <i class="bi bi-arrow-down-circle sb-icon" style="color:var(--success)"></i>
            <span class="sb-text">Stock In</span>
          </a>
        }

        if (hasFeat("STOCK_OUT"))
        {
          <a href="@Url.Action("StockOut","Stock")"
             class="sb-link @(ctrl=="Stock"&&act=="StockOut"?"active":"")"
             data-bs-toggle="tooltip" data-bs-title="Stock Out Deduction" data-bs-placement="right">
            <i class="bi bi-arrow-up-circle sb-icon" style="color:var(--danger)"></i>
            <span class="sb-text">Stock Out</span>
          </a>
        }

        if (hasFeat("STOCK_HISTORY"))
        {
          <a href="@Url.Action("History","Stock")"
             class="sb-link @(ctrl=="Stock"&&act=="History"?"active":"")"
             data-bs-toggle="tooltip" data-bs-title="Stock History Audit" data-bs-placement="right">
            <i class="bi bi-clock-history sb-icon"></i>
            <span class="sb-text">Stock History</span>
          </a>
        }

        if (hasFeat("PURCHASE_RETURNS"))
        {
          <a href="@Url.Action("Index","PurchaseReturn")"
             class="sb-link @(ctrl=="PurchaseReturn"?"active":"")"
             data-bs-toggle="tooltip" data-bs-title="Purchase Returns" data-bs-placement="right">
            <i class="bi bi-box-arrow-left sb-icon" style="color:var(--danger)"></i>
            <span class="sb-text">Purchase Returns</span>
          </a>
        }

        if (hasFeat("INVENTORY_SUMMARY"))
        {
          <a href="@Url.Action("InventorySummary","Stock")"
             class="sb-link @(ctrl=="Stock"&&act=="InventorySummary"?"active":"")"
             data-bs-toggle="tooltip" data-bs-title="Inventory Summary Overview" data-bs-placement="right">
            <i class="bi bi-file-earmark-text sb-icon"></i>
            <span class="sb-text">Inventory Summary</span>
          </a>
        }
      }

      <!-- RECORDS & REPORTS -->
      if (hasFeat("INVOICE_RECORDS") || hasFeat("REPORTS") || hasFeat("ORDER_MANAGEMENT"))
      {
        <div class="sb-label">RECORDS & REPORTS</div>

        if (hasFeat("INVOICE_RECORDS"))
        {
          <a href="@Url.Action("Index","Sales")"
             class="sb-link @(ctrl=="Sales"&&(act=="Index"||act=="Details"||act=="Invoice")?"active":"")"
             data-bs-toggle="tooltip" data-bs-title="Invoice Records" data-bs-placement="right">
            <i class="bi bi-journal-text sb-icon"></i>
            <span class="sb-text">Invoice Records</span>
          </a>
        }

        if (hasFeat("REPORTS"))
        {
          <a href="@Url.Action("Index","Report")"
             class="sb-link @(ctrl=="Report"?"active":"")"
             data-bs-toggle="tooltip" data-bs-title="Reports & Analytics" data-bs-placement="right">
            <i class="bi bi-bar-chart-line sb-icon"></i>
            <span class="sb-text">Reports</span>
          </a>
        }

        if (hasFeat("ORDER_MANAGEMENT"))
        {
          <a href="@Url.Action("Index","SupplierOrder")"
             class="sb-link @(ctrl=="SupplierOrder"?"active":"")"
             data-bs-toggle="tooltip" data-bs-title="Order Management" data-bs-placement="right">
            <i class="bi bi-cart-check sb-icon"></i>
            <span class="sb-text">Order Management</span>
          </a>
        }
      }

      <!-- SYSTEM / MANAGEMENT -->
      if (hasFeat("ADMINISTRATORS") || hasFeat("EMPLOYEES") || hasFeat("MY_PROFILE") || hasFeat("SETTINGS") || hasFeat("SYSTEM_LOGS") || User.IsInRole(Role.Admin))
      {
        <div class="sb-label">SYSTEM / MANAGEMENT</div>

        if (hasFeat("ADMINISTRATORS"))
        {
          <a href="@Url.Action("Index","Admin")"
             class="sb-link @(ctrl=="Admin"?"active":"")"
             data-bs-toggle="tooltip" data-bs-title="Administrator Management" data-bs-placement="right">
            <i class="bi bi-shield-lock sb-icon"></i>
            <span class="sb-text">Administrators</span>
          </a>
        }

        if (hasFeat("EMPLOYEES"))
        {
          <a href="@Url.Action("Index","User")"
             class="sb-link @(ctrl=="User"?"active":"")"
             data-bs-toggle="tooltip" data-bs-title="Employee Directory" data-bs-placement="right">
            <i class="bi bi-person-badge sb-icon"></i>
            <span class="sb-text">Employees</span>
          </a>
        }

        if (hasFeat("MY_PROFILE"))
        {
          <a href="@Url.Action("Profile","Account")"
             class="sb-link @(ctrl=="Account"&&act=="Profile"?"active":"")"
             data-bs-toggle="tooltip" data-bs-title="My User Profile" data-bs-placement="right">
            <i class="bi bi-person-circle sb-icon"></i>
            <span class="sb-text">My Profile</span>
          </a>
        }

        if (User.IsInRole(Role.Admin))
        {
          <a href="@Url.Action("MyPlan","Subscription")"
             class="sb-link @(ctrl=="Subscription"&&act=="MyPlan"?"active":"")"
             data-bs-toggle="tooltip" data-bs-title="Subscription Plan & License" data-bs-placement="right">
            <i class="bi bi-shield-check sb-icon" style="color:var(--primary)"></i>
            <span class="sb-text">Subscription Plan</span>
          </a>
        }

        if (hasFeat("SETTINGS"))
        {
          <a href="@Url.Action("Index","Settings")"
             class="sb-link @(ctrl=="Settings"?"active":"")"
             data-bs-toggle="tooltip" data-bs-title="System Settings" data-bs-placement="right">
            <i class="bi bi-sliders sb-icon"></i>
            <span class="sb-text">Settings</span>
          </a>
        }

        if (hasFeat("SYSTEM_LOGS"))
        {
          <a href="@Url.Action("Index","SystemLog")"
             class="sb-link @(ctrl=="SystemLog"?"active":"")"
             data-bs-toggle="tooltip" data-bs-title="System Activity Logs" data-bs-placement="right">
            <i class="bi bi-terminal sb-icon"></i>
            <span class="sb-text">System Logs</span>
          </a>
        }
      }
    }
    </div><!-- /sb-scroll -->

    <!-- Footer collapse -->
    <div class="sb-footer">
      <button id="sb-collapse-btn" class="sb-collapse-btn" aria-label="Toggle sidebar">
        <i class="bi bi-layout-sidebar-reverse"></i>
        <span>Collapse</span>
      </button>
    </div>
  </aside>

  <!-- ══════════════════════════════════════════
       MAIN
  ══════════════════════════════════════════════ -->
  <div id="main">

    <!-- TOP NAVBAR -->
    <header class="topbar">
      <!-- Mobile hamburger -->
      <button id="sb-mobile-btn" class="topbar-hamburger" aria-label="Open menu">
        <i class="bi bi-list"></i>
      </button>

      <!-- Breadcrumb -->
      <div class="topbar-breadcrumb">
        <span>SIMS</span>
        <i class="bi bi-chevron-right crumb-sep" style="font-size:10px"></i>
        <span class="crumb-current">@(ViewData["Title"] ?? ctrl)</span>
      </div>

      <!-- Search -->
      <div class="topbar-search">
        <i class="bi bi-search topbar-search-icon"></i>
        <input type="search" placeholder="Search…" autocomplete="off" aria-label="Search">
      </div>

      <!-- Right actions -->
      <div class="topbar-actions">

        <span id="topbar-date" class="topbar-date"></span>

        <!-- Theme Toggle -->
        <button class="topbar-btn theme-toggle-btn" type="button" onclick="toggleSIMSTheme()" aria-label="Toggle Dark/Light theme" data-bs-toggle="tooltip" data-bs-title="Toggle Theme">
          <i class="bi bi-sun-fill"></i>
        </button>

        <!-- Notifications -->
        <div class="dropdown" style="position:relative">
          <button class="topbar-btn" type="button"
                  id="notifDropdownBtn"
                  data-dd-toggle="dropdown"
                  aria-expanded="false"
                  aria-label="Notifications">
            <i class="bi bi-bell"></i>
            <span id="notif-badge" class="notif-dot" style="display:none"></span>
          </button>
          <div class="dropdown-menu dropdown-menu-end notif-panel p-0" aria-labelledby="notifDropdownBtn">
            <div class="notif-header">
              <div class="notif-header-title">
                <h6>Notifications</h6>
                <span id="notif-unread-count" class="notif-count-pill" style="display:none">0 unread</span>
              </div>
              <div class="notif-header-actions">
                <button type="button" id="notif-mark-read-btn" class="notif-mark-read-btn" title="Recent alerts">
                  Recent alerts
                </button>
              </div>
            </div>
            <div id="notif-list">
              <div class="empty-s" style="padding:24px">
                <i class="bi bi-bell-slash empty-s-icon"></i>
                <div class="empty-s-title">Loading…</div>
              </div>
            </div>
          </div>
        </div>

        <!-- User dropdown -->
        <div class="dropdown" style="position:relative">
          <button class="topbar-user" type="button"
                  id="userDropdownBtn"
                  data-dd-toggle="dropdown"
                  aria-expanded="false"
                  aria-label="User menu">
            @if (!string.IsNullOrEmpty(profPic))
            {
              <img src="@profPic" alt="@fullName" class="topbar-avatar"
                   onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
            }
            <div style="width:30px;height:30px;border-radius:50%;background:var(--primary-dim);display:@(string.IsNullOrEmpty(profPic)?"flex":"none");align-items:center;justify-content:center;color:var(--primary-text);font-size:14px;font-weight:700;flex-shrink:0">
              @displayInitial
            </div>
            <span class="topbar-username">@displayUserName</span>
            <i class="bi bi-chevron-down" style="font-size:10px;color:var(--text-muted)"></i>
          </button>
          <ul class="dropdown-menu dropdown-menu-end dd-menu" aria-labelledby="userDropdownBtn">
            <li class="px-2 pt-2 pb-2">
              <div style="font-size:13.5px;font-weight:700;color:var(--text-primary)">@displayUserFullName</div>
              <div style="font-size:11px;color:var(--text-muted)">@(isSupplier ? "Supplier Vendor" : $"@{uname}")</div>
            </li>
            <li><hr class="dd-divider mx-1"></li>
            @if (isSupplier)
            {
              <li><a class="dd-item" href="@Url.Action("Profile","SupplierDashboard")"><i class="bi bi-person-badge"></i> Vendor Profile</a></li>
            }
            else
            {
              <li><a class="dd-item" href="@Url.Action("Profile","Account")"><i class="bi bi-person"></i> My Profile</a></li>
            }
            @if (isSuperAdmin)
            {
              <li><a class="dd-item text-primary fw-bold" href="@Url.Action("Dashboard","PlatformAdmin")"><i class="bi bi-speedometer2"></i> Platform Dashboard</a></li>
            }
            @if (isAdmin)
            {
              <li><a class="dd-item" href="@Url.Action("Index","Settings")"><i class="bi bi-sliders"></i> Settings</a></li>
            }
            <li><hr class="dd-divider mx-1"></li>
            <li><a class="dd-item dd-danger" href="@Url.Action("Logout","Account")"><i class="bi bi-box-arrow-right"></i> Sign Out</a></li>
          </ul>
        </div>
      </div>
    </header>

    <!-- Page Body -->
    <main class="page-body" role="main">
      @if (isCurrentShopLicenseExpired && act != "LicenseExpired" && act != "Suspended")
      {
          <div class="alert alert-danger border-danger border-opacity-50 mx-3 mt-3 mb-0 shadow-sm d-flex align-items-center justify-content-between flex-wrap gap-2 rounded-3" style="background:rgba(239,68,68,0.12);">
              <div class="d-flex align-items-center gap-2">
                  <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger text-light flex-shrink-0" style="width:30px;height:30px;">
                      <i class="bi bi-clock-history fs-7"></i>
                  </span>
                  <div>
                      <strong class="text-danger">Subscription Plan Expired!</strong>
                      <span class="text-light fs-7 ms-1">
                          Your shop's active license expired on @(currentShopLicense != null ? currentShopLicense.ExpiryDate.AddMinutes(330).ToString("dd MMM yyyy, hh:mm tt IST") : "N/A"). @(isAdmin ? "Please renew immediately to restore full store access." : "Please contact your store administrator to renew.")
                      </span>
                  </div>
              </div>
              <div class="d-flex align-items-center gap-2">
                  @if (isAdmin)
                  {
                      <a href="@Url.Action("Renew", "Subscription")" class="btn btn-danger btn-sm fw-bold">
                          <i class="bi bi-arrow-repeat me-1"></i> Renew Now
                      </a>
                  }
                  <a href="@Url.Action("LicenseExpired", "Home")" class="btn btn-outline-danger btn-sm">
                      <i class="bi bi-eye me-1"></i> View Notice
                  </a>
              </div>
          </div>
      }
      else if (isCurrentShopExpiringSoon && act != "LicenseExpired" && act != "Suspended")
      {
          <div class="alert alert-warning border-warning border-opacity-50 mx-3 mt-3 mb-0 shadow-sm d-flex align-items-center justify-content-between flex-wrap gap-2 rounded-3" style="background:rgba(245,158,11,0.12);">
              <div class="d-flex align-items-center gap-2">
                  <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-warning text-dark flex-shrink-0" style="width:30px;height:30px;">
                      <i class="bi bi-hourglass-bottom fs-7"></i>
                  </span>
                  <div>
                      <strong class="text-warning">Subscription Expiring Soon!</strong>
                      <span class="text-light fs-7 ms-1">
                          You have only <strong>@(Math.Max(0, currentShopDaysRemaining)) day(s)</strong> remaining on your active plan (Expires: @(currentShopLicense != null ? currentShopLicense.ExpiryDate.AddMinutes(330).ToString("dd MMM yyyy, hh:mm tt IST") : "N/A")). Renew or upgrade now to retain seamless access to all your shop features.
                      </span>
                  </div>
              </div>
              <div class="d-flex align-items-center gap-2">
                  @if (isAdmin)
                  {
                      <a href="@Url.Action("Renew", "Subscription")" class="btn btn-warning btn-sm fw-bold text-dark">
                          <i class="bi bi-arrow-repeat me-1"></i> Extend License
                      </a>
                  }
                  <a href="@Url.Action("MyPlan", "Subscription")" class="btn btn-outline-warning btn-sm">
                      <i class="bi bi-eye me-1"></i> Plan Overview
                  </a>
              </div>
          </div>
      }
      @RenderBody()
    </main>

  </div><!-- /main -->
}
else
{
  var pubCtrl = ViewContext.RouteData.Values["controller"]?.ToString();
  var pubAct  = ViewContext.RouteData.Values["action"]?.ToString();
  var pSettings = await PlatformSettingsService.GetSettingsAsync();

  <div class="public-saas-wrapper is-home-ecom min-vh-100 d-flex flex-column">
    @if (pSettings.WebsiteMaintenanceEnabled && pSettings.WebsiteMaintenanceStartTime.HasValue && DateTime.UtcNow < pSettings.WebsiteMaintenanceStartTime.Value)
    {
      <div class="bg-warning text-dark py-2 px-3 text-center fs-8 fw-semibold border-bottom border-warning">
        <i class="bi bi-clock-history me-1"></i> Scheduled Maintenance Notice: The platform will undergo maintenance starting at @pSettings.WebsiteMaintenanceStartTime.Value.AddMinutes(330).ToString("dd MMM yyyy, hh:mm tt") IST.
      </div>
    }

    <!-- Refined Minimalist Navbar Across All Public Marketing Pages -->
    <nav class="navbar navbar-expand-lg ecom-navbar sticky-top">
      <div class="container">
        <!-- Brand / Logo on left (Compact black SIMS wordmark) -->
        <a class="navbar-brand ecom-nav-brand" href="@Url.Action("Index", "Landing")">
          <span class="ecom-brand-text">SIMS</span>
        </a>

        <!-- Mobile Hamburger Toggle Button -->
        <button class="navbar-toggler ecom-toggler border-0 shadow-none p-1" type="button" data-bs-toggle="collapse" data-bs-target="#ecomNavbar" aria-controls="ecomNavbar" aria-expanded="false" aria-label="Toggle navigation">
          <i class="bi bi-list fs-2 text-dark"></i>
        </button>

        <!-- Navigation Links & Right Actions (Dedicated Page Routes with Active States) -->
        <div class="collapse navbar-collapse" id="ecomNavbar">
          <ul class="navbar-nav mx-auto mb-2 mb-lg-0 ecom-menu-list">
            <li class="nav-item">
              <a class="nav-link ecom-menu-link @(pubCtrl == "Landing" && pubAct == "Index" ? "active" : "")" href="@Url.Action("Index", "Landing")">Home</a>
            </li>
            <li class="nav-item">
              <a class="nav-link ecom-menu-link @(pubCtrl == "Landing" && pubAct == "Features" ? "active" : "")" href="@Url.Action("Features", "Landing")">Platform &amp; Features</a>
            </li>
            <li class="nav-item">
              <a class="nav-link ecom-menu-link @(pubCtrl == "Landing" && pubAct == "Pricing" ? "active" : "")" href="@Url.Action("Pricing", "Landing")">Pricing</a>
            </li>
            <li class="nav-item">
              <a class="nav-link ecom-menu-link @(pubCtrl == "Landing" && pubAct == "Contact" ? "active" : "")" href="@Url.Action("Contact", "Landing")">Company &amp; Support</a>
            </li>
          </ul>

          <div class="d-flex align-items-center gap-3 pt-2 pt-lg-0 ecom-nav-actions">
            <a href="@Url.Action("Login", "Account")" class="ecom-btn-signin text-decoration-none">
              Sign In
            </a>
            <a href="@Url.Action("Register", "Landing")" class="ecom-btn-primary text-decoration-none">
              Start Free Trial
            </a>
          </div>
        </div>
      </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-grow-1" role="main">
      @RenderBody()
    </main>

    <!-- Refined Minimal Editorial Multi-Column Footer (Universal Across All Public Pages) -->
    <footer class="ecom-footer py-5 mt-auto">
      <div class="ecom-container">
        <div class="row g-4 g-lg-5 mb-5">
          <!-- Col 1: Brand & Description -->
          <div class="col-lg-4 col-md-12 text-start">
            <div class="d-flex align-items-center gap-2 mb-3">
              <span class="ecom-brand-text fs-4 fw-bold">SIMS</span>
            </div>
            <p class="ecom-footer-desc mb-4">
              The smart inventory management system engineered for modern retailers, repair workshops, and growing businesses to manage inventory, sales, and operations with complete precision.
            </p>
            <div class="ecom-status-badge">
              <span class="ecom-status-dot"></span>
              <span>All Systems Operational</span>
            </div>
          </div>

          <!-- Col 2: Product -->
          <div class="col-lg-2 col-md-3 col-6 text-start">
            <h6 class="ecom-footer-heading">Product</h6>
            <ul class="list-unstyled ecom-footer-links mb-0">
              <li><a href="@Url.Action("Features", "Landing")">Platform Overview</a></li>
              <li><a href="@Url.Action("Features", "Landing")#imei">IMEI &amp; Serial Tracking</a></li>
              <li><a href="@Url.Action("Features", "Landing")#pos">POS Billing</a></li>
              <li><a href="@Url.Action("Features", "Landing")#repairs">Repair Workshop</a></li>
              <li><a href="@Url.Action("Pricing", "Landing")">Subscription Plans</a></li>
            </ul>
          </div>

          <!-- Col 3: Resources -->
          <div class="col-lg-2 col-md-3 col-6 text-start">
            <h6 class="ecom-footer-heading">Resources</h6>
            <ul class="list-unstyled ecom-footer-links mb-0">
              <li><a href="@Url.Action("Features", "Landing")">Retail Guides</a></li>
              <li><a href="@Url.Action("Features", "Landing")">GST Compliance</a></li>
              <li><a href="@Url.Action("Features", "Landing")">Shrinkage Guard</a></li>
              <li><a href="@Url.Action("Pricing", "Landing")">Feature Comparison</a></li>
            </ul>
          </div>

          <!-- Col 4: Company -->
          <div class="col-lg-2 col-md-3 col-6 text-start">
            <h6 class="ecom-footer-heading">Company</h6>
            <ul class="list-unstyled ecom-footer-links mb-0">
              <li><a href="@Url.Action("Contact", "Landing")">About Us</a></li>
              <li><a href="@Url.Action("Contact", "Landing")">Support Desk</a></li>
              <li><a href="@Url.Action("Pricing", "Landing")">Pricing Tiers</a></li>
              <li><a href="@Url.Action("Register", "Landing")">Register Business</a></li>
            </ul>
          </div>

          <!-- Col 5: Stay Updated / Newsletter -->
          <div class="col-lg-2 col-md-3 col-12 text-start">
            <h6 class="ecom-footer-heading">Stay Updated</h6>
            <p class="ecom-footer-micro-desc mb-3">
              Latest updates, inventory insights &amp; operational guides.
            </p>
            <form id="footerNewsletterForm" class="ecom-footer-newsletter mb-3" novalidate>
              <div class="ecom-newsletter-field">
                <input type="email" 
                       id="footerNewsletterEmail" 
                       name="newsletterEmail" 
                       class="ecom-newsletter-input" 
                       placeholder="Your email" 
                       required 
                       aria-label="Email address"
                       aria-describedby="footerNewsletterMsg"
                       autocomplete="email" />
                <button type="submit" class="ecom-newsletter-btn" aria-label="Subscribe to newsletter">
                  <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </button>
              </div>
              <div id="footerNewsletterMsg" 
                   class="ecom-newsletter-msg" 
                   role="status" 
                   aria-live="polite"></div>
            </form>
            <div class="ecom-social-row">
              <a href="javascript:void(0)" class="ecom-social-icon" aria-label="Twitter"><i class="bi bi-twitter-x"></i></a>
              <a href="javascript:void(0)" class="ecom-social-icon" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
              <a href="javascript:void(0)" class="ecom-social-icon" aria-label="Telegram"><i class="bi bi-telegram"></i></a>
            </div>
          </div>
        </div>

        <div class="ecom-footer-bottom pt-4 border-top d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
          <span class="ecom-copyright">
            &copy; @DateTime.Now.Year SIMS Platform. All rights reserved.
          </span>
          <div class="d-flex gap-4 ecom-bottom-links">
            <a href="@Url.Action("Contact", "Landing")">Support Desk</a>
            <a href="@Url.Action("Pricing", "Landing")">Plans &amp; Pricing</a>
            <a href="@Url.Action("Login", "Account")">Sign In</a>
          </div>
        </div>
      </div>
    </footer>
  </div>
}

<!-- Toast stack -->
<div id="toast-stack" class="toast-stack" aria-live="polite"></div>

<!-- Scripts -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>
<script src="~/js/app.js" asp-append-version="true"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
